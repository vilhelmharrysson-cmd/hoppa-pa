1.831683],[57.75846,11.831392],[57.758267,11.831577],[57.7565,11.831009],[57.756385,11.830699],[57.756228,11.830915],[57.754335,11.830324],[57.754412,11.830183],[57.754335,11.830307],[57.754099,11.830244],[57.748865,11.827979],[57.745291,11.82846],[57.74482,11.828316],[57.744081,11.827541],[57.743423,11.826002],[57.74328,11.825325],[57.743207,11.824205],[57.743248,11.821546],[57.743141,11.820496],[57.739283,11.807205],[57.739315,11.806714],[57.739132,11.806596],[57.737423,11.800478],[57.737508,11.800269],[57.737475,11.800036],[57.737303,11.800001],[57.736582,11.797443],[57.735845,11.795307],[57.733551,11.790637],[57.729573,11.781932],[57.728971,11.780171],[57.727179,11.77403],[57.726418,11.772384],[57.724614,11.768983],[57.724223,11.768447],[57.723406,11.767797],[57.722773,11.767635],[57.721915,11.767829],[57.721031,11.768765],[57.718635,11.774203],[57.718588,11.774123],[57.718584,11.774308],[57.715696,11.780914],[57.714389,11.783264],[57.714091,11.78319],[57.714105,11.783054]],"stops":[{"name":"Nils Ericson Terminalen","lat":57.709939,"lon":11.972229,"story":"Välkommen ombord på buss 129 mot Torslandakrysset! Resan tar ungefär 68 minuter. Göteborg får snart en ny station under fötterna. Glasterminalen själv ritades av norrmannen Niels Torp och fick Kasper Salin-priset 1996. I Nordstan finns Emotrappan, där punkare och hårdrockare samlades redan på 1980-talet.","tips":[["Se skulpturen Bohuslän vid Centralen","2 min"],["Hitta Emotrappan i Nordstan","3 min"]],"dur":21.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Bohusl%C3%A4n.sculpture.JPG/1280px-Bohusl%C3%A4n.sculpture.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Bohusl%C3%A4n.sculpture.JPG","title":"Bohuslän.sculpture"}],"audio":"audio/piper/d7dcca6d909e0e64.mp3"},{"name":"Hjalmar Brantingsplatsen","lat":57.720849,"lon":11.951966,"story":"Hjalmar Brantingsplatsen är Hisingens stora knutpunkt. Hisingen är Sveriges fjärde största ö, och här byggdes en gång både fartyg och bilar. Volvo grundades i Göteborg 1927, och huvudkontoret ligger fortfarande på Hisingen.","tips":[["Backaplan, handel","8 min"]],"dur":13.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/Green_fly%2C_white_flower.jpeg/1280px-Green_fly%2C_white_flower.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Philip Jägenstedt","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Green_fly,_white_flower.jpeg","title":"A green fly (green bottle?) in Gothenburg, Sweden.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Paddan_1.JPG/1280px-Paddan_1.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Paddan_1.JPG","title":"Paddan 1 Vid Kungsportsplatsen","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/Backabrandens_lokaler_i_mars_2015.jpg/1280px-Backabrandens_lokaler_i_mars_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Backabrandens_lokaler_i_mars_2015.jpg","title":"Backabrandens lokaler i mars 2015.","near":true}],"audio":"audio/piper/e70844d966c46352.mp3"},{"name":"Skra Bro","lat":57.758552,"lon":11.832527,"story":"Namnet Skra Bro sägs komma av det skrapande ljudet från slädmedar som skrapade mot underlaget i töväder. Den gamla bron över Osbäcken finns kvar alldeles intill, men är i dag bara en gångbro mellan pendelparkeringen och en matvaruaffär. Biltrafiken går numera över en större vägbro norr om rondellen.","tips":[["Skra bro","2 min"]],"dur":16.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Skra_bro.jpg/1280px-Skra_bro.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Eva Ekeblad","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skra_bro.jpg","title":"Skra bro"}],"audio":"audio/piper/cd632ea626ff0838.mp3"},{"name":"Kvisljungeby","lat":57.754412,"lon":11.830183},{"name":"Gamla Lillebyvägen","lat":57.750217,"lon":11.828482,"story":"Alldeles intill ligger Hovgårdsvallen, fotbollsplanen i Björlanda som är hemmaplan för IK Zenith. Den går under flera namn, och den som pratar om Hovgården eller Zenithgården menar samma plan. Kanske är det en fördel att ha tre namn när motståndarlaget ska hitta rätt?","tips":[["Hovgårdsvallen","3 min"]],"dur":14.7,"audio":"audio/piper/243598a45f028daf.mp3"},{"name":"Skräddaregården","lat":57.745737,"lon":11.828337},{"name":"Låssbyvägen","lat":57.743251,"lon":11.823092},{"name":"Innegården","lat":57.74254,"lon":11.818398},{"name":"Lilleby Kronogård","lat":57.73908,"lon":11.806298},{"name":"Lillebyvägen","lat":57.737141,"lon":11.799293,"story":"Lilleby vid havet på Hisingen var länge ren landsbygd och hörde till Björlanda socken, tills området blev en del av Göteborg 1967. Laga skifte genomfördes här redan 1846. Numera växer bostadsområdena snabbt. Stadsdelen omfattar 1 330 hektar och bjuder också på Sillviks Havskoloni med sina bevarade 1950-talsstugor.","tips":[],"dur":21.4,"audio":"audio/piper/bb618d3d181f205d.mp3"},{"name":"Lilleby Skolväg","lat":57.735284,"lon":11.794096},{"name":"Torslanda Mellangård","lat":57.733318,"lon":11.789935},{"name":"Änghagen","lat":57.731205,"lon":11.785316},{"name":"Vårbäcksvägen","lat":57.728367,"lon":11.777973},{"name":"Hembygdsgatan","lat":57.726974,"lon":11.77341,"story":"En kort promenad härifrån står Torslanda kyrka, som räknas till en av Göteborgs stifts mest populära bröllopskyrkor. Kyrkan är sockenkyrka för Torslanda socken, som ända till 1967 låg utanför Göteborgs stad i Västra Hisings härad i Bohuslän. Sedan 2010 hör den till Torslanda-Björlanda församling.","tips":[["Torslanda kyrka","5 min"]],"dur":18.2,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/2/22/Torslanda_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"User Tor Svensson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Torslanda_kyrka.jpg","title":"Torslanda kyrka"}],"audio":"audio/piper/d12b59bb9a95cc74.mp3"},{"name":"Torslanda Torg","lat":57.722447,"lon":11.767564,"story":"Torslanda är en stor stadsdel på västra Hisingen, 4 425 hektar, med mindre orter som Amhult, Hjuvik, Hällsvik och Tumlehed. En kort promenad bort står Torslanda kyrka, en av Göteborgs stifts mest populära bröllopskyrkor. Och innan Landvetter byggdes 1977 låg Göteborgs huvudflygplats just här i Torslanda.","tips":[["Torslanda kyrka","4 min"]],"dur":20.7,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/2/22/Torslanda_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"User Tor Svensson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Torslanda_kyrka.jpg","title":"Torslanda kyrka"}],"audio":"audio/piper/a1a59475bdb3a7af.mp3"},{"name":"Nordhagsvägen","lat":57.718588,"lon":11.774123,"story":"Torslanda är kyrkbyn i den gamla Torslanda socken, som uppgick i Göteborgs stad 1967. Orten är känd för sina många badstränder och sin natur, men allra mest för Volvos bilfabrik Torslandaverken. Idrotten har djupa rötter här: Torslanda IK grundades den 18 januari 1944, och tillsammans med Torslanda HK hör klubben till ortens idrottsföreningar.","tips":[],"dur":22.4,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/2/22/Torslanda_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"User Tor Svensson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Torslanda_kyrka.jpg","title":"Torslanda kyrka"}],"audio":"audio/piper/56165d48334e106d.mp3"},{"name":"Torslandakrysset","lat":57.714105,"lon":11.783054,"story":"Snart är vi framme vid ändhållplatsen Torslandakrysset. Gamla flygfältet kallas det också, Torslanda flygfält, som anlades 1923 en bit härifrån på Hisingens västra sida, cirka 15 kilometer från centrala Göteborg. I mer än femtio år var det stadens flygplats, tills Landvetter ersatte det 1977. I dag är Torslanda framför allt känt för Volvos bilfabrik Torslandaverken. Tack för att du åkte med!","tips":[],"dur":26.6,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/e/e6/Torslanda.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"OkändUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Torslanda.jpg","title":"Torslanda"}],"audio":"audio/piper/e043423da2c0d152.mp3"}],"looks":[{"id":"lappstiftet","lat":57.7117,"lon":11.9677,"r":260,"text":"Till vänster ser du den röd-vita skyskrapan som göteborgarna kallar Läppstiftet.","dur":6.0,"audio":"audio/piper/4cf4412fffeaa2c4.mp3"}],"from":"Nils Ericson Terminalen","to":"Torslandakrysset","variant":"Mot Torslandakrysset","color":["#0071b9","#ffffff"],"trips":32,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}