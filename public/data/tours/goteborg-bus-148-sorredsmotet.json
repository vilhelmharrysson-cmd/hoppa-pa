,[57.755612,11.889802],[57.756316,11.886597],[57.756334,11.883704],[57.756663,11.880985],[57.756348,11.880592],[57.756009,11.879612],[57.755979,11.879144],[57.756237,11.877558],[57.75228,11.87494],[57.750452,11.874073],[57.750409,11.873757],[57.75107,11.871414],[57.749723,11.870404],[57.745411,11.867919],[57.742135,11.864135],[57.74201,11.864515],[57.741742,11.864219],[57.741627,11.863943],[57.741719,11.86365],[57.740837,11.86255],[57.740236,11.861476],[57.739236,11.858151],[57.738939,11.857773],[57.738868,11.857426],[57.738684,11.857627],[57.738772,11.857922],[57.738613,11.858373],[57.737881,11.859327],[57.737654,11.859952],[57.737028,11.864056],[57.735175,11.872014],[57.734914,11.872709],[57.734565,11.872756],[57.734123,11.873416],[57.733822,11.873627],[57.733111,11.87357],[57.731322,11.872465],[57.728995,11.8707],[57.727994,11.869459],[57.727105,11.867704],[57.728721,11.864708],[57.728747,11.861413],[57.728002,11.859982],[57.727954,11.859499],[57.72534,11.856702],[57.724354,11.855342],[57.72467,11.853954],[57.724594,11.852718],[57.72397,11.851125],[57.723858,11.850581],[57.723507,11.849855],[57.723274,11.848767],[57.723017,11.848218],[57.722469,11.847846],[57.719951,11.847796],[57.719913,11.846993],[57.719154,11.845782],[57.718828,11.844585],[57.718767,11.841063],[57.718215,11.840909],[57.715242,11.840984],[57.715139,11.841177],[57.715089,11.842055],[57.714775,11.842435],[57.714505,11.843164],[57.71418,11.843478],[57.713925,11.844054],[57.713736,11.844037],[57.71319,11.84343],[57.712805,11.842741],[57.711327,11.839713],[57.711378,11.839591]],"stops":[{"name":"Angered Centrum","lat":57.795566,"lon":12.04839,"story":"Välkommen ombord på buss 148 mot Sörredsmotet! Resan tar ungefär 83 minuter. Angered byggdes på 1970-talet och är i dag en av Göteborgs mest internationella stadsdelar. Här ligger kulturhuset Blå Stället, och runt omkring finns stora naturområden med sjöar och skog.","tips":[["Kulturhuset Blå Stället","2 min"]],"dur":18.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Angered_Centrum.jpg/1280px-Angered_Centrum.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Angered_Centrum.jpg","title":"Angered Centrum i maj 2012.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Angered_Centrum_2.jpg/1280px-Angered_Centrum_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Angered_Centrum_2.jpg","title":"Angered Centrum i maj 2012.","near":true}],"audio":"audio/piper/1b7e383493db368c.mp3"},{"name":"Gårdstensliden","lat":57.797796,"lon":12.036543,"story":"Gårdsten har vänt en trend. När det kommunala bostadsbolaget Gårdstensbostäder bildades 1997 stod över 800 av cirka 2 200 lägenheter tomma. Bolaget placerades mitt i området för att arbeta nära hyresgästerna. Ombyggnaden av östra Gårdsten vann Stora Samhällsbyggarpriset 2006, och 2019 blev Gårdsten det första området som togs bort från polisens lista över särskilt utsatta områden.","tips":[],"dur":25.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Angereds_Centrum.jpg/1280px-Angereds_Centrum.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Okänd","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Angereds_Centrum.jpg","title":"Angereds Centrum"}],"audio":"audio/piper/f4e07915c332b9f5.mp3"},{"name":"Klareberg","lat":57.800793,"lon":11.990541,"story":"Klareberg i Kärra är en plats där bussarna andas ut. Här tar busschaufförer gärna en paus, och den stora busshållplatsen används för resor till Kungälv, Angered och Göteborg. Men området är också känt bland ryttare och hundägare, som kommer hit för att rida och träna sina hundar.","tips":[],"dur":16.1,"audio":"audio/piper/d396ead809af1713.mp3"},{"name":"Skändla Rös","lat":57.790197,"lon":11.925467,"story":"En kort bit bort ligger Svensbydösen, även kallad Drottning Hackas grav, Göteborgs enda kända långdös och kommunens äldsta byggnadsverk. Enligt sägnen ska det finnas en guldring smidd av en jätte i graven, och skattsökare har skadat dösen svårt i jakten på den. När Norrleden planerades 1978 grävde arkeologer ut graven och kunde slå fast att det verkligen var en dös.","tips":[["Svensbydösen","7 min"]],"dur":20.9,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/4/4f/Drottning_Hackas_grav.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"User Tor Svensson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Drottning_Hackas_grav.jpg","title":"Drottning Hackas grav"}],"audio":"audio/piper/958c04b66497c7bb.mp3"},{"name":"Granhäll","lat":57.774902,"lon":11.891306,"story":"Hisingen är stor, cirka 199 kvadratkilometer, vilket är ungefär hälften av Göteborgs kommuns yta, och här bor ungefär en fjärdedel av invånarna. Ön ramas in av Göta älv i söder och öster, Nordre älv i norr och Kattegatt i väster. I trakten ligger den lilla bebyggelsen Holm i Tuve socken.","tips":[],"dur":18.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Hisingisland.jpg/1280px-Hisingisland.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jesperhallen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hisingisland.jpg","title":"Hisingisland"}],"audio":"audio/piper/cccbb0afebe8d7d6.mp3"},{"name":"Volvo Tuve L B","lat":57.755547,"lon":11.89191,"story":"Med sina 199 kvadratkilometer utgör Hisingen ungefär hälften av Göteborgs kommuns yta. Ön tillhör Västra Götalands län och är Sveriges femte största. Den omges av vatten på alla sidor: Göta älv, Nordre älv och Kattegatt. Ungefär en fjärdedel av ön räknas till Västergötland, resten till Bohuslän.","tips":[],"dur":20.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Hisingisland.jpg/1280px-Hisingisland.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jesperhallen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hisingisland.jpg","title":"Hisingisland"}],"audio":"audio/piper/133fce97fafcaf9c.mp3"},{"name":"Volvo Tuve L A","lat":57.756365,"lon":11.884239,"story":"Visste du att Hisingen till största delen räknas till Bohuslän? Cirka tre fjärdedelar av ön hör dit, med socknarna Torslanda, Björlanda, Säve, Backa och Rödbo. Den återstående fjärdedelen, med Lundby och Tuve, räknas till Västergötland. Så här på Hisingen kan man alltså byta landskap utan att lämna ön.","tips":[],"dur":19.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Hisingisland.jpg/1280px-Hisingisland.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jesperhallen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hisingisland.jpg","title":"Hisingisland"}],"audio":"audio/piper/389dcfe9d69cd6d6.mp3"},{"name":"Lexby Odlareväg","lat":57.750333,"lon":11.870687},{"name":"Kålsered","lat":57.741775,"lon":11.864099},{"name":"John Bunyans Väg","lat":57.737551,"lon":11.860129},{"name":"Hisingen Logistikpark","lat":57.73512,"lon":11.871952},{"name":"Volvo Torslanda PVH","lat":57.72807,"lon":11.866025},{"name":"Volvo Torslanda PV","lat":57.728377,"lon":11.860638},{"name":"Polestar","lat":57.725624,"lon":11.856912},{"name":"Volvohallen","lat":57.723581,"lon":11.849916,"story":"Den kupolformade byggnaden är Volvohallen, en utställningshall som Volvo Personvagnar uppförde 1975 efter ritningar av Lund & Valentin arkitekter. Volvos fabrik Torslandaverken började anläggas i stadsdelen Sörred, ett bynamn som finns belagt redan 1388 i formen Surfua rudi. Sörred hörde till Björlanda socken tills det inkorporerades i Göteborg 1967.","tips":[["Volvohallen","2 min"]],"dur":23.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/G%C3%B6teborg_volvo_headquarters_-_panoramio.jpg/1280px-G%C3%B6teborg_volvo_headquarters_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Robande","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:G%C3%B6teborg_volvo_headquarters_-_panoramio.jpg","title":"göteborg volvo headquarters","near":true},{"src":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Hot_Rod_Jakob_%283951214303%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Jeremy from Albuquerque, NM","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Hot_Rod_Jakob_(3951214303).jpg","title":"Pictures from the FDC - Sept 2010","near":true}],"audio":"audio/piper/cf9ca43a8b3a7bc5.mp3"},{"name":"Volvo City","lat":57.719542,"lon":11.846202,"story":"Volvohallen är en kupolformad utställningshall med kvadratisk planform, som Volvo Personvagnar lät uppföra 1975 intill sitt dåvarande huvudkontor. En bit bort ligger Torslandaverken, Volvo Personvagnars fabrik, som var Nordens största fabrik i ett plan när den invigdes. Fabriken började anläggas i Sörred åren 1960–1961.","tips":[],"dur":20.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7a/Aerial_photo_of_Gothenburg_2013-10-27_076_%28Torslandaverken%29.jpg/1280px-Aerial_photo_of_Gothenburg_2013-10-27_076_%28Torslandaverken%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aerial_photo_of_Gothenburg_2013-10-27_076_(Torslandaverken).jpg","title":"Aerial photo of Gothenburg 2013-10-27 076 (Torslandaverken)"}],"audio":"audio/piper/3a46ede2ce98ff1f.mp3"},{"name":"Volvo Torslanda TK","lat":57.717827,"lon":11.840842,"story":"Hållplatsen ligger vid Volvos bilfabrik, Torslandaverken. Marken började grävas 4 november 1957, och 24 april 1964 invigdes fabriken av kung Gustaf VI Adolf. Den första bilen som lämnade linjen var en Volvo Amazon, och sportiga P1800 byggdes också här från start. I dag tillverkas bland annat XC90 i Torslanda.","tips":[],"dur":22.6,"audio":"audio/piper/f3f0e324ef533fba.mp3"},{"name":"Sörredsmotet","lat":57.711378,"lon":11.839591,"story":"Snart är vi framme vid ändhållplatsen Sörredsmotet. Västra Hisingen är industrins och hamnarnas rike. En bit härifrån ligger oljeraffinaderiet Preemraff, som köper sin råolja mest från Nordsjön. I grannstadsdelen Arendal låg Arendalsvarvet mellan 1963 och 1989, och i dag finns där bland annat huvudkontoret för Volvo Bussar. Arendal är ett så renodlat industriområde att bara 90 personer bodde där år 2012. Tack för att du åkte med!","tips":[],"dur":27.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Aerial_photo_of_Gothenburg_2013-10-27_050.jpg/1280px-Aerial_photo_of_Gothenburg_2013-10-27_050.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aerial_photo_of_Gothenburg_2013-10-27_050.jpg","title":"Aerial photo of Gothenburg 2013-10-27 050"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4b/Aerial_photo_of_Gothenburg_2013-10-27_048.jpg/1280px-Aerial_photo_of_Gothenburg_2013-10-27_048.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aerial_photo_of_Gothenburg_2013-10-27_048.jpg","title":"Aerial photo of Gothenburg 2013-10-27 048"}],"audio":"audio/piper/c10c67422560644a.mp3"}],"looks":[],"from":"Angered Centrum","to":"Sörredsmotet","variant":"Mot Sörredsmotet","color":["#0071b9","#ffffff"],"trips":10,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}