],[57.712409,11.99026],[57.713106,11.99084],[57.713609,11.991554],[57.713971,11.992817],[57.713959,11.994195],[57.714568,11.998276],[57.714866,12.002501],[57.714979,12.003113],[57.715267,12.003861],[57.715966,12.004559],[57.71655,12.005687],[57.71679,12.007061],[57.71672,12.008679],[57.717162,12.012573],[57.717272,12.014529],[57.718547,12.021344],[57.718496,12.022608],[57.718222,12.023571],[57.718047,12.024946],[57.717867,12.025296],[57.717995,12.026915],[57.717947,12.02796],[57.718019,12.027938],[57.717968,12.031519],[57.717762,12.03424],[57.717567,12.04089],[57.717452,12.04095],[57.717405,12.04124],[57.717128,12.041313],[57.715715,12.040487],[57.715186,12.039775],[57.714523,12.03946],[57.713604,12.040122],[57.713167,12.041048],[57.713024,12.041866],[57.713028,12.042386],[57.713227,12.04321],[57.713867,12.04487],[57.714258,12.046199],[57.714795,12.049161],[57.715515,12.051151],[57.715581,12.05207],[57.715295,12.054041],[57.715331,12.054844],[57.71557,12.055849],[57.716896,12.054885],[57.717368,12.054712],[57.71948,12.055095],[57.720209,12.055506],[57.72025,12.055738],[57.720402,12.055675],[57.72091,12.056272],[57.721651,12.057623],[57.721715,12.058054],[57.721823,12.058062],[57.721882,12.057873],[57.722882,12.056817],[57.723373,12.055921],[57.723591,12.054862],[57.723593,12.053014],[57.723713,12.052769],[57.723592,12.05256],[57.723533,12.049676],[57.722168,12.049686],[57.722179,12.048257],[57.722304,12.04781]],"stops":[{"name":"Hinnebäcksgatan","lat":57.752172,"lon":11.917435,"story":"Välkommen ombord på buss 17 mot Östra Sjukhuset! Resan tar ungefär 62 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":9.6,"audio":"audio/piper/a0d2361ccea1907e.mp3"},{"name":"Norumshöjd","lat":57.75666,"lon":11.919777},{"name":"Norumsgärde","lat":57.757998,"lon":11.924522,"story":"Tuve ligger mitt på Hisingen, på gränsen mellan den tätbebyggda staden i söder och landsbygden i norr. Stadsdelen har en area på 1 720 hektar. Strax intill ligger bostadsområdet Tångedal, med radhus och vinkelhus som var klara för inflyttning 1968–1969, och en bit bort finns Tuve torg.","tips":[["Tuve torg","6 min"]],"dur":18.6,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/4/41/Tuve_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"User Tor Svensson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Tuve_kyrka.jpg","title":"Tuve kyrka"},{"src":"https://upload.wikimedia.org/wikipedia/commons/4/43/Flygbild_%C3%B6ver_T%C3%A5ngedal.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"John Glimberg","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Flygbild_%C3%B6ver_T%C3%A5ngedal.jpg","title":"Flygbild över Tångedal"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/25/Tuvetorg_2.jpg/1280px-Tuvetorg_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Civilspanaren","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Tuvetorg_2.jpg","title":"Tuvetorg 2"}],"audio":"audio/piper/3606776eab293330.mp3"},{"name":"Tuve Centrum","lat":57.754081,"lon":11.928335,"story":"Tuve torg, alldeles intill, stod klart 1971 och hette från början Norums torg. Först 1998 bytte det namn till Tuve torg, och 2007 fick det en ordentlig ansiktslyftning. Vid torget finns bland annat konditori, bibliotek och apotek, och strax intill ligger Glöstorpskyrkan, som i dag hör till Tuve-Säve församling.","tips":[["Tuve torg","2 min"],["Glöstorpskyrkan","1 min"]],"dur":19.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/25/Tuvetorg_2.jpg/1280px-Tuvetorg_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Civilspanaren","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Tuvetorg_2.jpg","title":"Tuvetorg 2"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/80/Gl%C3%B6storpskyrkan_Tuve.JPG/1280px-Gl%C3%B6storpskyrkan_Tuve.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Stenssen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Gl%C3%B6storpskyrkan_Tuve.JPG","title":"Glöstorpskyrkan Tuve"}],"audio":"audio/piper/5905e95cc8f35e93.mp3"},{"name":"Brunnehagen","lat":57.750316,"lon":11.928369,"story":"Tuve ligger mitt på Hisingen, precis på gränsen mellan den tätbebyggda staden och landsbygden. En bit härifrån finns Gunnestorps mosse, en blandning av sjö, kärr och mosse där vass, kaveldun och näckrosor växer sida vid sida med tranbär, sileshår och tuvull. Kring mossen finns fuktängar som tidigare var betesmarker.","tips":[],"dur":19.3,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/4/41/Tuve_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"User Tor Svensson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Tuve_kyrka.jpg","title":"Tuve kyrka"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Gunnestorps_mosse_02.jpg/1280px-Gunnestorps_mosse_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Gunnestorps_mosse_02.jpg","title":"Gunnestorps mosse 02"}],"audio":"audio/piper/14af3ef463d11eda.mp3"},{"name":"Gunnesgärde","lat":57.748813,"lon":11.933456,"story":"En bit härifrån ligger Gunnestorps mosse, en del av S.A. Hedlunds park och Hisingsparken. Norr om mossen finns ruinerna av ett gammalt torp, kallat Mosstorpet. Ruinen har blivit en del av utflyktslekplatsen Fruktträdgården, så där leker barn i dag där det en gång stod ett torp.","tips":[],"dur":16.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Gunnestorps_mosse_02.jpg/1280px-Gunnestorps_mosse_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Gunnestorps_mosse_02.jpg","title":"Gunnestorps mosse 02"}],"audio":"audio/piper/d54843a524f486d2.mp3"},{"name":"Grimbo","lat":57.741767,"lon":11.940154,"story":"I området ligger Gunnestorps mosse, en blandning av sjö, kärr och mosse i Hisingsparken. Här växer vass, kaveldun och näckrosor sida vid sida med tranbär, sileshår och tuvull. Norr om mossen finns ruinerna efter Mosstorpet, som numera ingår i utflyktslekplatsen Fruktträdgården.","tips":[],"dur":17.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Gunnestorps_mosse_02.jpg/1280px-Gunnestorps_mosse_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Gunnestorps_mosse_02.jpg","title":"Gunnestorps mosse 02"}],"audio":"audio/piper/83c756ac9381ea2c.mp3"},{"name":"Bäckedalsvägen","lat":57.734776,"lon":11.94172,"story":"En promenad bort ligger Slätta damm, som bildades kring 1860 i S.A. Hedlunds park. Vid dammen finns grillplats och ett våffelkafé, och under kalla vintrar åker folk skridsko på isen. Det är mest änder och knipor som simmar här. Parken ingår i Hisingsparken, Göteborgs största parkområde.","tips":[["Slätta damm","10 min"]],"dur":18.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Sl%C3%A4tta_Damm.jpg/1280px-Sl%C3%A4tta_Damm.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Lonezor","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sl%C3%A4tta_Damm.jpg","title":"Slätta Damm"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Sl%C3%A4tta_damm_2015_004.jpg/1280px-Sl%C3%A4tta_damm_2015_004.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Sl%C3%A4tta_damm_2015_004.jpg","title":"Slätta damm 2015 004"}],"audio":"audio/piper/f1dfe507001801fe.mp3"},{"name":"Hildedalsgatan","lat":57.732213,"lon":11.942423},{"name":"Björnsonsgatan","lat":57.7293,"lon":11.944601},{"name":"Swedenborgsplatsen","lat":57.725995,"lon":11.945451,"story":"En bit härifrån står Bjurslättskyrkan, som har bytt tradition: den var tidigare en kyrka i nuvarande Lundby församling men tillhör sedan 1998 den grekisk-ortodoxa kyrkan. Längre bort vid Vågmästareplatsen ligger Kville saluhall, invigd 2013, med kött, fisk och skaldjur, bageri, café och ett brett utbud av restauranger.","tips":[["Bjurslättskyrkan","5 min"],["Kville saluhall","8 min"]],"dur":19.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Bjursl%C3%A4ttskyrkan.jpg/1280px-Bjursl%C3%A4ttskyrkan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bulver","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Bjursl%C3%A4ttskyrkan.jpg","title":"Bjurslättskyrkan"}],"audio":"audio/piper/7e79ffbcde404a39.mp3"},{"name":"Vågmästareplatsen","lat":57.721457,"lon":11.945112,"story":"Hungrig? Kville saluhall öppnade 2013 med kött, fisk, skaldjur, bageri och massor av restauranger. En bit bort låg biografen Gnistan. Premiären 1938 var militärfarsen Kamrater i vapenrocken, och 1968 släcktes ridån för gott efter Django skjuter alltid först. På Kvilletorget står Carl Milles staty Susanna, även kallad Flicka med snäcka.","tips":[["Ät eller handla i Kville saluhall","1 min"],["Se Milles Susanna på Kvilletorget","4 min"]],"dur":22.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/Kvilletorget.jpg/1280px-Kvilletorget.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jesperhallen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kvilletorget.jpg","title":"Kvilletorget"}],"audio":"audio/piper/7b50282f44a1ae86.mp3"},{"name":"Hjalmar Brantingsplatsen","lat":57.72069,"lon":11.952433,"story":"Hjalmar Brantingsplatsen är Hisingens stora knutpunkt. Hisingen är Sveriges fjärde största ö, och här byggdes en gång både fartyg och bilar. Volvo grundades i Göteborg 1927, och huvudkontoret ligger fortfarande på Hisingen.","tips":[["Backaplan, handel","8 min"]],"dur":13.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/Green_fly%2C_white_flower.jpeg/1280px-Green_fly%2C_white_flower.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Philip Jägenstedt","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Green_fly,_white_flower.jpeg","title":"A green fly (green bottle?) in Gothenburg, Sweden.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Paddan_1.JPG/1280px-Paddan_1.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Paddan_1.JPG","title":"Paddan 1 Vid Kungsportsplatsen","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/Backabrandens_lokaler_i_mars_2015.jpg/1280px-Backabrandens_lokaler_i_mars_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Backabrandens_lokaler_i_mars_2015.jpg","title":"Backabrandens lokaler i mars 2015.","near":true}],"audio":"audio/piper/e70844d966c46352.mp3"},{"name":"Nils Ericsonsplatsen","lat":57.709114,"lon":11.970803,"story":"Nils Ericsonsplatsen är uppkallad efter Nils Ericson, som byggde Sveriges första stambanor. Han var bror till uppfinnaren John Ericsson. Under oss byggs Västlänken, en järnvägstunnel under centrala Göteborg.","tips":[["Nordstan, inomhusgalleria","3 min"]],"dur":12.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f9/Buses_in_Gothenburg.jpg/1280px-Buses_in_Gothenburg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Marcusroos","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Buses_in_Gothenburg.jpg","title":"Buses in Gothenburg, Sweden. From left to right: MAN NG 313 (#574, built 2004) and Volvo 7500 Bi-art","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/42/G%C3%B6teborgs_Centralstation_Shopping_%2815345716652%29.jpg/1280px-G%C3%B6teborgs_Centralstation_Shopping_%2815345716652%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Tony Webster from Portland, Oregon, United States","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:G%C3%B6teborgs_Centralstation_Shopping_(15345716652).jpg","title":"Gothenburg, Sweden","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Nordstan_G%C3%B6teborg_%2815368560122%29.jpg/1280px-Nordstan_G%C3%B6teborg_%2815368560122%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Tony Webster from Portland, Oregon, United States","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Nordstan_G%C3%B6teborg_(15368560122).jpg","title":"Gothenburg, Sweden","near":true}],"audio":"audio/piper/18a58aed436523a2.mp3"},{"name":"Drottningtorget","lat":57.708626,"lon":11.975193,"story":"Drottningtorget ligger mitt framför Centralstationen, som invigdes 1858 och är en av landets äldsta stationsbyggnader som fortfarande används. Härifrån utgår stora delar av Nordens största spårvägsnät. Göteborg fick hästspårvagnar 1879 och elektriska vagnar 1902, och staden valde att behålla spårvagnen när många andra svenska städer lade ner sin.","tips":[["Nordstan, inomhusgalleria","2 min"],["Lilla Bommen och Göteborgsoperan","8 min"]],"dur":22.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Hotel_Eggers_1.JPG/1280px-Hotel_Eggers_1.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hotel_Eggers_1.JPG","title":"Hotel Eggers Vid Drottningtorget i Göteborg","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Tram_2_at_Centralstation_%282416433995%29.jpg/1280px-Tram_2_at_Centralstation_%282416433995%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"LHOON from Mechelen, Belgium","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Tram_2_at_Centralstation_(2416433995).jpg","title":"Tram M31 352, Drottningtorget, April 2008.","near":true},{"src":"https://pub.raa.se/dokumentation/27191d8d-4c6a-43a7-8888-c5a814a72709/visning/1","credit":"Sjöbeck, Mårten","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/27191d8d-4c6a-43a7-8888-c5a814a72709","title":"Fattighuskanalen vid Drottningtorget","old":true,"year":1931,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/5094b2a3-0c97-4fc1-afb3-df802b1b2856/visning/1","credit":"Bruno, Fredrik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/5094b2a3-0c97-4fc1-afb3-df802b1b2856","title":"Södra Hamngatan","old":true,"year":1943,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/4f510ef0a9fd7bc1.mp3"},{"name":"Svingeln","lat":57.713536,"lon":11.99151,"story":"Uppe på berget i närheten ligger Skansen Lejonet, en försvarsborg från 1600-talet med ett förgyllt lejon på toppen. Den byggdes för att skydda staden från angrepp österifrån.","tips":[["Skansen Lejonet","8 min"]],"dur":10.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/Skansen_Lejonet.jpg/1280px-Skansen_Lejonet.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Lintoncat","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skansen_Lejonet.jpg","title":"Skansen Lejonet, Gullbergsvass 703:4. Göteborg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/G%C3%B6teborgs_fd_spinnhus_%28Stampen_20-2%29_2012-09-28_11-50-15.jpg/1280px-G%C3%B6teborgs_fd_spinnhus_%28Stampen_20-2%29_2012-09-28_11-50-15.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"SM6XSG","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:G%C3%B6teborgs_fd_spinnhus_(Stampen_20-2)_2012-09-28_11-50-15.jpg","title":"Göteborgs fd spinnhus (Stampen 20:2)","near":true},{"src":"https://pub.raa.se/dokumentation/11affe9f-9248-41de-af7d-0e78c9144ad6/visning/1","credit":"Okänd","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/11affe9f-9248-41de-af7d-0e78c9144ad6","title":"Kapellet uppfördes 1864, för uppdraget anlitades byggmästarna Philip Jacob Rapp för den arkitektoniska gestalt","old":true,"year":1988,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/5979f2bf-2e71-4967-8f03-f81b932c9110/visning/1","credit":"Okänd","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/5979f2bf-2e71-4967-8f03-f81b932c9110","title":"Kapellet från 1864 har fasader av gult tegel och en plåtklädd kupol. Det är byggt i morisk stil, med interiör ","old":true,"year":1988,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/0a4e26fa7375077a.mp3"},{"name":"Olskrokstorget","lat":57.71466,"lon":11.999495},{"name":"Redbergsplatsen","lat":57.716071,"lon":12.004819,"story":"Redbergsplatsen hette förr Korsvägen och fick sitt nuvarande namn 1883. År 1873 sattes en allmän vattenpump upp här, där man kunde njuta av vatten från Delsjön. Strax norr om platsen, i Redbergslids Folkpark, restes 1886 en paviljong med scen för artister. Nedanför Sankt Pauli kyrka står fontängruppen Elementens kamp i brons, flyttad hit från Olskrokstorget 1968.","tips":[["Fontänen Elementens kamp","3 min"],["Sankt Pauli kyrka","4 min"]],"dur":26.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Redbergsparken.JPG/1280px-Redbergsparken.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Redbergsparken.JPG","title":"Redbergsparken"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/44/Elementens_Kamp%2C_Gothenburg-2009-01-02.jpg/1280px-Elementens_Kamp%2C_Gothenburg-2009-01-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Halhen","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Elementens_Kamp,_Gothenburg-2009-01-02.jpg","title":"Elementens Kamp, Gothenburg-2009-01-02"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/St_Pauli_ka.JPG/1280px-St_Pauli_ka.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:St_Pauli_ka.JPG","title":"St Pauli ka"}],"audio":"audio/piper/4fb01d48df0e69c2.mp3"},{"name":"Härlanda","lat":57.7185,"lon":12.02128,"story":"Bakom murarna i Härlanda satt fångar från 1907 till 1997. Det gamla centralfängelset är byggnadsminne och heter numera Härlanda park. Biografen Saga på Sofiagatan stängde 1964. Året därpå blev den livsmedelsbutik – Saga Hemköp, den första i kedjan Sagabutikerna. Mitt bland husen ligger även en gammal kyrkoruin.","tips":[["Gå runt i Härlanda park, det gamla fängelset","4 min"],["Se Härlanda kyrkoruin","3 min"]],"dur":21.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/The_H%C3%A4rlanda_Prison.jpg/1280px-The_H%C3%A4rlanda_Prison.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"MichaelRedbridge","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:The_H%C3%A4rlanda_Prison.jpg","title":"The Härlanda Prison"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Saga_1943.jpg/1280px-Saga_1943.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Otto Thulin","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Saga_1943.jpg","title":"Saga 1943"},{"src":"https://pub.raa.se/dokumentation/773c97ef-fc9c-4a61-bcb6-761e23c902fd/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/773c97ef-fc9c-4a61-bcb6-761e23c902fd","title":"Flygbild över hamnen och staden. Härlanda med Bagaregården, Strömmensberg och Östra kyrkogården","old":true,"year":1966,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/9b55543f817bc3b3.mp3"},{"name":"Munkebäckstorget","lat":57.717947,"lon":12.02796,"story":"Munkebäckstorget fick sitt namn 1947 efter Munkebäcken, ett gammalt namn på Härlandabäcken. Munkarna i namnet syftar troligen på munkar i Nya Lödöse. Strax intill finns resterna av den gamla Härlanda kyrka som kyrkoruin, minnet av en församling som uppgick i Nylöse församling redan 1528. Granne med ruinen står Härlanda nya kyrka.","tips":[["Härlanda kyrka","3 min"],["Härlanda kyrkoruin","4 min"]],"dur":22.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1e/Munkeb%C3%A4ckstorget.JPG/1280px-Munkeb%C3%A4ckstorget.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Munkeb%C3%A4ckstorget.JPG","title":"Munkebäckstorget"}],"audio":"audio/piper/17733b1d2a6493b4.mp3"},{"name":"Qvidingsgatan","lat":57.717762,"lon":12.03424},{"name":"Bovallstrandsgatan","lat":57.717507,"lon":12.040223,"story":"Vid Torpagatan sitter skulpturen Ensam av Margareta Ryndel: ett litet barn på huk med armarna tätt mot bröstet. Den placerades ut 1988 till minne av Vidkärrs barnhem, som låg i grannskapet. Länge fanns en platta som talade om kärlek och omtanke på barnhemmet, men många av dem som bott där upplevde texten som ett grovt hån, och plattan är numera borttagen.","tips":[["Skulpturen Ensam","3 min"]],"dur":20.7,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8c/Ensam_Margareta_Ryndel.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Eva Ekeblad","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ensam_Margareta_Ryndel.JPG","title":"Ensam Margareta Ryndel"}],"audio":"audio/piper/c0954bccfc4ecd3f.mp3"},{"name":"Studiegången","lat":57.714291,"lon":12.039546},{"name":"Stabbetorget","lat":57.71449,"lon":12.047658,"story":"Gatunamnen här doftar sågspån. Sågmästaren Nils Georg Sörensen drev sågverket Säfveåns AB, och det har gett namn åt flera gator i Björkekärr: Hyvelsågsgatan, Klyvsågsgatan och just Stabbetorget. Sörensen fick dessutom en egen gata. På en kulle vid torget står Björkekärrs kyrka, och området gränsar till Delsjöområdets naturreservat.","tips":[["Björkekärrs kyrka","1 min"]],"dur":21.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a3/Bj%C3%B6rkek%C3%A4rrs_kyrka.jpg/1280px-Bj%C3%B6rkek%C3%A4rrs_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Historiker","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bj%C3%B6rkek%C3%A4rrs_kyrka.jpg","title":"Björkekärrs kyrka"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Sp%C3%A5ntorget.jpg/1280px-Sp%C3%A5ntorget.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"HVB","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sp%C3%A5ntorget.jpg","title":"Spåntorget"}],"audio":"audio/piper/7dcddcccb02f0b73.mp3"},{"name":"Trätorget","lat":57.715384,"lon":12.053228,"story":"Flera gator i trakten har fått sina namn från ett sågverk. Sörensens gata hedrar sågmästaren Nils Georg Sörensen, vars sågverk Säfveåns AB också gett namn åt Hyvelsågsgatan, Klyvsågsgatan och Stabbetorget. På en kulle vid Stabbetorget står Björkekärrs kyrka. En bit bort ligger Drottning Silvias barnsjukhus, Sveriges största barnsjukhus.","tips":[["Björkekärrs kyrka","5 min"]],"dur":20.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a3/Bj%C3%B6rkek%C3%A4rrs_kyrka.jpg/1280px-Bj%C3%B6rkek%C3%A4rrs_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Historiker","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bj%C3%B6rkek%C3%A4rrs_kyrka.jpg","title":"Björkekärrs kyrka"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/Drottning_Silvias_barnsjukhus%2C_vy_fr%C3%A5n_nordv%C3%A4st%2C_vidvinkel_%282022%29.jpg/1280px-Drottning_Silvias_barnsjukhus%2C_vy_fr%C3%A5n_nordv%C3%A4st%2C_vidvinkel_%282022%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Lucas Ravens","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Drottning_Silvias_barnsjukhus,_vy_fr%C3%A5n_nordv%C3%A4st,_vidvinkel_(2022).jpg","title":"Drottning Silvias barnsjukhus, vy från nordväst, vidvinkel (2022)"}],"audio":"audio/piper/1cdeb29e8381e5da.mp3"},{"name":"Spåntorget","lat":57.716173,"lon":12.055498},{"name":"Smörslottsgatan","lat":57.720029,"lon":12.055504},{"name":"Östra Sjukhuset","lat":57.722304,"lon":12.04781,"story":"Ändhållplatsen ligger vid Östra sjukhuset. Härifrån är det nära till Delsjöområdet, ett stort naturreservat med sjöar, skog och bad, där många göteborgare tillbringar helgerna. Tack för att du åkte med!","tips":[["Delsjöområdet","20 min"]],"dur":11.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/%C3%96stra_sjukhuset%2C_G%C3%B6teborg.JPG/1280px-%C3%96stra_sjukhuset%2C_G%C3%B6teborg.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Hannibal","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:%C3%96stra_sjukhuset,_G%C3%B6teborg.JPG","title":"Östra sjukhuset in Gothenburg from tram stop","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/H%C3%A5llplats_%C3%96stra_Sjukhuset.JPG/1280px-H%C3%A5llplats_%C3%96stra_Sjukhuset.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%A5llplats_%C3%96stra_Sjukhuset.JPG","title":"Bygget av den nya hållplatsen för linje 5 vid Östra Sjukhuset","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/%C3%96stra_Sjukhuset_h%C3%A5llplats.JPG/1280px-%C3%96stra_Sjukhuset_h%C3%A5llplats.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:%C3%96stra_Sjukhuset_h%C3%A5llplats.JPG","title":"Bygget av den nya hållplatsen för linje 5 vid Östra Sjukhuset","near":true}],"audio":"audio/piper/df767fcc3897223d.mp3"}],"looks":[{"id":"skansenlejonet","lat":57.7158,"lon":11.9887,"r":320,"text":"Till vänster ligger Skansen Lejonet, en försvarsborg från 1600-talet med ett förgyllt lejon på toppen.","dur":7.3,"audio":"audio/piper/64aad9e228418c61.mp3"},{"id":"lappstiftet","lat":57.7117,"lon":11.9677,"r":260,"text":"Till höger ser du den röd-vita skyskrapan som göteborgarna kallar Läppstiftet.","dur":5.4,"audio":"audio/piper/dc65394d7b4531a0.mp3"}],"from":"Hinnebäcksgatan","to":"Östra Sjukhuset","variant":"Mot Östra Sjukhuset","color":["#1d2a6b","#fddd04"],"trips":565,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}