.019533],[57.633382,12.020316],[57.631347,12.023599],[57.631176,12.023596],[57.631081,12.023353],[57.631229,12.022805],[57.631082,12.022632],[57.63092,12.022629],[57.630774,12.023328]],"stops":[{"name":"Svarte Mosse","lat":57.73315,"lon":11.887581,"story":"Välkommen ombord på buss 25 mot Peppareds torg! Resan tar ungefär 79 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":8.9},{"name":"Länsmanstorget","lat":57.732577,"lon":11.894587},{"name":"Temperaturgatan","lat":57.733129,"lon":11.895867},{"name":"Solstrålegatan","lat":57.738488,"lon":11.900349},{"name":"Klara","lat":57.739821,"lon":11.903747},{"name":"Bjurslättsliden","lat":57.73516,"lon":11.91238},{"name":"Toleredsgatan","lat":57.73104,"lon":11.918881},{"name":"Bjurslätts Torg","lat":57.728244,"lon":11.926982},{"name":"Wieselgrensgatan","lat":57.727354,"lon":11.935122},{"name":"Wieselgrensplatsen","lat":57.72134,"lon":11.934354},{"name":"Vågmästareplatsen","lat":57.720276,"lon":11.944607},{"name":"Hjalmar Brantingsplatsen","lat":57.72069,"lon":11.952433,"story":"Hjalmar Brantingsplatsen är Hisingens stora knutpunkt. Hisingen är Sveriges fjärde största ö, och här byggdes en gång både fartyg och bilar. Volvo grundades i Göteborg 1927, och huvudkontoret ligger fortfarande på Hisingen.","tips":[["Backaplan, handel","8 min"]],"dur":15.9},{"name":"Lilla Bommen","lat":57.708991,"lon":11.966817,"story":"Vid Lilla Bommen möter staden älven. Den röd-vita skyskrapan kallas Läppstiftet. Den stod klar 1989 och har en utsiktsvåning högst upp. Bredvid ligger Göteborgsoperan, invigd 1994, och vid kajen ligger segelfartyget Barken Viking från 1906.","tips":[["Göteborgsoperan","3 min"],["Barken Viking vid kajen","4 min"]],"dur":17.1},{"name":"Brunnsparken","lat":57.707675,"lon":11.967397,"story":"Brunnsparken är stadens hjärta för kollektivtrafiken. Härifrån går nästan alla spårvagnslinjer. Precis intill ligger Gustaf Adolfs torg med statyn av kungen som grundade Göteborg 1621. Staden byggdes av holländska ingenjörer, och det är därför Göteborg har kanaler. Holländarna kunde bygga på lera.","tips":[["Gustaf Adolfs torg och Stora Hamnkanalen","2 min"],["Göteborgs stadsmuseum i Ostindiska huset","4 min"]],"dur":21.3},{"name":"Domkyrkan","lat":57.704127,"lon":11.963748,"story":"Gustavi domkyrka har brunnit två gånger, 1721 och 1802. Den byggnad du ser stod klar 1815. Gatorna runt omkring är rutnätet från stadens första år, och Kungsgatan, en av Sveriges längsta gågator, går bara ett kvarter bort.","tips":[["Kungsgatan, shopping","1 min"],["Domkyrkan, ofta öppen dagtid","1 min"]],"dur":15.9},{"name":"Grönsakstorget","lat":57.702256,"lon":11.965164,"story":"Här tar innerstaden slut och vallgraven tar vid. Den slingrande kanalen är resterna av befästningen som en gång omgav Göteborg. Längs vattnet ligger Feskekôrka, stadens fiskhall från 1874. Den ser ut som en kyrka, och göteborgarna har kallat den fiskkyrkan sedan dess.","tips":[["Feskekôrka, räkmacka vid vattnet","3 min"],["Stora Saluhallen vid Kungstorget","6 min"]],"dur":19.1},{"name":"Pilgatan","lat":57.696719,"lon":11.960273},{"name":"Linnéplatsen","lat":57.689266,"lon":11.952741,"story":"Vid Linnéplatsen börjar Slottsskogen, stadens stora park från 1874. Där finns djur, dammar och Naturhistoriska museet, som har en uppstoppad blåval från 1865. Åt andra hållet går Linnégatan, en av stadens mest omtyckta restauranggator.","tips":[["Slottsskogen","2 min"],["Naturhistoriska museet och blåvalen","10 min"],["Linnégatan, restauranger","2 min"]],"dur":16.8},{"name":"Annedalskyrkan","lat":57.685542,"lon":11.95448},{"name":"Sahlgrenska Huvudentré","lat":57.683596,"lon":11.959879,"story":"Här ligger Sahlgrenska universitetssjukhuset, ett av Nordeuropas största sjukhus. Det har fått sitt namn efter Niclas Sahlgren, ännu en av de rika direktörerna i Ostindiska Kompaniet, vars pengar lade grunden till sjukhuset.","tips":[["Botaniska trädgården","8 min"]],"dur":16.0},{"name":"Sahlgrenska Södra","lat":57.681198,"lon":11.965181},{"name":"Södermalmsgatan","lat":57.678723,"lon":11.969196},{"name":"Dalgångsgatan","lat":57.672644,"lon":11.980323},{"name":"Toltorpsskolan","lat":57.670792,"lon":11.984083},{"name":"Fässbergs äldreboende","lat":57.66479,"lon":11.992833},{"name":"Bifrost","lat":57.661509,"lon":11.998455},{"name":"Jungfruplatsen","lat":57.65925,"lon":12.002146},{"name":"Fässbergsskolan","lat":57.656405,"lon":12.006489},{"name":"Storgatan","lat":57.655999,"lon":12.011351},{"name":"Mölndals Innerstad","lat":57.656486,"lon":12.017129,"story":"Välkommen till Mölndal. Längs forsen i Mölndals kvarnby har vattenkraften drivit kvarnar och fabriker i flera hundra år. I dag är kvarnbyn ett kulturmiljöområde med museum och kaféer.","tips":[["Mölndals kvarnby","8 min"]],"dur":13.1},{"name":"Katrinebergsgatan","lat":57.649616,"lon":12.018113},{"name":"AstraZeneca","lat":57.643516,"lon":12.01749},{"name":"GoCo","lat":57.639736,"lon":12.021856},{"name":"Gamla tingshuset","lat":57.637728,"lon":12.020546},{"name":"Peppareds torg","lat":57.630774,"lon":12.023328,"story":"Snart är vi framme vid ändhållplatsen Peppareds torg. Tack för att du åkte med!","tips":[],"dur":5.6}],"looks":[{"id":"lappstiftet","lat":57.7117,"lon":11.9677,"r":260,"text":"Till höger ser du den röd-vita skyskrapan som göteborgarna kallar Läppstiftet.","dur":5.6}],"from":"Svarte Mosse","to":"Peppareds torg","variant":"Mot Peppareds torg","color":["#1476c6","#ffffff"],"trips":541,"source":"Västtrafik via Trafiklab (GTFS Regional)"}