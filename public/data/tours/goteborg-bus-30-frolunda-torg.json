,[57.67386,11.89656],[57.672828,11.896615],[57.670337,11.897297],[57.669333,11.897383],[57.663291,11.897312],[57.662154,11.897879],[57.6613,11.893089],[57.66148,11.892017],[57.661344,11.891609],[57.661097,11.891446],[57.66062,11.891772],[57.659008,11.89419],[57.656658,11.897326],[57.652553,11.903645],[57.65214,11.904049],[57.652041,11.904427],[57.652187,11.904884],[57.653018,11.905769],[57.652667,11.906503],[57.652,11.906761],[57.651568,11.907502],[57.651832,11.908351],[57.651815,11.909124],[57.652108,11.909719]],"stops":[{"name":"Eketrägatan","lat":57.715976,"lon":11.910404,"story":"Välkommen ombord på buss 30 mot Frölunda Torg! Resan tar ungefär 45 minuter. Gatan minns adelsätten Eketrä, som från 1700-talet ägde godset Västra Pilegården ända fram till 1875 – just där asfalten ligger i dag. Härifrån svängde också Bräckelinjen av söderut. Spårvägen lades ner 1968 och revs under 1980-talet, men banvallen ligger kvar nästan orörd, som ett spår från en annan tid.","tips":[],"dur":25.9,"audio":"audio/piper/e9de15e6f8aca3d9.mp3"},{"name":"Kyrkbytorget","lat":57.711467,"lon":11.906103},{"name":"Vårvindsgatan","lat":57.706838,"lon":11.904282},{"name":"Oslogatan","lat":57.704778,"lon":11.901603},{"name":"Rosenhill","lat":57.702261,"lon":11.898696},{"name":"Ivarsbergsmotet","lat":57.699696,"lon":11.897421},{"name":"Klippan","lat":57.689913,"lon":11.912356,"story":"Klippan är en av Göteborgs äldsta miljöer, med gamla sjömanshus och resterna av den äldre Älvsborgs fästning. Strax intill reser sig Älvsborgsbron, och under bron ligger Röda Sten konsthall.","tips":[["Klippans kulturreservat","2 min"],["Röda Sten konsthall","8 min"]],"dur":10.2,"audio":"audio/piper/93c20ea82efe875c.mp3"},{"name":"Banehagsgatan","lat":57.687931,"lon":11.909185},{"name":"Orustgatan","lat":57.683991,"lon":11.905409},{"name":"Kungssten","lat":57.680811,"lon":11.901805,"story":"Kungssten ligger nära Göta älvs mynning. Härifrån ser du Älvsborgsbron, som var Sveriges längsta hängbro när den invigdes 1966. Ute i älvmynningen ligger Nya Älvsborgs fästning från 1600-talet, som skyddade staden mot danskarna. Vid vattnet nedanför ligger Klippan, med gamla sjömanshus och resterna av den äldre Älvsborgs fästning.","tips":[["Klippans kulturreservat","15 min"],["Röda Sten konsthall under Älvsborgsbron","20 min"]],"dur":20.1,"audio":"audio/piper/93b5532970ef5cd4.mp3"},{"name":"Bolmörtsgatan","lat":57.678535,"lon":11.900975},{"name":"Dalavägen","lat":57.67672,"lon":11.898077},{"name":"Kaprifolgatan","lat":57.672828,"lon":11.896615},{"name":"Trälåsvägen","lat":57.669887,"lon":11.897252},{"name":"Kavåsvägen","lat":57.66498,"lon":11.897302},{"name":"Klangfärgsgatan","lat":57.661742,"lon":11.895349},{"name":"Bergkristallsgatan","lat":57.656896,"lon":11.896769},{"name":"Smyckegatan","lat":57.6537,"lon":11.901703},{"name":"Frölunda Torg","lat":57.652108,"lon":11.909719,"story":"Snart är vi framme vid ändhållplatsen Frölunda Torg. Frölunda Torg öppnade 1966 och var ett av Sveriges första stora köpcentrum i förort. Runt omkring ligger Västra Frölunda, och några kilometer västerut börjar havet och skärgården. Tack för att du åkte med!","tips":[["Frölunda Torg, köpcentrum","2 min"]],"dur":15.3,"audio":"audio/piper/1b0fe9eb59c3ebf2.mp3"}],"looks":[],"from":"Eketrägatan","to":"Frölunda Torg","variant":"Mot Frölunda Torg","color":["#0071b9","#ffffff"],"trips":75,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}