7.761098,11.949752],[57.761235,11.949505],[57.76161,11.949776],[57.763148,11.949815],[57.764559,11.950184],[57.766303,11.949448],[57.766511,11.949851]],"stops":[{"name":"Svingeln","lat":57.713257,"lon":11.991113,"story":"Välkommen ombord på buss 43 mot Skogome! Resan tar ungefär 37 minuter. Uppe på berget i närheten ligger Skansen Lejonet, en försvarsborg från 1600-talet med ett förgyllt lejon på toppen. Den byggdes för att skydda staden från angrepp österifrån.","tips":[["Skansen Lejonet","8 min"]],"dur":16.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/Skansen_Lejonet.jpg/1280px-Skansen_Lejonet.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Lintoncat","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skansen_Lejonet.jpg","title":"Skansen Lejonet, Gullbergsvass 703:4. Göteborg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/G%C3%B6teborgs_fd_spinnhus_%28Stampen_20-2%29_2012-09-28_11-50-15.jpg/1280px-G%C3%B6teborgs_fd_spinnhus_%28Stampen_20-2%29_2012-09-28_11-50-15.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"SM6XSG","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:G%C3%B6teborgs_fd_spinnhus_(Stampen_20-2)_2012-09-28_11-50-15.jpg","title":"Göteborgs fd spinnhus (Stampen 20:2)","near":true},{"src":"https://upload.wikimedia.org/wikipedia/commons/2/27/Non-Violence_Stora_Samskolan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Erik Ekholm","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Non-Violence_Stora_Samskolan.jpg","title":"Non-Violence statyn vid Stora Samskolan i Göteborg","near":true}],"audio":"audio/piper/a2a920a16558377e.mp3"},{"name":"Tingstadsmotet","lat":57.731368,"lon":11.980586},{"name":"Balladgatan","lat":57.732083,"lon":11.975166,"story":"I närheten ligger Backa Folkets hus, uppfört 1924 och om- och tillbyggt 1939 i funktionalistisk stil av Sven Wedenmark. Här öppnade biografen Rex den 13 september 1940, och den visade film ända till 1958. Men duken var inte slut för alltid: 1992 öppnade Folkets Hus Backa bio i samma lokaler.","tips":[["Backa Folkets hus","5 min"]],"dur":20.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Tingstad_Slott_%E9%99%84%E8%BF%91%E7%9A%84%E5%95%86%E5%8A%A1%E6%A5%BC_-_panoramio.jpg/1280px-Tingstad_Slott_%E9%99%84%E8%BF%91%E7%9A%84%E5%95%86%E5%8A%A1%E6%A5%BC_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"wanghongliu","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Tingstad_Slott_%E9%99%84%E8%BF%91%E7%9A%84%E5%95%86%E5%8A%A1%E6%A5%BC_-_panoramio.jpg","title":"Tingstad Slott 附近的商务楼","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e9/2003%E5%B9%B4%E5%93%A5%E5%BE%B7%E5%A0%A1_Tingstad_Slott_-_panoramio.jpg/1280px-2003%E5%B9%B4%E5%93%A5%E5%BE%B7%E5%A0%A1_Tingstad_Slott_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"wanghongliu","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:2003%E5%B9%B4%E5%93%A5%E5%BE%B7%E5%A0%A1_Tingstad_Slott_-_panoramio.jpg","title":"2003年哥德堡 Tingstad Slott","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/2003%E5%B9%B4%E5%93%A5%E5%BE%B7%E5%A0%A1_Tingstad_Slott_-_panoramio_%281%29.jpg/1280px-2003%E5%B9%B4%E5%93%A5%E5%BE%B7%E5%A0%A1_Tingstad_Slott_-_panoramio_%281%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"wanghongliu","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:2003%E5%B9%B4%E5%93%A5%E5%BE%B7%E5%A0%A1_Tingstad_Slott_-_panoramio_(1).jpg","title":"vy från Nya Tingstadsgatan 1 med Nya Tingstadsgatan 3 i bakgrunden.","near":true}],"audio":"audio/piper/da4ef65fbcf35dde.mp3"},{"name":"Björkrisvägen","lat":57.739949,"lon":11.973736,"story":"I Backa Folkets hus, byggt 1924 och om- och tillbyggt i funktionalistisk stil 1939, fanns en gång biografen Rex. Den öppnade i september 1940 och stängde i juni 1958. Men filmduken fick en comeback: 1992 öppnade Folkets Hus Backa bio i samma lokaler. Huset finns med i kommunens bevaringsprogram och har fem lokaler för mellan 30 och 200 personer.","tips":[["Backa Folkets hus","8 min"]],"dur":24.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/V%C3%A4rdens_park.jpg/1280px-V%C3%A4rdens_park.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:V%C3%A4rdens_park.jpg","title":"Värdens park, en liten park i bostadsområdet Backa Röd i Göteborg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/09/20180629_LandvetterFwy_9673_%2848427787026%29.jpg/1280px-20180629_LandvetterFwy_9673_%2848427787026%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ray Swi-hymn from Sijhih-Taipei, Taiwan","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:20180629_LandvetterFwy_9673_(48427787026).jpg","title":"20180629_LandvetterFwy_9673","near":true}],"audio":"audio/piper/678b0af0d97ca648.mp3"},{"name":"Backa Kyrkogata","lat":57.743279,"lon":11.975021,"story":"Backa Röd heter hyreshusområdet runt knuten, med sina 1 500 lägenheter. Och nej, namnet handlar troligen inte om någon färg. Röd betyder sannolikt röjd mark, alltså mark som en gång röjts för att kunna odlas. I stadsdelen finns idrottsplatsen Backavallens IP och dessutom Göteborgs allra första näridrottsplats.","tips":[["Backa Röd","4 min"]],"dur":19.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/BackaR%C3%B6d.jpg/1280px-BackaR%C3%B6d.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Civilspanaren","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:BackaR%C3%B6d.jpg","title":"BackaRöd"}],"audio":"audio/piper/66406bf9c7ccd6ae.mp3"},{"name":"Sägengatan","lat":57.746157,"lon":11.977738,"story":"Backa, även kallat Hisings Backa, ligger på östra sidan av Hisingen och sträcker sig från Brunnsbo i söder till Skälltorp i norr. Den gamla Backa socken uppgick 1948 i Göteborgs stad. Backa kyrka, socknens kyrka, ligger en bit härifrån, och lite längre bort finns Selma Lagerlöfs torg.","tips":[["Backa kyrka","4 min"]],"dur":17.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/54/Aerial_photo_of_Gothenburg_2013-10-27_277.jpg/1280px-Aerial_photo_of_Gothenburg_2013-10-27_277.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aerial_photo_of_Gothenburg_2013-10-27_277.jpg","title":"Aerial photo of Gothenburg 2013-10-27 277"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a2/Backa_kyrka.jpg/1280px-Backa_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Anders Orsander","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Backa_kyrka.jpg","title":"Backa kyrka"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Selma_Lagerl%C3%B6fs_torg_-_Fiskhuset.jpg/1280px-Selma_Lagerl%C3%B6fs_torg_-_Fiskhuset.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Selma_Lagerl%C3%B6fs_torg_-_Fiskhuset.jpg","title":"Selma Lagerlöfs torg - Fiskhuset"}],"audio":"audio/piper/29a5600317ba8def.mp3"},{"name":"Selma Lagerlöfs Torg","lat":57.749803,"lon":11.981015,"story":"Torget byggdes 1971 och är uppkallat efter författaren och nobelpristagaren Selma Lagerlöf. Det ligger cirka fyra kilometer norr om Göteborgs centrum och är ett lokalt centrum för norra Backa. Här finns grundskolorna Svenska Balettskolan och Skälltorpsskolan, och på torget låg också Bäckebols kyrksal, som hörde till Backa församling.","tips":[],"dur":19.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Selma_Lagerl%C3%B6fs_torg_-_Fiskhuset.jpg/1280px-Selma_Lagerl%C3%B6fs_torg_-_Fiskhuset.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Selma_Lagerl%C3%B6fs_torg_-_Fiskhuset.jpg","title":"Selma Lagerlöfs torg - Fiskhuset"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/B%C3%A4ckebols_kyrksal.jpg/1280px-B%C3%A4ckebols_kyrksal.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:B%C3%A4ckebols_kyrksal.jpg","title":"Bäckebols kyrksal"}],"audio":"audio/piper/ad9d221f447a316c.mp3"},{"name":"Akkas Gata","lat":57.753909,"lon":11.980958,"story":"Alldeles intill, i hörnet av Litteraturgatan och Skälltorpsvägen, ligger Friedländerska kyrkogården. Med drygt tjugo gravplatser är den Göteborgs minsta kyrkogård, och dessutom privatägd. Den hör till Bäckebols gård, en herrgård en bit bort, och tillsammans med gården har den förklarats som byggnadsminne.","tips":[["Friedländerska kyrkogården","2 min"],["Bäckebols gård","9 min"]],"dur":16.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/B%C3%A4ckebol5.jpg/1280px-B%C3%A4ckebol5.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Eskil Malmberg","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:B%C3%A4ckebol5.jpg","title":"Bäckebol5"}],"audio":"audio/piper/918e3bfe60c73366.mp3"},{"name":"Olshammarsgatan","lat":57.75525,"lon":11.971229,"story":"Här i Skälltorp, norra Backa, finns en bit svensk musikhistoria. Musikteatergruppen Nationalteatern flyttade 1970 till Backa Fritidsgård vid Selma Lagerlöfs torg. I närheten ligger också Friedländerska kyrkogården, med drygt tjugo gravplatser Göteborgs minsta.","tips":[["Friedländerska kyrkogården","6 min"]],"dur":16.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Bl%C3%A5_staden_G%C3%B6teborg.jpg/1280px-Bl%C3%A5_staden_G%C3%B6teborg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bl%C3%A5_staden_G%C3%B6teborg.jpg","title":"Blå staden Göteborg"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/39/Friedl%C3%A4nderska_kyrkog%C3%A5rden_02.jpg/1280px-Friedl%C3%A4nderska_kyrkog%C3%A5rden_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Friedl%C3%A4nderska_kyrkog%C3%A5rden_02.jpg","title":"Friedländerska kyrkogården 02"}],"audio":"audio/piper/a0fcecc3e075509f.mp3"},{"name":"Åketorpsgatan","lat":57.754701,"lon":11.960699},{"name":"Skogsbrynet","lat":57.754118,"lon":11.958512,"story":"Skälltorp, området här intill, omfattar norra Backa med Selma Lagerlöfs torg, Backadalen, Blå staden, Åketorp och Backatorp. Lite längre bort ligger Sophie Elkans gata, uppkallad 1992 efter den Göteborgsfödda författaren Sophie Elkan, mer bekant som Selma Lagerlöfs väninna. Här i trakten möts alltså de två väninnorna i gatunamnen.","tips":[],"dur":21.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Bl%C3%A5_staden_G%C3%B6teborg.jpg/1280px-Bl%C3%A5_staden_G%C3%B6teborg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bl%C3%A5_staden_G%C3%B6teborg.jpg","title":"Blå staden Göteborg"}],"audio":"audio/piper/6d3518bc5c8d9d67.mp3"},{"name":"Skälltorpsvägen","lat":57.75399,"lon":11.947594,"story":"En bit härifrån ligger Lillhagsparkens sjukhus, ursprungligen Lillhagens sjukhus för psykiskt sjuka. Göteborgarna kallade det oftast bara Lillhagen, Hagen eller LS. Någon vård bedrivs inte längre där; den rättspsykiatriska verksamheten flyttade 2013. Närmare hållplatsen låg Hökälla säteri, en gammal gård i Skogome.","tips":[],"dur":20.2,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/d/d0/H%C3%B6k%C3%A4lla_s%C3%A4teri.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6k%C3%A4lla_s%C3%A4teri.jpg","title":"Hökälla säteri"}],"audio":"audio/piper/f41c516686a46696.mp3"},{"name":"Lillhagsparken Södra","lat":57.758298,"lon":11.949198,"story":"Strax intill ligger Lillhagsparkens sjukhus, som från början hette Lillhagens sjukhus för psykiskt sjuka. Göteborgarna sa oftast bara Lillhagen, Hagen eller LS. I dag bedrivs ingen vård här längre; den rättspsykiatriska verksamheten flyttade 2013 till Rågården.","tips":[["Lillhagsparkens sjukhus","3 min"]],"dur":16.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/Skogome_g%C3%A5ngv%C3%A4g_-_panoramio.jpg/1280px-Skogome_g%C3%A5ngv%C3%A4g_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Robande","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Skogome_g%C3%A5ngv%C3%A4g_-_panoramio.jpg","title":"Skogome gångväg","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/H%C3%B6k%C3%A4lla_v%C3%A5tmarkspark_04.jpg/1280px-H%C3%B6k%C3%A4lla_v%C3%A5tmarkspark_04.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6k%C3%A4lla_v%C3%A5tmarkspark_04.jpg","title":"Hökälla våtmarkspark på Hisingen i Göteborg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/41/H%C3%B6k%C3%A4lla_v%C3%A5tmarkspark_05.jpg/1280px-H%C3%B6k%C3%A4lla_v%C3%A5tmarkspark_05.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alicia Fagerving","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6k%C3%A4lla_v%C3%A5tmarkspark_05.jpg","title":"Boskap i Hökälla våtmarkspark på Hisingen i Göteborg.","near":true}],"audio":"audio/piper/d301c827de0e3694.mp3"},{"name":"Lillhagsparken Norra","lat":57.760531,"lon":11.94938},{"name":"Skogome","lat":57.766511,"lon":11.949851,"story":"Snart är vi framme vid ändhållplatsen Skogome. Tack för att du åkte med!","tips":[],"dur":4.1,"audio":"audio/piper/e660e3a64890c950.mp3"}],"looks":[{"id":"skansenlejonet","lat":57.7158,"lon":11.9887,"r":320,"text":"Till vänster ligger Skansen Lejonet, en försvarsborg från 1600-talet med ett förgyllt lejon på toppen.","dur":7.3,"audio":"audio/piper/64aad9e228418c61.mp3"}],"from":"Svingeln","to":"Skogome","variant":"Mot Skogome","color":["#0071b9","#ffffff"],"trips":188,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}