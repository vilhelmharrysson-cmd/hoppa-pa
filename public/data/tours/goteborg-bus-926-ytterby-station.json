 BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Lycke_kyrka.jpg","title":"Lycke kyrka"}],"audio":"audio/piper/f9f4752ef62fbcdf.mp3"},{"name":"Lycke","lat":57.87277,"lon":11.72859},{"name":"Lyckans förskola","lat":57.872005,"lon":11.730988},{"name":"Lilla Ryr","lat":57.871254,"lon":11.734649},{"name":"Mellan-Ryr","lat":57.868841,"lon":11.740435},{"name":"Stora Ryr norra","lat":57.865632,"lon":11.748129},{"name":"Stora Ryr","lat":57.863178,"lon":11.755114},{"name":"Ranneberg norra","lat":57.860195,"lon":11.765383,"story":"Kärna bokskog ligger nära, ett naturreservat på omkring 18 hektar som förvaltas av Västkuststiftelsen och inrättades 2008. Bland bokarna växer den sällsynta gräsarten skogssvingel, och här finns flera rödlistade lavar. Delar av området är tillgänglighetsanpassade, så skogen är öppen för fler än de mest vana vandrarna.","tips":[["Kärna bokskog","5 min"]],"dur":19.0,"images":[{"src":"https://pub.raa.se/dokumentation/5051cc4e-6641-46ae-9e3a-5228bece3d3b/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/5051cc4e-6641-46ae-9e3a-5228bece3d3b","title":"Rannebergen bostadsområde byggt 1974","old":true,"year":1977,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/aa9570f3-f866-4058-bba8-b2de1742007d/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/aa9570f3-f866-4058-bba8-b2de1742007d","title":"Rannebergen, bostadsområde byggt 1974. Bilden troligen från mitten av 1970-talet","old":true,"year":1970,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/ad79c0520ca0150d.mp3"},{"name":"Ranneberg södra","lat":57.856843,"lon":11.773188,"story":"Bara några minuters promenad bort väntar Kärna bokskog, ett naturreservat sedan 2008. Lavälskare har särskilt mycket att glädjas åt, för här finns flera rödlistade lavarter, och i floran märks även det sällsynta gräset skogssvingel. Reservatet är omkring 18 hektar och sköts av Västkuststiftelsen, med vissa delar tillgänglighetsanpassade.","tips":[["Kärna bokskog","4 min"]],"dur":20.2,"images":[{"src":"https://pub.raa.se/dokumentation/5051cc4e-6641-46ae-9e3a-5228bece3d3b/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/5051cc4e-6641-46ae-9e3a-5228bece3d3b","title":"Rannebergen bostadsområde byggt 1974","old":true,"year":1977,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/aa9570f3-f866-4058-bba8-b2de1742007d/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/aa9570f3-f866-4058-bba8-b2de1742007d","title":"Rannebergen, bostadsområde byggt 1974. Bilden troligen från mitten av 1970-talet","old":true,"year":1970,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/b782055cb5ff687e.mp3"},{"name":"Skåttan","lat":57.855251,"lon":11.778776,"story":"I området ligger den lilla sjön Skåtte mosse, cirka 55 meter över havet, vars vatten rinner vidare genom Glose å. En bit bort finns Kärna bokskog, ett naturreservat sedan 2008 där den sällsynta gräsarten skogssvingel och flera rödlistade lavar trivs. Delar av bokskogen är tillgänglighetsanpassade.","tips":[["Kärna bokskog","9 min"]],"dur":18.5,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/9/98/Sweden_V%C3%A4stra_G%C3%B6taland_relief_location_map.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Silverkey (Mickaël Delcey)","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Sweden_V%C3%A4stra_G%C3%B6taland_relief_location_map.png","title":"Sweden Västra Götaland relief location map"}],"audio":"audio/piper/e45649e42eb535b2.mp3"},{"name":"Kärna bygdegård","lat":57.84799,"lon":11.787365},{"name":"Kärna bussterminal","lat":57.844191,"lon":11.792457},{"name":"Lefstad","lat":57.840656,"lon":11.801604},{"name":"Hallbjörtorp västra","lat":57.84148