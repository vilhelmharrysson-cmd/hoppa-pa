3%B6lunda_Torg_tram_stop_entrance_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Olof Lagerkvist","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Fr%C3%B6lunda_Torg_tram_stop_entrance_-_panoramio.jpg","title":"Frölunda Torg tram stop entrance","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Fr%C3%B6lunda_Torg_-_panoramio.jpg/1280px-Fr%C3%B6lunda_Torg_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Olof Lagerkvist","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Fr%C3%B6lunda_Torg_-_panoramio.jpg","title":"Frölunda Torg","near":true},{"src":"https://pub.raa.se/dokumentation/f3f9fceb-3522-4378-a611-22a981a2f324/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/f3f9fceb-3522-4378-a611-22a981a2f324","title":"Köpcentret interiört","old":true,"year":1977,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/c1167b97-9b7a-4036-ac06-3091e28393d4/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/c1167b97-9b7a-4036-ac06-3091e28393d4","title":"Kundvagnar, i bakgrunden köpcentret","old":true,"year":1977,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/540a09a3bdc42611.mp3"},{"name":"Västra Frölunda Kyrka","lat":57.64969,"lon":11.920755,"story":"Alldeles intill står Västra Frölunda kyrka, sockenkyrkan för den gamla Västra Frölunda socken. Socknen var drygt 32 kvadratkilometer stor och uppgick 1945 i Göteborgs stad. En bit härifrån ligger något mycket nyare: Järnbrott bussdepå, som sedan sommaren 2026 är hem för helelektriska bussar.","tips":[["Västra Frölunda kyrka","2 min"]],"dur":18.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/V%C3%A4stra_Fr%C3%B6lunda_kyrka.jpg/1280px-V%C3%A4stra_Fr%C3%B6lunda_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Kemitsv","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:V%C3%A4stra_Fr%C3%B6lunda_kyrka.jpg","title":"Västra Frölunda kyrka"}],"audio":"audio/piper/59f905068b10cadf.mp3"},{"name":"Radiovägen","lat":57.65005,"lon":11.930398},{"name":"Sändaregatan","lat":57.653154,"lon":11.93198,"story":"Radiotorget i närheten var något helt nytt när det invigdes 1954. Det var ett så kallat satellittorg, ett torg utanför stadskärnan efter amerikansk förebild, och det första i sitt slag i Sverige och ett av de första i Europa. Torget rustades upp 2019 till 2020 och har fortfarande flera små butiker.","tips":[["Radiotorget","6 min"]],"dur":18.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Radiotorget%2C_h%C3%B6st.jpg/1280px-Radiotorget%2C_h%C3%B6st.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Radiotorget,_h%C3%B6st.jpg","title":"Radiotorget, höst"}],"audio":"audio/piper/882872c0b6c12a4e.mp3"},{"name":"Radiotorget","lat":57.657416,"lon":11.933179},{"name":"Armlängdsgatan","lat":57.660844,"lon":11.934432,"story":"Radiotorget, några hundra meter bort, invigdes 1954 som Sveriges första satellittorg, efter amerikansk förebild. En bit längre bort ligger Högsbo pegmatitbrott, där man mellan 1945 och slutet av 1950-talet bröt fältspat, kvarts, glimmer och beryll. Där har man också hittat sällsynta mineral som monazit och vismutglans.","tips":[["Radiotorget","6 min"]],"dur":21.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Radiotorget%2C_h%C3%B6st.jpg/1280px-Radiotorget%2C_h%C3%B6st.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Radiotorget,_h%C3%B6st.jpg","title":"Radiotorget, höst"},{"src":"https://ems.dimu.org/image/012uP1vpGHM7?dimension=600x600","credit":"Halling, Dennis","license":"Public domain","page":"https://kulturarvsdata.se/pm/photo/html/POST053762","title":"Armlängdsgatan","old":true,"year":1963,"museum":"Postmuseum"}],"audio":"audio/piper/0f986628cd93a61c.mp3"},{"name":"Synhållsgatan","lat":57.664051,"lon":11.935084,"story":"En bit härifrån ligger Högsbo pegmatitbrott, två gamla brott med cirka 200 meters mellanrum. Här bröt man fältspat, kvarts, glimmer och beryll från 1945 till slutet av 1950-talet, och hittade även sällsynta mineral som monazit, columbit och vismutglans. Sedan 2016 ingår området i naturreservatet Änggårdsbergen.","tips":[],"dur":21.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/Sweet_and_tender_burmese_kitten_%288424746318%29.jpg/1280px-Sweet_and_tender_burmese_kitten_%288424746318%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Mikael Tigerström from Gothenburg, Sweden","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Sweet_and_tender_burmese_kitten_(8424746318).jpg","title":"Almost three weeks old chocolate burmese kitten :-)","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/P%C3%A5%C3%A5ls_bagerier_2020.jpg/1280px-P%C3%A5%C3%A5ls_bagerier_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vogler","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:P%C3%A5%C3%A5ls_bagerier_2020.jpg","title":"Industrial scale bakery in Högsbo industrial park, Gothenburg Sweden. Formerly Pååls bröd, currently","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Niclas_Persson_Tenhuinen.jpg/1280px-Niclas_Persson_Tenhuinen.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AnnaMariaÖF","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Niclas_Persson_Tenhuinen.jpg","title":"Niclas Persson Tenhuinen","near":true}],"audio":"audio/piper/6c587ed3aa62cb95.mp3"},{"name":"Tvärhandsgatan","lat":57.66744,"lon":11.935502},{"name":"Högsbo","lat":57.669518,"lon":11.937055,"story":"Här mäter gatunamnen jord. Marklandsgatan fick sitt namn 1959 efter markland, en enhet för jordvärdering. Vid hållplatsen Marklandsgatan vänder spårvagnslinje 3, medan linjerna 1, 2, 7 och 8 passerar på väg mot Frölunda torg och Tynnered. Strax intill löper Dag Hammarskjöldsleden, fem kilometer lång från Linnéplatsen.","tips":[],"dur":20.4,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/d/d4/Marklandsgatan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Bulver","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Marklandsgatan.jpg","title":"Marklandsgatan"}],"audio":"audio/piper/39e45de2b4a2be64.mp3"},{"name":"Marklandsgatan","lat":57.674307,"lon":11.935862,"story":"Snart är vi framme vid ändhållplatsen Marklandsgatan. Gatan har fått sitt namn efter markland, en gammal enhet för att värdera jord. Strax intill ligger Frölundaborgs isstadion. Den invigdes 1967 med en vänskapsmatch där Västra Frölunda IF slog svenska ishockeylandslaget med 4–3. Vid Slottsskogsvallen slingrar Friidrottens väg, uppkallad efter höjdhoppstränaren Viljo Nousiainen som slipade Patrik Sjöberg och Stefan Holm här. Tack för att du åkte med!","tips":[["Se Frölundaborgs isstadion","5 min"],["Gå Friidrottens väg vid Slottsskogsvallen","4 min"]],"dur":27.7,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/d/d4/Marklandsgatan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Bulver","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Marklandsgatan.jpg","title":"Marklandsgatan"}],"audio":"audio/piper/790172cc4113ced6.mp3"}],"looks":[],"from":"Frölunda Torg","to":"Marklandsgatan","variant":"Mot Marklandsgatan","color":["#0071b9","#ffffff"],"trips":86,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}