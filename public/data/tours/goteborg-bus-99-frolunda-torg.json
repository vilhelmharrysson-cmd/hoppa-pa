1.896785],[57.677591,11.896224],[57.676969,11.895774],[57.674304,11.894861],[57.67267,11.893843],[57.671586,11.892879],[57.669268,11.890344],[57.668516,11.889771],[57.667247,11.889309],[57.665901,11.889408],[57.662765,11.890917],[57.661228,11.892005],[57.659011,11.894308],[57.655972,11.898323],[57.652553,11.903645],[57.652114,11.904102],[57.652041,11.904427],[57.652187,11.904884],[57.653018,11.905769],[57.652667,11.906503],[57.652,11.906761],[57.651568,11.907502],[57.651821,11.908285],[57.65182,11.908972],[57.652113,11.909568]],"stops":[{"name":"Hjalmar Brantingsplatsen","lat":57.720849,"lon":11.951966,"story":"Välkommen ombord på buss 99 mot Frölunda Torg! Resan tar ungefär 44 minuter. Hjalmar Brantingsplatsen är Hisingens stora knutpunkt. Hisingen är Sveriges fjärde största ö, och här byggdes en gång både fartyg och bilar. Volvo grundades i Göteborg 1927, och huvudkontoret ligger fortfarande på Hisingen.","tips":[["Backaplan, handel","8 min"]],"dur":19.5,"audio":"audio/piper/9057053790e8e251.mp3"},{"name":"Vågmästareplatsen","lat":57.719978,"lon":11.944934,"story":"Hungrig? Kville saluhall öppnade 2013 med kött, fisk, skaldjur, bageri och massor av restauranger. En bit bort låg biografen Gnistan. Premiären 1938 var militärfarsen Kamrater i vapenrocken, och 1968 släcktes ridån för gott efter Django skjuter alltid först. På Kvilletorget står Carl Milles staty Susanna, även kallad Flicka med snäcka.","tips":[["Ät eller handla i Kville saluhall","1 min"],["Se Milles Susanna på Kvilletorget","4 min"]],"dur":22.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/Kvilletorget.jpg/1280px-Kvilletorget.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jesperhallen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kvilletorget.jpg","title":"Kvilletorget"}],"audio":"audio/piper/7b50282f44a1ae86.mp3"},{"name":"Madängsgatan","lat":57.717381,"lon":11.944918},{"name":"Regnbågsgatan","lat":57.71159,"lon":11.94146},{"name":"Polstjärnegatan","lat":57.710583,"lon":11.933283},{"name":"Nordviksgatan","lat":57.706973,"lon":11.921935,"story":"Mellan nybyggda hus och köpcentrum står fyra stenar från förhistorisk tid. Sannegårdsmonumentet är resterna av ett gravfält från övergången mellan brons- och järnålder. Den största, trekantiga bautastenen står kvar på sin ursprungliga plats, medan de andra har flyttats på grund av grustäkt. Hamnen nedanför, Sannegårdshamnen, invigdes 1914.","tips":[["Se bautastenarna i Sannegårdsmonumentet","5 min"]],"dur":20.8,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/9/92/Sanneg%C3%A5rdsmonumentet.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Max Ronnersjö","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sanneg%C3%A5rdsmonumentet.jpg","title":"Sannegårdsmonumentet"}],"audio":"audio/piper/245f123572d068be.mp3"},{"name":"Sörhallstorget","lat":57.703033,"lon":11.919583},{"name":"Eriksbergstorget","lat":57.702408,"lon":11.912786},{"name":"Pölsebo","lat":57.700329,"lon":11.9042},{"name":"Ivarsbergsmotet","lat":57.699696,"lon":11.897421},{"name":"Kungssten","lat":57.680348,"lon":11.901626,"story":"Kungssten ligger nära Göta älvs mynning. Härifrån ser du Älvsborgsbron, som var Sveriges längsta hängbro när den invigdes 1966. Ute i älvmynningen ligger Nya Älvsborgs fästning från 1600-talet, som skyddade staden mot danskarna. Vid vattnet nedanför ligger Klippan, med gamla sjömanshus och resterna av den äldre Älvsborgs fästning.","tips":[["Klippans kulturreservat","15 min"],["Röda Sten konsthall under Älvsborgsbron","20 min"]],"dur":20.1,"audio":"audio/piper/93b5532970ef5cd4.mp3"},{"name":"Bergkristallsgatan","lat":57.656896,"lon":11.896769},{"name":"Smyckegatan","lat":57.6537,"lon":11.901703},{"name":"Frölunda Torg","lat":57.652113,"lon":11.909568,"story":"Snart är vi framme vid ändhållplatsen Frölunda Torg. Frölunda Torg öppnade 1966 och var ett av Sveriges första stora köpcentrum i förort. Runt omkring ligger Västra Frölunda, och några kilometer västerut börjar havet och skärgården. Tack för att du åkte med!","tips":[["Frölunda Torg, köpcentrum","2 min"]],"dur":15.3,"audio":"audio/piper/1b0fe9eb59c3ebf2.mp3"}],"looks":[],"from":"Hjalmar Brantingsplatsen","to":"Frölunda Torg","variant":"Mot Frölunda Torg","color":["#0071b9","#ffffff"],"trips":298,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}