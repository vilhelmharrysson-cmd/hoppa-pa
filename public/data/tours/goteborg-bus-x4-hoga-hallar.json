],[57.66271,12.114504],[57.659455,12.11758],[57.658905,12.117925],[57.658772,12.119194],[57.658654,12.119505],[57.658529,12.119548],[57.658169,12.119543],[57.657812,12.119253],[57.657537,12.117816],[57.657457,12.117873],[57.657335,12.117245],[57.656911,12.117564],[57.65676,12.116872],[57.657219,12.1165],[57.657302,12.116594],[57.657706,12.118926],[57.657115,12.120214],[57.656863,12.121407],[57.656723,12.121536],[57.656792,12.121799],[57.656504,12.124957],[57.656323,12.126095],[57.656041,12.126754],[57.655157,12.127763],[57.654326,12.12917],[57.653857,12.134253],[57.653628,12.135629],[57.653336,12.136641],[57.651519,12.139735],[57.650935,12.140938],[57.650016,12.142033],[57.64982,12.142501],[57.64967,12.145815],[57.649834,12.145919],[57.650984,12.148293],[57.651439,12.150135],[57.651314,12.151754],[57.651306,12.153415],[57.651203,12.15401],[57.650947,12.154633],[57.649641,12.156881],[57.649379,12.156835]],"stops":[{"name":"Kungälv resecentrum","lat":57.871808,"lon":11.96845,"story":"Välkommen ombord på buss X4 mot Höga hallar! Resan tar ungefär 134 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":9.6,"audio":"audio/piper/94854b5e8e8cac13.mp3"},{"name":"Kongahällagatan","lat":57.873515,"lon":11.974446},{"name":"Västra Parken","lat":57.871887,"lon":11.97966},{"name":"Kexbageriet","lat":57.869113,"lon":11.982423},{"name":"Fars Hatt","lat":57.864876,"lon":11.993251},{"name":"Eriksdal","lat":57.857917,"lon":11.998822},{"name":"Backadalsmotet","lat":57.747055,"lon":11.989413},{"name":"Hjalmar Brantingsplatsen","lat":57.720807,"lon":11.954708,"story":"Hjalmar Brantingsplatsen är Hisingens stora knutpunkt. Hisingen är Sveriges fjärde största ö, och här byggdes en gång både fartyg och bilar. Volvo grundades i Göteborg 1927, och huvudkontoret ligger fortfarande på Hisingen.","tips":[["Backaplan, handel","8 min"]],"dur":13.8,"audio":"audio/piper/e70844d966c46352.mp3"},{"name":"Nils Ericsonsplatsen","lat":57.709114,"lon":11.970803,"story":"Nils Ericsonsplatsen är uppkallad efter Nils Ericson, som byggde Sveriges första stambanor. Han var bror till uppfinnaren John Ericsson. Under oss byggs Västlänken, en järnvägstunnel under centrala Göteborg.","tips":[["Nordstan, inomhusgalleria","3 min"]],"dur":12.6,"audio":"audio/piper/18a58aed436523a2.mp3"},{"name":"Polhemsplatsen","lat":57.707895,"lon":11.977353},{"name":"Heden","lat":57.70211,"lon":11.974461,"story":"När Trädgårn öppnade som kafé 1858 fanns bara manlig personal, och punsch var den enda spritdrycken. Huset intill hållplatsen, Exercishuset, stod klart 1867 som gåva från grosshandlaren Julius Lindström. Där skulle folkskolebarn gymnastisera och skarpskyttar exercera. Själva Heden var militärens övningsfält, och fram till 2019 låg en bandybana här.","tips":[["Se Exercishuset vid Parkgatan","1 min"],["Ta en fika eller middag på Trädgårn","3 min"]],"dur":23.3,"audio":"audio/piper/ae45a9136b93159a.mp3"},{"name":"Berzeliigatan","lat":57.698605,"lon":11.981602,"story":"Härifrån är det nära till Götaplatsen, stadens kulturtorg. Där ligger Göteborgs konstmuseum, som öppnade 1923, och runt torget finns även Stadsteatern och Konserthuset. Mitt på platsen står Poseidon, Carl Milles kraftfulla havsgud.","tips":[["Göteborgs konstmuseum","4 min"],["Götaplatsen och Poseidon","4 min"]],"dur":14.7,"audio":"audio/piper/31126ac7d7c68fbe.mp3"},{"name":"Korsvägen","lat":57.696763,"lon":11.986909,"story":"Korsvägen är porten till Göteborgs evenemangsstråk. Här ligger nöjesparken Liseberg, som öppnade 1923, vetenskapscentret Universeum och Världskulturmuseet. Svenska Mässan ligger också alldeles intill.","tips":[["Liseberg","4 min"],["Universeum","3 min"],["Världskulturmuseet","3 min"]],"dur":12.7,"audio":"audio/piper/27cdf83cf590876c.mp3"},{"name":"Liseberg Station","lat":57.698477,"lon":11.994724,"story":"Vi är vid Lisebergs norra sida. Nöjesparken öppnade 1923 i samband med stadens jubileumsutställning och är i dag en av Nordens mest besökta. Vid jul förvandlas den till en julmarknad med miljontals ljus.","tips":[["Liseberg","3 min"]],"dur":12.6,"audio":"audio/piper/a4211823f25bc778.mp3"},{"name":"Delsjömotet","lat":57.676404,"lon":12.025559},{"name":"Mölnlyckemotet","lat":57.67006,"lon":12.090505},{"name":"Råda portar","lat":57.668401,"lon":12.096542},{"name":"Platåvägen","lat":57.667494,"lon":12.104816},{"name":"Solsten","lat":57.666335,"lon":12.113881},{"name":"Kyrkvägen","lat":57.661906,"lon":12.115138},{"name":"Hulebäcksgymnasiet","lat":57.659144,"lon":12.117772},{"name":"Mölnlycke resecentrum","lat":57.657113,"lon":12.117363},{"name":"Högadal","lat":57.65598,"lon":12.126809},{"name":"Sommarhemsvägen","lat":57.653537,"lon":12.136005},{"name":"Lövskogsvägen","lat":57.652159,"lon":12.138629},{"name":"Nysätersvägen","lat":57.649746,"lon":12.145222},{"name":"Långetjärn","lat":57.651274,"lon":12.153199},{"name":"Höga hallar","lat":57.649379,"lon":12.156835,"story":"Snart är vi framme vid ändhållplatsen Höga hallar. Tack för att du åkte med!","tips":[],"dur":4.5,"audio":"audio/piper/51d35b5325eeeaf7.mp3"}],"looks":[{"id":"lappstiftet","lat":57.7117,"lon":11.9677,"r":260,"text":"Till höger ser du den röd-vita skyskrapan som göteborgarna kallar Läppstiftet.","dur":5.4,"audio":"audio/piper/dc65394d7b4531a0.mp3"},{"id":"liseberg","lat":57.695,"lon":11.9925,"r":280,"text":"Till höger ligger nöjesparken Liseberg.","dur":4.0,"audio":"audio/piper/4d8aa27788403f58.mp3"}],"from":"Kungälv resecentrum","to":"Höga hallar","variant":"Mot Höga hallar","color":["#0071b9","#ffffff"],"trips":126,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}