],[57.848817,12.002463],[57.853208,12.001895],[57.854691,12.001502],[57.856041,12.000816],[57.856632,12.000379],[57.857438,11.999469],[57.857742,11.999393],[57.857815,11.999067],[57.858847,11.997868],[57.859273,11.997664],[57.860859,11.997448],[57.861934,11.996549],[57.862991,11.996393],[57.864506,11.995103],[57.864801,11.993493],[57.86564,11.991754],[57.86595,11.9908],[57.866487,11.987652],[57.867035,11.986139],[57.868475,11.983556],[57.868609,11.983545],[57.868681,11.983168],[57.870038,11.981283],[57.870591,11.980697],[57.871054,11.980911],[57.874135,11.976689],[57.873902,11.975949],[57.873339,11.973466],[57.873388,11.973259],[57.873269,11.973151],[57.872414,11.969344],[57.872175,11.969515],[57.871286,11.969152],[57.871153,11.968488],[57.871193,11.968282],[57.871721,11.968171],[57.871808,11.96845]],"stops":[{"name":"Höga hallar","lat":57.649643,"lon":12.156998,"story":"Välkommen ombord på buss X4 mot Kungälv resecentrum! Resan tar ungefär 135 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":10.1,"audio":"audio/piper/523a643d5954f460.mp3"},{"name":"Långetjärn","lat":57.651302,"lon":12.153214},{"name":"Nysätersvägen","lat":57.649785,"lon":12.144934},{"name":"Lövskogsvägen","lat":57.652873,"lon":12.137617},{"name":"Sommarhemsvägen","lat":57.653868,"lon":12.134353},{"name":"Högadal","lat":57.65606,"lon":12.126769},{"name":"Mölnlycke resecentrum","lat":57.656952,"lon":12.117393},{"name":"Hulebäcksgymnasiet","lat":57.659352,"lon":12.117806},{"name":"Kyrkvägen","lat":57.662287,"lon":12.114907},{"name":"Solsten","lat":57.667036,"lon":12.113875},{"name":"Platåvägen","lat":57.667511,"lon":12.104764},{"name":"Råda portar","lat":57.668237,"lon":12.097997},{"name":"Mölnlyckemotet","lat":57.67019,"lon":12.091082},{"name":"Delsjömotet","lat":57.677156,"lon":12.025832},{"name":"Liseberg Station","lat":57.697675,"lon":11.9939,"story":"Vi är vid Lisebergs norra sida. Nöjesparken öppnade 1923 i samband med stadens jubileumsutställning och är i dag en av Nordens mest besökta. Vid jul förvandlas den till en julmarknad med miljontals ljus.","tips":[["Liseberg","3 min"]],"dur":12.6,"audio":"audio/piper/a4211823f25bc778.mp3"},{"name":"Korsvägen","lat":57.696837,"lon":11.986231,"story":"Korsvägen är porten till Göteborgs evenemangsstråk. Här ligger nöjesparken Liseberg, som öppnade 1923, vetenskapscentret Universeum och Världskulturmuseet. Svenska Mässan ligger också alldeles intill.","tips":[["Liseberg","4 min"],["Universeum","3 min"],["Världskulturmuseet","3 min"]],"dur":12.7,"audio":"audio/piper/27cdf83cf590876c.mp3"},{"name":"Berzeliigatan","lat":57.698393,"lon":11.982157,"story":"Härifrån är det nära till Götaplatsen, stadens kulturtorg. Där ligger Göteborgs konstmuseum, som öppnade 1923, och runt torget finns även Stadsteatern och Konserthuset. Mitt på platsen står Poseidon, Carl Milles kraftfulla havsgud.","tips":[["Göteborgs konstmuseum","4 min"],["Götaplatsen och Poseidon","4 min"]],"dur":14.7,"audio":"audio/piper/31126ac7d7c68fbe.mp3"},{"name":"Heden","lat":57.702226,"lon":11.974417,"story":"När Trädgårn öppnade som kafé 1858 fanns bara manlig personal, och punsch var den enda spritdrycken. Huset intill hållplatsen, Exercishuset, stod klart 1867 som gåva från grosshandlaren Julius Lindström. Där skulle folkskolebarn gymnastisera och skarpskyttar exercera. Själva Heden var militärens övningsfält, och fram till 2019 låg en bandybana här.","tips":[["Se Exercishuset vid Parkgatan","1 min"],["Ta en fika eller middag på Trädgårn","3 min"]],"dur":23.3,"audio":"audio/piper/ae45a9136b93159a.mp3"},{"name":"Polhemsplatsen","lat":57.708048,"lon":11.97771},{"name":"Nils Ericsonsplatsen","lat":57.709331,"lon":11.971222,"story":"Nils Ericsonsplatsen är uppkallad efter Nils Ericson, som byggde Sveriges första stambanor. Han var bror till uppfinnaren John Ericsson. Under oss byggs Västlänken, en järnvägstunnel under centrala Göteborg.","tips":[["Nordstan, inomhusgalleria","3 min"]],"dur":12.6,"audio":"audio/piper/18a58aed436523a2.mp3"},{"name":"Hjalmar Brantingsplatsen","lat":57.721008,"lon":11.954842,"story":"Hjalmar Brantingsplatsen är Hisingens stora knutpunkt. Hisingen är Sveriges fjärde största ö, och här byggdes en gång både fartyg och bilar. Volvo grundades i Göteborg 1927, och huvudkontoret ligger fortfarande på Hisingen.","tips":[["Backaplan, handel","8 min"]],"dur":13.8,"audio":"audio/piper/e70844d966c46352.mp3"},{"name":"Backadalsmotet","lat":57.748007,"lon":11.990897},{"name":"Eriksdal","lat":57.858126,"lon":11.998923},{"name":"Fars Hatt","lat":57.865043,"lon":11.993085},{"name":"Kexbageriet","lat":57.868256,"lon":11.984181},{"name":"Västra Parken","lat":57.871701,"lon":11.980148},{"name":"Kongahällagatan","lat":57.87367,"lon":11.974535},{"name":"Kungälv resecentrum","lat":57.871808,"lon":11.96845,"story":"Snart är vi framme vid ändhållplatsen Kungälv resecentrum. Tack för att du åkte med!","tips":[],"dur":5.0,"audio":"audio/piper/8903e4632950173e.mp3"}],"looks":[{"id":"lappstiftet","lat":57.7117,"lon":11.9677,"r":260,"text":"Till vänster ser du den röd-vita skyskrapan som göteborgarna kallar Läppstiftet.","dur":6.0,"audio":"audio/piper/4cf4412fffeaa2c4.mp3"},{"id":"liseberg","lat":57.695,"lon":11.9925,"r":280,"text":"Till vänster ligger nöjesparken Liseberg.","dur":3.5,"audio":"audio/piper/cc09fca39ce2b836.mp3"}],"from":"Höga hallar","to":"Kungälv resecentrum","variant":"Mot Kungälv resecentrum","color":["#0071b9","#ffffff"],"trips":169,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}