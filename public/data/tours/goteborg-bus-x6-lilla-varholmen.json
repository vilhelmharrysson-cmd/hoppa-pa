2],[57.707669,11.754171],[57.708431,11.748863],[57.708941,11.743158],[57.709335,11.740302],[57.709933,11.736654],[57.710039,11.736577],[57.709979,11.736347],[57.710117,11.735445],[57.711596,11.726931],[57.711735,11.725692],[57.711977,11.724646],[57.711874,11.724471],[57.71166,11.722475],[57.710677,11.716803],[57.710822,11.714069],[57.710963,11.713972],[57.710912,11.713725],[57.711188,11.711869],[57.711153,11.710898],[57.710942,11.710044],[57.710258,11.708629],[57.709764,11.707263],[57.709351,11.706578],[57.709045,11.705531],[57.708656,11.702678],[57.708709,11.702656]],"stops":[{"name":"Landvetter resecentrum","lat":57.686075,"lon":12.213025,"story":"Välkommen ombord på buss X6 mot Lilla Varholmen! Resan tar ungefär 134 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":9.7,"audio":"audio/piper/f7455c48b6a92160.mp3"},{"name":"Delsjömotet","lat":57.677156,"lon":12.025832},{"name":"Liseberg Station","lat":57.697675,"lon":11.9939,"story":"Vi är vid Lisebergs norra sida. Nöjesparken öppnade 1923 i samband med stadens jubileumsutställning och är i dag en av Nordens mest besökta. Vid jul förvandlas den till en julmarknad med miljontals ljus.","tips":[["Liseberg","3 min"]],"dur":12.6,"audio":"audio/piper/a4211823f25bc778.mp3"},{"name":"Korsvägen","lat":57.696837,"lon":11.986231,"story":"Korsvägen är porten till Göteborgs evenemangsstråk. Här ligger nöjesparken Liseberg, som öppnade 1923, vetenskapscentret Universeum och Världskulturmuseet. Svenska Mässan ligger också alldeles intill.","tips":[["Liseberg","4 min"],["Universeum","3 min"],["Världskulturmuseet","3 min"]],"dur":12.7,"audio":"audio/piper/27cdf83cf590876c.mp3"},{"name":"Berzeliigatan","lat":57.698393,"lon":11.982157,"story":"Härifrån är det nära till Götaplatsen, stadens kulturtorg. Där ligger Göteborgs konstmuseum, som öppnade 1923, och runt torget finns även Stadsteatern och Konserthuset. Mitt på platsen står Poseidon, Carl Milles kraftfulla havsgud.","tips":[["Göteborgs konstmuseum","4 min"],["Götaplatsen och Poseidon","4 min"]],"dur":14.7,"audio":"audio/piper/31126ac7d7c68fbe.mp3"},{"name":"Heden","lat":57.702226,"lon":11.974417,"story":"När Trädgårn öppnade som kafé 1858 fanns bara manlig personal, och punsch var den enda spritdrycken. Huset intill hållplatsen, Exercishuset, stod klart 1867 som gåva från grosshandlaren Julius Lindström. Där skulle folkskolebarn gymnastisera och skarpskyttar exercera. Själva Heden var militärens övningsfält, och fram till 2019 låg en bandybana här.","tips":[["Se Exercishuset vid Parkgatan","1 min"],["Ta en fika eller middag på Trädgårn","3 min"]],"dur":23.3,"audio":"audio/piper/ae45a9136b93159a.mp3"},{"name":"Drottningtorget","lat":57.708698,"lon":11.974818,"story":"Drottningtorget ligger mitt framför Centralstationen, som invigdes 1858 och är en av landets äldsta stationsbyggnader som fortfarande används. Härifrån utgår stora delar av Nordens största spårvägsnät. Göteborg fick hästspårvagnar 1879 och elektriska vagnar 1902, och staden valde att behålla spårvagnen när många andra svenska städer lade ner sin.","tips":[["Nordstan, inomhusgalleria","2 min"],["Lilla Bommen och Göteborgsoperan","8 min"]],"dur":22.3,"audio":"audio/piper/4f510ef0a9fd7bc1.mp3"},{"name":"Bergslagsparken","lat":57.712024,"lon":11.973734},{"name":"Järnvågen","lat":57.701394,"lon":11.949136,"story":"Namnet kommer från en våg. Här vägdes järnet som skeppades ut genom Göteborgs hamn, bland annat från bruk i Värmland. På 1780-talet flyttades stadens järnvåg till en tomt strax norr om dagens Järntorget, och torget fick sitt namn efter den. Järnbärarna, som hanterade tackorna, bosatte sig i kvarteren runt omkring. Själva vågen är riven sedan länge.","tips":[],"dur":20.3,"audio":"audio/piper/e15deb9ec1f3b9f2.mp3"},{"name":"Vädermotet","lat":57.704583,"lon":11.880901},{"name":"Sörredsmotet","lat":57.711859,"lon":11.841564},{"name":"Syrhåla","lat":57.717719,"lon":11.820762},{"name":"Amhult Resecentrum","lat":57.708793,"lon":11.781645},{"name":"Gossbydalsvägen","lat":57.709335,"lon":11.765878},{"name":"Hällsviksvägen","lat":57.70784,"lon":11.753467},{"name":"Övre Hällsvik","lat":57.708902,"lon":11.744086},{"name":"Långrevsvägen","lat":57.710134,"lon":11.735729},{"name":"Batterivägen","lat":57.711855,"lon":11.723381},{"name":"Majvik","lat":57.710697,"lon":11.716499},{"name":"Lilla Varholmen","lat":57.708709,"lon":11.702656,"story":"Snart är vi framme vid ändhållplatsen Lilla Varholmen. Tack för att du åkte med!","tips":[],"dur":4.6,"audio":"audio/piper/5b9ec685b21f9368.mp3"}],"looks":[{"id":"lappstiftet","lat":57.7117,"lon":11.9677,"r":260,"text":"Till höger ser du den röd-vita skyskrapan som göteborgarna kallar Läppstiftet.","dur":5.4,"audio":"audio/piper/dc65394d7b4531a0.mp3"},{"id":"liseberg","lat":57.695,"lon":11.9925,"r":280,"text":"Till vänster ligger nöjesparken Liseberg.","dur":3.5,"audio":"audio/piper/cc09fca39ce2b836.mp3"}],"from":"Landvetter resecentrum","to":"Lilla Varholmen","variant":"Mot Lilla Varholmen","color":["#0071b9","#ffffff"],"trips":109,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}