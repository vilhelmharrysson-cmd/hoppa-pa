71],[57.663281,11.925221],[57.662621,11.925059],[57.661872,11.924569],[57.660567,11.923052],[57.658547,11.919803],[57.654988,11.915376],[57.654065,11.914029],[57.651778,11.909445],[57.651396,11.908187],[57.651043,11.90587],[57.650676,11.904828],[57.65032,11.904255],[57.649687,11.903705],[57.647896,11.903238],[57.647249,11.902874],[57.646605,11.901923],[57.645744,11.899783],[57.645003,11.898908],[57.644568,11.898761],[57.643915,11.898883],[57.643422,11.899311],[57.642518,11.900545]],"stops":[{"name":"Östra Sjukhuset","lat":57.72232,"lon":12.048112,"story":"Välkommen ombord på spårvagn 1 mot Opaltorget! Resan tar ungefär 48 minuter. Vi startar vid Östra sjukhuset. Härifrån är det nära till Delsjöområdet, ett stort naturreservat med sjöar, skog och bad.","tips":[["Delsjöområdet","20 min"]],"dur":13.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/%C3%96stra_sjukhuset%2C_G%C3%B6teborg.JPG/1280px-%C3%96stra_sjukhuset%2C_G%C3%B6teborg.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Hannibal","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:%C3%96stra_sjukhuset,_G%C3%B6teborg.JPG","title":"Östra sjukhuset in Gothenburg from tram stop","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/H%C3%A5llplats_%C3%96stra_Sjukhuset.JPG/1280px-H%C3%A5llplats_%C3%96stra_Sjukhuset.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%A5llplats_%C3%96stra_Sjukhuset.JPG","title":"Bygget av den nya hållplatsen för linje 5 vid Östra Sjukhuset","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/%C3%96stra_Sjukhuset_h%C3%A5llplats.JPG/1280px-%C3%96stra_Sjukhuset_h%C3%A5llplats.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:%C3%96stra_Sjukhuset_h%C3%A5llplats.JPG","title":"Bygget av den nya hållplatsen för linje 5 vid Östra Sjukhuset","near":true}],"audio":"audio/piper/6ba23c403eb8debc.mp3"},{"name":"Tingvallsvägen","lat":57.724676,"lon":12.042006},{"name":"Kaggeledstorget","lat":57.722821,"lon":12.033053,"story":"Torget fick sitt namn 1946, troligen efter guvernören Nils Kagg. Här står Eric Grates bronsstaty Våren, en naken kvinna på en granitsockel, utplacerad 1950. En likadan finns i Alingsås. På gamla Torpavallen, där Qviding FIF spelade på grus, ligger numera ett handelsområde.","tips":[["Se statyn Våren","1 min"]],"dur":19.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Kaggeledstorget_i_G%C3%B6teborg.jpg/1280px-Kaggeledstorget_i_G%C3%B6teborg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Mattias Blomgren","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kaggeledstorget_i_G%C3%B6teborg.jpg","title":"Kaggeledstorget i Göteborg"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/34/V%C3%A5ren%2C_Erik_Grate.JPG/1280px-V%C3%A5ren%2C_Erik_Grate.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Eva Ekeblad Eric Grate","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:V%C3%A5ren,_Erik_Grate.JPG","title":"Våren, Erik Grate"},{"src":"https://pub.raa.se/dokumentation/709d5cf3-edf9-4b56-8182-6f5e008bd091/visning/1","credit":"Norrman, Jan","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/709d5cf3-edf9-4b56-8182-6f5e008bd091","title":"Västra Torpa bostadsområde i stadsdelen Sävenäs, Göteborg. Bilden är tagen mot (väderstreck): N","old":true,"year":1990,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/c39b183b-7d61-4998-aa09-6da3a4b7057e/visning/1","credit":"Norrman, Jan","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/c39b183b-7d61-4998-aa09-6da3a4b7057e","title":"Vid bildens mitt Västra Torpa bostadsområde i stadsdelen Sävenäs, Göteborg. Bilden är tagen mot (väderstreck):","old":true,"year":1990,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/01454e2952a3b24d.mp3"},{"name":"Munkebäckstorget","lat":57.718433,"lon":12.026073,"story":"Munkebäckstorget fick sitt namn 1947 efter Munkebäcken, ett gammalt namn på Härlandabäcken. Munkarna i namnet syftar troligen på munkar i Nya Lödöse. Strax intill finns resterna av den gamla Härlanda kyrka som kyrkoruin, minnet av en församling som uppgick i Nylöse församling redan 1528. Granne med ruinen står Härlanda nya kyrka.","tips":[["Härlanda kyrka","3 min"],["Härlanda kyrkoruin","4 min"]],"dur":22.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1e/Munkeb%C3%A4ckstorget.JPG/1280px-Munkeb%C3%A4ckstorget.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Munkeb%C3%A4ckstorget.JPG","title":"Munkebäckstorget"}],"audio":"audio/piper/17733b1d2a6493b4.mp3"},{"name":"Härlanda","lat":57.718104,"lon":12.019331,"story":"Bakom murarna i Härlanda satt fångar från 1907 till 1997. Det gamla centralfängelset är byggnadsminne och heter numera Härlanda park. Biografen Saga på Sofiagatan stängde 1964. Året därpå blev den livsmedelsbutik – Saga Hemköp, den första i kedjan Sagabutikerna. Mitt bland husen ligger även en gammal kyrkoruin.","tips":[["Gå runt i Härlanda park, det gamla fängelset","4 min"],["Se Härlanda kyrkoruin","3 min"]],"dur":21.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/The_H%C3%A4rlanda_Prison.jpg/1280px-The_H%C3%A4rlanda_Prison.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"MichaelRedbridge","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:The_H%C3%A4rlanda_Prison.jpg","title":"The Härlanda Prison"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Saga_1943.jpg/1280px-Saga_1943.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Otto Thulin","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Saga_1943.jpg","title":"Saga 1943"},{"src":"https://pub.raa.se/dokumentation/773c97ef-fc9c-4a61-bcb6-761e23c902fd/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/773c97ef-fc9c-4a61-bcb6-761e23c902fd","title":"Flygbild över hamnen och staden. Härlanda med Bagaregården, Strömmensberg och Östra kyrkogården","old":true,"year":1966,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/9b55543f817bc3b3.mp3"},{"name":"Stockholmsgatan","lat":57.71708,"lon":12.013654,"story":"En biograf blev början på en hel butikskedja. Saga på Sofiagatan visade film 1942–1964, och när Bengt Johansson köpte den nedlagda salongen öppnade han en livsmedelsbutik: Saga hemköp, den första av Sagabutikerna. Strax intill låg Härlanda fängelse, i drift 1907–97. Murarna står kvar som byggnadsminne, och sedan 2011 heter området Härlanda park.","tips":[["Gå runt i Härlanda park, före detta fängelse","3 min"],["Promenera på Östra kyrkogården","3 min"]],"dur":24.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Saga_1943.jpg/1280px-Saga_1943.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Otto Thulin","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Saga_1943.jpg","title":"Saga 1943"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/The_H%C3%A4rlanda_Prison.jpg/1280px-The_H%C3%A4rlanda_Prison.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"MichaelRedbridge","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:The_H%C3%A4rlanda_Prison.jpg","title":"The Härlanda Prison"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/%C3%96stra_kg_i_oktober_2009.JPG/1280px-%C3%96stra_kg_i_oktober_2009.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:%C3%96stra_kg_i_oktober_2009.JPG","title":"Östra kg i oktober 2009"}],"audio":"audio/piper/e3d2038e086942e3.mp3"},{"name":"Redbergsplatsen","lat":57.716241,"lon":12.004755,"story":"Redbergsplatsen hette förr Korsvägen och fick sitt nuvarande namn 1883. År 1873 sattes en allmän vattenpump upp här, där man kunde njuta av vatten från Delsjön. Strax norr om platsen, i Redbergslids Folkpark, restes 1886 en paviljong med scen för artister. Nedanför Sankt Pauli kyrka står fontängruppen Elementens kamp i brons, flyttad hit från Olskrokstorget 1968.","tips":[["Fontänen Elementens kamp","3 min"],["Sankt Pauli kyrka","4 min"]],"dur":26.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Redbergsparken.JPG/1280px-Redbergsparken.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Redbergsparken.JPG","title":"Redbergsparken"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/44/Elementens_Kamp%2C_Gothenburg-2009-01-02.jpg/1280px-Elementens_Kamp%2C_Gothenburg-2009-01-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Halhen","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Elementens_Kamp,_Gothenburg-2009-01-02.jpg","title":"Elementens Kamp, Gothenburg-2009-01-02"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/St_Pauli_ka.JPG/1280px-St_Pauli_ka.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:St_Pauli_ka.JPG","title":"St Pauli ka"}],"audio":"audio/piper/4fb01d48df0e69c2.mp3"},{"name":"Olskrokstorget","lat":57.714631,"lon":11.998657},{"name":"Svingeln","lat":57.713016,"lon":11.991217,"story":"Uppe på berget i närheten ligger Skansen Lejonet, en försvarsborg från 1600-talet med ett förgyllt lejon på toppen. Den byggdes för att skydda staden från angrepp österifrån.","tips":[["Skansen Lejonet","8 min"]],"dur":10.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/Skansen_Lejonet.jpg/1280px-Skansen_Lejonet.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Lintoncat","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skansen_Lejonet.jpg","title":"Skansen Lejonet, Gullbergsvass 703:4. Göteborg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/G%C3%B6teborgs_fd_spinnhus_%28Stampen_20-2%29_2012-09-28_11-50-15.jpg/1280px-G%C3%B6teborgs_fd_spinnhus_%28Stampen_20-2%29_2012-09-28_11-50-15.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"SM6XSG","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:G%C3%B6teborgs_fd_spinnhus_(Stampen_20-2)_2012-09-28_11-50-15.jpg","title":"Göteborgs fd spinnhus (Stampen 20:2)","near":true},{"src":"https://pub.raa.se/dokumentation/11affe9f-9248-41de-af7d-0e78c9144ad6/visning/1","credit":"Okänd","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/11affe9f-9248-41de-af7d-0e78c9144ad6","title":"Kapellet uppfördes 1864, för uppdraget anlitades byggmästarna Philip Jacob Rapp för den arkitektoniska gestalt","old":true,"year":1988,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/5979f2bf-2e71-4967-8f03-f81b932c9110/visning/1","credit":"Okänd","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/5979f2bf-2e71-4967-8f03-f81b932c9110","title":"Kapellet från 1864 har fasader av gult tegel och en plåtklädd kupol. Det är byggt i morisk stil, med interiör ","old":true,"year":1988,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/0a4e26fa7375077a.mp3"},{"name":"Ullevi Norra","lat":57.708124,"lon":11.9862,"story":"Utanför Nya Ullevi står Ingo – the Champ, Peter Lindes bronsstaty av Ingemar Johansson, världsmästare i tungviktsboxning 1959–1960. Statyn är 2,4 meter hög och väger 400 kilo. På arenan besegrade Ingo amerikanen Eddie Machen inför drygt 53 000 åskådare. Längs Stampgatan rinner Fattighusån, en grävd kanal som invigdes redan 1641 av greve Per Brahe.","tips":[["Ingo – the Champ","2 min"],["Mariakyrkan","2 min"]],"dur":26.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/Ingo-the-Champ.jpg/1280px-Ingo-the-Champ.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bolstermage","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ingo-the-Champ.jpg","title":"Ingo-the-Champ"}],"audio":"audio/piper/821b95bb44c15bfe.mp3"},{"name":"Drottningtorget","lat":57.70764,"lon":11.973059,"story":"Drottningtorget ligger mitt framför Centralstationen, som invigdes 1858 och är en av landets äldsta stationsbyggnader som fortfarande används. Härifrån utgår stora delar av Nordens största spårvägsnät. Göteborg fick hästspårvagnar 1879 och elektriska vagnar 1902, och staden valde att behålla spårvagnen när många andra svenska städer lade ner sin.","tips":[["Nordstan, inomhusgalleria","2 min"],["Lilla Bommen och Göteborgsoperan","8 min"]],"dur":22.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Hotel_Eggers_1.JPG/1280px-Hotel_Eggers_1.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hotel_Eggers_1.JPG","title":"Hotel Eggers Vid Drottningtorget i Göteborg","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Tram_2_at_Centralstation_%282416433995%29.jpg/1280px-Tram_2_at_Centralstation_%282416433995%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"LHOON from Mechelen, Belgium","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Tram_2_at_Centralstation_(2416433995).jpg","title":"Tram M31 352, Drottningtorget, April 2008.","near":true},{"src":"https://pub.raa.se/dokumentation/27191d8d-4c6a-43a7-8888-c5a814a72709/visning/1","credit":"Sjöbeck, Mårten","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/27191d8d-4c6a-43a7-8888-c5a814a72709","title":"Fattighuskanalen vid Drottningtorget","old":true,"year":1931,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/5094b2a3-0c97-4fc1-afb3-df802b1b2856/visning/1","credit":"Bruno, Fredrik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/5094b2a3-0c97-4fc1-afb3-df802b1b2856","title":"Södra Hamngatan","old":true,"year":1943,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/4f510ef0a9fd7bc1.mp3"},{"name":"Brunnsparken","lat":57.706584,"lon":11.968764,"story":"Brunnsparken är stadens hjärta för kollektivtrafiken. Härifrån går nästan alla spårvagnslinjer. Precis intill ligger Gustaf Adolfs torg med statyn av kungen som grundade Göteborg 1621. Staden byggdes av holländska ingenjörer, och det är därför Göteborg har kanaler. Holländarna kunde bygga på lera.","tips":[["Gustaf Adolfs torg och Stora Hamnkanalen","2 min"],["Göteborgs stadsmuseum i Ostindiska huset","4 min"]],"dur":19.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Tram_in_G%C3%B6teborg%2C_Sweden_%28103414971%29.jpg/1280px-Tram_in_G%C3%B6teborg%2C_Sweden_%28103414971%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"LHOON from Mechelen, Belgium","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Tram_in_G%C3%B6teborg,_Sweden_(103414971).jpg","title":"Tram M21 268, Brunnsparken, Gothenburg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/ElectriCity_-_Brunnsparken_02.JPG/1280px-ElectriCity_-_Brunnsparken_02.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Leif Jørgensen","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:ElectriCity_-_Brunnsparken_02.JPG","title":"ElectriCity is a test with electric buses and electric hybrid buses in Göteborg. Bus at Brunnsparken","near":true},{"src":"https://pub.raa.se/dokumentation/77a406c0-5c39-4548-86b6-fe27a38222ae/visning/1","credit":"Bruno, Fredrik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/77a406c0-5c39-4548-86b6-fe27a38222ae","title":"Vallgraven vid Brunnsparken","old":true,"year":1944,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/90ef8bf4-7931-4a28-8c82-545c216f718b/visning/1","credit":"Bruno, Fredrik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/90ef8bf4-7931-4a28-8c82-545c216f718b","title":"Statyn Såningskvinnan, oftare benämnd som \"Johanna i Brunnsparken\"","old":true,"year":1944,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/2d5f78e86da885d3.mp3"},{"name":"Stenpiren","lat":57.705702,"lon":11.957471,"story":"Nu kör vi ner mot Göta älv och Stenpiren. Under 1800-talet och början av 1900-talet lämnade över en miljon svenskar landet för att söka ett nytt liv i Amerika, och de flesta reste via Göteborg. Många av dem gick ombord just här. I dag går färjan Älvsnabben härifrån över älven, och den ingår i samma biljett som spårvagnen. På andra sidan ser du Lindholmen och Eriksberg, där stadens stora varv en gång låg.","tips":[["Färjan Älvsnabben över älven","1 min"],["Göteborgs stadsmuseum i Ostindiska huset","7 min"]],"dur":25.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Gothenburg_juli_2009_%28ubt%29-026.JPG/1280px-Gothenburg_juli_2009_%28ubt%29-026.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Tomasz Sienicki [user: tsca, mail: tomasz.sienicki at gmail.com]","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Gothenburg_juli_2009_(ubt)-026.JPG","title":"Gothenburg, Sweden","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Linje_1_Stenpiren.jpg/1280px-Linje_1_Stenpiren.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Linje_1_Stenpiren.jpg","title":"Spårvagn M29 844 på linje 1 lämnar Stenpiren.","near":true},{"src":"https://ems.dimu.org/image/032wX1rC6QDe?dimension=600x600","credit":"Leo Bonsdorff","license":"CC BY","page":"https://kulturarvsdata.se/gnm/photo/html/GNM2674%3A001","title":"Stenpiren","old":true,"year":1933,"museum":"Göteborgs Naturhistoriska Museum"}],"audio":"audio/piper/926ec9af4a7d7178.mp3"},{"name":"Järntorget","lat":57.699962,"lon":11.952732,"story":"Järntorget har fått sitt namn av järnet som vägdes och skeppades härifrån. Fontänen i mitten är från 1927 och föreställer jordens fem världsdelar. Nu börjar arbetarstadsdelarna. Söderut ligger Haga med sina kaféer och landshövdingehus, och västerut går Långgatorna med vintagebutiker och barer.","tips":[["Haga Nygata och jättekanelbullar","5 min"],["Långgatorna, vintage och barer","2 min"],["Skansen Kronan, utsikt över staden","12 min"]],"dur":18.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/J%C3%A4rntorget_i_G%C3%B6teborg%2C_den_3_sept_2006.JPG/1280px-J%C3%A4rntorget_i_G%C3%B6teborg%2C_den_3_sept_2006.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Harri Blomberg","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:J%C3%A4rntorget_i_G%C3%B6teborg,_den_3_sept_2006.JPG","title":"Göteborg","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Pustervik.jpg/1280px-Pustervik.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Fluff","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Pustervik.jpg","title":"Entrance to the teater, bar and restaurant Pustervik, Gothenburg","near":true},{"src":"https://samlingar.goteborgsstadsmuseum.se/carlotta/web/image/zoom/852918/GSME_140001_622.jpg","credit":"Olsson & Hammarqvist Fotografiatelier","license":"Public domain","page":"https://kulturarvsdata.se/GSM/delobjekt/html/852888","title":"Nya Teatern i arbetarföreningens hus - Järntorget","old":true,"year":null,"museum":"Göteborgs stadsmuseum"},{"src":"https://samlingar.goteborgsstadsmuseum.se/carlotta/web/image/zoom/852882/GSME_140001_619.jpg","credit":"Olsson & Hammarqvist Fotografiatelier","license":"Public domain","page":"https://kulturarvsdata.se/GSM/delobjekt/html/852855","title":"Amatörsalongen, Nya Teatern i arbetarföreningens hus - Järntorget","old":true,"year":null,"museum":"Göteborgs stadsmuseum"}],"audio":"audio/piper/fda327ba4cc46a3a.mp3"},{"name":"Prinsgatan","lat":57.696379,"lon":11.951388},{"name":"Olivedalsgatan","lat":57.692081,"lon":11.952454,"story":"Biograferna har avlöst varandra här. Biografteatern på Sveagatan visade film redan 1904–1908. Mignon på Linnégatan hade 182 platser och höll öppet från 1941 till 1982. Vid Sveaplan låg sedan Klappan och därefter Svea fram till 2008. Gatan har fått namn efter egendomen Olivedal, troligen uppkallad efter Olivia Melin.","tips":[["Gå till Sveaplan med Gösta Silléns stenskulpturer","2 min"]],"dur":24.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Olivedalsg.jpg/1280px-Olivedalsg.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Mjaha","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Olivedalsg.jpg","title":"Olivedalsg"}],"audio":"audio/piper/c6324a4e05d0f8ce.mp3"},{"name":"Linnéplatsen","lat":57.689942,"lon":11.952046,"story":"Vid Linnéplatsen börjar Slottsskogen, stadens stora park från 1874. Där finns djur, dammar och Naturhistoriska museet, som har en uppstoppad blåval från 1865. Åt andra hållet går Linnégatan, en av stadens mest omtyckta restauranggator.","tips":[["Slottsskogen","2 min"],["Naturhistoriska museet och blåvalen","10 min"],["Linnégatan, restauranger","2 min"]],"dur":17.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/GS_805%2C_Linn%C3%A9platsen%2C_2019_%2801%29.jpg/1280px-GS_805%2C_Linn%C3%A9platsen%2C_2019_%2801%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bahnfrend","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:GS_805,_Linn%C3%A9platsen,_2019_(01).jpg","title":"Göteborgs Spårvägar tram no. M29 805 operating a line 1 service at the Linnéplatsen tram stop, Gothe","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/GS_351%2C_Linn%C3%A9platsen%2C_2019_%2801%29.jpg/1280px-GS_351%2C_Linn%C3%A9platsen%2C_2019_%2801%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bahnfrend","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:GS_351,_Linn%C3%A9platsen,_2019_(01).jpg","title":"Göteborgs Spårvägar tram no. M31 351 operating a line 6 service at the Linnéplatsen tram stop, Gothe","near":true},{"src":"https://ems.dimu.org/image/022wX1r986Uf?dimension=600x600","credit":"G. Albert Gustavsson","license":"CC BY","page":"https://kulturarvsdata.se/gnm/photo/html/GNM01067%3A001","title":"Linnéplatsen","old":true,"year":1918,"museum":"Göteborgs Naturhistoriska Museum"}],"audio":"audio/piper/40117ead82f33d61.mp3"},{"name":"Botaniska Trädgården","lat":57.681403,"lon":11.945733,"story":"Göteborgs botaniska trädgård öppnade 1923 och är en av Europas större botaniska trädgårdar. Här finns en klippträdgård, en japansk dal och växthus med tusentals växter. På andra sidan vägen ligger Slottsskogen, stadens stora stadspark.","tips":[["Botaniska trädgården","2 min"],["Slottsskogen","3 min"]],"dur":14.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Vagnhallen_Slottsskogen_2012-08-14_02.jpg/1280px-Vagnhallen_Slottsskogen_2012-08-14_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Vagnhallen_Slottsskogen_2012-08-14_02.jpg","title":"\"Vagnhallen Slottsskogen\" in Göteborg, Sweden.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Vagnhallen_Slottsskogen_2012-08-14_03.jpg/1280px-Vagnhallen_Slottsskogen_2012-08-14_03.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Vagnhallen_Slottsskogen_2012-08-14_03.jpg","title":"\"Vagnhallen Slottsskogen\" in Göteborg, Sweden.","near":true},{"src":"https://pub.raa.se/dokumentation/4d96b02c-358e-4378-9137-cab53e766556/visning/1","credit":"Bruno, Fredrik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/4d96b02c-358e-4378-9137-cab53e766556","title":"Trädgårdsföreningen","old":true,"year":1945,"museum":"Riksantikvarieämbetet"},{"src":"https://ems.dimu.org/image/032wX1rKX1SP?dimension=600x600","credit":"Magnus Leijer","license":"CC BY","page":"https://kulturarvsdata.se/gnm/photo/html/GNM5224%3A004","title":"Botaniska Trädgården","old":true,"year":1921,"museum":"Göteborgs Naturhistoriska Museum"}],"audio":"audio/piper/2538f4a5975cfa1e.mp3"},{"name":"Marklandsgatan","lat":57.674452,"lon":11.935548,"story":"Gatan har fått sitt namn efter markland, en gammal enhet för att värdera jord. Strax intill ligger Frölundaborgs isstadion. Den invigdes 1967 med en vänskapsmatch där Västra Frölunda IF slog svenska ishockeylandslaget med 4–3. Vid Slottsskogsvallen slingrar Friidrottens väg, uppkallad efter höjdhoppstränaren Viljo Nousiainen som slipade Patrik Sjöberg och Stefan Holm här.","tips":[["Se Frölundaborgs isstadion","5 min"],["Gå Friidrottens väg vid Slottsskogsvallen","4 min"]],"dur":22.6,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/d/d4/Marklandsgatan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Bulver","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Marklandsgatan.jpg","title":"Marklandsgatan"}],"audio":"audio/piper/61f4613f9525ccb6.mp3"},{"name":"Axel Dahlströms Torg","lat":57.672261,"lon":11.927496,"story":"Torget sticker ut med ett 16 våningar högt höghus som stod klart 1956, och på medborgarhuset sitter ett väggkonstverk i form av en marmorintarsia av konstnären Endre Nemes. Samma år invigdes Högsboskolan alldeles intill, byggd för cirka 1 000 elever. Skolan finns dock inte kvar, den revs 2013.","tips":[["Höghuset och marmorintarsian på torget","2 min"]],"dur":18.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/H%C3%B6gsbo_kyrka_den_22_oktober_2005%2C_exteri%C3%B6r_2..JPG/1280px-H%C3%B6gsbo_kyrka_den_22_oktober_2005%2C_exteri%C3%B6r_2..JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"User Västgöten on sv.wikipedia","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6gsbo_kyrka_den_22_oktober_2005,_exteri%C3%B6r_2..JPG","title":"Högsbo kyrka i Göteborg, den 22 oktober 2005. Bilden är fotograferad av Harri Blomberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Kapplandsgatan1.JPG/1280px-Kapplandsgatan1.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"DavidIvar","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Kapplandsgatan1.JPG","title":"Kapplandsgatan viewed from its beginning in the direction of Tunnlandsgatan. 6 augusti 2015","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Bankogatan_May_2020.jpg/1280px-Bankogatan_May_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vogler","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Bankogatan_May_2020.jpg","title":"Bankogatan i Göteborg sedd från Axel Dahlströms torgs spårvagnshållplats i maj 2020. Arkitekt Åke Wa","near":true}],"audio":"audio/piper/73df4a52c637dd2f.mp3"},{"name":"Lantmilsgatan","lat":57.667124,"lon":11.924711,"story":"Titta på perrongen. Där sitter en kvinna i brons med spetsig mössa och väntar, och det har hon gjort sedan 2001. Skulpturen heter Väntan och är gjord av Britt Ignell. Kanske väntar hon på någon som ska kliva av spårvagnen. Under tiden har hon sett parkeringshuset mittemot byggas på med bostäder.","tips":[["Hälsa på bronskvinnan Väntan","1 min"]],"dur":17.1,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8a/V%C3%A4ntan_Britt_Ignell.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Eva Ekeblad","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:V%C3%A4ntan_Britt_Ignell.JPG","title":"Väntan Britt Ignell"}],"audio":"audio/piper/1252fd192a706f61.mp3"},{"name":"Nymilsgatan","lat":57.662611,"lon":11.925026},{"name":"Musikvägen","lat":57.659061,"lon":11.920598,"story":"Här i Västra Frölunda har gatorna musikaliska namn, som Musikvägen och Positivgatan. Stadsdelen byggdes under 1960-talet, när Göteborg växte snabbt söderut.","tips":[["Ruddalens idrottsområde","8 min"]],"dur":10.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Aerial_photo_of_Gothenburg_2013-10-27_376.jpg/1280px-Aerial_photo_of_Gothenburg_2013-10-27_376.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aerial_photo_of_Gothenburg_2013-10-27_376.jpg","title":"Photo taken on a helicopter over Gothenburg","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Aerial_photo_of_Gothenburg_2013-10-27_377.jpg/1280px-Aerial_photo_of_Gothenburg_2013-10-27_377.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aerial_photo_of_Gothenburg_2013-10-27_377.jpg","title":"Photo taken on a helicopter over Gothenburg","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ca/Marconihallen_snettfram.JPG/1280px-Marconihallen_snettfram.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"DavidIvar","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Marconihallen_snettfram.JPG","title":"Marconihallen, augusti 2015","near":true}],"audio":"audio/piper/2f858eee521f3fb6.mp3"},{"name":"Positivgatan","lat":57.656766,"lon":11.917556},{"name":"Frölunda Torg","lat":57.652732,"lon":11.911359,"story":"Frölunda Torg öppnade 1966 och var ett av Sveriges första stora köpcentrum i förort. Runt omkring ligger Västra Frölunda, och några kilometer västerut börjar havet och skärgården.","tips":[["Frölunda Torg, köpcentrum","2 min"]],"dur":11.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Fr%C3%B6lunda_Torg_tram_stop_entrance_-_panoramio.jpg/1280px-Fr%C3%B6lunda_Torg_tram_stop_entrance_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Olof Lagerkvist","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Fr%C3%B6lunda_Torg_tram_stop_entrance_-_panoramio.jpg","title":"Frölunda Torg tram stop entrance","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Fr%C3%B6lunda_Torg_-_panoramio.jpg/1280px-Fr%C3%B6lunda_Torg_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Olof Lagerkvist","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Fr%C3%B6lunda_Torg_-_panoramio.jpg","title":"Frölunda Torg","near":true},{"src":"https://pub.raa.se/dokumentation/f3f9fceb-3522-4378-a611-22a981a2f324/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/f3f9fceb-3522-4378-a611-22a981a2f324","title":"Köpcentret interiört","old":true,"year":1977,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/c1167b97-9b7a-4036-ac06-3091e28393d4/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/c1167b97-9b7a-4036-ac06-3091e28393d4","title":"Kundvagnar, i bakgrunden köpcentret","old":true,"year":1977,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/edc7585e34a622ae.mp3"},{"name":"Briljantgatan","lat":57.649016,"lon":11.903494,"story":"Spårvagnarna under Frölunda torg en bit härifrån gick från början i en helt underjordisk hållplats när den byggdes 1966, men 2008 öppnades den delvis upp mot omvärlden. Intill torget låg också Frölunda specialistsjukhus, invigt 1968, som i början av 2024 ersattes av nya Högsbo närsjukhus. Närmast ligger Tynnereds kyrka och Smycketorget.","tips":[["Tynnereds kyrka","4 min"]],"dur":22.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Fr%C3%B6lunda_torg_DSC_0113.jpg/1280px-Fr%C3%B6lunda_torg_DSC_0113.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"BIL","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Fr%C3%B6lunda_torg_DSC_0113.jpg","title":"Frölunda torg DSC 0113"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Fr%C3%B6lunda_Specialistsjukhus.jpg/1280px-Fr%C3%B6lunda_Specialistsjukhus.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Okänd","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Fr%C3%B6lunda_Specialistsjukhus.jpg","title":"Frölunda Specialistsjukhus"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Tynnereds_kyrka_september_2012.jpg/1280px-Tynnereds_kyrka_september_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Arild Vågen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Tynnereds_kyrka_september_2012.jpg","title":"Tynnereds kyrka september 2012"}],"audio":"audio/piper/a3854df8bbcf9143.mp3"},{"name":"Smaragdgatan","lat":57.645288,"lon":11.899152},{"name":"Opaltorget","lat":57.642518,"lon":11.900545,"story":"Snart är vi framme vid ändhållplatsen Opaltorget. Vi är i Tynnered, där gatorna har fått namn efter ädelstenar: Opaltorget, Smaragdgatan och Briljantgatan. Härifrån är det nära till naturreservat och havsbad i Västra Frölunda. Tack för att du åkte med!","tips":[["Opaltorget","1 min"]],"dur":15.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Evening_tram_in_G%C3%B6teborg%2C_Sweden_%28103414931%29.jpg/1280px-Evening_tram_in_G%C3%B6teborg%2C_Sweden_%28103414931%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"LHOON from Mechelen, Belgium","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Evening_tram_in_G%C3%B6teborg,_Sweden_(103414931).jpg","title":"Evening tram in Göteborg, Sweden. M21 262.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Evening_tram_in_G%C3%B6teborg%2C_Sweden_%28enlightened%29.jpg/1280px-Evening_tram_in_G%C3%B6teborg%2C_Sweden_%28enlightened%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Tuvalkin, based on work by LHOON","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Evening_tram_in_G%C3%B6teborg,_Sweden_(enlightened).jpg","title":"Evening tram in Göteborg, Sweden. M21 262.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/Opalkyrkan_2019.jpg/1280px-Opalkyrkan_2019.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"This image was produced by me, David Castor (user:dcastor). The pictures I submi","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Opalkyrkan_2019.jpg","title":"Opalkyrkan i Tynnered i Göteborg, kyrksalen. Kyrkan tillhör Svenska Alliansmissionen.","near":true}],"audio":"audio/piper/bdf7d1d88689e749.mp3"}],"looks":[{"id":"feskekorka","lat":57.70125,"lon":11.95706,"r":220,"text":"Till vänster, vid kanalen, ligger Feskekôrka, stadens fiskhall från 1874. Den ser ut som en kyrka, och göteborgarna kallar den fiskkyrkan.","dur":10.5,"audio":"audio/piper/405600fc398c1d35.mp3"},{"id":"skansenkronan","lat":57.6966,"lon":11.9504,"r":300,"text":"Till höger, uppe på berget, syns Skansen Kronan, en försvarsborg från 1600-talet.","dur":7.6,"audio":"audio/piper/cc748976cc756060.mp3"},{"id":"skansenlejonet","lat":57.7158,"lon":11.9887,"r":320,"text":"Till höger ligger Skansen Lejonet, en försvarsborg från 1600-talet med ett förgyllt lejon på toppen.","dur":7.4,"audio":"audio/piper/af426c35fad68dbe.mp3"},{"id":"ullevi","lat":57.7062,"lon":11.987,"r":260,"text":"Till vänster reser sig Nya Ullevi, arenan som byggdes till fotbolls-VM 1958.","dur":6.7,"audio":"audio/piper/0fbe853322b68c2f.mp3"}],"from":"Östra Sjukhuset","to":"Opaltorget","variant":"Mot Opaltorget","color":["#ffffff","#231f20"],"trips":1009,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}