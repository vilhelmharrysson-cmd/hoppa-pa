[57.685892,11.954468],[57.686126,11.954095],[57.686302,11.953175],[57.686136,11.952282],[57.683347,11.949194],[57.680797,11.944828],[57.679051,11.94323],[57.67718,11.940569],[57.676382,11.939898],[57.675282,11.939387],[57.674902,11.938915],[57.674638,11.937646],[57.674277,11.933147],[57.673936,11.931314],[57.672412,11.927802],[57.671174,11.926045],[57.670714,11.925581],[57.669902,11.925096],[57.668356,11.924724],[57.667133,11.92471],[57.663281,11.925221],[57.662621,11.925059],[57.662037,11.924705],[57.660921,11.923525],[57.658547,11.919803],[57.654457,11.91465],[57.653622,11.913212],[57.652732,11.911359]],"stops":[{"name":"Angered Centrum","lat":57.795552,"lon":12.04898,"story":"Välkommen ombord på spårvagn 8 mot Frölunda Torg! Resan tar ungefär 63 minuter. Angered byggdes på 1970-talet och är i dag en av Göteborgs mest internationella stadsdelar. Här ligger kulturhuset Blå Stället, och runt omkring finns stora naturområden med sjöar och skog.","tips":[["Kulturhuset Blå Stället","2 min"]],"dur":17.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Angered_Centrum.jpg/1280px-Angered_Centrum.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Angered_Centrum.jpg","title":"Angered Centrum i maj 2012.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Angered_Centrum_2.jpg/1280px-Angered_Centrum_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Angered_Centrum_2.jpg","title":"Angered Centrum i maj 2012.","near":true},{"src":"https://pub.raa.se/dokumentation/2388047f-cd6a-44d6-ba49-1edc42fe8cc6/visning/1","credit":"Sjöbeck, Mårten","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/2388047f-cd6a-44d6-ba49-1edc42fe8cc6","title":"Angered","old":true,"year":1932,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/89b2c427-65e8-49ab-9611-0cb581058a56/visning/1","credit":"Roland, Anders","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/89b2c427-65e8-49ab-9611-0cb581058a56","title":"Interiör mot öster","old":true,"year":1923,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/259b992e0d90184a.mp3"},{"name":"Storås","lat":57.784883,"lon":12.046217},{"name":"Hammarkullen","lat":57.779807,"lon":12.035544,"story":"Hammarkullen är känt för sin karneval, som varje år fyller stadsdelen med musik, dans och färgglada kostymer. Hållplatsen ligger djupt inne i berget och nås med en lång rulltrappa.","tips":[["Hammarkullens torg","3 min"]],"dur":10.3,"images":[{"src":"https://pub.raa.se/dokumentation/8692f5c6-43cc-46c6-93e7-5e01f62db813/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/8692f5c6-43cc-46c6-93e7-5e01f62db813","title":"Hammarkullen","old":true,"year":1977,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/1e5da212-d109-4f4f-9d4b-2d8f2455e09d/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/1e5da212-d109-4f4f-9d4b-2d8f2455e09d","title":"Bostadsbebyggelse","old":true,"year":1977,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/5e0f28464fa952c8.mp3"},{"name":"Hjällbo","lat":57.769261,"lon":12.022382,"story":"Hjällbo centrum byggdes 1969 och fick ett nytt utseende vid en ombyggnad 2001. På torget finns en saluhall med frukt och grönt, och i handelsbyggnaden både orientalisk livs, presentbutik och pizzeria. Bibliotek, apotek och kyrka ligger också här, så det mesta av vardagen ryms runt ett och samma torg.","tips":[["Hjällbo centrum","2 min"],["Hjällbo kyrka","1 min"]],"dur":18.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/33/Hj%C3%A4llbo_Centrum.jpg/1280px-Hj%C3%A4llbo_Centrum.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bulver","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hj%C3%A4llbo_Centrum.jpg","title":"Hjällbo Centrum"},{"src":"https://upload.wikimedia.org/wikipedia/commons/d/dc/Hj%C3%A4llbo_kyrka%2C_den_17_mars_2009.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Västgöten","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hj%C3%A4llbo_kyrka,_den_17_mars_2009.JPG","title":"Hjällbo kyrka, den 17 mars 2009"}],"audio":"audio/piper/e64d0c4c5a9ef9c5.mp3"},{"name":"Gamlestads Torg","lat":57.72763,"lon":12.004452,"story":"Gamlestaden är just det, den gamla staden. Här grundades Nya Lödöse 1473, långt innan dagens Göteborg anlades 1621. Senare blev området industri, och här växte kullagerföretaget SKF fram.","tips":[["Gamlestadens fabriker, mat och design","4 min"]],"dur":15.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/Linje_13_%281%29.JPG/1280px-Linje_13_%281%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Linje_13_(1).JPG","title":"Linje 13 vid Drottningtorget","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Gamlestadstorget_bus_station_-_panoramio.jpg/1280px-Gamlestadstorget_bus_station_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Olof Lagerkvist","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Gamlestadstorget_bus_station_-_panoramio.jpg","title":"Gamlestadstorget bus station","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Gamlestadstorget_tram_stop_-_panoramio.jpg/1280px-Gamlestadstorget_tram_stop_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Olof Lagerkvist","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Gamlestadstorget_tram_stop_-_panoramio.jpg","title":"Gamlestadstorget tram stop","near":true}],"audio":"audio/piper/c5aa3b2af1fe7b03.mp3"},{"name":"Ejdergatan","lat":57.72085,"lon":12.005819,"story":"Den del av Ånäsvägen som går mellan Redbergsplatsen och Ejdergatan hade förr ett härligt namn: Nyfikeliden, eller bara Nyfiken och Nyfika. Liden betyder backe, och namnet kommer troligen från ett hus som på en karta från 1790 kallas Nyfika. Själva Ånäsvägen fick sitt namn 1883 efter landeriet Ånäs och är drygt en kilometer lång.","tips":[],"dur":21.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/57/%C3%85n%C3%A4sv%C3%A4gen_46-56_i_G%C3%B6teborg.jpg/1280px-%C3%85n%C3%A4sv%C3%A4gen_46-56_i_G%C3%B6teborg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Mattias Blomgren","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:%C3%85n%C3%A4sv%C3%A4gen_46-56_i_G%C3%B6teborg.jpg","title":"Ånäsvägen 46-56 i Göteborg"}],"audio":"audio/piper/c37b49eb0fdb3235.mp3"},{"name":"Redbergsplatsen","lat":57.716253,"lon":12.004502,"story":"Redbergsplatsen hette förr Korsvägen och fick sitt nuvarande namn 1883. År 1873 sattes en allmän vattenpump upp här, där man kunde njuta av vatten från Delsjön. Strax norr om platsen, i Redbergslids Folkpark, restes 1886 en paviljong med scen för artister. Nedanför Sankt Pauli kyrka står fontängruppen Elementens kamp i brons, flyttad hit från Olskrokstorget 1968.","tips":[["Fontänen Elementens kamp","3 min"],["Sankt Pauli kyrka","4 min"]],"dur":26.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Redbergsparken.JPG/1280px-Redbergsparken.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Redbergsparken.JPG","title":"Redbergsparken"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/44/Elementens_Kamp%2C_Gothenburg-2009-01-02.jpg/1280px-Elementens_Kamp%2C_Gothenburg-2009-01-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Halhen","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Elementens_Kamp,_Gothenburg-2009-01-02.jpg","title":"Elementens Kamp, Gothenburg-2009-01-02"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/St_Pauli_ka.JPG/1280px-St_Pauli_ka.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Raphael Saulus","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:St_Pauli_ka.JPG","title":"St Pauli ka"}],"audio":"audio/piper/4fb01d48df0e69c2.mp3"},{"name":"Olskrokstorget","lat":57.714631,"lon":11.998657},{"name":"Svingeln","lat":57.713016,"lon":11.991217,"story":"Uppe på berget i närheten ligger Skansen Lejonet, en försvarsborg från 1600-talet med ett förgyllt lejon på toppen. Den byggdes för att skydda staden från angrepp österifrån.","tips":[["Skansen Lejonet","8 min"]],"dur":10.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/Skansen_Lejonet.jpg/1280px-Skansen_Lejonet.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Lintoncat","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skansen_Lejonet.jpg","title":"Skansen Lejonet, Gullbergsvass 703:4. Göteborg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/G%C3%B6teborgs_fd_spinnhus_%28Stampen_20-2%29_2012-09-28_11-50-15.jpg/1280px-G%C3%B6teborgs_fd_spinnhus_%28Stampen_20-2%29_2012-09-28_11-50-15.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"SM6XSG","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:G%C3%B6teborgs_fd_spinnhus_(Stampen_20-2)_2012-09-28_11-50-15.jpg","title":"Göteborgs fd spinnhus (Stampen 20:2)","near":true},{"src":"https://pub.raa.se/dokumentation/11affe9f-9248-41de-af7d-0e78c9144ad6/visning/1","credit":"Okänd","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/11affe9f-9248-41de-af7d-0e78c9144ad6","title":"Kapellet uppfördes 1864, för uppdraget anlitades byggmästarna Philip Jacob Rapp för den arkitektoniska gestalt","old":true,"year":1988,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/5979f2bf-2e71-4967-8f03-f81b932c9110/visning/1","credit":"Okänd","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/5979f2bf-2e71-4967-8f03-f81b932c9110","title":"Kapellet från 1864 har fasader av gult tegel och en plåtklädd kupol. Det är byggt i morisk stil, med interiör ","old":true,"year":1988,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/0a4e26fa7375077a.mp3"},{"name":"Ullevi Norra","lat":57.708124,"lon":11.9862,"story":"Utanför Nya Ullevi står Ingo – the Champ, Peter Lindes bronsstaty av Ingemar Johansson, världsmästare i tungviktsboxning 1959–1960. Statyn är 2,4 meter hög och väger 400 kilo. På arenan besegrade Ingo amerikanen Eddie Machen inför drygt 53 000 åskådare. Längs Stampgatan rinner Fattighusån, en grävd kanal som invigdes redan 1641 av greve Per Brahe.","tips":[["Ingo – the Champ","2 min"],["Mariakyrkan","2 min"]],"dur":26.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/Ingo-the-Champ.jpg/1280px-Ingo-the-Champ.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bolstermage","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ingo-the-Champ.jpg","title":"Ingo-the-Champ"}],"audio":"audio/piper/821b95bb44c15bfe.mp3"},{"name":"Ullevi Södra","lat":57.703809,"lon":11.985031,"story":"Nya Ullevi byggdes till fotbolls-VM 1958 och är fortfarande en av Sveriges största arenor. Den är också känd för konserterna. När Bruce Springsteen spelade här 1985 gungade läktarna så kraftigt att arenan senare fick förstärkas.","tips":[["Nya Ullevi","2 min"],["Heden, stort öppet fält","4 min"]],"dur":14.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Norska_sjomanskyrkan%2C_Goteborg.jpg/1280px-Norska_sjomanskyrkan%2C_Goteborg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vogler","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Norska_sjomanskyrkan,_Goteborg.jpg","title":"The Norwegian Sailor's Church, in Göteborg Sweden. The Norwegian pennant raised on the flagpole.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/Garnisonskyrkog%C3%A5rden_2012-09-28_12-13-48.jpg/1280px-Garnisonskyrkog%C3%A5rden_2012-09-28_12-13-48.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"SM6XSG","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Garnisonskyrkog%C3%A5rden_2012-09-28_12-13-48.jpg","title":"Garnisonskyrkogården (RAÄ-nr Göteborg 436) vid Ullevi, Göteborg, Västergötland, Västra Götalands län","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/86/Garnisonskyrkog%C3%A5rden_2012-09-28_12-14-19.jpg/1280px-Garnisonskyrkog%C3%A5rden_2012-09-28_12-14-19.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"SM6XSG","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Garnisonskyrkog%C3%A5rden_2012-09-28_12-14-19.jpg","title":"Garnisonskyrkogården (RAÄ-nr Göteborg 436) vid Ullevi, Göteborg, Västergötland, Västra Götalands län","near":true}],"audio":"audio/piper/7a3fa429806e7aac.mp3"},{"name":"Scandinavium","lat":57.700191,"lon":11.985919,"story":"Den stora arenan här är Scandinavium, invigd 1971. Här har det spelats ishockey, hållits konserter och arrangerats världsmästerskap. Strax intill ligger Nya Ullevi.","tips":[["Scandinavium","2 min"],["Nya Ullevi","5 min"]],"dur":11.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Sk%C3%A5negatan_och_hotell_Opalen.jpg/1280px-Sk%C3%A5negatan_och_hotell_Opalen.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"ArildV","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sk%C3%A5negatan_och_hotell_Opalen.jpg","title":"Skånegatan (Scania street) and hotell Opalen.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Middag_med_Wikimedia_Sverige-g%C3%A4nget_efter_Bokm%C3%A4ssan_i_G%C3%B6teborg_2015.JPG/1280px-Middag_med_Wikimedia_Sverige-g%C3%A4nget_efter_Bokm%C3%A4ssan_i_G%C3%B6teborg_2015.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Hannibal","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Middag_med_Wikimedia_Sverige-g%C3%A4nget_efter_Bokm%C3%A4ssan_i_G%C3%B6teborg_2015.JPG","title":"Middag med Wikimedia Sverige-gänget efter Bokmässan i Göteborg 2015","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/Skandinavium_fint_upplyst_p%C3%A5_kv%C3%A4llen%2C_G%C3%B6teborg_2010_-_panoramio.jpg/1280px-Skandinavium_fint_upplyst_p%C3%A5_kv%C3%A4llen%2C_G%C3%B6teborg_2010_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Robande","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Skandinavium_fint_upplyst_p%C3%A5_kv%C3%A4llen,_G%C3%B6teborg_2010_-_panoramio.jpg","title":"Skandinavium fint upplyst på kvällen, Göteborg 2010","near":true}],"audio":"audio/piper/701b40204aad2a44.mp3"},{"name":"Korsvägen","lat":57.697021,"lon":11.98719,"story":"Korsvägen är porten till Göteborgs evenemangsstråk. Här ligger nöjesparken Liseberg, som öppnade 1923, vetenskapscentret Universeum och Världskulturmuseet. Svenska Mässan ligger också alldeles intill.","tips":[["Liseberg","4 min"],["Universeum","3 min"],["Världskulturmuseet","3 min"]],"dur":12.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/090712_Restaurant_Incontro.jpg/1280px-090712_Restaurant_Incontro.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Fluff","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:090712_Restaurant_Incontro.jpg","title":"Restaurant Incontro, next to Swedish Fair in Gothenburg, Sweden","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/30/Ringlinjen_Linje_12_vid_Korsv%C3%A4gen.JPG/1280px-Ringlinjen_Linje_12_vid_Korsv%C3%A4gen.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bo Randstedt","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ringlinjen_Linje_12_vid_Korsv%C3%A4gen.JPG","title":"Ring line tram M5 92 at Korsvägen.","near":true},{"src":"https://pub.raa.se/dokumentation/36d5f81b-aa96-4275-aad3-92ba0ca55f3c/visning/1","credit":"Bruno, Fredrik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/36d5f81b-aa96-4275-aad3-92ba0ca55f3c","title":"Svenska Mässan. Mässhallen","old":true,"year":1943,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/27cdf83cf590876c.mp3"},{"name":"Chalmers","lat":57.689932,"lon":11.97259,"story":"Chalmers tekniska högskola grundades 1829 med pengar som William Chalmers testamenterade. Han hade arbetat för Svenska Ostindiska Kompaniet. Runt omkring ligger campus Johanneberg, där tusentals ingenjörer utbildas varje år.","tips":[["Chalmers campus Johanneberg","2 min"],["Utsikt från Chalmersområdet","6 min"]],"dur":14.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a2/Johanneberg_and_Chalmers_by_BIL.jpg/1280px-Johanneberg_and_Chalmers_by_BIL.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"BIL, B I Larsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Johanneberg_and_Chalmers_by_BIL.jpg","title":"The city area Johanneberg, and Chalmers University, in Gothenburg, Sweden","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/090627_Landala_kapell.jpg/1280px-090627_Landala_kapell.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Fluff","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:090627_Landala_kapell.jpg","title":"Landala kapell (chapel) in Gothenburg, Sweden","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Rms_signing_books_%286331839061%29.jpg/1280px-Rms_signing_books_%286331839061%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"jonsson from Göteborg, Sweden","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Rms_signing_books_(6331839061).jpg","title":"Richard Stallman signing books @ Chalmers","near":true}],"audio":"audio/piper/aca1ed4e38bc224d.mp3"},{"name":"Wavrinskys Plats","lat":57.688963,"lon":11.96819,"story":"Mitt i rondellen står en 4,5 meter hög knappnål, stucken genom ett kryss i marken. Skulpturen heter Här och är gjord av Ebba Matz. Själva namnet var omstritt. Fastighetskontoret ville hellre ha Reutersplatsen, delvis för att Wavrinsky var så svårt att uttala. På kullen intill bor studenter numera i Guldhedens gamla norra vattentorn.","tips":[["Se knappnålen Här","1 min"],["Promenera till Guldhedstorget från 1945","2 min"]],"dur":19.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/090627_Wavrinskys_plats.jpg/1280px-090627_Wavrinskys_plats.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Fluff","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:090627_Wavrinskys_plats.jpg","title":"090627 Wavrinskys plats"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2e/The_Here_sculpture_in_Gbg.jpg/1280px-The_Here_sculpture_in_Gbg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Rolf Broberg","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:The_Here_sculpture_in_Gbg.jpg","title":"The Here sculpture in Gbg"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Guldhedens_torg_Exteri%C3%B6r_Vy_%C3%B6ver_torget_m._restaurant%2C_butiksl%C3%A4nga_och_kollektivhus._ArkDes_ARKM.1962-101-0955.jpg/1280px-Guldhedens_torg_Exteri%C3%B6r_Vy_%C3%B6ver_torget_m._restaurant%2C_butiksl%C3%A4nga_och_kollektivhus._ArkDes_ARKM.1962-101-0955.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jaerke","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Guldhedens_torg_Exteri%C3%B6r_Vy_%C3%B6ver_torget_m._restaurant,_butiksl%C3%A4nga_och_kollektivhus._ArkDes_ARKM.1962-101-0955.jpg","title":"Guldhedens torg Exteriör Vy över torget m. restaurant, butikslänga och kollektivhus. ArkDes ARKM.196"}],"audio":"audio/piper/aef412dd16964078.mp3"},{"name":"Medicinaregatan","lat":57.685262,"lon":11.964153,"story":"Uppe på Hökeberget står Guldhedens norra vattentorn, som sedan 2008 är ombyggt till 74 studentbostäder. Taket ligger cirka 140 meter över havet, och på elfte våningen finns en gemensam takterrass. Lägenheterna på varje plan är ordnade i solfjädersform. Här i trakten finns också KV konstskola, grundad 1969.","tips":[["Guldhedens norra vattentorn","2 min"]],"dur":21.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Sahlgrenska_Universitetssjukhuset.JPG/1280px-Sahlgrenska_Universitetssjukhuset.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sahlgrenska_Universitetssjukhuset.JPG","title":"Sahlgrenska University Hospital in Gothenburg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c8/Per_och_Alma_Olssons_fond_plaque_1997.jpg/1280px-Per_och_Alma_Olssons_fond_plaque_1997.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vogler","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Per_och_Alma_Olssons_fond_plaque_1997.jpg","title":"Akutintagets tillbyggnad till Sahlgrenska sjukhuset i Göteborg färdigställdes 1996 och erhöll 1997 å","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Biomedicinska_biblioteket.jpg/1280px-Biomedicinska_biblioteket.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vogler","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Biomedicinska_biblioteket.jpg","title":"Biomedicinska biblioteket vid Medicinaregatan 4 i Göteborg, en av Göteborgs universitetsbiblioteks f","near":true}],"audio":"audio/piper/8709409b35b26aaa.mp3"},{"name":"Sahlgrenska Huvudentré","lat":57.683685,"lon":11.961365,"story":"Här ligger Sahlgrenska universitetssjukhuset, ett av Nordeuropas största sjukhus. Det har fått sitt namn efter Niclas Sahlgren, ännu en av de rika direktörerna i Ostindiska Kompaniet, vars pengar lade grunden till sjukhuset.","tips":[["Botaniska trädgården","8 min"]],"dur":12.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Sahlgrenska_Universitetssjukhuset.JPG/1280px-Sahlgrenska_Universitetssjukhuset.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sahlgrenska_Universitetssjukhuset.JPG","title":"Sahlgrenska University Hospital in Gothenburg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Sahlgrenska_hospital_former_church_room_windows.jpg/1280px-Sahlgrenska_hospital_former_church_room_windows.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vogler","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Sahlgrenska_hospital_former_church_room_windows.jpg","title":"Bevarade blyinfattade fönster från Sahlgrenskas tidigare kyrksal.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c8/Per_och_Alma_Olssons_fond_plaque_1997.jpg/1280px-Per_och_Alma_Olssons_fond_plaque_1997.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vogler","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Per_och_Alma_Olssons_fond_plaque_1997.jpg","title":"Akutintagets tillbyggnad till Sahlgrenska sjukhuset i Göteborg färdigställdes 1996 och erhöll 1997 å","near":true}],"audio":"audio/piper/2ec3b435d48af716.mp3"},{"name":"Botaniska Trädgården","lat":57.681403,"lon":11.945733,"story":"Göteborgs botaniska trädgård öppnade 1923 och är en av Europas större botaniska trädgårdar. Här finns en klippträdgård, en japansk dal och växthus med tusentals växter. På andra sidan vägen ligger Slottsskogen, stadens stora stadspark.","tips":[["Botaniska trädgården","2 min"],["Slottsskogen","3 min"]],"dur":14.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Vagnhallen_Slottsskogen_2012-08-14_02.jpg/1280px-Vagnhallen_Slottsskogen_2012-08-14_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Vagnhallen_Slottsskogen_2012-08-14_02.jpg","title":"\"Vagnhallen Slottsskogen\" in Göteborg, Sweden.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Vagnhallen_Slottsskogen_2012-08-14_03.jpg/1280px-Vagnhallen_Slottsskogen_2012-08-14_03.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Albin Olsson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Vagnhallen_Slottsskogen_2012-08-14_03.jpg","title":"\"Vagnhallen Slottsskogen\" in Göteborg, Sweden.","near":true},{"src":"https://pub.raa.se/dokumentation/4d96b02c-358e-4378-9137-cab53e766556/visning/1","credit":"Bruno, Fredrik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/4d96b02c-358e-4378-9137-cab53e766556","title":"Trädgårdsföreningen","old":true,"year":1945,"museum":"Riksantikvarieämbetet"},{"src":"https://ems.dimu.org/image/032wX1rKX1SP?dimension=600x600","credit":"Magnus Leijer","license":"CC BY","page":"https://kulturarvsdata.se/gnm/photo/html/GNM5224%3A004","title":"Botaniska Trädgården","old":true,"year":1921,"museum":"Göteborgs Naturhistoriska Museum"}],"audio":"audio/piper/2538f4a5975cfa1e.mp3"},{"name":"Marklandsgatan","lat":57.674452,"lon":11.935548,"story":"Gatan har fått sitt namn efter markland, en gammal enhet för att värdera jord. Strax intill ligger Frölundaborgs isstadion. Den invigdes 1967 med en vänskapsmatch där Västra Frölunda IF slog svenska ishockeylandslaget med 4–3. Vid Slottsskogsvallen slingrar Friidrottens väg, uppkallad efter höjdhoppstränaren Viljo Nousiainen som slipade Patrik Sjöberg och Stefan Holm här.","tips":[["Se Frölundaborgs isstadion","5 min"],["Gå Friidrottens väg vid Slottsskogsvallen","4 min"]],"dur":22.6,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/d/d4/Marklandsgatan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Bulver","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Marklandsgatan.jpg","title":"Marklandsgatan"}],"audio":"audio/piper/61f4613f9525ccb6.mp3"},{"name":"Axel Dahlströms Torg","lat":57.672261,"lon":11.927496,"story":"Torget sticker ut med ett 16 våningar högt höghus som stod klart 1956, och på medborgarhuset sitter ett väggkonstverk i form av en marmorintarsia av konstnären Endre Nemes. Samma år invigdes Högsboskolan alldeles intill, byggd för cirka 1 000 elever. Skolan finns dock inte kvar, den revs 2013.","tips":[["Höghuset och marmorintarsian på torget","2 min"]],"dur":18.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/H%C3%B6gsbo_kyrka_den_22_oktober_2005%2C_exteri%C3%B6r_2..JPG/1280px-H%C3%B6gsbo_kyrka_den_22_oktober_2005%2C_exteri%C3%B6r_2..JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"User Västgöten on sv.wikipedia","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6gsbo_kyrka_den_22_oktober_2005,_exteri%C3%B6r_2..JPG","title":"Högsbo kyrka i Göteborg, den 22 oktober 2005. Bilden är fotograferad av Harri Blomberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Kapplandsgatan1.JPG/1280px-Kapplandsgatan1.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"DavidIvar","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Kapplandsgatan1.JPG","title":"Kapplandsgatan viewed from its beginning in the direction of Tunnlandsgatan. 6 augusti 2015","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Bankogatan_May_2020.jpg/1280px-Bankogatan_May_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vogler","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Bankogatan_May_2020.jpg","title":"Bankogatan i Göteborg sedd från Axel Dahlströms torgs spårvagnshållplats i maj 2020. Arkitekt Åke Wa","near":true}],"audio":"audio/piper/73df4a52c637dd2f.mp3"},{"name":"Lantmilsgatan","lat":57.667124,"lon":11.924711,"story":"Titta på perrongen. Där sitter en kvinna i brons med spetsig mössa och väntar, och det har hon gjort sedan 2001. Skulpturen heter Väntan och är gjord av Britt Ignell. Kanske väntar hon på någon som ska kliva av spårvagnen. Under tiden har hon sett parkeringshuset mittemot byggas på med bostäder.","tips":[["Hälsa på bronskvinnan Väntan","1 min"]],"dur":17.1,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8a/V%C3%A4ntan_Britt_Ignell.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Eva Ekeblad","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:V%C3%A4ntan_Britt_Ignell.JPG","title":"Väntan Britt Ignell"}],"audio":"audio/piper/1252fd192a706f61.mp3"},{"name":"Nymilsgatan","lat":57.662611,"lon":11.925026},{"name":"Musikvägen","lat":57.659061,"lon":11.920598,"story":"Här i Västra Frölunda har gatorna musikaliska namn, som Musikvägen och Positivgatan. Stadsdelen byggdes under 1960-talet, när Göteborg växte snabbt söderut.","tips":[["Ruddalens idrottsområde","8 min"]],"dur":10.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Aerial_photo_of_Gothenburg_2013-10-27_376.jpg/1280px-Aerial_photo_of_Gothenburg_2013-10-27_376.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aerial_photo_of_Gothenburg_2013-10-27_376.jpg","title":"Photo taken on a helicopter over Gothenburg","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Aerial_photo_of_Gothenburg_2013-10-27_377.jpg/1280px-Aerial_photo_of_Gothenburg_2013-10-27_377.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Averater","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aerial_photo_of_Gothenburg_2013-10-27_377.jpg","title":"Photo taken on a helicopter over Gothenburg","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ca/Marconihallen_snettfram.JPG/1280px-Marconihallen_snettfram.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"DavidIvar","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Marconihallen_snettfram.JPG","title":"Marconihallen, augusti 2015","near":true}],"audio":"audio/piper/2f858eee521f3fb6.mp3"},{"name":"Positivgatan","lat":57.656766,"lon":11.917556},{"name":"Frölunda Torg","lat":57.652732,"lon":11.911359,"story":"Snart är vi framme vid ändhållplatsen Frölunda Torg. Frölunda Torg öppnade 1966 och var ett av Sveriges första stora köpcentrum i förort. Runt omkring ligger Västra Frölunda, och några kilometer västerut börjar havet och skärgården. Tack för att du åkte med!","tips":[["Frölunda Torg, köpcentrum","2 min"]],"dur":15.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Fr%C3%B6lunda_Torg_tram_stop_entrance_-_panoramio.jpg/1280px-Fr%C3%B6lunda_Torg_tram_stop_entrance_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Olof Lagerkvist","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Fr%C3%B6lunda_Torg_tram_stop_entrance_-_panoramio.jpg","title":"Frölunda Torg tram stop entrance","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Fr%C3%B6lunda_Torg_-_panoramio.jpg/1280px-Fr%C3%B6lunda_Torg_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Olof Lagerkvist","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Fr%C3%B6lunda_Torg_-_panoramio.jpg","title":"Frölunda Torg","near":true},{"src":"https://pub.raa.se/dokumentation/f3f9fceb-3522-4378-a611-22a981a2f324/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/f3f9fceb-3522-4378-a611-22a981a2f324","title":"Köpcentret interiört","old":true,"year":1977,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/c1167b97-9b7a-4036-ac06-3091e28393d4/visning/1","credit":"Nilsson, Pål-Nils","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/c1167b97-9b7a-4036-ac06-3091e28393d4","title":"Kundvagnar, i bakgrunden köpcentret","old":true,"year":1977,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/1b0fe9eb59c3ebf2.mp3"}],"looks":[{"id":"skansenlejonet","lat":57.7158,"lon":11.9887,"r":320,"text":"Till höger ligger Skansen Lejonet, en försvarsborg från 1600-talet med ett förgyllt lejon på toppen.","dur":7.4,"audio":"audio/piper/af426c35fad68dbe.mp3"},{"id":"ullevi","lat":57.7062,"lon":11.987,"r":260,"text":"Till vänster reser sig Nya Ullevi, arenan som byggdes till fotbolls-VM 1958.","dur":6.7,"audio":"audio/piper/0fbe853322b68c2f.mp3"},{"id":"liseberg","lat":57.695,"lon":11.9925,"r":280,"text":"Till vänster ligger nöjesparken Liseberg.","dur":3.5,"audio":"audio/piper/cc09fca39ce2b836.mp3"}],"from":"Angered Centrum","to":"Frölunda Torg","variant":"Mot Frölunda Torg","color":["#a32b9b","#ffffff"],"trips":744,"source":"Västtrafik via Trafiklab (GTFS Regional)","tts":"Piper"}