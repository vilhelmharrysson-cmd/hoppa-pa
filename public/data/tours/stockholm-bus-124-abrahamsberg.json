13.mp3"},{"name":"Västerledstorget","lat":59.328797,"lon":17.968814},{"name":"Mossens idrottsplats","lat":59.328516,"lon":17.9639},{"name":"Nyängsvägen","lat":59.328703,"lon":17.955854},{"name":"Grundläggarvägen","lat":59.329074,"lon":17.952008},{"name":"Abrahamsbergsvägen","lat":59.329456,"lon":17.945886},{"name":"Rörläggarvägen","lat":59.33122,"lon":17.946087},{"name":"Gustav III:s väg","lat":59.333226,"lon":17.945862},{"name":"Abrahamsbergsskolan","lat":59.334453,"lon":17.949784},{"name":"Abrahamsberg","lat":59.336118,"lon":17.952423,"story":"Snart är vi framme vid ändhållplatsen Abrahamsberg. Tack för att du åkte med!","tips":[],"dur":4.5,"audio":"audio/piper/8d5f89fd99b82682.mp3"}],"looks":[],"from":"Alvik","to":"Abrahamsberg","variant":"Mot Abrahamsberg","color":["#d71d24","#ffffff"],"trips":133,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}