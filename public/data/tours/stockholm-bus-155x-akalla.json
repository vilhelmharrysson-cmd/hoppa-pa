{"id":"stockholm-bus-155x-akalla","group":"stockholm-bus-155x","city":"Stockholm","mode":"bus","line":"155X","vehicle":"buss","vehicleLong":"buss","operator":"SL","api":"sl","tab":"","guide":null,"speedKmh":18,"dwellSec":15,"route":[[59.338646,17.937836],[59.33871,17.937736],[59.338791,17.938007],[59.338705,17.938159],[59.338852,17.938329],[59.339119,17.938123],[59.339544,17.939102],[59.339458,17.93946],[59.339519,17.93991],[59.3397,17.940167],[59.339945,17.940043],[59.340318,17.941133],[59.342311,17.951538],[59.342646,17.952675],[59.34344,17.954703],[59.34366,17.957163],[59.343938,17.958547],[59.344561,17.960012],[59.345807,17.961846],[59.346475,17.963893],[59.347294,17.961795],[59.350589,17.959524],[59.350538,17.959679],[59.350549,17.959549],[59.351759,17.958659],[59.352199,17.957649],[59.351734,17.957021],[59.351845,17.956674],[59.353559,17.958819],[59.354299,17.958939],[59.354958,17.958638],[59.354921,17.958521],[59.355891,17.957155],[59.356578,17.95544],[59.357098,17.953444],[59.358401,17.946877],[59.358802,17.945732],[59.359473,17.944755],[59.361619,17.943384],[59.362741,17.94316],[59.367067,17.944784],[59.367538,17.944821],[59.3682,17.944573],[59.36891,17.944038],[59.369685,17.942952],[59.370413,17.941483],[59.371087,17.939693],[59.371326,17.939733],[59.371353,17.940236],[59.37092,17.940924],[59.370745,17.941487],[59.370953,17.941729],[59.371053,17.941657],[59.371566,17.940325],[59.372126,17.939378],[59.372502,17.937772],[59.373092,17.938054],[59.374235,17.9393],[59.375394,17.93919],[59.375606,17.940916],[59.37645,17.941729],[59.376904,17.941913],[59.377333,17.941458],[59.377462,17.940223],[59.377701,17.940066],[59.378565,17.939975],[59.378981,17.940186],[59.379258,17.940546],[59.380754,17.938949],[59.381718,17.938821],[59.381892,17.938964],[59.382013,17.937815],[59.382357,17.936114],[59.383239,17.936157],[59.383707,17.936464],[59.384486,17.93733],[59.385641,17.938861],[59.387143,17.940024],[59.387572,17.940593],[59.387898,17.941188],[59.388297,17.942321],[59.389242,17.945599],[59.389647,17.946467],[59.390108,17.947106],[59.390973,17.947881],[59.393003,17.949023],[59.394472,17.950116],[59.396509,17.952424],[59.396734,17.952977],[59.397021,17.953068],[59.397377,17.952367],[59.398093,17.951463],[59.398753,17.950855],[59.398954,17.950972],[59.399351,17.950674],[59.399234,17.949831],[59.399033,17.949713],[59.398893,17.949135],[59.399015,17.948247],[59.399305,17.947472],[59.399742,17.947108],[59.399704,17.947011],[59.399847,17.946769],[59.400787,17.945537],[59.401129,17.945329],[59.401596,17.94548],[59.401642,17.945203],[59.403025,17.943418],[59.402718,17.942558],[59.403727,17.941268],[59.404,17.942157],[59.404878,17.940868],[59.4064,17.936577],[59.406629,17.934714],[59.406929,17.933736],[59.408733,17.92972],[59.410108,17.92788],[59.410508,17.927173],[59.412283,17.922705],[59.412544,17.922502],[59.412763,17.922576],[59.415012,17.924602],[59.415713,17.921721],[59.416533,17.919963],[59.417472,17.916003],[59.417535,17.916049],[59.41746,17.915996],[59.417679,17.915037],[59.415795,17.913359],[59.415622,17.913441],[59.415259,17.913146]],"stops":[{"name":"Brommaplan","lat":59.338646,"lon":17.937836,"story":"Välkommen ombord på buss 155X mot Akalla! Resan tar ungefär 51 minuter. Vid tunnelbanans viadukt står skulpturen ”Fågel Rock med tre ägg” av Berndt Helleberg från 1969. Viadukten är äldre än tunnelbanan. Den togs i bruk 1944 och trafikerades då av spårvagnar. Stationens konst, i plåt, glas och fotografier, handlar om Brommas och flygets historia. Höghuset Brommahöjden med sina 16 våningar kom först 2008.","tips":[["Leta upp Fågel Rock med tre ägg vid viadukten","2 min"]],"dur":30.4,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/c/cc/Brommaplansrondellen.png?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Gonate1","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Brommaplansrondellen.png","title":"Brommaplansrondellen"}],"audio":"audio/piper/8dd290e54604bc5f.mp3"},{"name":"Riksbyvägen","lat":59.341226,"lon":17.945904,"story":"På en berghäll vid Drottningholmsvägen finns två runristningar från 1000-talet. De upptäcktes av en slump 1904, när någon var ute och plockade bär. I århundraden hade de legat under jord och mossa, och därför är de fortfarande välbevarade. På den ena står att Sigvid och Sigrev lät rista stenen efter sin far Sinar.","tips":[["Se runhällen vid Drottningholmsvägen","4 min"]],"dur":18.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Lekplatsen_B%C3%A5tsmanstorpet_02.jpg/1280px-Lekplatsen_B%C3%A5tsmanstorpet_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Sabelöga","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Lekplatsen_B%C3%A5tsmanstorpet_02.jpg","title":"Skjulet vid Lekplatsen Båtsmanstorpet i Riksby, Bromma i västra Stockholm","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Lekplatsen_B%C3%A5tsmanstorpet_03.jpg/1280px-Lekplatsen_B%C3%A5tsmanstorpet_03.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Sabelöga","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Lekplatsen_B%C3%A5tsmanstorpet_03.jpg","title":"Tennisbanan vid Lekplatsen Båtsmanstorpet i Riksby, Bromma i västra Stockholm","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Lekplatsen_B%C3%A5tsmanstorpet_01.jpg/1280px-Lekplatsen_B%C3%A5tsmanstorpet_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Sabelöga","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Lekplatsen_B%C3%A5tsmanstorpet_01.jpg","title":"Pingisbord vid Lekplatsen Båtsmanstorpet i Riksby, Bromma i västra Stockholm","near":true}],"audio":"audio/piper/fdacced1fbac4f51.mp3"},{"name":"Hemslöjdsvägen","lat":59.341901,"lon":17.949746},{"name":"Jetverkstäderna","lat":59.343576,"lon":17.956679},{"name":"Norrbyvägen","lat":59.345276,"lon":17.961086,"story":"I Fructushuset på Ulvsundavägen tillverkades en gång Pommac. Fabriken byggdes 1939–1940, och den långa vita byggnaden anses vara ett fint exempel på en modern och funktionell fabrik. Vid kanalen mot Ulvsundasjön står Mejerivillan från 1905, den enda byggnad som finns kvar av Ulvsunda lantgård.","tips":[["Se Fructushuset, där Pommac tillverkades","3 min"]],"dur":18.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/71/Mejerivillan%2C_Ulvsunda%2C_2013a.jpg/1280px-Mejerivillan%2C_Ulvsunda%2C_2013a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bysmon","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Mejerivillan,_Ulvsunda,_2013a.jpg","title":"Mejerivillan, Ulvsunda, 2013a"}],"audio":"audio/piper/aca577538149a3e0.mp3"},{"name":"Ekbacksvägen","lat":59.346845,"lon":17.963361,"story":"Mitt bland lagerhallar och verkstäder står en gammal väderkvarn. Ulvsunda kvarn, även kallad Bällsta kvarn, står vid foten av Kvarnberget intill Ulvsundavägen, strax söder om Bromma flygplats. Ännu närmare ligger Fructushuset, den vita funktionalistiska fabriken där läsken Pommac tillverkades.","tips":[["Fructushuset","4 min"],["Ulvsunda kvarn","6 min"]],"dur":17.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Ulvsunda_kvarn_2013_02.jpg/1280px-Ulvsunda_kvarn_2013_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ulvsunda_kvarn_2013_02.jpg","title":"Ulvsunda kvarn 2013 02"}],"audio":"audio/piper/f51da9ff78fc4a07.mp3"},{"name":"Ranhammarsvägen","lat":59.347971,"lon":17.961458},{"name":"Lintavägen","lat":59.350538,"lon":17.959679,"story":"Törstig? I Fructushuset på Ulvsundavägen tillverkades en gång läsken Pommac. Fabriken byggdes 1939 till 1940 efter ritningar av Ture Wennerholm och räknas som ett elegant exempel på funktionell industriarkitektur. Alldeles i närheten låg också Flygtekniska försöksanstalten, en statlig myndighet som forskade och experimenterade inom flygteknik fram till millennieskiftet.","tips":[["Fructushuset","5 min"]],"dur":23.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Former_FFA_building_December_2010.jpg/1280px-Former_FFA_building_December_2010.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Former_FFA_building_December_2010.jpg","title":"Former FFA building December 2010"}],"audio":"audio/piper/c37fb8434fe6abba.mp3"},{"name":"Bromma handelscenter","lat":59.354958,"lon":17.958638,"story":"Shopping i gamla flyghangarer! Köpcentret Bromma Blocks inryms i Bromma flygplats hangarer, som på sin tid var de största i norra Europa. Arkitekten Paul Hedqvist ritade dem i en blockliknande funktionalistisk stil, därav namnet. Och ute i Bällstaviken finns en holme som egentligen är ett skeppsvrak: ett gammalt lastfartyg som sjönk och sakta har vuxit igen med grönska.","tips":[["Bromma Blocks","5 min"],["Pråmholmen","6 min"]],"dur":21.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Bromma_Blocks_February_2013.jpg/1280px-Bromma_Blocks_February_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Arild Vågen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bromma_Blocks_February_2013.jpg","title":"Bromma Blocks February 2013"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Pr%C3%A5mholmen_3.jpg/1280px-Pr%C3%A5mholmen_3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Sebastianbay","license":"CC BY 4.0","page":"https://commons.wikimedia.org/wiki/File:Pr%C3%A5mholmen_3.jpg","title":"Pråmholmen 3"}],"audio":"audio/piper/e9d8acb30d9042b6.mp3"},{"name":"Flygverkstäderna","lat":59.357006,"lon":17.954199},{"name":"Hagelstavägen","lat":59.358389,"lon":17.947201,"story":"Bromma flygplats invigdes den 13 maj 1936 av kung Gustaf V och var den första flygplatsen i Europa med asfalterade landningsbanor. De gamla hangarerna var på sin tid de största i norra Europa, och i dem ligger i dag köpcentret Bromma Blocks. Där flyttade den första stormarknaden in redan 1972.","tips":[["Bromma Blocks","5 min"]],"dur":18.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/65/Bromma_flygplats2.jpg/1280px-Bromma_flygplats2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Okänd","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bromma_flygplats2.jpg","title":"Bromma flygplats2"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Bromma_Blocks_February_2013.jpg/1280px-Bromma_Blocks_February_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Arild Vågen","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bromma_Blocks_February_2013.jpg","title":"Bromma Blocks February 2013"}],"audio":"audio/piper/04ba2cc7ae86f40a.mp3"},{"name":"Duvkullavägen","lat":59.371215,"lon":17.941375,"story":"Strax intill ligger Solvalla, Sveriges nationalarena för trav och Nordens största travbana. Varje år körs Elitloppet här, ett av världens största travlopp, och läktarna rymmer 35 000 besökare. Banan invigdes den 31 juli 1927, och premiäråret kördes tolv lopp.","tips":[["Gå till Solvalla travbana","5 min"]],"dur":16.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Solvalla_1.JPG/1280px-Solvalla_1.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Solvalla_1.JPG","title":"Solvalla 1"}],"audio":"audio/piper/623864a9d77eef84.mp3"},{"name":"Rissne","lat":59.376041,"lon":17.941396,"story":"Rissne är den enda tunnelbanestationen i Stockholm som har sitt namn ristat med runor. Namnet finns även på en runsten i Sigtuna, rest efter ”Gunnars son i Risnö”. På 1650-talet gjorde ägarna Johan och Beata von Kaulbars Rissne till herrgård med en ståtlig huvudbyggnad i sten. I dag är Rissne gård restaurang och konferensgård.","tips":[],"dur":19.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Svea_artilleriregemente_in_Stockholm_2014_%2804%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2804%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(04).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Svea_artilleriregemente_in_Stockholm_2014_%2806%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2806%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(06).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Svea_artilleriregemente_in_Stockholm_2014_%2805%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2805%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(05).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true}],"audio":"audio/piper/c4e203f77df0746e.mp3"},{"name":"Rissneleden","lat":59.37981,"lon":17.940006,"story":"I norra delen av Rissne, inte långt härifrån, sover hela blå linjen. I Rissnedepån står nämligen samtliga tunnelbanevagnar som trafikerar blå linjen uppställda, på spår under jord. Mellan 1975 och 1985 användes förbindelsespåret dit även för vanliga passagerare, eftersom sträckan via Huvudsta och Rissne ännu inte var färdig.","tips":[["Rissne torg","5 min"]],"dur":20.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a3/Svea_artilleriregemente_in_Stockholm_2014_%2810%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2810%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(10).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Svea_artilleriregemente_in_Stockholm_2014_%2811%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2811%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(11).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Svea_artilleriregemente_in_Stockholm_2014_%2812%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2812%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(12).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true}],"audio":"audio/piper/d2d1fc889294a99c.mp3"},{"name":"Ärvingevägen","lat":59.399742,"lon":17.947108,"story":"Ärvinge är ett informellt område i södra Kista, och härifrån är det nära till Kista Galleria. Där finns inte bara 180 butiker och restauranger utan även en bowlinghall, en multiplexbiograf och en gokartbana på hela 4 000 kvadratmeter. I gallerians två torn bor dessutom studenter, så vissa har shoppingen precis under sängen.","tips":[["Kista Galleria","4 min"]],"dur":18.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/54/%C3%84rvinge_november_2010.jpg/1280px-%C3%84rvinge_november_2010.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"U. Schröter","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:%C3%84rvinge_november_2010.jpg","title":"Ärvinge november 2010"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/Kista_galleria.jpg/1280px-Kista_galleria.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kista_galleria.jpg","title":"Kista galleria"}],"audio":"audio/piper/35c7b43a485ba512.mp3"},{"name":"Kista centrum","lat":59.403169,"lon":17.941938,"story":"Kista tunnelbanestation är den enda på blå linjen som ligger ovan jord. Den vilar på en viadukt som är 1 120 meter lång, den längsta i hela tunnelbanenätet. När stationen skulle få namn ville namnberedningen först lägga till ”Gård”, för att ingen skulle tänka på en likkista. Ovanför gallerian reser sig Kista torn, 120 meter högt.","tips":[["Se Kista torn","3 min"],["Gå på bio på Filmstaden Kista","2 min"]],"dur":18.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Kista.jpg/1280px-Kista.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"JM AB. Fotograf: Gustav Kaiser","license":"CC BY-SA 1.0","page":"https://commons.wikimedia.org/wiki/File:Kista.jpg","title":"Kista"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Kista_Tower_Stockholm_Sweden.jpg/1280px-Kista_Tower_Stockholm_Sweden.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Brorsson","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kista_Tower_Stockholm_Sweden.jpg","title":"Kista Tower Stockholm Sweden"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Filmstaden_Kista%2C_exterior.jpg/1280px-Filmstaden_Kista%2C_exterior.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Filmstaden_Kista,_exterior.jpg","title":"Filmstaden Kista, exterior"}],"audio":"audio/piper/666a8b50c27c92ae.mp3"},{"name":"Tönsbergsgatan","lat":59.406931,"lon":17.933933,"story":"Det höga betongtornet i närheten hör till Kista brandstation från 1980. Det är ett övningstorn för brandmännen och ett välkänt landmärke i trakten. Vid Kista gård står dessutom Kistastenen, en runsten som visar att Järvafältet var bebott långt innan Kista blev IT-stad.","tips":[["Se brandstationens övningstorn","5 min"]],"dur":15.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Kista_brandstation_2015.jpg/1280px-Kista_brandstation_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kista_brandstation_2015.jpg","title":"Kista brandstation 2015"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a7/Kistastenen_U75%2C_2015a.jpg/1280px-Kistastenen_U75%2C_2015a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kistastenen_U75,_2015a.jpg","title":"Kistastenen U75, 2015a"}],"audio":"audio/piper/30dadfa3d092aa69.mp3"},{"name":"Bergengatan","lat":59.408663,"lon":17.930011,"story":"Under fötterna ligger Husby tunnelbanestation, insprängd i berget och öppnad 1977. Konstnären Birgit Broms har målat dess gula väggar med björkstammar och Vaxholmsbåtar, en oväntad skärgårdskänsla mitt i Järva. Ovan jord står Husbykyrkan från 1976, grönmärkt av Stadsmuseet för sitt höga kulturhistoriska värde.","tips":[["Se Birgit Broms björkar och båtar i tunnelbanan","2 min"],["Se Husbykyrkan","2 min"]],"dur":19.6,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/f/fe/Husbykyrkan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Anton Thilander","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Husbykyrkan.jpg","title":"Husbykyrkan"}],"audio":"audio/piper/ccc68925445c2b1b.mp3"},{"name":"Trondheimsgatan","lat":59.410649,"lon":17.927003,"story":"Där Husby står i dag övade militären ända till 1965, för Järvafältet var ett militärt övningsfält. Stadsdelen bildades 1971 och hette först Husby gård. I dag finns här Husbybadet med äventyrsbad, 25-metersbassäng och hopptorn med 1- och 3-metersavsatser.","tips":[["Bada på Husbybadet","4 min"]],"dur":16.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Husbybadet02.jpg/1280px-Husbybadet02.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ulkl","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Husbybadet02.jpg","title":"Husbybadet02"}],"audio":"audio/piper/5bcd2e3fc186bc7e.mp3"},{"name":"Helsingforsgatan","lat":59.413227,"lon":17.923092,"story":"Husbybadet öppnade kring millennieskiftet och lockar med äventyrsbad, bubbelpool och bastu. Lite längre bort ligger Akalla kyrka, med en ovanlig historia: invigd 1976, såld av Svenska kyrkan 2020 till Stockholms katolska stift. I dag är den hemkyrka för den syrianska katolska kyrkan.","tips":[["Bada på Husbybadet","2 min"],["Se Akalla kyrka","4 min"]],"dur":18.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Husbybadet02.jpg/1280px-Husbybadet02.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ulkl","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Husbybadet02.jpg","title":"Husbybadet02"}],"audio":"audio/piper/a02aa5c50e290277.mp3"},{"name":"Stavangergatan","lat":59.414642,"lon":17.924418},{"name":"Sveaborgsgatan","lat":59.417535,"lon":17.916049},{"name":"Akalla","lat":59.415259,"lon":17.913146,"story":"Snart är vi framme vid ändhållplatsen Akalla. Huvudstråket genom Akalla heter Sibeliusgången, efter den finländske kompositören Jean Sibelius, och är 900 meter långt. Längs vägen porlar Bertil Johnsons fontäner från 1976. Men namnet Akalla är känt redan från medeltiden: i Akalla by står Storgården från 1600-talet, i en av Stockholmstraktens bäst bevarade bymiljöer, med 4H-gård och kafé. Tack för att du åkte med!","tips":[["Besök Akalla by med 4H-gård och kafé","4 min"],["Se Akallafontänen längs Sibeliusgången","2 min"]],"dur":26.6,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/3/3f/Akalla_3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Photograph by Henryk Kotowski. User Kotoviski on sv.wikipedia","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Akalla_3.jpg","title":"Akalla 3"},{"src":"https://upload.wikimedia.org/wikipedia/commons/f/f4/Akalla_by1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"No machine-readable author provided. Kotoviski assumed (based on copyright claim","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Akalla_by1.jpg","title":"Akalla by1"},{"src":"https://upload.wikimedia.org/wikipedia/commons/7/7e/Akalla_view_barkarby.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Henryk Kotowski Kotoviski","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Akalla_view_barkarby.jpg","title":"Akalla view barkarby"}],"audio":"audio/piper/dc326e96712baa5a.mp3"}],"looks":[],"from":"Brommaplan","to":"Akalla","variant":"Mot Akalla","color":["#d71d24","#ffffff"],"trips":14,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}