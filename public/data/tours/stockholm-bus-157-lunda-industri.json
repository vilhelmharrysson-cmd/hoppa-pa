{"id":"stockholm-bus-157-lunda-industri","group":"stockholm-bus-157","city":"Stockholm","mode":"bus","line":"157","vehicle":"buss","vehicleLong":"buss","operator":"SL","api":"sl","tab":"","guide":null,"speedKmh":18,"dwellSec":15,"route":[[59.389804,18.042268],[59.387441,18.042926],[59.38601,18.043105],[59.384029,18.0422],[59.381819,18.040723],[59.381195,18.040568],[59.380316,18.040736],[59.380174,18.040611],[59.380072,18.040256],[59.379899,18.037993],[59.380078,18.035253],[59.380096,18.032191],[59.379799,18.027775],[59.379337,18.023327],[59.379391,18.018161],[59.379308,18.016764],[59.378697,18.013062],[59.378206,18.010888],[59.376942,18.007779],[59.376774,18.0065],[59.376954,18.003908],[59.376988,18.000849],[59.377175,17.999235],[59.377568,17.997461],[59.378896,17.993349],[59.379206,17.991592],[59.379271,17.989375],[59.379345,17.98941],[59.37927,17.98938],[59.379229,17.984472],[59.379354,17.982858],[59.379655,17.981607],[59.380828,17.978649],[59.381179,17.977148],[59.381388,17.975552],[59.381403,17.973922],[59.381233,17.972341],[59.380195,17.967971],[59.379742,17.965235],[59.379532,17.962688],[59.379509,17.960155],[59.379619,17.957648],[59.379824,17.955382],[59.380591,17.949767],[59.38127,17.945864],[59.381778,17.939253],[59.381998,17.938587],[59.381837,17.938227],[59.381195,17.938454],[59.380515,17.938472],[59.380146,17.939483],[59.379226,17.940499],[59.37889,17.940097],[59.378488,17.939945],[59.377502,17.94015],[59.377394,17.941334],[59.377126,17.941789],[59.376857,17.941898],[59.376161,17.941463],[59.375599,17.940905],[59.375394,17.93919],[59.374235,17.9393],[59.373092,17.938054],[59.372502,17.937772],[59.37277,17.936186],[59.373449,17.934479],[59.373559,17.934439],[59.373619,17.933159],[59.373859,17.932099],[59.374319,17.931299],[59.375089,17.930719],[59.375639,17.930039],[59.375683,17.930122],[59.375637,17.930017],[59.375984,17.929427],[59.375634,17.928521],[59.375177,17.92825],[59.374701,17.927391],[59.374562,17.926804],[59.374367,17.924915],[59.37416,17.924454],[59.373011,17.923147],[59.372707,17.922634],[59.372441,17.921625],[59.372401,17.920842],[59.372445,17.920321],[59.372734,17.919336],[59.373785,17.917312],[59.376881,17.909713],[59.378352,17.905775],[59.378662,17.905315],[59.379956,17.904587],[59.38049,17.903943],[59.382986,17.898286],[59.384795,17.895122],[59.38565,17.893411],[59.386042,17.892252],[59.386202,17.892178],[59.386183,17.891919],[59.386013,17.891949],[59.385234,17.890704],[59.38429,17.890953],[59.384294,17.890419],[59.385486,17.886458],[59.385548,17.886532],[59.385485,17.886449],[59.38702,17.880481],[59.387445,17.879878],[59.387619,17.87806],[59.388215,17.876066],[59.39014,17.880234],[59.392261,17.876576],[59.39294,17.877863],[59.393784,17.876495],[59.393868,17.87653]],"stops":[{"name":"Danderyds sjukhus","lat":59.389804,"lon":18.042268,"story":"Välkommen ombord på buss 157 mot Lunda industri! Resan tar ungefär 54 minuter. I Inverness låg bryggeriet Inverness brunn mellan 1929 och 1945. Här tillverkades bland annat Sveriges första Club soda. Källan finns kvar vid Stocksundets strand, men vattnet är otjänligt och smakar salt. Närmare hållplatsen låg 1700-talsgården Mörby gård, som gav området namn. Den blev byggnadsminne 1944 men brann ner 1976.","tips":[["Se Roslagsbanans gamla verkstäder i Mörby","2 min"]],"dur":30.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Inverness_k%C3%A4lla_2014.jpg/1280px-Inverness_k%C3%A4lla_2014.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Inverness_k%C3%A4lla_2014.jpg","title":"Inverness källa 2014"},{"src":"https://upload.wikimedia.org/wikipedia/commons/a/ac/M%C3%B6rby_g%C3%A5rd_flygfoto.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:M%C3%B6rby_g%C3%A5rd_flygfoto.JPG","title":"Mörby gård flygfoto"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/M%C3%B6rby_verkst%C3%A4der_2014b.jpg/1280px-M%C3%B6rby_verkst%C3%A4der_2014b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:M%C3%B6rby_verkst%C3%A4der_2014b.jpg","title":"Mörby verkstäder 2014b"}],"audio":"audio/piper/90f9712888fffd41.mp3"},{"name":"Mörbylund","lat":59.387438,"lon":18.042823,"story":"Vid Stocksundets strand låg bryggeriet Inverness brunn, som gjorde Sveriges första Club soda. Källan finns kvar, men vattnet smakar salt. Ett stenkast bort står Calles klimp, en stenhäll med förgylld text. Sägnerna säger att Calle var Karl IX, Karl XII eller Karl XV. Troligen var det en kryddhandlare, Carl Eneroth, som fick den i present på sin födelsedag.","tips":[["Hitta Calles klimp vid vattnet","6 min"],["Se Inverness källa","2 min"]],"dur":21.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Inverness_k%C3%A4lla_2014.jpg/1280px-Inverness_k%C3%A4lla_2014.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Inverness_k%C3%A4lla_2014.jpg","title":"Inverness källa 2014"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Calles_klimp_2014c.jpg/1280px-Calles_klimp_2014c.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Calles_klimp_2014c.jpg","title":"Calles klimp 2014c"}],"audio":"audio/piper/cc594b0b0606c99b.mp3"},{"name":"Bergshamra bro","lat":59.380096,"lon":18.032191,"story":"Hela Bergshamra ligger i Nationalstadsparken. Marken till studentområdet Kungshamra skänktes av kung Gustaf VI Adolf, därav namnet. Vattentornet från 1951 vid Edsviken är ett landmärke på långt håll, och vid Pipers väg står Övre Karlsro, även kallat Carl Malmstens hus.","tips":[["Se Bergshamra vattentorn","5 min"],["Se Carl Malmstens hus, Övre Karlsro","5 min"]],"dur":16.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Kungshamra16.JPG/1280px-Kungshamra16.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Einarspetz","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kungshamra16.JPG","title":"Kungshamra16"}],"audio":"audio/piper/f4850827c5dc26ce.mp3"},{"name":"Ritorp","lat":59.377141,"lon":18.008154,"story":"Ritorp började som ett torp på 1600-talet, och den nuvarande gårdsbyggnaden från 1770-talet beskrivs av Stockholms läns museum som omistlig. Runt omkring finns bebyggelse med charmiga smeknamn: Tornvillan från 1903, Majhillshuset från 1911 och Hästskostallet från 1929, som flyttades 1993. I norra delen märks de så kallade Rödingarna.","tips":[["Ritorps gård","3 min"]],"dur":23.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Ritorps_g%C3%A5rd_2015a.jpg/1280px-Ritorps_g%C3%A5rd_2015a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Ritorps_g%C3%A5rd_2015a.jpg","title":"Ritorps gård 2015a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Kvarteret_Majhill%2C_Ritorp%2C_Solna_2015.jpg/1280px-Kvarteret_Majhill%2C_Ritorp%2C_Solna_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kvarteret_Majhill,_Ritorp,_Solna_2015.jpg","title":"Kvarteret Majhill, Ritorp, Solna 2015"}],"audio":"audio/piper/a7f0977526603e4d.mp3"},{"name":"Bagartorp","lat":59.377383,"lon":17.998428},{"name":"Råstahem","lat":59.379345,"lon":17.98941,"story":"Villaområdet Råstahem kallades ursprungligen Ulriksdals järnvägshem av SJ, och tomterna såldes bara till personer anställda vid Statens Järnvägar. De flesta husen byggdes under andra halvan av 1920-talet och första halvan av 1930-talet. Järnvägen finns kvar nära: Hagalunds bangård är Sveriges största rangerbangård för persontrafik.","tips":[],"dur":20.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/R%C3%A5stahem_2011b.jpg/1280px-R%C3%A5stahem_2011b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:R%C3%A5stahem_2011b.jpg","title":"Råstahem 2011b"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/Hagalunds_bang%C3%A5rd.JPG/1280px-Hagalunds_bang%C3%A5rd.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hagalunds_bang%C3%A5rd.JPG","title":"Hagalunds bangård"}],"audio":"audio/piper/1d8b74e0e3c839fa.mp3"},{"name":"Råsta","lat":59.380828,"lon":17.978649,"story":"Brotorp är Sundbybergs ytmässigt minsta stadsdel, bara tre procent av kommunens yta. Marken disponerades länge av militären, och inte långt härifrån låg Järva skjutfält, ett militärt övningsfält på Järvafältet. I dag är Brotorp Sundbybergs del av det stora stadsbyggnadsprojektet Järvastaden, som delas med Solna.","tips":[],"dur":19.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/25/Akalla_by_minnessten_2015.jpg/1280px-Akalla_by_minnessten_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Akalla_by_minnessten_2015.jpg","title":"Akalla by minnessten 2015"}],"audio":"audio/piper/c51a2f5902f68caa.mp3"},{"name":"Ursvik","lat":59.380163,"lon":17.953293,"story":"Ursvik är egentligen två stadsdelar, Lilla Ursvik och Stora Ursvik. En kort bit härifrån breder Rissne äng ut sig, en stadspark som binder ihop Rissne, Hallonbergen och centrala Sundbyberg. Där trivs flera rödlistade skalbaggar, och sedan 2024 har området förberetts för att bli naturreservat.","tips":[["Rissne äng","6 min"]],"dur":18.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Ursvik_2013.jpg/1280px-Ursvik_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ursvik_2013.jpg","title":"Ursvik 2013"}],"audio":"audio/piper/48cc649a869f67f4.mp3"},{"name":"Oxenstiernas allé","lat":59.38127,"lon":17.945863},{"name":"Rissneleden","lat":59.379733,"lon":17.939841,"story":"I norra delen av Rissne, inte långt härifrån, sover hela blå linjen. I Rissnedepån står nämligen samtliga tunnelbanevagnar som trafikerar blå linjen uppställda, på spår under jord. Mellan 1975 och 1985 användes förbindelsespåret dit även för vanliga passagerare, eftersom sträckan via Huvudsta och Rissne ännu inte var färdig.","tips":[["Rissne torg","5 min"]],"dur":20.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a3/Svea_artilleriregemente_in_Stockholm_2014_%2810%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2810%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(10).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Svea_artilleriregemente_in_Stockholm_2014_%2811%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2811%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(11).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Svea_artilleriregemente_in_Stockholm_2014_%2812%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2812%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(12).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true}],"audio":"audio/piper/d2d1fc889294a99c.mp3"},{"name":"Rissne","lat":59.375525,"lon":17.939917,"story":"Rissne är den enda tunnelbanestationen i Stockholm som har sitt namn ristat med runor. Namnet finns även på en runsten i Sigtuna, rest efter ”Gunnars son i Risnö”. På 1650-talet gjorde ägarna Johan och Beata von Kaulbars Rissne till herrgård med en ståtlig huvudbyggnad i sten. I dag är Rissne gård restaurang och konferensgård.","tips":[],"dur":19.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Svea_artilleriregemente_in_Stockholm_2014_%2804%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2804%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(04).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Svea_artilleriregemente_in_Stockholm_2014_%2806%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2806%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(06).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Svea_artilleriregemente_in_Stockholm_2014_%2805%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2805%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(05).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true}],"audio":"audio/piper/c4e203f77df0746e.mp3"},{"name":"Lavettvägen","lat":59.373338,"lon":17.934885,"story":"En bit härifrån ligger Rissne torg, som tidigare hette Dragonplan och där en åttkantig byggnad blivit stadsdelens landmärke. Djupt därunder, 25 till 40 meter ner i berget, ligger tunnelbanestationen Rissne, vars konstnärliga utsmyckning är en textad tidsaxel med historiska händelser från 3000 före Kristus fram till 1985, året då stationen öppnade. Konstverket gjordes av Madeleine Dranger och Rolf H Reimers.","tips":[["Rissne torg","6 min"]],"dur":24.7,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/2/2f/Rissne_torg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Axeloi","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Rissne_torg.jpg","title":"Rissne torg"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e4/Rissne_T-bana_2026.jpg/1280px-Rissne_T-bana_2026.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"HartOve","license":"CC BY 4.0","page":"https://commons.wikimedia.org/wiki/File:Rissne_T-bana_2026.jpg","title":"Rissne T-bana 2026"}],"audio":"audio/piper/a22bd374cb34137d.mp3"},{"name":"Rissne IP","lat":59.375683,"lon":17.930122,"story":"Där bostadsområdet Rissne ligger i dag huserade förr militären. Svea artilleriregemente hade sin förläggning här fram till 1963, och därefter höll Tygförvaltningsskolan till i området fram till 1977. Först 1982 till 1988 byggdes flerfamiljshusen. Torget hette passande nog Dragonplan innan det döptes om till Rissne torg.","tips":[["Rissne torg","8 min"]],"dur":21.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/Rissne_gard.JPG/1280px-Rissne_gard.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Toyah","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Rissne_gard.JPG","title":"Rissne gard"},{"src":"https://upload.wikimedia.org/wikipedia/commons/2/2f/Rissne_torg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Axeloi","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Rissne_torg.jpg","title":"Rissne torg"}],"audio":"audio/piper/fe28927c26bd5096.mp3"},{"name":"Gamla Bromstensvägen","lat":59.373173,"lon":17.918637,"story":"Ett par stenkast bort, i Sundby, ligger två runhällar sida vid sida: U 80, en stor och påkostad runhäll, och U 81, som aldrig blev färdig. Stadsdelen Sundby räknas till Gamla Spånga och namnet är känt ända sedan 1312, även om själva stadsdelen bildades först 1953, på mark som Stockholms stad hade köpt från Spånga 1949.","tips":[["Runhällarna U 80 och U 81","2 min"]],"dur":22.4,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/7/7b/Runsten_Uppland_80.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"User:Mceder","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Runsten_Uppland_80.jpg","title":"Runsten Uppland 80"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Sundby_U_81_r%C3%A4ttv%C3%A4nd.jpeg/1280px-Sundby_U_81_r%C3%A4ttv%C3%A4nd.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Björn Persson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sundby_U_81_r%C3%A4ttv%C3%A4nd.jpeg","title":"Sundby U 81 rättvänd"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/20130202_Stockholm_Sk%C3%A4rg%C3%A5rd_%281%29.jpg/1280px-20130202_Stockholm_Sk%C3%A4rg%C3%A5rd_%281%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Belola80","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:20130202_Stockholm_Sk%C3%A4rg%C3%A5rd_(1).jpg","title":"20130202 Stockholm Skärgård (1)"}],"audio":"audio/piper/ffed0abe93439201.mp3"},{"name":"Herdevägen","lat":59.37598,"lon":17.912081},{"name":"Spångavägen","lat":59.378057,"lon":17.906783,"story":"I trakten finns gott om runor. Vid Sundby ligger U 80, en stor och påkostad runhäll, och strax intill den en ofullbordad runhäll, U 81. Flysta hade också en vikingatida runsten, men den har eftersökts flera gånger och är troligen förkommen. I Bromstens industriområde fanns Fascinate, Sveriges äldsta bevarade större graffitimålning, ända tills väggen revs i början av december 2021.","tips":[],"dur":23.8,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/7/7b/Runsten_Uppland_80.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"User:Mceder","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Runsten_Uppland_80.jpg","title":"Runsten Uppland 80"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Sundby_U_81_r%C3%A4ttv%C3%A4nd.jpeg/1280px-Sundby_U_81_r%C3%A4ttv%C3%A4nd.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Björn Persson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sundby_U_81_r%C3%A4ttv%C3%A4nd.jpeg","title":"Sundby U 81 rättvänd"},{"src":"https://upload.wikimedia.org/wikipedia/commons/9/91/Upplands_runinskrifter_70.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Johan Leitz och Johan Hadorph","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Upplands_runinskrifter_70.png","title":"Upplands runinskrifter 70"}],"audio":"audio/piper/a4b4bd14d05f6bd7.mp3"},{"name":"Spånga station","lat":59.38244,"lon":17.899602,"story":"Namnet Spånga finns i skrift redan år 1300, som ”apud Ecclesiam spangar”. Det kommer från den gamla kyrkbyn och betyder helt enkelt spångar, flera smala gångbroar. Stationen ligger vid Mälarbanan, drygt elva kilometer från Centralen. En bit bort ligger Svandammen, en park med badplats där både ungdomar och barnfamiljer brukar samlas.","tips":[["Promenera till parken och badplatsen Svandammen","5 min"]],"dur":20.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Sp%C3%A5nga%2C_flygfoto_2014-09-20.jpg/1280px-Sp%C3%A5nga%2C_flygfoto_2014-09-20.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sp%C3%A5nga,_flygfoto_2014-09-20.jpg","title":"Spånga, flygfoto 2014-09-20"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Sp%C3%A5nga_station_-_fr%C3%A5n_plattformen.jpg/1280px-Sp%C3%A5nga_station_-_fr%C3%A5n_plattformen.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bengt bäverman","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sp%C3%A5nga_station_-_fr%C3%A5n_plattformen.jpg","title":"Spånga station - från plattformen"},{"src":"https://pub.raa.se/dokumentation/3697e14a-f999-4d4b-836c-2dd43d6b406c/visning/1","credit":"Wallenberg, Berit","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/3697e14a-f999-4d4b-836c-2dd43d6b406c","title":"\"Röse mellan Spånga station och Nälsta\"","old":true,"year":1930,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/8b951388e04b8125.mp3"},{"name":"Salagatan","lat":59.384735,"lon":17.890812,"story":"Ett stycke härifrån slingrar sig Bällstaån, som i sitt övre lopp också kallas Spångaån. Den börjar på ett berg i Viksjö och har en riktigt äventyrlig färd: under Spånga leds den i en cirka 1,4 kilometer lång tunnel, och längre fram korsar den Solvalla travbana på längden, mitt i banans grönområde.","tips":[["Bällstaån","5 min"]],"dur":17.5,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/e/e5/B%C3%A4llsta%C3%A5n_070611.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Mats Halldin 20:49, 11 June 2007 (UTC)","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:B%C3%A4llsta%C3%A5n_070611.JPG","title":"Bällstaån 070611"}],"audio":"audio/piper/89ce7890faef059a.mp3"},{"name":"Kälvestavägen","lat":59.385548,"lon":17.886532,"story":"En bit härifrån ligger Lundadepån, en av SL:s bussdepåer, som togs i bruk 2009. Där finns plats för 75 bussar och verkstäder, och sedan augusti 2024 körs trafiken därifrån av Keolis. Lite närmare står något mycket äldre: Kälvesta kvarn, en väderkvarn från 1600-talet som har flyttats hit från Observatoriegatan inne i Stockholm.","tips":[["Kälvesta kvarn","4 min"]],"dur":22.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Equipment_used_to_document_the_solar_eclipse_%2851238699758%29.jpg/1280px-Equipment_used_to_document_the_solar_eclipse_%2851238699758%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"EchelonForce","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Equipment_used_to_document_the_solar_eclipse_(51238699758).jpg","title":"Equipment used to document the solar eclipse of 2021 June 10 in Stockholm, Sweden.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3f/Equipment_used_to_document_the_solar_eclipse_%2851237785427%29.jpg/1280px-Equipment_used_to_document_the_solar_eclipse_%2851237785427%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"EchelonForce","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Equipment_used_to_document_the_solar_eclipse_(51237785427).jpg","title":"Equipment used to document the solar eclipse of 2021 June 10 in Stockholm, Sweden.","near":true}],"audio":"audio/piper/3f0736f123351e33.mp3"},{"name":"Avestagatan","lat":59.386922,"lon":17.88105,"story":"Bara ett par minuters promenad härifrån står Kälvesta kvarn, en väderkvarn från 1600-talet som också går under namnen Lilla Stampan och Lunda kvarn. Stadsmuseet har blåmärkt den, den högsta kulturhistoriska klassningen som finns, eftersom den bedöms ha ett synnerligen högt kulturhistoriskt värde. Inte illa för en kvarn som började sitt liv vid Observatoriegatan i innerstan.","tips":[["Kälvesta kvarn","3 min"]],"dur":20.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2d/Stj%C3%A4rnornas_stj%C3%A4rna.jpg/1280px-Stj%C3%A4rnornas_stj%C3%A4rna.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Stj%C3%A4rnornas_stj%C3%A4rna.jpg","title":"Stjärnornas stjärna-studion","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2d/Kadiatou.jpg/1280px-Kadiatou.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Gingher","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kadiatou.jpg","title":"Kadiatou under Idol 2018, precis innan hon sjunger \"Say something\"","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Kadiatou2.jpg/1280px-Kadiatou2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Gingher","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kadiatou2.jpg","title":"Kadiatou träffar fans under Idolomgången","near":true}],"audio":"audio/piper/005044f790f414c2.mp3"},{"name":"Finspångsgatan","lat":59.388986,"lon":17.877831,"story":"Mellan Hjulsta och Lunda ligger Hjulsta koloniträdgård, en förening som bildades 1973 och i dag är ett exempel på mångkulturella odlingsområden. Lunda självt domineras av arbets- och industriområden. Den gamla väderkvarnen Kälvesta kvarn kallas förresten också Lunda kvarn, och stod faktiskt i Lunda en tid efter 1884.","tips":[["Kälvesta kvarn","7 min"]],"dur":19.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Hjulsta_koloni_2010a.jpg/1280px-Hjulsta_koloni_2010a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hjulsta_koloni_2010a.jpg","title":"Hjulsta koloni 2010a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Lunda_industriomr%C3%A5de_1.jpg/1280px-Lunda_industriomr%C3%A5de_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bengt bäverman","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Lunda_industriomr%C3%A5de_1.jpg","title":"Lunda industriområde 1"}],"audio":"audio/piper/7d1e27a8ba33892b.mp3"},{"name":"Domnarvsgatan","lat":59.392011,"lon":17.877052},{"name":"Lunda industri","lat":59.393868,"lon":17.87653,"story":"Snart är vi framme vid ändhållplatsen Lunda industri. Tack för att du åkte med!","tips":[],"dur":4.8,"audio":"audio/piper/6fd03126d76785df.mp3"}],"looks":[],"from":"Danderyds sjukhus","to":"Lunda industri","variant":"Mot Lunda industri","color":["#d71d24","#ffffff"],"trips":45,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}