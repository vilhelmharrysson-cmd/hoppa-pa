,[59.238835,17.98074],[59.238716,17.981259],[59.238548,17.981319],[59.236006,17.977665],[59.235595,17.97673],[59.235926,17.976325],[59.23595,17.975754],[59.235798,17.975321],[59.235536,17.97502],[59.235515,17.974683],[59.235711,17.974114],[59.236063,17.97367],[59.236344,17.973686],[59.236561,17.973991],[59.236645,17.974462],[59.236551,17.974818],[59.23587,17.974632],[59.2342,17.973448],[59.233252,17.972255],[59.231402,17.967864],[59.229125,17.963441],[59.227361,17.959077],[59.226642,17.957561],[59.221169,17.948807],[59.220895,17.948328],[59.220946,17.948218],[59.220894,17.948327],[59.220045,17.946819],[59.219928,17.946293],[59.220002,17.945257],[59.220251,17.944261],[59.220691,17.943047],[59.22083,17.942938],[59.222363,17.938594],[59.223489,17.935813],[59.223487,17.93546],[59.224761,17.931887],[59.225294,17.931183],[59.225842,17.930944],[59.226394,17.934561],[59.226665,17.93533],[59.227033,17.935958],[59.227953,17.936778],[59.230963,17.937915],[59.231059,17.936457],[59.23131,17.934788],[59.232834,17.930299],[59.234725,17.920609],[59.236658,17.914758],[59.237984,17.910189],[59.241109,17.897923],[59.244726,17.889036],[59.245853,17.886542],[59.247174,17.883802],[59.248797,17.881538],[59.249617,17.879713],[59.249944,17.878839],[59.250117,17.878058],[59.250532,17.875866],[59.25055,17.87445],[59.25038,17.87344],[59.249705,17.871152],[59.249573,17.869413],[59.250084,17.865639],[59.250313,17.865238],[59.250331,17.864938],[59.250177,17.864663],[59.249569,17.864488],[59.249006,17.863765],[59.248471,17.86222],[59.248552,17.861892],[59.24833,17.861527],[59.248102,17.860809],[59.248015,17.860803],[59.247679,17.861747],[59.248472,17.863371],[59.249041,17.865543],[59.249347,17.865138],[59.249569,17.864488],[59.249897,17.864885],[59.250036,17.865344],[59.250275,17.865322],[59.250317,17.864423],[59.250671,17.862591],[59.251312,17.859795],[59.251573,17.859437],[59.251604,17.858788],[59.252385,17.856175],[59.252635,17.854836],[59.252659,17.853923],[59.252786,17.853174],[59.25236,17.851792],[59.251902,17.850784],[59.250214,17.848816],[59.249785,17.848031],[59.249384,17.846746],[59.249154,17.84465],[59.249738,17.835791],[59.249812,17.835806],[59.249738,17.835792],[59.249985,17.830457],[59.250636,17.830467],[59.250959,17.830029],[59.251891,17.826226],[59.252006,17.824965],[59.244302,17.823284],[59.244032,17.824406],[59.243924,17.825929],[59.243941,17.826135],[59.244082,17.826118],[59.244218,17.825291]],"stops":[{"name":"Skarpnäck","lat":59.263876,"lon":18.13259,"story":"Välkommen ombord på buss 172 mot Hallunda centrum! Resan tar ungefär 94 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":9.7,"audio":"audio/piper/bb997e3b1eb371d9.mp3"},{"name":"Horisontvägen","lat":59.26558,"lon":18.12637,"story":"Skarpnäcks tunnelbanestation, en kort promenad bort, blev den hundrade stationen i nätet när den invigdes den 15 augusti 1994. Den ligger i ett bergrum 25 meter under marken, och konstnären Richard Nonas har smyckat den med 17 bänkliknande skulpturer. Ännu närmare ligger Skarpnäcks folkhögskola, som är Stockholms största folkhögskola.","tips":[["Skarpnäcks tunnelbanestation","6 min"]],"dur":20.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0e/Skarpnack_T_bana_perrong.jpg/1280px-Skarpnack_T_bana_perrong.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Xauxa Håkan Svensson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skarpnack_T_bana_perrong.jpg","title":"Skarpnack T bana perrong"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Skarpn%C3%A4cks_folkh%C3%B6gskola.jpg/1280px-Skarpn%C3%A4cks_folkh%C3%B6gskola.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skarpn%C3%A4cks_folkh%C3%B6gskola.jpg","title":"Skarpnäcks folkhögskola"}],"audio":"audio/piper/dbe73d608bde2f84.mp3"},{"name":"Norra Sköndal","lat":59.261258,"lon":18.111549,"story":"En bit härifrån ligger Skarpnäcksfältet, som en gång var ett flygfält. Här kördes under många år motortävlingen Skarpnäcksloppet, och den sista flyguppvisningen hölls i augusti 1980. Sedan dess har fältet fått ett bostadsområde. Närmare till hands ligger Gubbängens företagsområde, även kallat Norra Sköndals industriområde, ett av stadens minsta.","tips":[],"dur":21.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Skarpnack_allee_2.jpg/1280px-Skarpnack_allee_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skarpnack_allee_2.jpg","title":"Skarpnack allee 2"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Gubb%C3%A4ngens_f%C3%B6retagsomr%C3%A5de%2C_april_2020.jpg/1280px-Gubb%C3%A4ngens_f%C3%B6retagsomr%C3%A5de%2C_april_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Gubb%C3%A4ngens_f%C3%B6retagsomr%C3%A5de,_april_2020.jpg","title":"Gubbängens företagsområde, april 2020"}],"audio":"audio/piper/8f638e1c7edc8771.mp3"},{"name":"Söndagsvägen","lat":59.260186,"lon":18.095265,"story":"Stadsdelen Gubbängen har fått sitt namn efter Gubbängens gård, ett torp som senare blev en självständig bondgård och som revs 1965. I närheten breder Gubbängsparken ut sig, en landskapspark på närmare tolv hektar med parklek. En bit bort, söder om Skogskyrkogården, ligger Södra judiska begravningsplatsen, som togs i bruk 1952.","tips":[["Gubbängsparken","5 min"]],"dur":19.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Gubb%C3%A4ngsparken.jpg/1280px-Gubb%C3%A4ngsparken.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Gubb%C3%A4ngsparken.jpg","title":"Gubbängsparken"}],"audio":"audio/piper/e70c30565ab93800.mp3"},{"name":"Hökarängen","lat":59.258356,"lon":18.082921,"story":"Hökarängen var en av de första förorterna som växte upp längs den nya tunnelbanan efter andra världskriget, och den bilfria centrumanläggningen av David Helldén blev förebild för förorter över hela Sverige. Alldeles intill ligger Farsta brandstation, som från början hette Enskede brandstation. Och Gubbängshallens ljusa, bågformade tak syns långt över Gubbängsfältet.","tips":[["Gubbängshallen","5 min"]],"dur":19.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/H%C3%B6kar%C3%A4ngens_centrum_2012b.jpg/1280px-H%C3%B6kar%C3%A4ngens_centrum_2012b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"ArildV","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6kar%C3%A4ngens_centrum_2012b.jpg","title":"Hökarängens centrum 2012b"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Farsta_brandstation_2015.jpg/1280px-Farsta_brandstation_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Farsta_brandstation_2015.jpg","title":"Farsta brandstation 2015"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Gubb%C3%A4ngshallen%2C_juli_2016_01.jpg/1280px-Gubb%C3%A4ngshallen%2C_juli_2016_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Gubb%C3%A4ngshallen,_juli_2016_01.jpg","title":"Gubbängshallen, juli 2016 01"}],"audio":"audio/piper/221392fb930b31a9.mp3"},{"name":"Selaövägen","lat":59.261934,"lon":18.060238,"story":"Högdalens industriområde har av Stockholms stad utnämnts till stadens viktigaste tekniska försörjningsområde. Mitt i området står Högdalenverket, som eldar avfall och gör om det till el och fjärrvärme. När det togs i drift 1970 producerade det bara el, fjärrvärmen kom 1979. En bit bort ligger Gubbängens IP, som förr i tiden var känt för speedway med bilar.","tips":[["Gubbängens IP","6 min"]],"dur":21.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/H%C3%B6gdalens_industriomr%C3%A5de_mars_2011.jpg/1280px-H%C3%B6gdalens_industriomr%C3%A5de_mars_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6gdalens_industriomr%C3%A5de_mars_2011.jpg","title":"Högdalens industriområde mars 2011"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/H%C3%B6gdalsverket_2011b.jpg/1280px-H%C3%B6gdalsverket_2011b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6gdalsverket_2011b.jpg","title":"Högdalsverket 2011b"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Gubb%C3%A4ngens_IP%2C_2016a.jpg/1280px-Gubb%C3%A4ngens_IP%2C_2016a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Gubb%C3%A4ngens_IP,_2016a.jpg","title":"Gubbängens IP, 2016a"}],"audio":"audio/piper/0bc0f0a1bdc3c644.mp3"},{"name":"Högdalen","lat":59.26324,"lon":18.04206,"story":"Inte långt härifrån reser sig tre konstgjorda berg av rivningsmassor och grovsopor. Det första, Högdalstoppen, var klart 1964, och berget där var tidigare den högsta punkten i Högdalen och Fagersjö. I dag är topparna friluftsområde med skatepark och discgolfbana. Högdalstoppen 3 fylls fortfarande på med schaktmassor från vägbyggen.","tips":[],"dur":20.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/H%C3%B6gdalens_tunnelbanestation.jpg/1280px-H%C3%B6gdalens_tunnelbanestation.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6gdalens_tunnelbanestation.jpg","title":"Högdalen metro station","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/47/H%C3%B6gdalen_Harpsundsv%C3%A4gen%2C_2016b.jpg/1280px-H%C3%B6gdalen_Harpsundsv%C3%A4gen%2C_2016b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6gdalen_Harpsundsv%C3%A4gen,_2016b.jpg","title":"Högdalen Harpsundsvägen \"Tupphuset\"","near":true},{"src":"https://pub.raa.se/dokumentation/724f5067-f3ab-4c7f-9020-aa8065e2f0af/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/724f5067-f3ab-4c7f-9020-aa8065e2f0af","title":"Högdalen vattentorn","old":true,"year":1968,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/b2d3ae6e04150e30.mp3"},{"name":"Rågsved","lat":59.256561,"lon":18.026776,"story":"Ute på plattformen vid Rågsveds station står bronsskulpturen Fågel Grön av Björn Selder. En bit härifrån, i Högdalen, finns kulturhuset Cyklopen, som drivs helt ideellt av föreningen Kulturkampanjen. Det första Cyklopen stod klart 2007 men brändes ner i november 2008 i en anlagd brand av misstänkta nazister. Föreningen gav inte upp, utan byggde ett nytt.","tips":[],"dur":21.9,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/2/23/Cyklopen.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Qvarten","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Cyklopen.jpg","title":"Cyklopen"}],"audio":"audio/piper/e4f417fa864c423b.mp3"},{"name":"Ågestavägen","lat":59.251411,"lon":18.009691},{"name":"Huddinge gymnasium","lat":59.244832,"lon":17.996815,"story":"Uppe på Kvarnberget snurrade en gång Stuvsta gårds väderkvarn, och det är den som gett hela området Kvarnbergsplan dess namn. Flera kvarnstenar finns bevarade, och en av dem har kommunen placerat vid Gymnasievägen. Där ligger också Huddingegymnasiet, vars skolhus räknas som en av kommunens särskilt värdefulla byggnader.","tips":[["Huddingegymnasiet","2 min"]],"dur":17.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Huddingegymnasiet.jpg/1280px-Huddingegymnasiet.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Huddingegymnasiet.jpg","title":"Huddingegymnasiet"}],"audio":"audio/piper/6690f3f4922bc9da.mp3"},{"name":"Huddinge station","lat":59.236523,"lon":17.978319,"story":"Pendeltågen stannar vid Huddinge centrum, kommunens hjärta och handelscentrum. Längs Kommunalvägen, som löper nästan parallellt med Västra stambanans spår i cirka 1,3 kilometer, ligger både Huddinge kyrka och kommunalhuset. I närheten finns också spåren av Svartlösa domsaga, vars tingshus ritades 1959 av arkitekten Karl Karlström – domsagan blev bara tolv år gammal och upplöstes vid tingsrättsreformen 1971.","tips":[["Huddinge centrum","4 min"]],"dur":25.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Huddinge_centrum_2010b.jpg/1280px-Huddinge_centrum_2010b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_centrum_2010b.jpg","title":"Huddinge centrum 2010b"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg/1280px-Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg","title":"Nyboda museum Kommunalvägen 2013"},{"src":"https://pub.raa.se/dokumentation/06e8db91-217b-48d0-9409-532f39e50d76/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/06e8db91-217b-48d0-9409-532f39e50d76","title":"Bygget av Karolinska Universitetssjukhuset i Huddinge. Huddingevägen, Flemmingsberg, Visättra","old":true,"year":1970,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/659b936357823273.mp3"},{"name":"Flemingsbergs station","lat":59.220946,"lon":17.948218,"story":"En bit härifrån låg LM Ericssons centrallager, byggt mellan 1965 och 1975. Godshanteringen var så automatiserad att lagret blev en sevärdhet. Åt andra hållet syns Grantorp, där de färgglada höghusen från miljonprogrammets tidiga 1970-tal blivit ett känt inslag i stadsbilden. Kommunen klassar dem i dag som särskilt värdefull kulturmiljö.","tips":[],"dur":22.0,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/b/be/LM_Ericssons_centrallager_Flemingsberg%2C_modellfoto.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:LM_Ericssons_centrallager_Flemingsberg,_modellfoto.jpg","title":"LM Ericssons centrallager Flemingsberg, modellfoto"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/Solg%C3%A5rds_fornborg_maj_2018d.jpg/1280px-Solg%C3%A5rds_fornborg_maj_2018d.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Solg%C3%A5rds_fornborg_maj_2018d.jpg","title":"Solgårds fornborg maj 2018d"}],"audio":"audio/piper/00aa91ae0dcb4ea7.mp3"},{"name":"Södertörns högskola","lat":59.220587,"lon":17.943347,"story":"Runt 14 000 studenter läser vid Södertörns högskola, som bland annat har polisutbildning och lärarutbildning med interkulturell profil. Mycket av forskningen handlar om Östersjön och Östeuropa, och den stöds av Östersjöstiftelsen, som regeringen bildade 1994. Biblioteket är öppet för alla, och strax intill ligger Flemingsbergsparken, som vann Huddinges byggnadspris 2021.","tips":[["Flemingsbergsparken","2 min"]],"dur":22.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fb/S%C3%B6dert%C3%B6rns_h%C3%B6gskola_Moas_b%C3%A5ge.jpg/1280px-S%C3%B6dert%C3%B6rns_h%C3%B6gskola_Moas_b%C3%A5ge.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Okänd","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:S%C3%B6dert%C3%B6rns_h%C3%B6gskola_Moas_b%C3%A5ge.jpg","title":"Södertörns högskola Moas båge"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/S%C3%B6dert%C3%B6rns_h%C3%B6gskolebibliotek_p%C3%A5_kv%C3%A4llen.jpg/1280px-S%C3%B6dert%C3%B6rns_h%C3%B6gskolebibliotek_p%C3%A5_kv%C3%A4llen.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"No machine-readable author provided. Kalle1~commonswiki assumed (based on copyri","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:S%C3%B6dert%C3%B6rns_h%C3%B6gskolebibliotek_p%C3%A5_kv%C3%A4llen.jpg","title":"Södertörns högskolebibliotek på kvällen"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Flemingsbergsparken%2C_okt_2021a.jpg/1280px-Flemingsbergsparken%2C_okt_2021a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Flemingsbergsparken,_okt_2021a.jpg","title":"Flemingsbergsparken, okt 2021a"}],"audio":"audio/piper/c2e06a65164fc9d5.mp3"},{"name":"Huddinge sjukhus","lat":59.2228,"lon":17.937617,"story":"Alldeles intill ligger Röda Korsets Högskola, Sveriges äldsta sekulära sjuksköterskeutbildning. Den grundades 1867 av Emmy Rappe, som själv hade utbildats av ingen mindre än Florence Nightingale i London. Skolan började i Uppsala och fanns länge vid Sabbatsbergs sjukhus innan den hamnade här. En kort bit bort ligger Flemingsbergs kyrka, invigd 1976.","tips":[["Röda Korsets Högskola","1 min"],["Flemingsbergs kyrka","2 min"]],"dur":23.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Swedish_Red_Cross_University_at_Campus_Flemingsberg%2C_H%C3%A4lsov%C3%A4gen_11_in_Huddinge_Stockholm.jpg/1280px-Swedish_Red_Cross_University_at_Campus_Flemingsberg%2C_H%C3%A4lsov%C3%A4gen_11_in_Huddinge_Stockholm.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"RKH18","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Swedish_Red_Cross_University_at_Campus_Flemingsberg,_H%C3%A4lsov%C3%A4gen_11_in_Huddinge_Stockholm.jpg","title":"Swedish Red Cross University at Campus Flemingsberg, Hälsovägen 11 in Huddinge Stockholm"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Flemingsbergs_kyrka_2013.jpg/1280px-Flemingsbergs_kyrka_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Flemingsbergs_kyrka_2013.jpg","title":"Flemingsbergs kyrka 2013"}],"audio":"audio/piper/303090b24beba269.mp3"},{"name":"Kästadalsvägen","lat":59.22795,"lon":17.936852,"story":"En bit bort ligger Kästadalsparken, en lekpark i villaområdet Kästa där allt är inspirerat av sagornas värld. Flemingsbergs kyrka byggdes 1975–1976 efter ritningar av Gunnar Cedervall och invigdes av biskop Ingmar Ström i augusti 1976. I närheten stod också Hagstaeken, Huddinges största naturminnesmärkta ek, tills den fälldes i december 2025.","tips":[["Flemingsbergs kyrka","6 min"]],"dur":22.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7c/K%C3%A4stadalsparken%2C_K%C3%A4sta%2C_Huddinge_kommun%2C_maj_2019c.jpg/1280px-K%C3%A4stadalsparken%2C_K%C3%A4sta%2C_Huddinge_kommun%2C_maj_2019c.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:K%C3%A4stadalsparken,_K%C3%A4sta,_Huddinge_kommun,_maj_2019c.jpg","title":"Kästadalsparken, Kästa, Huddinge kommun, maj 2019c"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Flemingsbergs_kyrka_2013.jpg/1280px-Flemingsbergs_kyrka_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Flemingsbergs_kyrka_2013.jpg","title":"Flemingsbergs kyrka 2013"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Hagstaeken_2019b.jpg/1280px-Hagstaeken_2019b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hagstaeken_2019b.jpg","title":"Hagstaeken 2019b"}],"audio":"audio/piper/3c48f9ca6d6a8e66.mp3"},{"name":"Gustav Adolfsvägen","lat":59.237771,"lon":17.911316,"story":"Bara ett par hundra meter bort, nära Glömstavägen, ligger Glömstahällen, en runhäll i Glömstadalen. Glömsta blev en egen kommundel så sent som 2018 och hörde dessförinnan till Flemingsberg. Bebyggelsen omger sjön Gömmaren, och det som en gång var ett gammalt fritidshusområde förtätas nu sakta med nya hus.","tips":[["Glömstahällen","5 min"]],"dur":18.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Glomstastenen_2008a.jpg/1280px-Glomstastenen_2008a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Glomstastenen_2008a.jpg","title":"Glomstastenen 2008a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Gl%C3%B6msta_g%C3%A5rd_2016.jpg/1280px-Gl%C3%B6msta_g%C3%A5rd_2016.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Gl%C3%B6msta_g%C3%A5rd_2016.jpg","title":"Glömsta gård 2016"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/Lillerudsv%C3%A4gen%2C_Gl%C3%B6msta%2C_2016.jpg/1280px-Lillerudsv%C3%A4gen%2C_Gl%C3%B6msta%2C_2016.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Lillerudsv%C3%A4gen,_Gl%C3%B6msta,_2016.jpg","title":"Lillerudsvägen, Glömsta, 2016"}],"audio":"audio/piper/32a958c050e4bf2c.mp3"},{"name":"Masmo","lat":59.249944,"lon":17.878839,"story":"Vid Albysjöns strand, ett par hundra meter bort, ligger Hagalunds tvätterimuseum – när det öppnade 1994 var det Sveriges första museum med tvätteri som tema. Det startades på initiativ av huddingekonstnären Olle Magnusson och är inrymt i en tvättarfamiljs torklada från 1906. Över Albysjön bär en bro tunnelbanans röda linje, och ovanför området reser sig Masmoberget, 94 meter över havet.","tips":[["Hagalunds tvätterimuseum","4 min"]],"dur":23.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/Tv%C3%A4ttmuseum_maj_2012a.jpg/1280px-Tv%C3%A4ttmuseum_maj_2012a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Tv%C3%A4ttmuseum_maj_2012a.jpg","title":"Tvättmuseum maj 2012a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Tunnelbanans_bro_Albysj%C3%B6n_2015.jpg/1280px-Tunnelbanans_bro_Albysj%C3%B6n_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Tunnelbanans_bro_Albysj%C3%B6n_2015.jpg","title":"Tunnelbanans bro Albysjön 2015"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/55/Myrstuguberget_2013a.jpg/1280px-Myrstuguberget_2013a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Myrstuguberget_2013a.jpg","title":"Myrstuguberget 2013a"}],"audio":"audio/piper/9e7afd45e3f1cc52.mp3"},{"name":"Fittja","lat":59.248287,"lon":17.86123,"story":"På tunnelbanestationen står ett exemplar av Carl Fredrik Reuterswärds skulptur Den knutna revolvern – det mest berömda exemplaret står utanför FN:s högkvarter i New York. Ett par hundra meter bort ligger Fittja gård, vars värdshus under 1600- och 1700-talen var ett av Sveriges största gästgiverier, och där en av byggnaderna var tingshus ända till 1916. I dag har Mångkulturellt centrum sin verksamhet på gården.","tips":[["Fittja gård","4 min"]],"dur":24.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/Stockholm_subway_fittja_20060913_001.jpg/1280px-Stockholm_subway_fittja_20060913_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jonas Bergsten","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Stockholm_subway_fittja_20060913_001.jpg","title":"Stockholm subway fittja 20060913 001"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Fittja_g%C3%A5rd_huvudbyggnad%2C_2014a.jpg/1280px-Fittja_g%C3%A5rd_huvudbyggnad%2C_2014a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Fittja_g%C3%A5rd_huvudbyggnad,_2014a.jpg","title":"Fittja gård huvudbyggnad, 2014a"},{"src":"https://pub.raa.se/dokumentation/f22dd8ee-e6e8-4f02-917b-d66cd5ddebb3/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/f22dd8ee-e6e8-4f02-917b-d66cd5ddebb3","title":"Fittja","old":true,"year":1970,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/13cb3b2dd5e9300a.mp3"},{"name":"Brunnaskolan","lat":59.249812,"lon":17.835806,"story":"Sporthallen en kort promenad bort, Botkyrkahallen, har både kunglig glans och vardagsnytta: den invigdes av kung Carl XVI Gustaf sommaren 2000 och fungerar samtidigt som idrottshall för Brunnaskolan. Här spelar Balrog IK:s herrlag inför upp till 1 500 åskådare. En bit åt andra hållet ligger Slagsta gård, en anrik herrgård och tidigare säteri.","tips":[["Botkyrkahallen","4 min"]],"dur":21.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Botkyrkahallen_September_2014_01.jpg/1280px-Botkyrkahallen_September_2014_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Arild Vågen","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Botkyrkahallen_September_2014_01.jpg","title":"Botkyrkahallen September 2014 01"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Slagsta_g%C3%A5rd_2009b.jpg/1280px-Slagsta_g%C3%A5rd_2009b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Slagsta_g%C3%A5rd_2009b.jpg","title":"Slagsta gård 2009b"}],"audio":"audio/piper/2ce8af8f782e76c4.mp3"},{"name":"Tomtbergavägen","lat":59.250021,"lon":17.831322,"story":"Botkyrkahallen, några minuter härifrån, invigdes sommaren 2000 av kung Carl XVI Gustaf och är hemmaplan för Balrog IK:s herrlag. En bit bort ligger S:t Botvids gymnasium, mest känt för sin nycirkusutbildning tillsammans med Cirkus Cirkör. Bland skolans tidigare elever finns artisten Dogge Doggelito och politikern Ibrahim Baylan.","tips":[["Botkyrkahallen","6 min"],["Ljusets kyrka","8 min"]],"dur":19.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Skolan.jpg/1280px-Skolan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Mats Lönn","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Skolan.jpg","title":"Skolan"}],"audio":"audio/piper/c5e5cbd92a7c0049.mp3"},{"name":"Borgskolan","lat":59.248589,"lon":17.824153,"story":"Hallunda var en levande jordbruksbygd ända tills miljonprogrammet kom i början av 1970-talet och Botkyrkastaden byggdes på gårdens mark. Själva Hallunda gård, en herrgård från 1700-talet en bit härifrån, undantogs dock i stadsplanen och är fortfarande privatägd – ett av få gamla herresäten i Stockholmstrakten där det är så. Intill gården finns ett stort gravfält från järnåldern.","tips":[["Hallunda centrum","6 min"]],"dur":21.1,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/9/91/Hallunda_g%C3%A5rd_1964.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Alf Nordström","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Hallunda_g%C3%A5rd_1964.jpg","title":"Hallunda gård 1964"}],"audio":"audio/piper/45ab1ce1b4f96115.mp3"},{"name":"Hallunda centrum","lat":59.244218,"lon":17.825291,"story":"Snart är vi framme vid ändhållplatsen Hallunda centrum. Kring köpcentrumet i norra Botkyrka finns ett ovanligt tätt kyrkligt grannskap. Botkyrka folkhögskola, startad 1997, ägs av fem kristna församlingar, tre av dem syrisk-ortodoxa, men är öppen för alla oavsett religion. Ljusets kyrka på Tomtbergavägen är granne med den syrisk-ortodoxa Sankt Petrus och Paulus kyrka, och Hallundakyrkan ligger nästan vägg i vägg med centrumet. Tack för att du åkte med!","tips":[["Hallunda Folkets hus","3 min"],["Ljusets kyrka","5 min"]],"dur":27.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Halundachurch.jpg/1280px-Halundachurch.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Adville","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Halundachurch.jpg","title":"Halundachurch"}],"audio":"audio/piper/7a6b13e2c8a02ed2.mp3"}],"looks":[],"from":"Skarpnäck","to":"Hallunda centrum","variant":"Mot Hallunda centrum","color":["#0089ca","#ffffff"],"trips":221,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}