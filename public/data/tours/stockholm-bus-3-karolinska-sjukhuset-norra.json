{"id":"stockholm-bus-3-karolinska-sjukhuset-norra","group":"stockholm-bus-3","city":"Stockholm","mode":"bus","line":"3","vehicle":"buss","vehicleLong":"buss","operator":"SL","api":"sl","tab":"","guide":null,"speedKmh":18,"dwellSec":15,"route":[[59.309898,18.05781],[59.309853,18.058594],[59.30914,18.060976],[59.309155,18.061159],[59.30948,18.061621],[59.308373,18.065256],[59.307989,18.067038],[59.307591,18.069498],[59.307437,18.071805],[59.307495,18.074782],[59.308041,18.079235],[59.309078,18.083528],[59.30995,18.086233],[59.310088,18.086348],[59.314084,18.084482],[59.314106,18.084599],[59.314083,18.084482],[59.316374,18.083378],[59.316613,18.083443],[59.317519,18.082829],[59.317709,18.082539],[59.318759,18.077899],[59.319059,18.073919],[59.319339,18.072759],[59.320229,18.072229],[59.320259,18.072879],[59.320429,18.073309],[59.321709,18.074439],[59.322129,18.072559],[59.322539,18.071389],[59.322579,18.069329],[59.323222,18.067684],[59.323904,18.06687],[59.324691,18.066781],[59.32548,18.066042],[59.325735,18.06656],[59.325657,18.066712],[59.325734,18.06656],[59.326074,18.067254],[59.326688,18.066255],[59.326666,18.065422],[59.327309,18.064375],[59.328252,18.062947],[59.328873,18.062782],[59.328398,18.060784],[59.328209,18.059436],[59.328179,18.058789],[59.328312,18.057999],[59.3279,18.053121],[59.327933,18.051439],[59.329899,18.036545],[59.331154,18.030653],[59.334485,18.03252],[59.339534,18.036608],[59.339452,18.037169],[59.339897,18.038942],[59.345829,18.033839],[59.347509,18.030899],[59.348989,18.027969],[59.350462,18.024651],[59.351872,18.028852],[59.352092,18.029327],[59.352548,18.029843],[59.353054,18.030945],[59.353134,18.031196],[59.352801,18.031541]],"stops":[{"name":"Södersjukhuset","lat":59.309898,"lon":18.05781,"story":"Välkommen ombord på buss 3 mot Karolinska sjukhuset norra! Resan tar ungefär 39 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":10.3,"audio":"audio/piper/d51d268e565883d9.mp3"},{"name":"Rosenlund","lat":59.309132,"lon":18.062583},{"name":"Eriksdal","lat":59.307575,"lon":18.069174,"story":"Vi är vid Eriksdal, på Södermalms södra kant. Nedanför ligger Årstaviken, där roddare och kajakpaddlare tränar en stor del av året. Här ligger också Eriksdalsbadet, ett av Stockholms största badhus.","tips":[["Eriksdalsbadet","4 min"],["Promenad längs Årstaviken","3 min"]],"dur":12.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/KvarteretMetern2010a.jpg/1280px-KvarteretMetern2010a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:KvarteretMetern2010a.jpg","title":"Kvarteret Metern, built by HSB 1928 (architects Sven Wallander and Sigurd Westholm).","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/KvarteretMetern2010b.jpg/1280px-KvarteretMetern2010b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:KvarteretMetern2010b.jpg","title":"Kvarteret Metern, built by HSB 1928 (architects Sven Wallander and Sigurd Westholm).","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/af/KvarteretMetern2010c.jpg/1280px-KvarteretMetern2010c.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:KvarteretMetern2010c.jpg","title":"Kvarteret Metern, built by HSB 1928 (architects Sven Wallander and Sigurd Westholm).","near":true}],"audio":"audio/piper/8669617d7ff98a6a.mp3"},{"name":"Skanstull","lat":59.307838,"lon":18.077643,"story":"Skanstull har fått sitt namn efter en skans, en liten befästning, och tullen vid stadens södra infart. Härifrån går Skanstullsbron söderut, och på andra sidan vattnet syns den stora vita kupolen vid Globenområdet.","tips":[["Götgatan, butiker och kaféer","2 min"],["Ringen, köpcentrum","1 min"]],"dur":11.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ed/Stockholm_-_Tunnelbana_-_Skanstull_%2811120543276%29.jpg/1280px-Stockholm_-_Tunnelbana_-_Skanstull_%2811120543276%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ingolf from Berlin , Deutschland","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Stockholm_-_Tunnelbana_-_Skanstull_(11120543276).jpg","title":"Gröna linjen - T17 - T18 - T19","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Stockholm_-_Tunnelbana_-_Skanstull_%2811120638323%29.jpg/1280px-Stockholm_-_Tunnelbana_-_Skanstull_%2811120638323%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ingolf from Berlin , Deutschland","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Stockholm_-_Tunnelbana_-_Skanstull_(11120638323).jpg","title":"Gröna linjen - T17 - T18 - T19","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Stockholm_-_Tunnelbana_-_Skanstull_%2811120243635%29.jpg/1280px-Stockholm_-_Tunnelbana_-_Skanstull_%2811120243635%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ingolf from Berlin , Deutschland","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Stockholm_-_Tunnelbana_-_Skanstull_(11120243635).jpg","title":"Gröna linjen - T17 - T18 - T19","near":true}],"audio":"audio/piper/1acde57771ced58f.mp3"},{"name":"Södermannagatan","lat":59.309078,"lon":18.083528,"story":"Vi är i SoFo, området söder om Folkungagatan. Här finns små butiker, kaféer och barer, och i mitten ligger Nytorget, en av Söders mest omtyckta parker.","tips":[["Nytorget","4 min"],["Små butiker i SoFo","2 min"]],"dur":10.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Bryggart%C3%A4ppan_2011-12-03b.jpg/1280px-Bryggart%C3%A4ppan_2011-12-03b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Axel Pettersson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bryggart%C3%A4ppan_2011-12-03b.jpg","title":"Byggande av lekpark vid Bryggartäppan med tema Per Anders Fogelström och Mina drömars stad. Bilden t","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/44/Bryggart%C3%A4ppan_2011-12-03a.jpg/1280px-Bryggart%C3%A4ppan_2011-12-03a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Axel Pettersson","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bryggart%C3%A4ppan_2011-12-03a.jpg","title":"Byggande av lekpark vid Bryggartäppan med tema Per Anders Fogelström och Mina drömars stad. Bilden t","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/V%C3%A5r_Bagarbod_2017.jpg/1280px-V%C3%A5r_Bagarbod_2017.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:V%C3%A5r_Bagarbod_2017.jpg","title":"Vår Bagarbod, tidigare \"Vår Bod\", Ringvägen 129","near":true}],"audio":"audio/piper/f64b7f324fa82f9c.mp3"},{"name":"Gotlandsgatan","lat":59.310614,"lon":18.086198,"story":"Groens malmgård är en riktig överlevare: huvudbyggnaden i karolinsk stil är den enda kvarvarande av sin typ i Stockholm, och i trädgården har man odlat oavbrutet i mer än 300 år. Gatan utanför hette först Vermdögatan, men namnet ansågs missvisande och byttes 1939 mot Malmgårdsvägen. På 1600-talet snurrade här också en väderkvarn, Bengt Bagares kvarn.","tips":[["Groens malmgård","1 min"],["Konstverket Sophie","2 min"]],"dur":22.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Malmg%C3%A5rdsv%C3%A4gen_2009.jpg/1280px-Malmg%C3%A5rdsv%C3%A4gen_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Malmg%C3%A5rdsv%C3%A4gen_2009.jpg","title":"Malmgårdsvägen 2009"},{"src":"https://upload.wikimedia.org/wikipedia/commons/2/26/Bengt_Bagares_kvarn_Holm_1674a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Holms tomtbok","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bengt_Bagares_kvarn_Holm_1674a.jpg","title":"Bengt Bagares kvarn Holm 1674a"}],"audio":"audio/piper/a1dc7cacdbe59ee7.mp3"},{"name":"Åsögatan","lat":59.314106,"lon":18.084599},{"name":"Tjärhovsplan","lat":59.316613,"lon":18.083443,"story":"Höjden Stigberget var Stockholms avrättningsplats under större delen av 1500- och 1600-talet, och det gamla kvartersnamnet Justitia minner fortfarande om det. I dag är stämningen gladare: på Stigbergsgatan finns Blockmakarens hus, en museilägenhet inredd som i början av 1900-talet. På Tjärhovsgatan har Kafé 44 hållit till sedan 1984 i den gamla Svenska kapsylfabriken, och Cornelisparken, tillägnad Cornelis Vreeswijk, ligger strax intill.","tips":[["Blockmakarens hus","1 min"],["Cornelisparken","2 min"]],"dur":28.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/Kaf%C3%A944.JPG/1280px-Kaf%C3%A944.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"GodSent 20:13, 18 May 2006 (UTC)","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Kaf%C3%A944.JPG","title":"Kafé44"}],"audio":"audio/piper/ebb129a75f81fbd6.mp3"},{"name":"Slussen","lat":59.319238,"lon":18.073047,"story":"Slussen är platsen där Mälaren möter Saltsjön och där Södermalm möter Gamla stan. Här har det funnits slussar sedan 1600-talet, och just nu byggs hela området om i ett av Stockholms största byggprojekt. Från kajerna har du utsikt mot Gamla stan, Skeppsholmen och Djurgården.","tips":[["Gamla stan","5 min"],["Fotografiska vid Stadsgårdskajen","8 min"],["Utsikt från Katarinahissen","4 min"]],"dur":16.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/%E6%96%AF%E5%BE%B7%E5%93%A5%E5%B0%94%E6%91%A9%E5%B8%82%E7%AB%8B%E5%8D%9A%E7%89%A9%E9%A6%86_Stockholms_Stadsmuseum_-_panoramio.jpg/1280px-%E6%96%AF%E5%BE%B7%E5%93%A5%E5%B0%94%E6%91%A9%E5%B8%82%E7%AB%8B%E5%8D%9A%E7%89%A9%E9%A6%86_Stockholms_Stadsmuseum_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"wanghongliu","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:%E6%96%AF%E5%BE%B7%E5%93%A5%E5%B0%94%E6%91%A9%E5%B8%82%E7%AB%8B%E5%8D%9A%E7%89%A9%E9%A6%86_Stockholms_Stadsmuseum_-_panoramio.jpg","title":"斯德哥尔摩市立博物馆 Stockholms Stadsmuseum","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Katarina-Sofia%2C_S%C3%B6dermalm%2C_Stockholm%2C_Sweden_-_panoramio_%2841%29.jpg/1280px-Katarina-Sofia%2C_S%C3%B6dermalm%2C_Stockholm%2C_Sweden_-_panoramio_%2841%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"bynyalcin","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Katarina-Sofia,_S%C3%B6dermalm,_Stockholm,_Sweden_-_panoramio_(41).jpg","title":"Katarina-Sofia, Södermalm, Stockholm, Sweden","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Katarina-Sofia%2C_S%C3%B6dermalm%2C_Stockholm%2C_Sweden_-_panoramio_%2844%29.jpg/1280px-Katarina-Sofia%2C_S%C3%B6dermalm%2C_Stockholm%2C_Sweden_-_panoramio_%2844%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"bynyalcin","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Katarina-Sofia,_S%C3%B6dermalm,_Stockholm,_Sweden_-_panoramio_(44).jpg","title":"Katarina-Sofia, Södermalm, Stockholm, Sweden","near":true}],"audio":"audio/piper/df5f6f471df10875.mp3"},{"name":"Mälartorget","lat":59.323101,"lon":18.068156},{"name":"Riddarhustorget","lat":59.325657,"lon":18.066712,"story":"Den vackra byggnaden här är Riddarhuset från 1600-talet, där adeln förr samlades. Strax intill ligger Riddarholmen med Riddarholmskyrkan, där svenska kungar begravts i flera hundra år.","tips":[["Riddarholmen och utsikten över Riddarfjärden","4 min"],["Gamla stan","2 min"]],"dur":11.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Riddarhuset_november_2010.jpg/1280px-Riddarhuset_november_2010.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Riddarhuset_november_2010.jpg","title":"The Swedish House of Nobility (Swedish: Riddarhuset)","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Maria_Magdalena_kyrka_September_2014_01.jpg/1280px-Maria_Magdalena_kyrka_September_2014_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Arild Vågen","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Maria_Magdalena_kyrka_September_2014_01.jpg","title":"Maria Magdalena kyrka (church),","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/Maria_Magdalena_kyrka_September_2014_02.jpg/1280px-Maria_Magdalena_kyrka_September_2014_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Arild Vågen","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Maria_Magdalena_kyrka_September_2014_02.jpg","title":"Maria Magdalena kyrka (church).","near":true}],"audio":"audio/piper/ab9031f37458d5bb.mp3"},{"name":"Tegelbacken","lat":59.328543,"lon":18.062773},{"name":"Stadshuset","lat":59.327977,"lon":18.053764,"story":"Stadshuset invigdes 1923 och är en av Stockholms symboler. Här hålls Nobelbanketten varje december i Blå hallen, och från tornet har du en vid utsikt över Riddarfjärden och Gamla stan.","tips":[["Stadshuset och tornet","2 min"],["Promenad längs Norr Mälarstrand","3 min"]],"dur":10.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Hantverkargatan_-_panoramio.jpg/1280px-Hantverkargatan_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Artem Korzhimanov","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Hantverkargatan_-_panoramio.jpg","title":"Hantverkargatan","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Gyllene_salen_%28Golden_Hall%29_and_mosaic_of_M%C3%A4lardrottningen_-_Stockholms_stadshus_%2824763564891%29.jpg/1280px-Gyllene_salen_%28Golden_Hall%29_and_mosaic_of_M%C3%A4lardrottningen_-_Stockholms_stadshus_%2824763564891%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jorge Láscar from Melbourne, Australia","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Gyllene_salen_(Golden_Hall)_and_mosaic_of_M%C3%A4lardrottningen_-_Stockholms_stadshus_(24763564891).jpg","title":"The Golden Hall (Gyllene Salen) is a banqueting hall in Stockholm City Hall. Measuring 44-metre (144","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Stockholms_stadshus_%2824831118066%29.jpg/1280px-Stockholms_stadshus_%2824831118066%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jorge Láscar from Melbourne, Australia","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Stockholms_stadshus_(24831118066).jpg","title":"Stockholm City Hall is the building of the Municipal Council for the City of Stockholm in Sweden. It","near":true}],"audio":"audio/piper/6e6cbb91565b87ab.mp3"},{"name":"Kungsholms kyrka","lat":59.328491,"lon":18.047354},{"name":"Kungsholmstorg","lat":59.329208,"lon":18.041828,"story":"På torget står Vesslan, en fontänskulptur från 1912 av Otto Strandman. En naken yngling i brons har just fått syn på en vessla, som gömmer sig i en grotta längst ner i skulpturen, och på var sida finns en dricksfontän. Runt hörnet, på Scheelegatan 8, låg restaurangen L'Escargot, som 1984 blev en av de fyra första i Sverige att få en stjärna i Guide Michelin.","tips":[["Skulpturen Vesslan","2 min"]],"dur":21.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Vesslan_2011a.jpg/1280px-Vesslan_2011a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Vesslan_2011a.jpg","title":"Vesslan 2011a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Vindruvan_14%2C_Stockholm.jpg/1280px-Vindruvan_14%2C_Stockholm.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Vindruvan_14,_Stockholm.jpg","title":"Vindruvan 14, Stockholm"}],"audio":"audio/piper/8b61a748336bdfce.mp3"},{"name":"Polhemsgatan","lat":59.330106,"lon":18.035682},{"name":"Kronobergsgatan","lat":59.330923,"lon":18.031851,"story":"I hörnet av Kronobergsparken finns en judisk begravningsplats som kom till på grund av ett gräl. Några i stadens judiska församling tyckte att en av de ledande personerna, Aaron Isaac, var alltför auktoritär, och skaffade sig då en egen begravningsplats. Den anlades 1787, den sista begravningen skedde 1857, och här vilar 209 personer. Lite längre bort lyste Sörman-skylten, en av Stockholms neonklassiker.","tips":[["Judiska begravningsplatsen Kronoberg","2 min"]],"dur":26.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Judiska_begravn_platsen_Kronoberg_2012.jpg/1280px-Judiska_begravn_platsen_Kronoberg_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Judiska_begravn_platsen_Kronoberg_2012.jpg","title":"Judiska begravn platsen Kronoberg 2012"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/S%C3%B6rman_neon_2010b.jpg/1280px-S%C3%B6rman_neon_2010b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:S%C3%B6rman_neon_2010b.jpg","title":"Sörman neon 2010b"}],"audio":"audio/piper/6da062ee857c30ef.mp3"},{"name":"Fleminggatan","lat":59.334976,"lon":18.033022,"story":"Håll utkik efter de rödlysande neonglasögonen över Ringdahls Optik på Fleminggatan 36. Skyltarna är från 1950- och 1960-talen och nominerades 2017 av Stadsmuseet till tävlingen Lysande skylt. Celsiusgatan i närheten är uppkallad efter Anders Celsius, trots att han inte hade någon särskild koppling till Kungsholmen.","tips":[["Se neonglasögonen vid Ringdahls Optik","3 min"]],"dur":20.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Ringdahl_optiker_2014c_pt.jpg/1280px-Ringdahl_optiker_2014c_pt.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Ringdahl_optiker_2014c_pt.jpg","title":"Ringdahl optiker 2014c pt"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Celsiusgatan_2014_4.jpeg/1280px-Celsiusgatan_2014_4.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Celsiusgatan_2014_4.jpeg","title":"Celsiusgatan 2014 4"}],"audio":"audio/piper/1d5b9122d0d77c1a.mp3"},{"name":"S:t Eriksplan","lat":59.339718,"lon":18.038259,"story":"Bakom den trekantiga parken döljer sig ett av Stockholms mest omtalade olösta brott. Den 4 maj 1932 hittades Lilly Lindeström mördad i sin lägenhet på Sankt Eriksplan 11, i det som kallas Vampyrmordet. Ljusare minnen finns runt hörnet: biografen Capitol från 1926 stängde 1985 men öppnade igen 2018 som Bio & Bistro Capitol.","tips":[["Se film eller ät på Bio & Bistro Capitol","2 min"]],"dur":22.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/98/Elin_W%C3%A4gner_h%C3%A5ller_tal_-_Siri_Derkert_02.jpg/1280px-Elin_W%C3%A4gner_h%C3%A5ller_tal_-_Siri_Derkert_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Lokal_Profil","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Elin_W%C3%A4gner_h%C3%A5ller_tal_-_Siri_Derkert_02.jpg","title":"Elin Wägner håller tal - Siri Derkert 02"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Vulkanusgatan_Loket_37%2B38.jpg/1280px-Vulkanusgatan_Loket_37%2B38.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Vulkanusgatan_Loket_37%2B38.jpg","title":"Vulkanusgatan Loket 37+38"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Bio_Capitol%2C_april_2022a.jpg/1280px-Bio_Capitol%2C_april_2022a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Bio_Capitol,_april_2022a.jpg","title":"Bio Capitol, april 2022a"}],"audio":"audio/piper/44ccdb3baf4add46.mp3"},{"name":"Karlbergsvägen","lat":59.342134,"lon":18.037056},{"name":"Torsplan","lat":59.344785,"lon":18.034768,"story":"Hagaparken börjar nästan här. Gustav III lät bygga Övre Haga som värdshus 1788–1789, med två kök och tre matsalar. Haga Trädgård är känd från Bellmans ”Fjäriln vingad syns på Haga”, och i ett av växthusen flyttade Fjärilshuset in 1989. Vill du ha utsikt kan du klättra upp på Frösundatoppen, cirka 72 meter över havet.","tips":[["Besök Fjärilshuset","6 min"],["Klättra upp på Frösundatoppen","3 min"]],"dur":22.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/%C3%96vre_Haga_2010x.jpg/1280px-%C3%96vre_Haga_2010x.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:%C3%96vre_Haga_2010x.jpg","title":"Övre Haga 2010x"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/%C3%96vre_Haga_v%C3%A4xthus_2010.jpg/1280px-%C3%96vre_Haga_v%C3%A4xthus_2010.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:%C3%96vre_Haga_v%C3%A4xthus_2010.jpg","title":"Övre Haga växthus 2010"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Hagaparken_Schmetter.jpg/1280px-Hagaparken_Schmetter.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hagaparken_Schmetter.jpg","title":"Hagaparken Schmetter"}],"audio":"audio/piper/9542c5744d5da37e.mp3"},{"name":"Hagaplan","lat":59.34732,"lon":18.031226,"story":"Torget Hagaplan ligger delvis ovanpå motorvägstunnlarna i Norra länken och invigdes 2023. Det runda kontorshuset Forskaren står mitt i den södra delen, och här planeras ett sextiotal träd, bland annat sequoia och tulpanträd. Sedan september 2023 står också konstverket Inflyttarna av Johanna Karlin på torget.","tips":[["Det entomologiska kvinnorovet","1 min"]],"dur":19.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Forskaren_03_by_Hagaplan_Stockholm-Solna_02_June_2024.jpg/1280px-Forskaren_03_by_Hagaplan_Stockholm-Solna_02_June_2024.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Sinikka Halme","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Forskaren_03_by_Hagaplan_Stockholm-Solna_02_June_2024.jpg","title":"Forskaren 03 by Hagaplan Stockholm-Solna 02 June 2024"}],"audio":"audio/piper/2c9f2e2231e0365e.mp3"},{"name":"Karolinska institutet Biomedicum","lat":59.349802,"lon":18.02628,"story":"Här, på Campus Solna, utses varje år mottagarna av Nobelpriset i fysiologi eller medicin, av Nobelförsamlingen vid Karolinska Institutet. Grannen Biomedicum är ett av Europas största laboratorier med drygt 82 000 kvadratmeter på elva plan. Kolla också in Aula Medica, ritad av Gert Wingårdh och utsedd till Årets Bygge 2014.","tips":[["Se Aula Medica","3 min"],["Titta på Biomedicum","2 min"]],"dur":20.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/Karolinska_Institutet%2C_infart_fr%C3%A5n_Solnav%C3%A4gen_20060723.jpg/1280px-Karolinska_Institutet%2C_infart_fr%C3%A5n_Solnav%C3%A4gen_20060723.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Oscar Franzén","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Karolinska_Institutet,_infart_fr%C3%A5n_Solnav%C3%A4gen_20060723.jpg","title":"Karolinska Institutet, infart från Solnavägen 20060723"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Biomedicum%2C_Solna%2C_april_2019a.jpg/1280px-Biomedicum%2C_Solna%2C_april_2019a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Biomedicum,_Solna,_april_2019a.jpg","title":"Biomedicum, Solna, april 2019a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Karolinska_institutes_aula_2012_07.jpg/1280px-Karolinska_institutes_aula_2012_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Karolinska_institutes_aula_2012_07.jpg","title":"Karolinska institutes aula 2012 07"}],"audio":"audio/piper/717bcb655a8d4eb5.mp3"},{"name":"Karolinska sjukhuset norra","lat":59.352801,"lon":18.031541,"story":"Snart är vi framme vid ändhållplatsen Karolinska sjukhuset norra. Sveriges första klinik för cancerbehandling, Radiumhemmet, grundades 1910 i en lägenhet på Kungsholmen och har sedan 1938 hört till sjukhuset här i Solna. En bit bort låg Norrbacka värdshus, ett av Stockholms kända utvärdshus vid vägen mot Uppsala, tills det brann ner 1882. I Hagaparken skulle det dessutom ha byggts ett utsiktstorn, men det blev aldrig ens påbörjat. Tack för att du åkte med!","tips":[],"dur":28.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/56/Stigbergets_sjukhus_2010a.jpg/1280px-Stigbergets_sjukhus_2010a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stigbergets_sjukhus_2010a.jpg","title":"Stigbergets sjukhus 2010a"},{"src":"https://upload.wikimedia.org/wikipedia/commons/6/6d/Norrbacka_v%C3%A4rdshus_%281%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Norrbacka_v%C3%A4rdshus_(1).jpg","title":"Norrbacka värdshus (1)"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Hagaparken_utsiktspyramid_1781.jpg/1280px-Hagaparken_utsiktspyramid_1781.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Fredrik Magnus Piper","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Hagaparken_utsiktspyramid_1781.jpg","title":"Hagaparken utsiktspyramid 1781"}],"audio":"audio/piper/b1606b7ecd69c1c0.mp3"}],"looks":[{"id":"stadshuset","lat":59.3275,"lon":18.0543,"r":320,"text":"Till vänster syns Stadshuset med sitt torn och de tre kronorna i toppen.","dur":5.0,"audio":"audio/piper/b877f7f9a89cba0c.mp3"},{"id":"riddarholmskyrkan","lat":59.3248,"lon":18.0644,"r":280,"text":"Till vänster syns Riddarholmskyrkan med sitt spetsiga gjutjärnstorn. Där ligger många av Sveriges kungar begravda.","dur":7.3,"audio":"audio/piper/ab415bd5013b1156.mp3"}],"from":"Södersjukhuset","to":"Karolinska sjukhuset norra","variant":"Mot Karolinska sjukhuset norra","color":["#0089ca","#ffffff"],"trips":656,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}