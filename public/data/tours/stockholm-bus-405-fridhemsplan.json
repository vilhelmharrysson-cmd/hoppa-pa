{"id":"stockholm-bus-405-fridhemsplan","group":"stockholm-bus-405","city":"Stockholm","mode":"bus","line":"405","vehicle":"buss","vehicleLong":"buss","operator":"SL","api":"sl","tab":"","guide":null,"speedKmh":18,"dwellSec":15,"route":[[59.31137,18.198196],[59.311652,18.198833],[59.311812,18.199893],[59.311715,18.200176],[59.311538,18.200247],[59.31053,18.199799],[59.310404,18.1997],[59.310229,18.199138],[59.309123,18.189311],[59.309163,18.184945],[59.309339,18.179972],[59.309311,18.17789],[59.309143,18.175851],[59.309207,18.175821],[59.309143,18.17585],[59.308988,18.174794],[59.308884,18.172913],[59.309087,18.169615],[59.309082,18.168502],[59.308939,18.167352],[59.308293,18.164809],[59.308292,18.163877],[59.308015,18.163583],[59.307569,18.161952],[59.307322,18.159738],[59.307345,18.158154],[59.307406,18.157024],[59.307464,18.157037],[59.307406,18.157025],[59.30755,18.152266],[59.307495,18.15228],[59.306915,18.146894],[59.306782,18.141699],[59.30685,18.140466],[59.306817,18.138107],[59.306706,18.137013],[59.306786,18.127753],[59.306681,18.124386],[59.306794,18.12228],[59.307146,18.120696],[59.30711,18.11995],[59.307683,18.117056],[59.308365,18.114623],[59.308556,18.113393],[59.308534,18.112524],[59.308322,18.110766],[59.308386,18.108193],[59.308793,18.106491],[59.309059,18.106031],[59.309392,18.105777],[59.309728,18.105726],[59.310155,18.105964],[59.311151,18.107568],[59.311867,18.107879],[59.312293,18.107695],[59.312633,18.107325],[59.313462,18.105735],[59.314018,18.103528],[59.31412,18.099807],[59.314279,18.098994],[59.315184,18.095742],[59.315399,18.095379],[59.316275,18.094915],[59.316238,18.094695],[59.316458,18.094395],[59.316718,18.09366],[59.317213,18.091083],[59.317756,18.085084],[59.318359,18.081373],[59.319247,18.077556],[59.319602,18.077105],[59.320655,18.072746],[59.320614,18.072017],[59.320903,18.070592],[59.321019,18.069176],[59.320977,18.066301],[59.321094,18.062335],[59.320984,18.061488],[59.3212,18.061166],[59.321216,18.060813],[59.321133,18.058963],[59.321145,18.05385],[59.32123,18.053717],[59.321148,18.053711],[59.321142,18.050822],[59.320483,18.042671],[59.320459,18.041162],[59.320119,18.038183],[59.319844,18.034398],[59.319573,18.033154],[59.319377,18.033208],[59.319069,18.032919],[59.318964,18.032074],[59.321359,18.030786],[59.322012,18.030252],[59.327155,18.024042],[59.328518,18.021869],[59.329089,18.021983],[59.331523,18.023913],[59.331773,18.023935],[59.331749,18.025424],[59.331986,18.028598],[59.332123,18.028641],[59.332102,18.027649],[59.332188,18.027656]],"stops":[{"name":"Nacka sjukhus","lat":59.31137,"lon":18.198196,"story":"Välkommen ombord på buss 405 mot Fridhemsplan! Resan tar ungefär 47 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":9.4,"audio":"audio/piper/22aa0163f77ae23b.mp3"},{"name":"Ektorps centrum","lat":59.310226,"lon":18.198484,"story":"Stora delar av grannområdet Ekängen byggdes på 1940-talet med små enfamiljsvillor, och det är fortfarande ett lugnt villakvarter norr om Saltsjö-Duvnäs. Lite längre bort ligger Långsjön, en liten skogssjö som sedan 2005 är naturreservat, med badplats och ett 1,4 kilometer långt motionsspår runt om. Perfekt för den som vill byta centrumliv mot ett varv runt sjön.","tips":[],"dur":21.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg","title":"Långsjöns naturreservat 2013 07"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg","title":"Långsjöns naturreservat 2013 05"}],"audio":"audio/piper/b5927dc0ab94edba.mp3"},{"name":"Skogalund","lat":59.309462,"lon":18.191601},{"name":"Långsjöstrand","lat":59.309205,"lon":18.186413,"story":"Långsjön är en liten sjö med badplats och ett 1,4 kilometer långt motionsspår runt om, och sedan 2005 är sjön och marken närmast den naturreservat. Sjön är 5,6 meter djup och ligger drygt 20 meter över havet. En bit bort i Storängen står Villa Widstrand, byggd 1906 åt bokförläggaren Wilhelm Widstrand, känd från förlaget Wahlström och Widstrand.","tips":[["Långsjön","4 min"]],"dur":21.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg","title":"Långsjöns naturreservat 2013 07"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg","title":"Långsjöns naturreservat 2013 05"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Villa_Widstrand_2013b.jpg/1280px-Villa_Widstrand_2013b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Widstrand_2013b.jpg","title":"Villa Widstrand 2013b"}],"audio":"audio/piper/a06015a91b0dc535.mp3"},{"name":"Storängen","lat":59.309207,"lon":18.175821,"story":"Villasamhället Storängen grundades 1904 av en egnahemsförening för tjänstemän, och samma år byggdes Villa Lodén, den allra första villan, åt en av grundarna. I området bodde konstnärer som Richard Bergh och paret Georg och Hanna Pauli. I Villa Jacobsen låg Nackas kommunalkontor mellan 1916 och 1961, och Villa Bellander fick ett helt nytt utseende av Ragnar Östberg efter att ha brunnit 1918.","tips":[["Villa Bergh","2 min"],["Villa Lodén","4 min"]],"dur":23.5,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8c/Stor%C3%A4ngen_flygfoto_1967.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Claesson, Erik","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Stor%C3%A4ngen_flygfoto_1967.jpg","title":"Storängen flygfoto 1967"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/Villa_Gullvivan_2013.jpg/1280px-Villa_Gullvivan_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Gullvivan_2013.jpg","title":"Villa Gullvivan 2013"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Villa_Richard_Bergh_2013.jpg/1280px-Villa_Richard_Bergh_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Richard_Bergh_2013.jpg","title":"Villa Richard Bergh 2013"}],"audio":"audio/piper/57f1afbbb6c1d824.mp3"},{"name":"Nacka Forum","lat":59.308377,"lon":18.164961,"story":"Nacka Forum öppnade den 1 mars 1989 och ersatte då ett provisoriskt centrum i baracker som hade fått duga i många år. Strax intill börjar villaidyllen i Storängen, där Villa Wållgren från 1907 har bedömts som omistlig. Ett stenkast bort står också Villa Yngve Larsson, ritad av Ragnar Östberg och byggd 1907 för den blivande borgarrådet och hans fru Elin, född Bonnier.","tips":[["Villa Wållgren","3 min"],["Villa Yngve Larsson","3 min"]],"dur":21.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/55/Nacka_Forum%2C_flygfoto_2014-09-20.jpg/1280px-Nacka_Forum%2C_flygfoto_2014-09-20.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nacka_Forum,_flygfoto_2014-09-20.jpg","title":"Nacka Forum, flygfoto 2014-09-20"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Villa_W%C3%A5llgren_2013a.jpg/1280px-Villa_W%C3%A5llgren_2013a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_W%C3%A5llgren_2013a.jpg","title":"Villa Wållgren 2013a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/21/Villa_Yngve_Larsson_2008b.jpg/1280px-Villa_Yngve_Larsson_2008b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Yngve_Larsson_2008b.jpg","title":"Villa Yngve Larsson 2008b"}],"audio":"audio/piper/f1957ca594ccd039.mp3"},{"name":"Lillängen","lat":59.307464,"lon":18.157037,"story":"Lillängen nämns första gången 1653 och var då en betes- och slåtteräng under Järla gård. Villaområdet planlades 1937, och redan samma höst kunde de första familjerna flytta in i sina nya hus. Samma år fick området en egen hållplats på Saltsjöbanan, och den funktionalistiska väntkuren från 1937, grön med vita knutar, står kvar än i dag.","tips":[["Lillängens station","4 min"]],"dur":21.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Lill%C3%A4ngen_2008b.jpg/1280px-Lill%C3%A4ngen_2008b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Lill%C3%A4ngen_2008b.jpg","title":"Lillängen 2008b"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Lill%C3%A4ngen_201905017_07.jpg/1280px-Lill%C3%A4ngen_201905017_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Lill%C3%A4ngen_201905017_07.jpg","title":"Lillängen 201905017 07"}],"audio":"audio/piper/2831390c8d0db88d.mp3"},{"name":"Järla station","lat":59.30755,"lon":18.152266,"story":"Saltsjöbanans station invigdes 1894, då stavat Jerla. Härifrån gick stickspår till en jästfabrik och till De Lavals ångturbinfabrik. Kul detalj: Anna Book gick på Nacka musikskola när hon sjöng ”ABC” i Melodifestivalen 1986. Från 2030 ska man kunna byta till tunnelbanans blå linje i en ny station här.","tips":[["Strosa i Järla sjö bland gamla industrihus","4 min"]],"dur":21.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg/1280px-Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg","title":"Saltsjö-Järla 20190517 12"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Nyborjarkonsert_Nacka_Musikskola_Nacka_Aula_2016-11-23_.jpg/1280px-Nyborjarkonsert_Nacka_Musikskola_Nacka_Aula_2016-11-23_.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Rubatone","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Nyborjarkonsert_Nacka_Musikskola_Nacka_Aula_2016-11-23_.jpg","title":"Nyborjarkonsert Nacka Musikskola Nacka Aula 2016-11-23"},{"src":"https://pub.raa.se/dokumentation/a680f642-8251-45e5-be76-20444c81a2ac/visning/1","credit":"Claesson, Erik","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/a680f642-8251-45e5-be76-20444c81a2ac","title":"Värmdövägen, Järlaleden, Gjuterigränd, Järla östra skolväg, Järla Station, Nacka","old":true,"year":1973,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/4fc5c6c142025fe2.mp3"},{"name":"Finntorp","lat":59.306828,"lon":18.138192,"story":"Nacka kyrka byggdes 1891 i nygotisk stil och omges av Nacka norra kyrkogård. Runt kyrkan ligger Birka, ett av Nackas äldsta villaområden, där de första husen kom på 1880-talet för de anställda i traktens växande industrier, som Atlas Copco i Sickla och de Lavals Ångturbin i Järla. Området har bytt namn flera gånger och har hetat både Järla, Järlaby och Birka-Järla.","tips":[["Nacka kyrka","3 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Nacka_kyrka_2011.jpg/1280px-Nacka_kyrka_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nacka_kyrka_2011.jpg","title":"Nacka kyrka 2011"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Birka_Nacka_kommun_2011.jpg/1280px-Birka_Nacka_kommun_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Birka_Nacka_kommun_2011.jpg","title":"Birka Nacka kommun 2011"},{"src":"https://pub.raa.se/dokumentation/34b34d9f-d766-4133-97fc-287531c1706f/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/34b34d9f-d766-4133-97fc-287531c1706f","title":"Finntorp, Nacka","old":true,"year":1967,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/e3f4b98f-cb8e-4171-ac0d-214f95571e0b/visning/1","credit":"Claesson, Erik","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/e3f4b98f-cb8e-4171-ac0d-214f95571e0b","title":"Finntorp, Sickla, Lugnet, TEAB, Henriksdal, Nacka","old":true,"year":1972,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/6e0105af61df4b93.mp3"},{"name":"Nacka station","lat":59.306843,"lon":18.131849,"story":"Redaren Jacob Gustaf Setterwall gjorde stora framgångar och lät 1896 bygga en magnifik patriciervilla i Finntorp, i dag en av de äldsta byggnaderna i Nacka. En bit bort vid Svindersviken ligger Svindersvik, ett sommarnöje från 1700-talets mitt ritat av Carl Hårleman för köpmannen Claes Grill. Det räknas som en av Sveriges bäst bevarade rokokoanläggningar, bland annat eftersom ingen någonsin har bott där året runt.","tips":[["Setterwallska villan","3 min"],["Svindersvik","5 min"]],"dur":24.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Setterwallska_villan.jpg/1280px-Setterwallska_villan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Setterwallska_villan.jpg","title":"Setterwallska villan"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b7/Svindersvik_2009.jpg/1280px-Svindersvik_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svindersvik_2009.jpg","title":"Svindersvik 2009"},{"src":"https://pub.raa.se/dokumentation/cfd6ab7b-739c-44b8-8138-b2e569d074fc/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/cfd6ab7b-739c-44b8-8138-b2e569d074fc","title":"Nacka","old":true,"year":1967,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/cf7ba340-2caf-400f-9851-56fc548064a1/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/cf7ba340-2caf-400f-9851-56fc548064a1","title":"Finntorp, Nacka","old":true,"year":1967,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/08a3510a45bca482.mp3"},{"name":"Alphyddan","lat":59.306841,"lon":18.126768,"story":"Bostadsområdet Alphyddan byggdes 1960 till 1965 efter ritningar av arkitektfirman Backström och Reinius, med naturområdet Svindersberg som grön granne i öster. En bit bort ligger Dieselverkstaden, där Atlas Diesel tillverkade dieselmotorer fram till 1951 och där det i dag finns kulturhus, bibliotek och biograf. Sickla Köpkvarter intill rymmer 168 butiker och restauranger.","tips":[],"dur":23.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Sickla_Alphyddan_2013.jpg/1280px-Sickla_Alphyddan_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sickla_Alphyddan_2013.jpg","title":"Sickla Alphyddan 2013"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Dieselverkstaden_2014c.jpg/1280px-Dieselverkstaden_2014c.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Dieselverkstaden_2014c.jpg","title":"Dieselverkstaden 2014c"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Luftverkstaden_Sickla_2014a.jpg/1280px-Luftverkstaden_Sickla_2014a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Luftverkstaden_Sickla_2014a.jpg","title":"Luftverkstaden Sickla 2014a"}],"audio":"audio/piper/8f863df8d01ffba7.mp3"},{"name":"Sickla bro","lat":59.307166,"lon":18.121082,"story":"Sickla kanal skiljer Södra Hammarbyhamnen från Nacka. Industrihistorien är tydlig här: på 1920-talet flyttade Atlas Diesel, sedermera Atlas Copco, all verksamhet till Sickla, och huvudkontoret ligger kvar än i dag. Fabrikerna var igång till slutet av 1980-talet. 1994 gjordes området om till Sickla köpkvarter.","tips":[],"dur":21.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/76/Stockholms_l%C3%A4ns_museum.jpg/1280px-Stockholms_l%C3%A4ns_museum.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stockholms_l%C3%A4ns_museum.jpg","title":"Stockholm County Museum, Sickla, east Stockholm, Sweden.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Finntorp_2.JPG/1280px-Finntorp_2.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Finntorp_2.JPG","title":"Finntorp sedd från helikopter.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Stockholms_l%C3%A4ns_museum_-_panoramio.jpg/1280px-Stockholms_l%C3%A4ns_museum_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"babbelfisk","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stockholms_l%C3%A4ns_museum_-_panoramio.jpg","title":"Stockholms läns museum","near":true}],"audio":"audio/piper/0c81edc5563cdba7.mp3"},{"name":"Londonviadukten","lat":59.314586,"lon":18.098018,"story":"Uppe på Åsöberget finns, tillsammans med Djurgårdsstaden, Stockholms största sammanhängande trähusbebyggelse. Området är kulturreservat sedan 1956. Vid Kvastmakarbacken står Hedbergs malmgård och trähus från tidigt 1700-tal. Nedanför låg viken Tegelviken, som fylldes igen 1910. Där lägger i dag Viking Lines finlandsfärjor till.","tips":[["Gå uppför Kvastmakarbacken till trähusen på Åsöberget","2 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/S%C3%A5gargatan_11_S%C3%B6dermalm_Stockholm_2005-06-13.JPG/1280px-S%C3%A5gargatan_11_S%C3%B6dermalm_Stockholm_2005-06-13.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jordgubbe","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:S%C3%A5gargatan_11_S%C3%B6dermalm_Stockholm_2005-06-13.JPG","title":"Sågargatan 11 Södermalm Stockholm 2005-06-13"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ca/Kvastmakartrappan%2C_fr%C3%A5n_F%C3%A5f%C3%A4ngan%2C_2019.jpg/1280px-Kvastmakartrappan%2C_fr%C3%A5n_F%C3%A5f%C3%A4ngan%2C_2019.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kvastmakartrappan,_fr%C3%A5n_F%C3%A5f%C3%A4ngan,_2019.jpg","title":"Kvastmakartrappan, från Fåfängan, 2019"},{"src":"https://pub.raa.se/dokumentation/4259085e-2148-43d1-97cf-615d3ba2a12f/visning/1","credit":"Claesson, Erik","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/4259085e-2148-43d1-97cf-615d3ba2a12f","title":"Södermalm, Londonviadukten, Folkungagatan, Viking Line terminalen","old":true,"year":1983,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/1830d571563df736.mp3"},{"name":"Münchenbryggeriet","lat":59.32123,"lon":18.053717,"story":"Ölet började flöda här 1857, i lokaler som tidigare varit en klädesfabrik, och bryggeriet höll igång ända till 1971. Efter en stor brand 1893 byggdes det snabbt upp igen i renässansstil, och fasaden mot Riddarfjärden är i dag ett välkänt inslag i stadsbilden. Uppe på Skinnarviksberget tronar Villa Ludvigsberg med sitt utsiktstorn, och vid kajen ligger Kronprinsesse Märtha, ett norskt fartyg byggt 1929 i Danzig som nu är restaurang.","tips":[["Villa Ludvigsberg","2 min"],["Münchenbryggeriet","2 min"]],"dur":26.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Ludvigsberg.JPG/1280px-Ludvigsberg.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Enhamre","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Ludvigsberg.JPG","title":"Ludvigsberg"}],"audio":"audio/piper/476951b217dbd6e6.mp3"},{"name":"Västerbroplan","lat":59.328404,"lon":18.022071,"story":"Ett stenkast härifrån breder Rålambshovsparken ut sig, i dagligt tal Rålis, med namn efter den gamla egendomen Rålambshovs gård. Parken anlades ungefär samtidigt som Västerbron på 1930-talet, och Lilla Västerbron spänner rakt över den. Vid torget ligger också Riksarkivet, vars huvudbyggnad stod klar 1968 när verksamheten flyttade hit från Gamla Riksarkivet på Riddarholmen.","tips":[["Rålambshovsparken","2 min"]],"dur":22.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/R%C3%A5lambshovsparken_syd_2010.jpg/1280px-R%C3%A5lambshovsparken_syd_2010.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:R%C3%A5lambshovsparken_syd_2010.jpg","title":"Rålambshovsparken syd 2010"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1e/Lilla_V%C3%A4sterbron_2024-07-17_image01.jpg/1280px-Lilla_V%C3%A4sterbron_2024-07-17_image01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Håkan Skogsjö","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Lilla_V%C3%A4sterbron_2024-07-17_image01.jpg","title":"Lilla Västerbron 2024-07-17 image01"},{"src":"https://pub.raa.se/dokumentation/e2c15ea4-2311-4fde-a8a1-f7b1cc77401a/visning/1","credit":"Claesson, Erik","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/e2c15ea4-2311-4fde-a8a1-f7b1cc77401a","title":"Kungsholmen, Västerbroplan, Rålambshovsparken, Drottningholmsvägen, Riksarkivet","old":true,"year":1973,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/79d28060-5f68-4970-addd-6d1a174fb4b8/visning/1","credit":"Claesson, Erik","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/79d28060-5f68-4970-addd-6d1a174fb4b8","title":"Kungsholmen, Västerbroplan, Rålambshovsparken, Drottningholmsvägen, Norr Mälarstrand, Riksarkivet","old":true,"year":1973,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/6dd9b7fadaafccda.mp3"},{"name":"Mariebergsgatan","lat":59.331749,"lon":18.025424,"story":"Vi är i Marieberg på Kungsholmen. Det höga tornet i närheten är DN-skrapan, där Dagens Nyheter flyttade in på 1960-talet. Strax intill ligger Rålambshovsparken, en av stadens populäraste sommarparker.","tips":[["Rålambshovsparken","3 min"],["Smedsuddsbadet vid Mälaren","10 min"]],"dur":13.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a7/Stockholms_sjukhem.JPG/1280px-Stockholms_sjukhem.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stockholms_sjukhem.JPG","title":"Stockholms sjukhem, Mariebergsgatan 22, Stockholm. Byggnad: Tengbom arkitekter 2012/2013","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Sanktt_G%C3%B6rans_sjukhus%2C_Personalbostaden.JPG/1280px-Sanktt_G%C3%B6rans_sjukhus%2C_Personalbostaden.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sanktt_G%C3%B6rans_sjukhus,_Personalbostaden.JPG","title":"S:t Görans sjukhus, Personalbostaden vid Mariebergsgatan. Byggnadsår 1926. Arkitekt Karl Güettler","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Kungsholmen_runt_2015_04.jpg/1280px-Kungsholmen_runt_2015_04.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kungsholmen_runt_2015_04.jpg","title":"Kungsholmen runt 2015","near":true}],"audio":"audio/piper/17ee245193f26590.mp3"},{"name":"Fridhemsplan","lat":59.332188,"lon":18.027656,"story":"Snart är vi framme vid ändhållplatsen Fridhemsplan. Fridhemsplan är en av Kungsholmens stora knutpunkter, med tunnelbana, bussar och butiker. Kungsholmen kallades på 1500-talet Munklägret, efter munkarna som hade mark här. Tack för att du åkte med!","tips":[["S:t Eriksgatan, kaféer och butiker","1 min"],["Kronobergsparken","8 min"]],"dur":15.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Kulsprutan_1.JPG/1280px-Kulsprutan_1.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kulsprutan_1.JPG","title":"Kulsprutan 1, Drottningholmsvägen 19-21, Fridhemsgatan 18, Hantverkargatan 88-90, Byggnadsår 1906-10","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Kvarteret_Basaren_2015_01.jpg/1280px-Kvarteret_Basaren_2015_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kvarteret_Basaren_2015_01.jpg","title":"Kvarteret Basaren på Hantverkargatan.","near":true},{"src":"https://pub.raa.se/dokumentation/8ac3f24e-90f4-49a3-a769-bc0edbb642dc/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/8ac3f24e-90f4-49a3-a769-bc0edbb642dc","title":"Fridhemsplan. Rivningar","old":true,"year":1966,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/0622584c-e016-443b-8380-83f0bdbe404d/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/0622584c-e016-443b-8380-83f0bdbe404d","title":"Fridhemsplan och Kronobergsparken. Rivningar","old":true,"year":1967,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/802de34f9326389f.mp3"}],"looks":[{"id":"vasterbron","lat":59.3233,"lon":18.0268,"r":170,"text":"Vi kör över Västerbron, med en av Stockholms bästa utsikter över Riddarfjärden, Stadshuset och Gamla stan.","dur":7.5,"audio":"audio/piper/9fc954705832112e.mp3"}],"from":"Nacka sjukhus","to":"Fridhemsplan","variant":"Mot Fridhemsplan","color":["#d71d24","#ffffff"],"trips":49,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}