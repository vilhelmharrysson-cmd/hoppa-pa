{"id":"stockholm-bus-420-slussen","group":"stockholm-bus-420","city":"Stockholm","mode":"bus","line":"420","vehicle":"buss","vehicleLong":"buss","operator":"SL","api":"sl","tab":"","guide":null,"speedKmh":18,"dwellSec":15,"route":[[59.326164,18.391736],[59.326111,18.391643],[59.326751,18.390068],[59.326862,18.390105],[59.32692,18.389954],[59.326566,18.389236],[59.326015,18.386097],[59.32582,18.385567],[59.326142,18.38522],[59.327047,18.385146],[59.327455,18.382678],[59.327526,18.381787],[59.327492,18.379428],[59.32727,18.377658],[59.326827,18.376148],[59.326821,18.37487],[59.327114,18.372631],[59.328171,18.368595],[59.328236,18.368014],[59.328136,18.366694],[59.327014,18.359916],[59.32698,18.359251],[59.327671,18.355755],[59.328102,18.354553],[59.328519,18.353731],[59.329347,18.352732],[59.330854,18.350095],[59.331655,18.348233],[59.331812,18.347151],[59.331812,18.346519],[59.331637,18.345727],[59.330902,18.344149],[59.330616,18.343206],[59.330255,18.340439],[59.329956,18.339221],[59.329578,18.338316],[59.328465,18.336503],[59.327643,18.334883],[59.327379,18.334006],[59.327236,18.333122],[59.327226,18.332252],[59.32736,18.331111],[59.327781,18.329116],[59.328884,18.324867],[59.329428,18.321508],[59.329602,18.318855],[59.329513,18.315216],[59.329334,18.313492],[59.328881,18.310874],[59.327756,18.306885],[59.326519,18.303543],[59.324344,18.299001],[59.323484,18.296777],[59.322921,18.294772],[59.322148,18.290945],[59.321611,18.288935],[59.320844,18.286841],[59.319034,18.283092],[59.318511,18.281725],[59.317796,18.279225],[59.317264,18.27632],[59.315858,18.26069],[59.315298,18.248594],[59.314332,18.2409],[59.313893,18.234022],[59.313739,18.230008],[59.313918,18.225501],[59.313867,18.21921],[59.314143,18.216342],[59.314692,18.213658],[59.314312,18.213034],[59.314033,18.212841],[59.313687,18.212187],[59.311534,18.207476],[59.311051,18.206003],[59.310421,18.200808],[59.310474,18.19989],[59.310229,18.199138],[59.309123,18.189311],[59.309163,18.184945],[59.309339,18.179972],[59.309311,18.17789],[59.309143,18.175851],[59.309207,18.175821],[59.309143,18.17585],[59.308988,18.174794],[59.308884,18.172913],[59.309087,18.169615],[59.309082,18.168502],[59.308939,18.167352],[59.308293,18.164809],[59.308292,18.163877],[59.308015,18.163583],[59.307828,18.162981],[59.307569,18.161952],[59.307372,18.160575],[59.307319,18.158773],[59.307406,18.157024],[59.307464,18.157037],[59.307406,18.157025],[59.30755,18.152266],[59.307495,18.15228],[59.30693,18.147228],[59.306782,18.141699],[59.30685,18.140466],[59.306813,18.137927],[59.306706,18.137013],[59.306795,18.132426],[59.30671,18.123257],[59.306838,18.122003],[59.307146,18.120696],[59.30711,18.11995],[59.307683,18.117056],[59.308365,18.114623],[59.308556,18.113393],[59.308307,18.109982],[59.308386,18.108193],[59.30852,18.107498],[59.308917,18.106239],[59.30922,18.105877],[59.309728,18.105726],[59.310155,18.105964],[59.311232,18.107641],[59.311672,18.107857],[59.312234,18.107736],[59.312256,18.107849],[59.312203,18.107758],[59.312725,18.107191],[59.313462,18.105735],[59.314018,18.103528],[59.31412,18.099807],[59.314709,18.097322],[59.314871,18.097029],[59.314783,18.097061],[59.315044,18.096121],[59.315303,18.09553],[59.316361,18.094836],[59.316638,18.094281],[59.317213,18.091083],[59.317835,18.084534],[59.318506,18.08065],[59.319044,18.07838],[59.3191,18.07844]],"stops":[{"name":"Gustavsbergs centrum","lat":59.326164,"lon":18.391736,"story":"Välkommen ombord på buss 420 mot Slussen! Resan tar ungefär 73 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":9.1,"audio":"audio/piper/99f9704bd79467fd.mp3"},{"name":"Höjdhagen","lat":59.327486,"lon":18.378972,"story":"Villa Strandvik i jugendstil, alldeles intill, byggdes 1911 till 1912 åt ingenjören Axel Odelberg från porslinsfabrikens ledning. Sedan dess har huset hunnit vara mäss, hotell, kontor och behandlingshem, och kommunen har pekat ut det som kulturhistoriskt omistligt. En kort promenad bort, i fabrikens gamla Torkhus, ligger Gustavsbergs porslinsmuseum, som varit öppet för allmänheten sedan 1956.","tips":[["Gustavsbergs kyrka","5 min"],["Gustavsbergs porslinsmuseum","6 min"]],"dur":25.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Villa_Strandvik_Gustavsberg_2015_01.jpg/1280px-Villa_Strandvik_Gustavsberg_2015_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Strandvik_Gustavsberg_2015_01.jpg","title":"Villa Strandvik Gustavsberg 2015 01"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/Gustavsbergs_porslinsmuseum.JPG/1280px-Gustavsbergs_porslinsmuseum.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Bengt Oberger","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Gustavsbergs_porslinsmuseum.JPG","title":"Gustavsbergs porslinsmuseum"}],"audio":"audio/piper/37cfbb46f71580c8.mp3"},{"name":"Östra Ekedal","lat":59.32723,"lon":18.372362,"story":"Längs Farstaviken byggde porslinsfabrikens familj Odelberg sina drömhus. Ferdinand Boberg ritade 1910 Villa Farsta udde åt Maria Bennich, dotter till fabriksdirektören Wilhelm Odelberg, och året efter Villa Strandvik åt hennes bror Axel. Direktören själv bodde i Farsta slott, vars ursprungsbyggnad från 1620-talet brändes ner av ryssarna 1719. På en kulle vid hamnen finns ett gravfält från yngre järnåldern.","tips":[["Gustavsbergs porslinsmuseum","9 min"]],"dur":26.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Farsta_udde_Gustavsberg_2015.jpg/1280px-Farsta_udde_Gustavsberg_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Farsta_udde_Gustavsberg_2015.jpg","title":"Farsta udde Gustavsberg 2015"}],"audio":"audio/piper/6c93e30942a44235.mp3"},{"name":"Eriksberg","lat":59.32755,"lon":18.356534,"story":"Farstaviken sträcker sig från Baggensfjärden in mot Gustavsberg, centralorten i Värmdö kommun, cirka två mil öster om Stockholm. Här har naturen själv byggt om kartan: på grund av landhöjningen har öarna Farstalandet och Ormingelandet vuxit ihop. Samtidigt har orter som Mörtnäs, Hemmesta och Torsby vuxit samman med Gustavsberg.","tips":[],"dur":18.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Gustavsberg%2C_maj_2018.jpg/1280px-Gustavsberg%2C_maj_2018.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Gustavsberg,_maj_2018.jpg","title":"Gustavsberg, maj 2018"},{"src":"https://upload.wikimedia.org/wikipedia/commons/5/52/Gustavsberg_-_KMB_-_16001000423266.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Jan Augustsson","license":"CC BY 2.5","page":"https://commons.wikimedia.org/wiki/File:Gustavsberg_-_KMB_-_16001000423266.jpg","title":"Gustavsberg"}],"audio":"audio/piper/e6df2e5b6c033902.mp3"},{"name":"Lagnövägen","lat":59.331497,"lon":18.345247,"story":"Orten Kil i Boo har fått sitt namn efter Kils gård, en välbevarad herrgård vid Graningevägen. Huvudbyggnaden och flyglarna fick sitt utseende i empirestil på 1820-talet under generalmajoren Louis Marie de Camps. En bit bort ligger Insjön, nästan tolv meter djup, med det gamla godset Velamsund och en badplats vid sin norra ände.","tips":[],"dur":19.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/80/Kils_gard_Nacka.jpg/1280px-Kils_gard_Nacka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Udo Schröter","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kils_gard_Nacka.jpg","title":"Kils gard Nacka"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/24/Velamsund_Insj%C3%B6n_2015.jpg/1280px-Velamsund_Insj%C3%B6n_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Velamsund_Insj%C3%B6n_2015.jpg","title":"Velamsund Insjön 2015"}],"audio":"audio/piper/825dfdc70ca16c33.mp3"},{"name":"Skurustugan","lat":59.313533,"lon":18.211749,"story":"Solsunda hette fram till 1922 Skuru gård, och på 1500-talet skänkte Gustav Vasa gården till Danviks hospital, så att arrendet skulle hjälpa till att betala hospitalets utgifter. Sedan början av 1900-talet har herrgårdsbyggnaden fungerat som vilo- och behandlingshem. Den lilla Bastusjön i närheten har både abborre, mört och två sorters dammusslor.","tips":[["Bastusjön","4 min"],["Solsunda","5 min"]],"dur":20.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Bastusj%C3%B6n.JPG/1280px-Bastusj%C3%B6n.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bastusj%C3%B6n.JPG","title":"Bastusjön"}],"audio":"audio/piper/4a3fe65cfd1e7d65.mp3"},{"name":"Skuru skola","lat":59.311857,"lon":18.207943},{"name":"Ektorps centrum","lat":59.310226,"lon":18.198484,"story":"Stora delar av grannområdet Ekängen byggdes på 1940-talet med små enfamiljsvillor, och det är fortfarande ett lugnt villakvarter norr om Saltsjö-Duvnäs. Lite längre bort ligger Långsjön, en liten skogssjö som sedan 2005 är naturreservat, med badplats och ett 1,4 kilometer långt motionsspår runt om. Perfekt för den som vill byta centrumliv mot ett varv runt sjön.","tips":[],"dur":21.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg","title":"Långsjöns naturreservat 2013 07"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg","title":"Långsjöns naturreservat 2013 05"}],"audio":"audio/piper/b5927dc0ab94edba.mp3"},{"name":"Skogalund","lat":59.309462,"lon":18.191601},{"name":"Långsjöstrand","lat":59.309205,"lon":18.186413,"story":"Långsjön är en liten sjö med badplats och ett 1,4 kilometer långt motionsspår runt om, och sedan 2005 är sjön och marken närmast den naturreservat. Sjön är 5,6 meter djup och ligger drygt 20 meter över havet. En bit bort i Storängen står Villa Widstrand, byggd 1906 åt bokförläggaren Wilhelm Widstrand, känd från förlaget Wahlström och Widstrand.","tips":[["Långsjön","4 min"]],"dur":21.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Villa_Widstrand_2013b.jpg/1280px-Villa_Widstrand_2013b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Widstrand_2013b.jpg","title":"Villa Widstrand 2013b"}],"audio":"audio/piper/a06015a91b0dc535.mp3"},{"name":"Storängen","lat":59.309207,"lon":18.175821,"story":"Villasamhället Storängen grundades 1904 av en egnahemsförening för tjänstemän, och samma år byggdes Villa Lodén, den allra första villan, åt en av grundarna. I området bodde konstnärer som Richard Bergh och paret Georg och Hanna Pauli. I Villa Jacobsen låg Nackas kommunalkontor mellan 1916 och 1961, och Villa Bellander fick ett helt nytt utseende av Ragnar Östberg efter att ha brunnit 1918.","tips":[["Villa Bergh","2 min"],["Villa Lodén","4 min"]],"dur":23.5,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8c/Stor%C3%A4ngen_flygfoto_1967.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Claesson, Erik","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Stor%C3%A4ngen_flygfoto_1967.jpg","title":"Storängen flygfoto 1967"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Villa_Richard_Bergh_2013.jpg/1280px-Villa_Richard_Bergh_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Richard_Bergh_2013.jpg","title":"Villa Richard Bergh 2013"}],"audio":"audio/piper/57f1afbbb6c1d824.mp3"},{"name":"Nacka Forum","lat":59.308377,"lon":18.164961,"story":"Nacka Forum öppnade den 1 mars 1989 och ersatte då ett provisoriskt centrum i baracker som hade fått duga i många år. Strax intill börjar villaidyllen i Storängen, där Villa Wållgren från 1907 har bedömts som omistlig. Ett stenkast bort står också Villa Yngve Larsson, ritad av Ragnar Östberg och byggd 1907 för den blivande borgarrådet och hans fru Elin, född Bonnier.","tips":[["Villa Wållgren","3 min"],["Villa Yngve Larsson","3 min"]],"dur":21.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/55/Nacka_Forum%2C_flygfoto_2014-09-20.jpg/1280px-Nacka_Forum%2C_flygfoto_2014-09-20.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nacka_Forum,_flygfoto_2014-09-20.jpg","title":"Nacka Forum, flygfoto 2014-09-20"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Villa_W%C3%A5llgren_2013a.jpg/1280px-Villa_W%C3%A5llgren_2013a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_W%C3%A5llgren_2013a.jpg","title":"Villa Wållgren 2013a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/21/Villa_Yngve_Larsson_2008b.jpg/1280px-Villa_Yngve_Larsson_2008b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Yngve_Larsson_2008b.jpg","title":"Villa Yngve Larsson 2008b"}],"audio":"audio/piper/f1957ca594ccd039.mp3"},{"name":"Lillängen","lat":59.307464,"lon":18.157037,"story":"Lillängen nämns första gången 1653 och var då en betes- och slåtteräng under Järla gård. Villaområdet planlades 1937, och redan samma höst kunde de första familjerna flytta in i sina nya hus. Samma år fick området en egen hållplats på Saltsjöbanan, och den funktionalistiska väntkuren från 1937, grön med vita knutar, står kvar än i dag.","tips":[["Lillängens station","4 min"]],"dur":21.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Lill%C3%A4ngen_2008b.jpg/1280px-Lill%C3%A4ngen_2008b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Lill%C3%A4ngen_2008b.jpg","title":"Lillängen 2008b"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Lill%C3%A4ngen_201905017_07.jpg/1280px-Lill%C3%A4ngen_201905017_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Lill%C3%A4ngen_201905017_07.jpg","title":"Lillängen 201905017 07"}],"audio":"audio/piper/2831390c8d0db88d.mp3"},{"name":"Järla station","lat":59.30755,"lon":18.152266,"story":"Saltsjöbanans station invigdes 1894, då stavat Jerla. Härifrån gick stickspår till en jästfabrik och till De Lavals ångturbinfabrik. Kul detalj: Anna Book gick på Nacka musikskola när hon sjöng ”ABC” i Melodifestivalen 1986. Från 2030 ska man kunna byta till tunnelbanans blå linje i en ny station här.","tips":[["Strosa i Järla sjö bland gamla industrihus","4 min"]],"dur":21.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg/1280px-Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg","title":"Saltsjö-Järla 20190517 12"},{"src":"https://pub.raa.se/dokumentation/a680f642-8251-45e5-be76-20444c81a2ac/visning/1","credit":"Claesson, Erik","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/a680f642-8251-45e5-be76-20444c81a2ac","title":"Värmdövägen, Järlaleden, Gjuterigränd, Järla östra skolväg, Järla Station, Nacka","old":true,"year":1973,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/4fc5c6c142025fe2.mp3"},{"name":"Finntorp","lat":59.306828,"lon":18.138192,"story":"Nacka kyrka byggdes 1891 i nygotisk stil och omges av Nacka norra kyrkogård. Runt kyrkan ligger Birka, ett av Nackas äldsta villaområden, där de första husen kom på 1880-talet för de anställda i traktens växande industrier, som Atlas Copco i Sickla och de Lavals Ångturbin i Järla. Området har bytt namn flera gånger och har hetat både Järla, Järlaby och Birka-Järla.","tips":[["Nacka kyrka","3 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Nacka_kyrka_2011.jpg/1280px-Nacka_kyrka_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nacka_kyrka_2011.jpg","title":"Nacka kyrka 2011"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Birka_Nacka_kommun_2011.jpg/1280px-Birka_Nacka_kommun_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Birka_Nacka_kommun_2011.jpg","title":"Birka Nacka kommun 2011"}],"audio":"audio/piper/6e0105af61df4b93.mp3"},{"name":"Nacka station","lat":59.306843,"lon":18.131849,"story":"Redaren Jacob Gustaf Setterwall gjorde stora framgångar och lät 1896 bygga en magnifik patriciervilla i Finntorp, i dag en av de äldsta byggnaderna i Nacka. En bit bort vid Svindersviken ligger Svindersvik, ett sommarnöje från 1700-talets mitt ritat av Carl Hårleman för köpmannen Claes Grill. Det räknas som en av Sveriges bäst bevarade rokokoanläggningar, bland annat eftersom ingen någonsin har bott där året runt.","tips":[["Setterwallska villan","3 min"],["Svindersvik","5 min"]],"dur":24.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Setterwallska_villan.jpg/1280px-Setterwallska_villan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Setterwallska_villan.jpg","title":"Setterwallska villan"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b7/Svindersvik_2009.jpg/1280px-Svindersvik_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svindersvik_2009.jpg","title":"Svindersvik 2009"}],"audio":"audio/piper/08a3510a45bca482.mp3"},{"name":"Alphyddan","lat":59.306841,"lon":18.126768,"story":"Bostadsområdet Alphyddan byggdes 1960 till 1965 efter ritningar av arkitektfirman Backström och Reinius, med naturområdet Svindersberg som grön granne i öster. En bit bort ligger Dieselverkstaden, där Atlas Diesel tillverkade dieselmotorer fram till 1951 och där det i dag finns kulturhus, bibliotek och biograf. Sickla Köpkvarter intill rymmer 168 butiker och restauranger.","tips":[],"dur":23.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Sickla_Alphyddan_2013.jpg/1280px-Sickla_Alphyddan_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sickla_Alphyddan_2013.jpg","title":"Sickla Alphyddan 2013"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Dieselverkstaden_2014c.jpg/1280px-Dieselverkstaden_2014c.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Dieselverkstaden_2014c.jpg","title":"Dieselverkstaden 2014c"}],"audio":"audio/piper/8f863df8d01ffba7.mp3"},{"name":"Sickla bro","lat":59.307166,"lon":18.121082,"story":"Sickla kanal skiljer Södra Hammarbyhamnen från Nacka. Industrihistorien är tydlig här: på 1920-talet flyttade Atlas Diesel, sedermera Atlas Copco, all verksamhet till Sickla, och huvudkontoret ligger kvar än i dag. Fabrikerna var igång till slutet av 1980-talet. 1994 gjordes området om till Sickla köpkvarter.","tips":[],"dur":21.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Lugnets_all%C3%A9_och_Sickla_kanal.jpg/1280px-Lugnets_all%C3%A9_och_Sickla_kanal.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Johan Jönsson (Julle)","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Lugnets_all%C3%A9_och_Sickla_kanal.jpg","title":"Lugnets allé och Sickla kanal"}],"audio":"audio/piper/0c81edc5563cdba7.mp3"},{"name":"Henriksdal","lat":59.312256,"lon":18.107849,"story":"Saltsjöbanans station här öppnade 1894. Under bygget av nya Slussen var Henriksdal banans inre slutstation från 2016 till slutet av 2022. Sedan 2023 har stora delar av banan varit avstängda, och sträckan till Slussen väntas öppna tidigast 2028. Vid Danvikstull låg förr Klippans sommarteater, där publiken skrattade åt John Elfström och Arthur Fischer.","tips":[],"dur":24.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Vorortzug_der_Saltsj%C3%B6banan_%288603647338%29.jpg/1280px-Vorortzug_der_Saltsj%C3%B6banan_%288603647338%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"kaffeeeinstein from Berlin, Germany","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Vorortzug_der_Saltsj%C3%B6banan_(8603647338).jpg","title":"Der Zug der Saltsjöbanan kommt von der Klappbrücke Danviksbron und fährt Richtung Saltsjöbaden in de","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Vorortzug_der_Saltsj%C3%B6banan_%288603646290%29.jpg/1280px-Vorortzug_der_Saltsj%C3%B6banan_%288603646290%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"kaffeeeinstein from Berlin, Germany","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Vorortzug_der_Saltsj%C3%B6banan_(8603646290).jpg","title":"Der Zug der Saltsjöbanan verlässt gerade einen Tunnel und fährt Richtung Stockholm Slussen in den Ba","near":true}],"audio":"audio/piper/20f90b5cf565d79b.mp3"},{"name":"Londonviadukten","lat":59.314871,"lon":18.097029,"story":"Uppe på Åsöberget finns, tillsammans med Djurgårdsstaden, Stockholms största sammanhängande trähusbebyggelse. Området är kulturreservat sedan 1956. Vid Kvastmakarbacken står Hedbergs malmgård och trähus från tidigt 1700-tal. Nedanför låg viken Tegelviken, som fylldes igen 1910. Där lägger i dag Viking Lines finlandsfärjor till.","tips":[["Gå uppför Kvastmakarbacken till trähusen på Åsöberget","2 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Hedbergs_malmg%C3%A5rd%2C_mars_2019b.jpg/1280px-Hedbergs_malmg%C3%A5rd%2C_mars_2019b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hedbergs_malmg%C3%A5rd,_mars_2019b.jpg","title":"Hedbergs malmgård, mars 2019b"},{"src":"https://pub.raa.se/dokumentation/4259085e-2148-43d1-97cf-615d3ba2a12f/visning/1","credit":"Claesson, Erik","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/4259085e-2148-43d1-97cf-615d3ba2a12f","title":"Södermalm, Londonviadukten, Folkungagatan, Viking Line terminalen","old":true,"year":1983,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/1830d571563df736.mp3"},{"name":"Slussen","lat":59.3191,"lon":18.07844,"story":"Snart är vi framme vid ändhållplatsen Slussen. Slussen är platsen där Mälaren möter Saltsjön och där Södermalm möter Gamla stan. Här har det funnits slussar sedan 1600-talet, och just nu byggs hela området om i ett av Stockholms största byggprojekt. Från kajerna har du utsikt mot Gamla stan, Skeppsholmen och Djurgården. Tack för att du åkte med!","tips":[["Gamla stan","5 min"],["Fotografiska vid Stadsgårdskajen","8 min"],["Utsikt från Katarinahissen","4 min"]],"dur":20.3,"images":[{"src":"https://pub.raa.se/dokumentation/27328925-fa58-4bee-b01b-563724294a32/visning/1","credit":"Rosenberg, Carl Gustaf","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/27328925-fa58-4bee-b01b-563724294a32","title":"Slussen","old":true,"year":1922,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/ed8c019f-0660-43dd-92c3-feabc2c7ec34/visning/1","credit":"Rosenberg, Carl Gustaf","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/ed8c019f-0660-43dd-92c3-feabc2c7ec34","title":"Båt vid Slussen","old":true,"year":null,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/8c784553311cd645.mp3"}],"looks":[],"from":"Gustavsbergs centrum","to":"Slussen","variant":"Mot Slussen","color":["#d71d24","#ffffff"],"trips":6,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}