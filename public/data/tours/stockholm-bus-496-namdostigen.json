,[59.323525,18.256404],[59.32359,18.256681],[59.323704,18.256591],[59.32364,18.255731],[59.323285,18.254704],[59.323143,18.253766],[59.323323,18.252713],[59.3241,18.250483]],"stops":[{"name":"Slussen","lat":59.319498,"lon":18.073432,"story":"Välkommen ombord på buss 496 mot Nämdöstigen! Resan tar ungefär 48 minuter. Slussen är platsen där Mälaren möter Saltsjön och där Södermalm möter Gamla stan. Här har det funnits slussar sedan 1600-talet, och just nu byggs hela området om i ett av Stockholms största byggprojekt. Från kajerna har du utsikt mot Gamla stan, Skeppsholmen och Djurgården.","tips":[["Gamla stan","5 min"],["Fotografiska vid Stadsgårdskajen","8 min"],["Utsikt från Katarinahissen","4 min"]],"dur":22.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/%E6%96%AF%E5%BE%B7%E5%93%A5%E5%B0%94%E6%91%A9%E5%B8%82%E7%AB%8B%E5%8D%9A%E7%89%A9%E9%A6%86_Stockholms_Stadsmuseum_-_panoramio.jpg/1280px-%E6%96%AF%E5%BE%B7%E5%93%A5%E5%B0%94%E6%91%A9%E5%B8%82%E7%AB%8B%E5%8D%9A%E7%89%A9%E9%A6%86_Stockholms_Stadsmuseum_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"wanghongliu","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:%E6%96%AF%E5%BE%B7%E5%93%A5%E5%B0%94%E6%91%A9%E5%B8%82%E7%AB%8B%E5%8D%9A%E7%89%A9%E9%A6%86_Stockholms_Stadsmuseum_-_panoramio.jpg","title":"斯德哥尔摩市立博物馆 Stockholms Stadsmuseum","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Katarina-Sofia%2C_S%C3%B6dermalm%2C_Stockholm%2C_Sweden_-_panoramio_%2841%29.jpg/1280px-Katarina-Sofia%2C_S%C3%B6dermalm%2C_Stockholm%2C_Sweden_-_panoramio_%2841%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"bynyalcin","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Katarina-Sofia,_S%C3%B6dermalm,_Stockholm,_Sweden_-_panoramio_(41).jpg","title":"Katarina-Sofia, Södermalm, Stockholm, Sweden","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Katarina-Sofia%2C_S%C3%B6dermalm%2C_Stockholm%2C_Sweden_-_panoramio_%2844%29.jpg/1280px-Katarina-Sofia%2C_S%C3%B6dermalm%2C_Stockholm%2C_Sweden_-_panoramio_%2844%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"bynyalcin","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Katarina-Sofia,_S%C3%B6dermalm,_Stockholm,_Sweden_-_panoramio_(44).jpg","title":"Katarina-Sofia, Södermalm, Stockholm, Sweden","near":true}],"audio":"audio/piper/b72d7d747167b5bb.mp3"},{"name":"Londonviadukten","lat":59.3147,"lon":18.09662,"story":"Uppe på Åsöberget finns, tillsammans med Djurgårdsstaden, Stockholms största sammanhängande trähusbebyggelse. Området är kulturreservat sedan 1956. Vid Kvastmakarbacken står Hedbergs malmgård och trähus från tidigt 1700-tal. Nedanför låg viken Tegelviken, som fylldes igen 1910. Där lägger i dag Viking Lines finlandsfärjor till.","tips":[["Gå uppför Kvastmakarbacken till trähusen på Åsöberget","2 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/S%C3%A5gargatan_11_S%C3%B6dermalm_Stockholm_2005-06-13.JPG/1280px-S%C3%A5gargatan_11_S%C3%B6dermalm_Stockholm_2005-06-13.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jordgubbe","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:S%C3%A5gargatan_11_S%C3%B6dermalm_Stockholm_2005-06-13.JPG","title":"Sågargatan 11 Södermalm Stockholm 2005-06-13"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ca/Kvastmakartrappan%2C_fr%C3%A5n_F%C3%A5f%C3%A4ngan%2C_2019.jpg/1280px-Kvastmakartrappan%2C_fr%C3%A5n_F%C3%A5f%C3%A4ngan%2C_2019.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kvastmakartrappan,_fr%C3%A5n_F%C3%A5f%C3%A4ngan,_2019.jpg","title":"Kvastmakartrappan, från Fåfängan, 2019"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Hedbergs_malmg%C3%A5rd%2C_mars_2019b.jpg/1280px-Hedbergs_malmg%C3%A5rd%2C_mars_2019b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hedbergs_malmg%C3%A5rd,_mars_2019b.jpg","title":"Hedbergs malmgård, mars 2019b"}],"audio":"audio/piper/1830d571563df736.mp3"},{"name":"Henriksdal","lat":59.310909,"lon":18.106827,"story":"Saltsjöbanans station här öppnade 1894. Under bygget av nya Slussen var Henriksdal banans inre slutstation från 2016 till slutet av 2022. Sedan 2023 har stora delar av banan varit avstängda, och sträckan till Slussen väntas öppna tidigast 2028. Vid Danvikstull låg förr Klippans sommarteater, där publiken skrattade åt John Elfström och Arthur Fischer.","tips":[],"dur":24.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ed/Henriksdalshamnen_Norra_Hammarbyhamnen_2009-08-21.jpg/1280px-Henriksdalshamnen_Norra_Hammarbyhamnen_2009-08-21.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jordgubbe","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Henriksdalshamnen_Norra_Hammarbyhamnen_2009-08-21.jpg","title":"Henriksdalshamnen och Norra Hammarbyhamnen i Hammarby sjöstad, sedda från Henriksdalsberget","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Vorortzug_der_Saltsj%C3%B6banan_%288603647338%29.jpg/1280px-Vorortzug_der_Saltsj%C3%B6banan_%288603647338%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"kaffeeeinstein from Berlin, Germany","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Vorortzug_der_Saltsj%C3%B6banan_(8603647338).jpg","title":"Der Zug der Saltsjöbanan kommt von der Klappbrücke Danviksbron und fährt Richtung Saltsjöbaden in de","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Vorortzug_der_Saltsj%C3%B6banan_%288603646290%29.jpg/1280px-Vorortzug_der_Saltsj%C3%B6banan_%288603646290%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"kaffeeeinstein from Berlin, Germany","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Vorortzug_der_Saltsj%C3%B6banan_(8603646290).jpg","title":"Der Zug der Saltsjöbanan verlässt gerade einen Tunnel und fährt Richtung Stockholm Slussen in den Ba","near":true}],"audio":"audio/piper/20f90b5cf565d79b.mp3"},{"name":"Sickla bro","lat":59.306763,"lon":18.122093,"story":"Sickla kanal skiljer Södra Hammarbyhamnen från Nacka. Industrihistorien är tydlig här: på 1920-talet flyttade Atlas Diesel, sedermera Atlas Copco, all verksamhet till Sickla, och huvudkontoret ligger kvar än i dag. Fabrikerna var igång till slutet av 1980-talet. 1994 gjordes området om till Sickla köpkvarter.","tips":[],"dur":21.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/76/Stockholms_l%C3%A4ns_museum.jpg/1280px-Stockholms_l%C3%A4ns_museum.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stockholms_l%C3%A4ns_museum.jpg","title":"Stockholm County Museum, Sickla, east Stockholm, Sweden.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Finntorp_2.JPG/1280px-Finntorp_2.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Finntorp_2.JPG","title":"Finntorp sedd från helikopter.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Stockholms_l%C3%A4ns_museum_-_panoramio.jpg/1280px-Stockholms_l%C3%A4ns_museum_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"babbelfisk","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stockholms_l%C3%A4ns_museum_-_panoramio.jpg","title":"Stockholms läns museum","near":true}],"audio":"audio/piper/0c81edc5563cdba7.mp3"},{"name":"Nacka station","lat":59.306708,"lon":18.132467,"story":"Redaren Jacob Gustaf Setterwall gjorde stora framgångar och lät 1896 bygga en magnifik patriciervilla i Finntorp, i dag en av de äldsta byggnaderna i Nacka. En bit bort vid Svindersviken ligger Svindersvik, ett sommarnöje från 1700-talets mitt ritat av Carl Hårleman för köpmannen Claes Grill. Det räknas som en av Sveriges bäst bevarade rokokoanläggningar, bland annat eftersom ingen någonsin har bott där året runt.","tips":[["Setterwallska villan","3 min"],["Svindersvik","5 min"]],"dur":24.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Setterwallska_villan.jpg/1280px-Setterwallska_villan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Setterwallska_villan.jpg","title":"Setterwallska villan"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b7/Svindersvik_2009.jpg/1280px-Svindersvik_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svindersvik_2009.jpg","title":"Svindersvik 2009"}],"audio":"audio/piper/08a3510a45bca482.mp3"},{"name":"Finntorp","lat":59.306795,"lon":18.140422,"story":"Nacka kyrka byggdes 1891 i nygotisk stil och omges av Nacka norra kyrkogård. Runt kyrkan ligger Birka, ett av Nackas äldsta villaområden, där de första husen kom på 1880-talet för de anställda i traktens växande industrier, som Atlas Copco i Sickla och de Lavals Ångturbin i Järla. Området har bytt namn flera gånger och har hetat både Järla, Järlaby och Birka-Järla.","tips":[["Nacka kyrka","3 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Nacka_kyrka_2011.jpg/1280px-Nacka_kyrka_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nacka_kyrka_2011.jpg","title":"Nacka kyrka 2011"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Birka_Nacka_kommun_2011.jpg/1280px-Birka_Nacka_kommun_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Birka_Nacka_kommun_2011.jpg","title":"Birka Nacka kommun 2011"}],"audio":"audio/piper/6e0105af61df4b93.mp3"},{"name":"Järla station","lat":59.307371,"lon":18.152326,"story":"Saltsjöbanans station invigdes 1894, då stavat Jerla. Härifrån gick stickspår till en jästfabrik och till De Lavals ångturbinfabrik. Kul detalj: Anna Book gick på Nacka musikskola när hon sjöng ”ABC” i Melodifestivalen 1986. Från 2030 ska man kunna byta till tunnelbanans blå linje i en ny station här.","tips":[["Strosa i Järla sjö bland gamla industrihus","4 min"]],"dur":21.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg/1280px-Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Saltsj%C3%B6-J%C3%A4rla_20190517_12.jpg","title":"Saltsjö-Järla 20190517 12"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Nyborjarkonsert_Nacka_Musikskola_Nacka_Aula_2016-11-23_.jpg/1280px-Nyborjarkonsert_Nacka_Musikskola_Nacka_Aula_2016-11-23_.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Rubatone","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Nyborjarkonsert_Nacka_Musikskola_Nacka_Aula_2016-11-23_.jpg","title":"Nyborjarkonsert Nacka Musikskola Nacka Aula 2016-11-23"}],"audio":"audio/piper/4fc5c6c142025fe2.mp3"},{"name":"Lillängen","lat":59.307245,"lon":18.159602,"story":"Lillängen nämns första gången 1653 och var då en betes- och slåtteräng under Järla gård. Villaområdet planlades 1937, och redan samma höst kunde de första familjerna flytta in i sina nya hus. Samma år fick området en egen hållplats på Saltsjöbanan, och den funktionalistiska väntkuren från 1937, grön med vita knutar, står kvar än i dag.","tips":[["Lillängens station","4 min"]],"dur":21.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Lill%C3%A4ngen_2008b.jpg/1280px-Lill%C3%A4ngen_2008b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Lill%C3%A4ngen_2008b.jpg","title":"Lillängen 2008b"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Lill%C3%A4ngen_201905017_07.jpg/1280px-Lill%C3%A4ngen_201905017_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Lill%C3%A4ngen_201905017_07.jpg","title":"Lillängen 201905017 07"}],"audio":"audio/piper/2831390c8d0db88d.mp3"},{"name":"Nacka Forum","lat":59.308745,"lon":18.165986,"story":"Nacka Forum öppnade den 1 mars 1989 och ersatte då ett provisoriskt centrum i baracker som hade fått duga i många år. Strax intill börjar villaidyllen i Storängen, där Villa Wållgren från 1907 har bedömts som omistlig. Ett stenkast bort står också Villa Yngve Larsson, ritad av Ragnar Östberg och byggd 1907 för den blivande borgarrådet och hans fru Elin, född Bonnier.","tips":[["Villa Wållgren","3 min"],["Villa Yngve Larsson","3 min"]],"dur":21.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/55/Nacka_Forum%2C_flygfoto_2014-09-20.jpg/1280px-Nacka_Forum%2C_flygfoto_2014-09-20.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nacka_Forum,_flygfoto_2014-09-20.jpg","title":"Nacka Forum, flygfoto 2014-09-20"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Villa_W%C3%A5llgren_2013a.jpg/1280px-Villa_W%C3%A5llgren_2013a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_W%C3%A5llgren_2013a.jpg","title":"Villa Wållgren 2013a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/21/Villa_Yngve_Larsson_2008b.jpg/1280px-Villa_Yngve_Larsson_2008b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Yngve_Larsson_2008b.jpg","title":"Villa Yngve Larsson 2008b"}],"audio":"audio/piper/f1957ca594ccd039.mp3"},{"name":"Storängen","lat":59.309021,"lon":18.175773,"story":"Villasamhället Storängen grundades 1904 av en egnahemsförening för tjänstemän, och samma år byggdes Villa Lodén, den allra första villan, åt en av grundarna. I området bodde konstnärer som Richard Bergh och paret Georg och Hanna Pauli. I Villa Jacobsen låg Nackas kommunalkontor mellan 1916 och 1961, och Villa Bellander fick ett helt nytt utseende av Ragnar Östberg efter att ha brunnit 1918.","tips":[["Villa Bergh","2 min"],["Villa Lodén","4 min"]],"dur":23.5,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8c/Stor%C3%A4ngen_flygfoto_1967.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Claesson, Erik","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Stor%C3%A4ngen_flygfoto_1967.jpg","title":"Storängen flygfoto 1967"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/Villa_Gullvivan_2013.jpg/1280px-Villa_Gullvivan_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Gullvivan_2013.jpg","title":"Villa Gullvivan 2013"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Villa_Richard_Bergh_2013.jpg/1280px-Villa_Richard_Bergh_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Richard_Bergh_2013.jpg","title":"Villa Richard Bergh 2013"}],"audio":"audio/piper/57f1afbbb6c1d824.mp3"},{"name":"Långsjöstrand","lat":59.309108,"lon":18.185405,"story":"Långsjön är en liten sjö med badplats och ett 1,4 kilometer långt motionsspår runt om, och sedan 2005 är sjön och marken närmast den naturreservat. Sjön är 5,6 meter djup och ligger drygt 20 meter över havet. En bit bort i Storängen står Villa Widstrand, byggd 1906 åt bokförläggaren Wilhelm Widstrand, känd från förlaget Wahlström och Widstrand.","tips":[["Långsjön","4 min"]],"dur":21.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg","title":"Långsjöns naturreservat 2013 07"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg","title":"Långsjöns naturreservat 2013 05"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Villa_Widstrand_2013b.jpg/1280px-Villa_Widstrand_2013b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Widstrand_2013b.jpg","title":"Villa Widstrand 2013b"}],"audio":"audio/piper/a06015a91b0dc535.mp3"},{"name":"Skogalund","lat":59.309729,"lon":18.195341},{"name":"Ektorps centrum","lat":59.310206,"lon":18.199256,"story":"Stora delar av grannområdet Ekängen byggdes på 1940-talet med små enfamiljsvillor, och det är fortfarande ett lugnt villakvarter norr om Saltsjö-Duvnäs. Lite längre bort ligger Långsjön, en liten skogssjö som sedan 2005 är naturreservat, med badplats och ett 1,4 kilometer långt motionsspår runt om. Perfekt för den som vill byta centrumliv mot ett varv runt sjön.","tips":[],"dur":21.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_07.jpg","title":"Långsjöns naturreservat 2013 07"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg/1280px-L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:L%C3%A5ngsj%C3%B6ns_naturreservat_2013_05.jpg","title":"Långsjöns naturreservat 2013 05"}],"audio":"audio/piper/b5927dc0ab94edba.mp3"},{"name":"Skuru skola","lat":59.311475,"lon":18.207454},{"name":"Skurustugan","lat":59.313781,"lon":18.212758,"story":"Solsunda hette fram till 1922 Skuru gård, och på 1500-talet skänkte Gustav Vasa gården till Danviks hospital, så att arrendet skulle hjälpa till att betala hospitalets utgifter. Sedan början av 1900-talet har herrgårdsbyggnaden fungerat som vilo- och behandlingshem. Den lilla Bastusjön i närheten har både abborre, mört och två sorters dammusslor.","tips":[["Bastusjön","4 min"],["Solsunda","5 min"]],"dur":20.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Bastusj%C3%B6n.JPG/1280px-Bastusj%C3%B6n.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bastusj%C3%B6n.JPG","title":"Bastusjön"}],"audio":"audio/piper/4a3fe65cfd1e7d65.mp3"},{"name":"Björknäs centrum","lat":59.315151,"lon":18.229618,"story":"Björknäs nämns i skrift redan 1436 och har fått sitt namn efter Stora Björknäs gård. Området ligger vid Skurubroarnas östra fäste, där Skurusundet skiljer landskapen åt: väster om vattnet är det Södermanland, öster om det Uppland. Broarna har byggts i tre omgångar, 1915, 1957 och 2023, och när den nyaste invigdes tog den över namnet Skurubron, medan de äldre fick heta Gamla Skurubron.","tips":[["Skurubroarna","6 min"]],"dur":25.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Bj%C3%B6rkn%C3%A4s_centrum.jpg/1280px-Bj%C3%B6rkn%C3%A4s_centrum.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bj%C3%B6rkn%C3%A4s_centrum.jpg","title":"Björknäs centrum"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Skurubron_2008a.jpg/1280px-Skurubron_2008a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skurubron_2008a.jpg","title":"Skurubron 2008a"}],"audio":"audio/piper/50201cb43f3f09f0.mp3"},{"name":"Centralplan","lat":59.316003,"lon":18.235183},{"name":"Skottvallsvägen","lat":59.31914,"lon":18.244519},{"name":"Koldalsvägen","lat":59.320063,"lon":18.248129,"story":"Boo breder ut sig på västra delen av ön Värmdö, öster om Skurusundet. Fram till 2015 var Boo en egen tätort, men sedan dess har bebyggelsen vuxit ihop med Stockholms tätort, så storstaden har i praktiken tagit sig över sundet. En bit härifrån glittrar Kocktorpssjön, en liten sjö i kommundelen.","tips":[],"dur":17.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Bj%C3%B6rkn%C3%A4s_centrum.jpg/1280px-Bj%C3%B6rkn%C3%A4s_centrum.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bj%C3%B6rkn%C3%A4s_centrum.jpg","title":"Björknäs centrum"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Kocktorpssj%C3%B6n_Tollare_Naturreservat_2015a.jpg/1280px-Kocktorpssj%C3%B6n_Tollare_Naturreservat_2015a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kocktorpssj%C3%B6n_Tollare_Naturreservat_2015a.jpg","title":"Kocktorpssjön Tollare Naturreservat 2015a"}],"audio":"audio/piper/8372e6ad730155d2.mp3"},{"name":"Telegramvägen","lat":59.321515,"lon":18.253996},{"name":"Nämdöstigen","lat":59.3241,"lon":18.250483,"story":"Snart är vi framme vid ändhållplatsen Nämdöstigen. Tack för att du åkte med!","tips":[],"dur":4.5,"audio":"audio/piper/192902b00eb9197a.mp3"}],"looks":[],"from":"Slussen","to":"Nämdöstigen","variant":"Mot Nämdöstigen","color":["#d71d24","#ffffff"],"trips":13,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}