[59.381779,17.998859],[59.381489,17.998909],[59.380829,17.998259],[59.380779,17.997359],[59.380659,17.996949],[59.380209,17.996269],[59.379539,17.996099],[59.379068,17.996188],[59.378229,17.996943],[59.377842,17.997552],[59.377526,17.998594],[59.377457,17.99974],[59.376991,17.999599],[59.376853,18.001277],[59.376844,18.003503],[59.376683,18.0067],[59.376739,18.007438],[59.376939,18.008348],[59.377764,18.01005],[59.378091,18.011022],[59.378817,18.014446],[59.379215,18.017113],[59.379187,18.02308],[59.379636,18.027795],[59.379509,18.028443],[59.379099,18.028823],[59.37886,18.027571],[59.378989,18.027184],[59.379423,18.026736],[59.380407,18.026243],[59.381169,18.026242],[59.381583,18.026551],[59.381904,18.027076],[59.38211,18.028015],[59.381807,18.037811],[59.381572,18.039461],[59.38125,18.039981],[59.380164,18.03985],[59.379208,18.038999],[59.379392,18.038484],[59.379757,18.03854],[59.37988,18.040574],[59.379816,18.04104],[59.378002,18.044158],[59.377602,18.044664],[59.374709,18.04758],[59.373378,18.04927],[59.372796,18.049693],[59.370754,18.050423],[59.370584,18.050339],[59.369701,18.05057],[59.36749,18.052267],[59.36604,18.053076],[59.365677,18.052889],[59.365581,18.051755],[59.36533,18.05183],[59.365263,18.052151],[59.365366,18.053641],[59.365515,18.054223],[59.365381,18.05438]],"stops":[{"name":"Tensta centrum","lat":59.39472,"lon":17.907012,"story":"Välkommen ombord på buss 540 mot Universitetet! Resan tar ungefär 58 minuter. Vill man kliva rakt in i 1969 finns Kämpingebacken 13, en museilägenhet som Stadsmuseet hyr. Interiören är bevarad från byggtiden och visar hur det såg ut när Tensta byggdes under miljonprogrammet, mellan 1966 och 1972. Tensta konsthall, för samtida konst, ligger också bara ett par minuter bort.","tips":[["Kämpingebacken 13","2 min"],["Tensta konsthall","3 min"]],"dur":25.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/59/K%C3%A4mpingebacken_13%2C_fasad%2C_2017.jpg/1280px-K%C3%A4mpingebacken_13%2C_fasad%2C_2017.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:K%C3%A4mpingebacken_13,_fasad,_2017.jpg","title":"Kämpingebacken 13, fasad, 2017"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/TENSTA.jpg/1280px-TENSTA.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Parisroi","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:TENSTA.jpg","title":"TENSTA"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f1/Tensta_wiki.jpg/1280px-Tensta_wiki.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Mimmicarolina","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Tensta_wiki.jpg","title":"Tensta wiki"}],"audio":"audio/piper/de141d3868a5ae7f.mp3"},{"name":"Risingeplan","lat":59.396064,"lon":17.908378},{"name":"Krällingegränd","lat":59.395065,"lon":17.917379,"story":"På Krällingegränd 3 ligger Järvabadet, ett utomhusbad som invigdes 12 juni 2020 och året därpå var en av finalisterna till Årets Stockholmsbyggnad. Strax intill ligger Eggeby gård, där människor har bott och brukat marken ända sedan vikingatiden. Vid gården står även runstenen U 69, Eggebystenen, och i dag bedriver Järva Folkets Park kulturverksamhet här.","tips":[["Järvabadet","4 min"],["Eggeby gård","5 min"]],"dur":20.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/J%C3%A4rvabadet_07_54_38_695000.jpeg/1280px-J%C3%A4rvabadet_07_54_38_695000.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Salgo60","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:J%C3%A4rvabadet_07_54_38_695000.jpeg","title":"Järvabadet 07 54 38 695000"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f1/Eggeby_g%C3%A5rd_2015.jpg/1280px-Eggeby_g%C3%A5rd_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Eggeby_g%C3%A5rd_2015.jpg","title":"Eggeby gård 2015"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Upplands_runinskrifter_69_april_2015.jpg/1280px-Upplands_runinskrifter_69_april_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Upplands_runinskrifter_69_april_2015.jpg","title":"Upplands runinskrifter 69 april 2015"}],"audio":"audio/piper/2c545c20542e1a1a.mp3"},{"name":"Bytorget","lat":59.391824,"lon":17.928663,"story":"Vid Spånga kyrkväg en bit härifrån ligger kvarteret Sörgården, med 76 vinkelbyggda småhus från början av 1970-talet, ritade av Höjer och Ljungqvist. Stadsmuseet har grönklassat dem som särskilt värdefulla. Nere i Rinkeby tunnelbanestation, öppnad 1975, har tre konstnärer stått för utsmyckningen, bland annat Nisse Zetterbergs tegelröda väggar.","tips":[],"dur":21.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cf/Kv_S%C3%B6rg%C3%A5rden_fr%C3%A5n_luften.jpg/1280px-Kv_S%C3%B6rg%C3%A5rden_fr%C3%A5n_luften.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"L.G.foto","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kv_S%C3%B6rg%C3%A5rden_fr%C3%A5n_luften.jpg","title":"Kv Sörgården från luften"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Rinkeby_tunnelbanestation%2C_ing%C3%A5ng.JPG/1280px-Rinkeby_tunnelbanestation%2C_ing%C3%A5ng.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"No machine-readable author provided. Caesar assumed (based on copyright claims).","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Rinkeby_tunnelbanestation,_ing%C3%A5ng.JPG","title":"Rinkeby tunnelbanestation, ingång"}],"audio":"audio/piper/a40ef8c5049f1995.mp3"},{"name":"Rinkeby centrum","lat":59.388254,"lon":17.925875,"story":"Kliv ner i Rinkeby tunnelbanestation och du hamnar i en vikingaskattkammare. Konstnären Nisse Zetterberg har förstorat små fornfynd från vikingatiden, som grävts fram i området, till stora väggmosaiker på tegelröda väggar med guldinlägg och runor. Stationen öppnade 1975, när blå linjen invigdes.","tips":[["Se vikingakonsten i tunnelbanan","2 min"],["Se Rinkebystråkets bro från 2016","5 min"]],"dur":17.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Rinkeby_tunnelbanestation%2C_ing%C3%A5ng.JPG/1280px-Rinkeby_tunnelbanestation%2C_ing%C3%A5ng.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"No machine-readable author provided. Caesar assumed (based on copyright claims).","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Rinkeby_tunnelbanestation,_ing%C3%A5ng.JPG","title":"Rinkeby tunnelbanestation, ingång"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Rinkebystr%C3%A5kets_bro%2C_2017a.jpg/1280px-Rinkebystr%C3%A5kets_bro%2C_2017a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Rinkebystr%C3%A5kets_bro,_2017a.jpg","title":"Rinkebystråkets bro, 2017a"}],"audio":"audio/piper/593c984b630774a0.mp3"},{"name":"Mjölbyplan","lat":59.386708,"lon":17.924557},{"name":"Rinkebysvängen","lat":59.383871,"lon":17.931657,"story":"Rinkeby är äldre än många tror. Byn omtalas redan 1347 och bestod då av flera gårdar. Det moderna Rinkeby byggdes från 1968 och framåt, under det så kallade miljonprogrammet. Vid Rinkebytorget finns i dag ett mindre köpcentrum och Folkets hus, och där kan man handla bland annat frukt och grönt.","tips":[["Rinkebytorget","6 min"]],"dur":20.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Stockholm_boroughs_1998-2006_Rinkeby.svg/1280px-Stockholm_boroughs_1998-2006_Rinkeby.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Alex Nordstrom, Jniemenmaa","license":"CC BY-SA 2.5","page":"https://commons.wikimedia.org/wiki/File:Stockholm_boroughs_1998-2006_Rinkeby.svg","title":"Stockholm boroughs 1998-2006 Rinkeby"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Rinkeby_torg%2C_font%C3%A4n_och_gr%C3%B6nsaksst%C3%A5nd.JPG/1280px-Rinkeby_torg%2C_font%C3%A4n_och_gr%C3%B6nsaksst%C3%A5nd.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"No machine-readable author provided. Caesar assumed (based on copyright claims).","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Rinkeby_torg,_font%C3%A4n_och_gr%C3%B6nsaksst%C3%A5nd.JPG","title":"Rinkeby torg, fontän och grönsaksstånd"}],"audio":"audio/piper/ce81a89e3ed5d2f7.mp3"},{"name":"Rissneleden","lat":59.379733,"lon":17.939841,"story":"I norra delen av Rissne, inte långt härifrån, sover hela blå linjen. I Rissnedepån står nämligen samtliga tunnelbanevagnar som trafikerar blå linjen uppställda, på spår under jord. Mellan 1975 och 1985 användes förbindelsespåret dit även för vanliga passagerare, eftersom sträckan via Huvudsta och Rissne ännu inte var färdig.","tips":[["Rissne torg","5 min"]],"dur":20.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a3/Svea_artilleriregemente_in_Stockholm_2014_%2810%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2810%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(10).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Svea_artilleriregemente_in_Stockholm_2014_%2811%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2811%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(11).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Svea_artilleriregemente_in_Stockholm_2014_%2812%29.JPG/1280px-Svea_artilleriregemente_in_Stockholm_2014_%2812%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Joshua06","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Svea_artilleriregemente_in_Stockholm_2014_(12).JPG","title":"Före detta kasern vid Svea artilleriregemente i Rissne, Sundbyberg.","near":true}],"audio":"audio/piper/d2d1fc889294a99c.mp3"},{"name":"Rissnehallen","lat":59.37809,"lon":17.947003},{"name":"Bergshöjden","lat":59.377647,"lon":17.956971,"story":"Ängarna en kort promenad härifrån är sedan 2026 skyddade som Rissne ängars naturreservat, cirka 21 hektar där Rissne, Hallonbergen och Duvbo möts. Öppna ängar omges av skogsbackar med tall, och flera rödlistade skalbaggar trivs här. Lite längre bort ligger Duvbo kyrka, som står i en brant bergssluttning mitt bland villorna.","tips":[["Rissne äng","4 min"]],"dur":20.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/41/DuvboKyrka2103.jpg/1280px-DuvboKyrka2103.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ulkl","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:DuvboKyrka2103.jpg","title":"DuvboKyrka2103"}],"audio":"audio/piper/bff6bba7149d20ca.mp3"},{"name":"Hallonbergsvägen","lat":59.376968,"lon":17.967073},{"name":"Hallonbergen","lat":59.375524,"lon":17.969729,"story":"Gå ner i tunnelbanan och det känns som att kliva in i en barnteckning. Konstnärerna Elis Eriksson och Gösta Wallmark smyckade stationen med motiv som ser ut som barns teckningar, inspirerade av sin egen barndom. Stationen öppnade den 31 augusti 1975, med blå linjens första sträcka mellan T-Centralen och Hjulsta.","tips":[],"dur":18.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Hallonbergen_20180624_02.jpg/1280px-Hallonbergen_20180624_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hallonbergen_20180624_02.jpg","title":"Hallonbergen tunnelbana","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Hallonbergen_20180624_01.jpg/1280px-Hallonbergen_20180624_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hallonbergen_20180624_01.jpg","title":"Hallonbergen tunnelbana","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Hallonbergen_20180624_04.jpg/1280px-Hallonbergen_20180624_04.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hallonbergen_20180624_04.jpg","title":"Hallonbergen tunnelbana","near":true}],"audio":"audio/piper/8622cb9936816717.mp3"},{"name":"Gesällvägen","lat":59.37743,"lon":17.970846},{"name":"Sundbypark södra","lat":59.379975,"lon":17.971308,"story":"Här är ett ortnamnsmysterium som löser sig självt: den historiska gården Råsta och grannen Frösunda gav tillsammans upphov till namnet Råsunda, alltså Råsta plus Frösunda. Och grannstadsdelen Hallonbergen? Den ligger på en bergig kulle och har antagligen fått namn efter trakten, som förr var rik på hallonsnår.","tips":[["Råstastenen","4 min"]],"dur":16.8,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/a/a8/R%C3%A5sta_g%C3%A5rd_1870-tal.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:R%C3%A5sta_g%C3%A5rd_1870-tal.jpg","title":"Råsta gård 1870-tal"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/05/Hallonbergen_September_2014.jpg/1280px-Hallonbergen_September_2014.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Arild Vågen","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hallonbergen_September_2014.jpg","title":"Hallonbergen September 2014"}],"audio":"audio/piper/18b749e136b2e6d8.mp3"},{"name":"Råstagaraget","lat":59.380608,"lon":17.977533},{"name":"Brotorp","lat":59.381974,"lon":17.978008},{"name":"Spegeldammsparken","lat":59.382808,"lon":17.983629},{"name":"Raoul Wallenbergskolan","lat":59.383517,"lon":17.988376,"story":"Mulle Meckparken, ett par minuter härifrån, skapades under ledning av konstnären Tor Svae och invigdes hösten 2008. Två år senare fick den Solnas Stadsmiljöpris. I närheten finns också en liten detektivhistoria: en runsten som hittades vid en vattenkälla år 1900 sågs för sista gången 1908, och bara ett litet fragment av den har sedan återfunnits.","tips":[["Mulle Meckparken","3 min"],["Statarmuseet, Överjärva gård","7 min"]],"dur":21.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Mulle_Meckparken_2015a.jpg/1280px-Mulle_Meckparken_2015a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Mulle_Meckparken_2015a.jpg","title":"Mulle Meckparken 2015a"},{"src":"https://upload.wikimedia.org/wikipedia/commons/1/1a/Rekonstruktion_runsten_U_126.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Udo Schröter","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Rekonstruktion_runsten_U_126.jpg","title":"Rekonstruktion runsten U 126"}],"audio":"audio/piper/33616ecdfb7b428a.mp3"},{"name":"Fridensborgsvägen","lat":59.381501,"lon":17.993976,"story":"Järvastaden är ett stadsbyggnadsprojekt som tar sin tid. De första invånarna flyttade in i september 2007, och när allt är klart är planen över 15 000 invånare. Den sista, nionde etappen får dock vänta till efter 2030, eftersom en högspänningsledning först måste flyttas. Granne i öster ligger bostadsområdet Agnesberg.","tips":[],"dur":19.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/10/J%C3%A4rva_skjutbanev%C3%A4g_2015.jpg/1280px-J%C3%A4rva_skjutbanev%C3%A4g_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:J%C3%A4rva_skjutbanev%C3%A4g_2015.jpg","title":"Järva skjutbaneväg 2015"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Agnesberg%2C_Solna_06.jpg/1280px-Agnesberg%2C_Solna_06.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Agnesberg,_Solna_06.jpg","title":"Agnesberg, Solna 06"}],"audio":"audio/piper/72c6f12020a8d772.mp3"},{"name":"Ulriksdals station","lat":59.381005,"lon":17.998343,"story":"Där Ulriksdals Golfklubb ligger i dag gick det förr undan på riktigt: området var tidigare plats för Ulriksdals kapplöpningsbana. Själva pendeltågsstationen ligger 7,1 kilometer från Stockholms central på grenen mot Märsta, och fick sin nuvarande utformning 1990, med biljetthall på plattformen och entré från en gångtunnel.","tips":[["Ulriksdals Golfklubb","4 min"]],"dur":18.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/Ulriksdals_golfklubb.JPG/1280px-Ulriksdals_golfklubb.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ulriksdals_golfklubb.JPG","title":"Ulriksdals golfklubb"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Ulriksdal_05.JPG/1280px-Ulriksdal_05.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Tomiwoj","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ulriksdal_05.JPG","title":"Ulriksdal 05"}],"audio":"audio/piper/5345b39f2780ad4f.mp3"},{"name":"Agnesberg","lat":59.379068,"lon":17.996188},{"name":"Bagartorp södra","lat":59.377473,"lon":17.998888},{"name":"Ritorp","lat":59.376939,"lon":18.008348,"story":"Ritorp började som ett torp på 1600-talet, och den nuvarande gårdsbyggnaden från 1770-talet beskrivs av Stockholms läns museum som omistlig. Runt omkring finns bebyggelse med charmiga smeknamn: Tornvillan från 1903, Majhillshuset från 1911 och Hästskostallet från 1929, som flyttades 1993. I norra delen märks de så kallade Rödingarna.","tips":[["Ritorps gård","3 min"]],"dur":23.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Ritorps_g%C3%A5rd_2015a.jpg/1280px-Ritorps_g%C3%A5rd_2015a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Ritorps_g%C3%A5rd_2015a.jpg","title":"Ritorps gård 2015a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Kvarteret_Majhill%2C_Ritorp%2C_Solna_2015.jpg/1280px-Kvarteret_Majhill%2C_Ritorp%2C_Solna_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kvarteret_Majhill,_Ritorp,_Solna_2015.jpg","title":"Kvarteret Majhill, Ritorp, Solna 2015"}],"audio":"audio/piper/a7f0977526603e4d.mp3"},{"name":"Bergshamra gård","lat":59.37923,"lon":18.02699,"story":"Vid Brunnsvikens nordvästra strand ligger Bergshamra by, ett kulturhistoriskt värdefullt villaområde och kulturreservat. I huset Övre Karlsro, från omkring 1865, bodde möbelformgivaren Carl Malmsten med familj, och det kallas därför också Carl Malmstens hus. Själva Bergshamra gård hette Bergshammar före 1865, och dess huvudbyggnad revs 1929.","tips":[["Övre Karlsro","4 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Malmstens_hus_01.jpg/1280px-Malmstens_hus_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Udo Schröter","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Malmstens_hus_01.jpg","title":"Malmstens hus 01"},{"src":"https://upload.wikimedia.org/wikipedia/commons/4/4a/Bergshamra_g%C3%A5rd.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Bergshamra_g%C3%A5rd.jpg","title":"Bergshamra gård"}],"audio":"audio/piper/678e92ec2ee01723.mp3"},{"name":"Kungshamra","lat":59.382067,"lon":18.027946,"story":"Studentområdet Kungshamra har ett kungligt namn av goda skäl: marken donerades av kung Gustaf den sjätte Adolf. Husen byggdes 1965 till 1967, och i dag finns här 1 383 studentbostäder. En kort promenad bort, i ett skogsparti, ligger Invalidkyrkogården, en begravningsplats som inrättades 1824 och där den sista begravningen skedde 1905.","tips":[["Invalidkyrkogården","5 min"]],"dur":24.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Kungshamra16.JPG/1280px-Kungshamra16.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Einarspetz","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kungshamra16.JPG","title":"Kungshamra16"}],"audio":"audio/piper/b688c1f67bd1c396.mp3"},{"name":"Bergshamra centrum","lat":59.381758,"lon":18.036885},{"name":"Bergshamra södra","lat":59.379522,"lon":18.039168,"story":"Bergshamras tunnelbanestation har en ovanlig konstruktion: Bergshamravägen går på en underjordisk bro rakt ovanpå gången mellan den södra entrén och plattformen. Stationen öppnade 1978. I trakten finns också gamla hus vid Stocksundet, som villan Fjällstugan från 1835 och Stocksundstorps gård, vars anläggning troligen uppfördes omkring 1753.","tips":[["Stocksundstorps gård","4 min"]],"dur":21.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Bergshamra_augusti_2016_bild_7.jpg/1280px-Bergshamra_augusti_2016_bild_7.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Bergshamra_augusti_2016_bild_7.jpg","title":"Bergshamra augusti 2016 bild 7"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/Konvaljstigen_4_Stocksund_2014a.jpg/1280px-Konvaljstigen_4_Stocksund_2014a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Konvaljstigen_4_Stocksund_2014a.jpg","title":"Konvaljstigen 4 Stocksund 2014a"}],"audio":"audio/piper/095e5122f9e4c2cc.mp3"},{"name":"Frescati","lat":59.369824,"lon":18.050478,"story":"Naturhistoriska riksmuseet, Sveriges största museianläggning, etablerades 1819, och dess nuvarande byggnad av Axel Anderberg invigdes 1916. Intill ligger Bergianska trädgården, vars största byggnad är Edvard Andersons växthus från 1995, uppkallat efter grosshandlaren som testamenterade pengar till en vinterträdgård för medelhavsklimatets växter. Bostadsområdet Ekhagen är ett av få områden som är helt byggda i funkisstil.","tips":[["Naturhistoriska riksmuseet","4 min"],["Edvard Andersons växthus","4 min"]],"dur":26.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Naturhistoriska_Riksmuseet_Stockholm_%282010%29.JPG/1280px-Naturhistoriska_Riksmuseet_Stockholm_%282010%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Gumisza","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Naturhistoriska_Riksmuseet_Stockholm_(2010).JPG","title":"Naturhistoriska Riksmuseet Stockholm (2010)"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Edvard_Anderson_Conservatory_-_Bergianska_tr%C3%A4dg%C3%A5rden_-_Stockholm%2C_Sweden_-_DSC00186.JPG/1280px-Edvard_Anderson_Conservatory_-_Bergianska_tr%C3%A4dg%C3%A5rden_-_Stockholm%2C_Sweden_-_DSC00186.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Daderot","license":"CC0","page":"https://commons.wikimedia.org/wiki/File:Edvard_Anderson_Conservatory_-_Bergianska_tr%C3%A4dg%C3%A5rden_-_Stockholm,_Sweden_-_DSC00186.JPG","title":"Edvard Anderson Conservatory - Bergianska trädgården - Stockholm, Sweden - DSC00186"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Ekhagen_20_maj_2013.JPG/1280px-Ekhagen_20_maj_2013.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Honungsbi","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ekhagen_20_maj_2013.JPG","title":"Ekhagen 20 maj 2013"}],"audio":"audio/piper/49b16c2ef3f98024.mp3"},{"name":"Universitetet","lat":59.365381,"lon":18.05438,"story":"Snart är vi framme vid ändhållplatsen Universitetet. Djupt under campus forskade man en gång i acceleratorfysik. Sedan 2019 är laboratoriet konsthallen Accelerator, invigd av konstnären Tino Sehgal. Ralph Erskine ritade Juristernas hus som en halvcirkel runt en gammal ek, och i Aula Magna har Nobelföreläsningar hållits. Längre bort ligger Villa Frescati från 1790-talet, Gustaf Mauritz Armfelts sommarnöje. Tack för att du åkte med!","tips":[["Besök konsthallen Accelerator i det gamla underjordslabbet","2 min"],["Se Juristernas hus som böjer sig runt eken","3 min"]],"dur":27.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4b/Manne_Siegbahnhusen_01.jpg/1280px-Manne_Siegbahnhusen_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Manne_Siegbahnhusen_01.jpg","title":"Manne Siegbahnhusen 01"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Juristerna_hus_2010c.jpg/1280px-Juristerna_hus_2010c.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Juristerna_hus_2010c.jpg","title":"Juristerna hus 2010c"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Aula_Magna_2010d.jpg/1280px-Aula_Magna_2010d.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Aula_Magna_2010d.jpg","title":"Aula Magna 2010d"}],"audio":"audio/piper/96898d7e9b15df13.mp3"}],"looks":[],"from":"Tensta centrum","to":"Universitetet","variant":"Mot Universitetet","color":["#d71d24","#ffffff"],"trips":166,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}