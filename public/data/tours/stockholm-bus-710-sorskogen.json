1844],[59.253756,17.994596],[59.253608,17.994864],[59.253108,17.995061],[59.252938,17.995305],[59.252361,17.997877],[59.249948,17.998471],[59.249025,17.997212],[59.248553,17.996766],[59.247963,17.996658],[59.245976,17.998838],[59.244943,18.000701],[59.243883,18.000088],[59.242545,17.999648],[59.242307,17.999186],[59.241862,17.997447],[59.241925,17.997389],[59.241862,17.997452],[59.24152,17.996117],[59.241507,17.995574],[59.241623,17.995504],[59.241628,17.995237],[59.241465,17.995202],[59.240901,17.994549],[59.240831,17.993591],[59.240322,17.991786],[59.239552,17.990232],[59.238886,17.985214],[59.237659,17.981861],[59.23729,17.981049],[59.235994,17.978957],[59.23566,17.978679],[59.234412,17.978369],[59.234044,17.977603],[59.232796,17.978961],[59.23244,17.979511],[59.231819,17.980882],[59.230352,17.985692],[59.228771,17.990133],[59.228452,17.991387],[59.228413,17.992425],[59.22781,17.992202],[59.226056,17.990712],[59.225806,17.991343],[59.225308,17.993837],[59.224851,17.994976],[59.223898,17.996195],[59.223327,17.996339],[59.223,17.996103],[59.222731,17.995649],[59.222323,17.993645],[59.222214,17.991709],[59.222477,17.9895],[59.222287,17.989534],[59.222304,17.990136]],"stops":[{"name":"Skärholmen","lat":59.276688,"lon":17.910019,"story":"Välkommen ombord på buss 710 mot Sörskogen! Resan tar ungefär 59 minuter. Prins Bertil invigde Skärholmens centrum den 8 september 1968. Det planerades som ett regionalt affärscentrum för 250 000 människor i södra Storstockholm och räknas än i dag till Sveriges största köpcentrum. Centrumet byggdes under miljonprogrammet och finns med i databasen SOS Brutalism över brutalistisk betongarkitektur.","tips":[],"dur":27.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Sk%C3%A4rholmens_kyrka.jpg/1280px-Sk%C3%A4rholmens_kyrka.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sk%C3%A4rholmens_kyrka.jpg","title":"Skärholmens kyrka","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Sk%C3%A4rholmens_kyrka_tuppen.jpg/1280px-Sk%C3%A4rholmens_kyrka_tuppen.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sk%C3%A4rholmens_kyrka_tuppen.jpg","title":"Skärholmens kyrka, tuppen","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Sk%C3%A4rholmen_T-bana_20170916_140842.jpg/1280px-Sk%C3%A4rholmen_T-bana_20170916_140842.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Sk%C3%A4rholmen_T-bana_20170916_140842.jpg","title":"Skärholmen T-bana","near":true}],"audio":"audio/piper/5be248710fa1c5fe.mp3"},{"name":"Ekgårdsvägen","lat":59.272523,"lon":17.920388,"story":"Kungens kurva har fått sitt namn från en riktig olycka. Den 28 september 1946 körde Gustaf V:s chaufför av Södertäljevägen här i närheten och fastnade i ett vattenfyllt dike. Namnet satt kvar. Ikea byggde sitt andra varuhus här 1965, och den runda byggnaden är inspirerad av Guggenheimmuseet i New York.","tips":[["Se Ikeas runda varuhus","4 min"]],"dur":19.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Kungens_Kurva_Kungens_bil_i_dike_1946a.jpg/1280px-Kungens_Kurva_Kungens_bil_i_dike_1946a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Kungens_Kurva_Kungens_bil_i_dike_1946a.jpg","title":"Kungens Kurva Kungens bil i dike 1946a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Ikea_Kungen_2009.jpg/1280px-Ikea_Kungen_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ikea_Kungen_2009.jpg","title":"Ikea Kungen 2009"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c1/Scandic_hotel_Kungens_kurva%2C_2018.jpg/1280px-Scandic_hotel_Kungens_kurva%2C_2018.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Scandic_hotel_Kungens_kurva,_2018.jpg","title":"Scandic hotel Kungens kurva, 2018"}],"audio":"audio/piper/f6a419ccea2d45e3.mp3"},{"name":"IKEA södra","lat":59.270368,"lon":17.917112,"story":"Ikeas andra svenska varuhus, efter det i Älmhult, öppnade här den 18 juni 1965. Den runda ursprungliga delen inspirerades av Guggenheimmuseet i New York, och efter en om- och tillbyggnad blev varuhuset till ytan världens näst största Ikea. Bland de allra första grannarna fanns Esso Motorhotell från 1968, som i dag är Scandic Kungens Kurva.","tips":[["Ikea Kungens kurva","2 min"]],"dur":21.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Ikea_Kungen_2009.jpg/1280px-Ikea_Kungen_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Ikea_Kungen_2009.jpg","title":"Ikea Kungen 2009"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c1/Scandic_hotel_Kungens_kurva%2C_2018.jpg/1280px-Scandic_hotel_Kungens_kurva%2C_2018.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Scandic_hotel_Kungens_kurva,_2018.jpg","title":"Scandic hotel Kungens kurva, 2018"}],"audio":"audio/piper/cfa503db297877ef.mp3"},{"name":"Kungens kurva","lat":59.268289,"lon":17.911672,"story":"Namnet Kungens kurva kommer från en alldeles äkta kunglig dikeskörning. En lördagseftermiddag den 28 september 1946 körde kung Gustaf V:s chaufför av Södertäljevägen och blev stående i ett vattenfyllt dike, och tidningarna var snabbt på plats. I dag är området ett av Skandinaviens största köpcentrum, och tillsammans med Skärholmen centrum lockar det 30 miljoner besökare varje år.","tips":[["Filmstaden Heron City","2 min"],["Ikea Kungens kurva","6 min"]],"dur":21.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Kungens_Kurva_Kungens_bil_i_dike_1946a.jpg/1280px-Kungens_Kurva_Kungens_bil_i_dike_1946a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Kungens_Kurva_Kungens_bil_i_dike_1946a.jpg","title":"Kungens Kurva Kungens bil i dike 1946a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/Kungens_kurva_2010b.jpg/1280px-Kungens_kurva_2010b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kungens_kurva_2010b.jpg","title":"Kungens kurva 2010b"}],"audio":"audio/piper/cad7d2ea2b0249ba.mp3"},{"name":"Månskärsvägen","lat":59.265158,"lon":17.91207,"story":"Torpet Månskär hade ett egendomligt namn, som inte har något med månskära att göra. Förleden kommer från en av de första brukarna, Måns, och efterleden från kärr, alltså våtmark. Torpet växte upp längs den nya sträckningen av Södertäljevägen som blev klar 1673. Strax intill ligger Filmstaden Heron City, Sveriges största biograf, med arton salonger och över fyratusen platser.","tips":[["Filmstaden Heron City","3 min"],["LM Ericsson-byggnaden i rött tegel","2 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/M%C3%A5nsk%C3%A4r_tr%C3%A4d_2012.jpg/1280px-M%C3%A5nsk%C3%A4r_tr%C3%A4d_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:M%C3%A5nsk%C3%A4r_tr%C3%A4d_2012.jpg","title":"Månskär träd 2012"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/70/Heron_City_2009d.jpg/1280px-Heron_City_2009d.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Heron_City_2009d.jpg","title":"Heron City 2009d"}],"audio":"audio/piper/2ce8be8b52b622d6.mp3"},{"name":"Diagonalvägen","lat":59.26466,"lon":17.921875},{"name":"Toyota","lat":59.268073,"lon":17.925376,"story":"Mitt i handelsområdet Kungens kurva finns en Oas, åtminstone till namnet. Skulpturen Oas anlades 2009 efter ritningar av konstnären och formgivaren Thomas Nordström, i samarbete med landskapsarkitekten Torsten Wallin. En bit bort ligger Kolartorp, ett torp med många namn: det har också kallats Kålartorp, Crone och Ryttartorp nummer två.","tips":[["Skulpturen Oas","4 min"]],"dur":20.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Oas_skulptur_Huddinge_2011a.jpg/1280px-Oas_skulptur_Huddinge_2011a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Oas_skulptur_Huddinge_2011a.jpg","title":"Oas skulptur Huddinge 2011a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Kolartorp_2012.jpg/1280px-Kolartorp_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kolartorp_2012.jpg","title":"Kolartorp 2012"}],"audio":"audio/piper/6f821c65cd826ad6.mp3"},{"name":"Jägerhorns väg","lat":59.273953,"lon":17.920795,"story":"Altartorp kan vara ett av traktens äldsta torp, med en ålder som anses gå tillbaka ända till 1540. Enligt en folklig tradition kommer namnet Altaret från en böneplats där soldater höll gudstjänst innan de drog ut på Europas slagfält. Ett stenkast bort går Smista allé, gatan som blivit känd för att så många bilföretag har etablerat sig längs den.","tips":[["Altartorp","4 min"]],"dur":19.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Altartorpet_2012.jpg/1280px-Altartorpet_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Altartorpet_2012.jpg","title":"Altartorpet 2012"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/25/Skansberget_2013.jpg/1280px-Skansberget_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Skansberget_2013.jpg","title":"Skansberget 2013"}],"audio":"audio/piper/edde8ecb8b510a79.mp3"},{"name":"Juringe allé","lat":59.275858,"lon":17.9272,"story":"Juringe gård var en gång utgård till det stora godset Vårby gård. Den gamla huvudbyggnaden revs 2001 och ersattes av en ny med liknande utseende, där det nu finns en förskola. Kvar från gårdens tid är magasinet, en tvätt- och mjölkbod och arbetarbostaden Väderluven. I trakten låg också torpet Nytorp, vid den nya färdvägen från 1673 som ersatte den gamle Götha vägen.","tips":[["Juringe gård","5 min"]],"dur":24.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Segeltorp_2.jpg/1280px-Segeltorp_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Segeltorp_2.jpg","title":"Segeltorp 2"},{"src":"https://upload.wikimedia.org/wikipedia/commons/5/56/General_Carta_V%C3%A5rby_1703_del_Nytorp.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Abraham Hesselgren","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:General_Carta_V%C3%A5rby_1703_del_Nytorp.jpg","title":"General Carta Vårby 1703 del Nytorp"}],"audio":"audio/piper/ba49c430dba0d3b2.mp3"},{"name":"Smista","lat":59.277725,"lon":17.935323},{"name":"Segeltorps centrum","lat":59.278979,"lon":17.942959,"story":"Mittemot Segeltorpsskolan, vid nuvarande Kapellvägen 1, låg förr torpet Holmtorp. Den första torparfamiljen var Jonas Olsson och hans hustru Kjärstin Eriksdotter, båda födda 1710, och på 1760-talet kallades stället Holmtorp eller Cronan. Torpet revs 1859. Ett annat torp, Segeltorp, stod kvar ända till 1964, då Jakobslundsvägens radhusområde byggdes på platsen.","tips":[["Segeltorps kyrka","4 min"]],"dur":26.3,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/5/56/General_Carta_V%C3%A5rby_1703_del_Nytorp.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Abraham Hesselgren","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:General_Carta_V%C3%A5rby_1703_del_Nytorp.jpg","title":"General Carta Vårby 1703 del Nytorp"},{"src":"https://upload.wikimedia.org/wikipedia/commons/0/05/Segeltorps_g%C3%A5rd_f%C3%B6r_1964.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"äldre vykort","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Segeltorps_g%C3%A5rd_f%C3%B6r_1964.jpg","title":"Segeltorps gård för 1964"}],"audio":"audio/piper/1264880024e4179b.mp3"},{"name":"Lövsångarvägen","lat":59.276547,"lon":17.945682},{"name":"Skrakvägen","lat":59.274224,"lon":17.950315,"story":"I vattenvaktarstugan bodde förr en vakt som skulle se till att Stockholms huvudvattenledning mellan Norsborgs vattenverk och Nybohovs reservoar fungerade utan störningar. Den första ledningen byggdes 1902 till 1904 och är än i dag en av stadens viktigaste ledningar för dricksvatten. I Gömmarens naturreservat, en bit bort, finns dessutom lämningar efter en gård från mellersta järnåldern.","tips":[["Vattenvaktarstugan","3 min"],["Segeltorps järnåldersgård","6 min"]],"dur":22.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Stockholms_vattenledningsn%C3%A4t_1910.jpg/1280px-Stockholms_vattenledningsn%C3%A4t_1910.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Stockholms vattenledningsverk","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Stockholms_vattenledningsn%C3%A4t_1910.jpg","title":"Stockholms vattenledningsnät 1910"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cf/%C3%96stra_stenraden_som_markerar_l%C3%A5ngsida_p%C3%A5_l%C3%A5nghus_under_mellersta_j%C3%A4rn%C3%A5ldern.jpg/1280px-%C3%96stra_stenraden_som_markerar_l%C3%A5ngsida_p%C3%A5_l%C3%A5nghus_under_mellersta_j%C3%A4rn%C3%A5ldern.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Kerstin Jensen-Urstad","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:%C3%96stra_stenraden_som_markerar_l%C3%A5ngsida_p%C3%A5_l%C3%A5nghus_under_mellersta_j%C3%A4rn%C3%A5ldern.jpg","title":"Östra stenraden som markerar långsida på långhus under mellersta järnåldern"}],"audio":"audio/piper/9ddde2d02585b62f.mp3"},{"name":"Orrvägen","lat":59.270842,"lon":17.955074},{"name":"Ejdervägen","lat":59.267912,"lon":17.95823},{"name":"Måsvägen","lat":59.26626,"lon":17.962479,"story":"Långsjön är bara tre meter djup men har ett viktigt uppdrag: sjön utgör gränsen mellan Stockholms och Huddinges kommuner, närmare bestämt mellan villaområdena Herrängen och Segeltorp. Vid sjöns norra sida ligger Långsjö gård, med anor från 1600-talet då stället var ett torp under Långbro gård. Gatan Segeltorpsvägen fick sitt namn 1928 efter gården Segeltorp, som revs 1964.","tips":[["Långsjön","4 min"]],"dur":24.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Langsjo_1.jpg/1280px-Langsjo_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Langsjo_1.jpg","title":"Langsjo 1"},{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Langsjo_gard.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Langsjo_gard.jpg","title":"Langsjo gard"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Segeltorpsv%C3%A4gen_2013.jpg/1280px-Segeltorpsv%C3%A4gen_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Segeltorpsv%C3%A4gen_2013.jpg","title":"Segeltorpsvägen 2013"}],"audio":"audio/piper/6cc2910ccfd55c0e.mp3"},{"name":"Tranvägen","lat":59.26436,"lon":17.968497,"story":"Ett par minuters promenad bort ligger Långsjö gård vid Långsjöns norra strand. Den har två identiska huvudbyggnader, och de har en rörande förklaring: affärsmannen Robert Ditzinger lät bygga dem 1882, ett hus till var och en av sina båda söner. Gården har sina anor i 1600-talet och har gett namn åt hela stadsdelen Långsjö.","tips":[["Långsjö gård","4 min"]],"dur":20.1,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Langsjo_gard.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Langsjo_gard.jpg","title":"Langsjo gard"}],"audio":"audio/piper/c089133611de7eca.mp3"},{"name":"Snättringe","lat":59.259313,"lon":17.976478,"story":"I trakten ligger Långsjö gård, som på 1600-talet var ett torp under Långbro gård och senare gav namn åt hela stadsdelen Långsjö. En bit härifrån går också Långsjövägen, som delvis följer den gamla Göta landsväg, där resenärer en gång färdades söderut från Stockholm.","tips":[],"dur":15.8,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Langsjo_gard.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Langsjo_gard.jpg","title":"Langsjo gard"}],"audio":"audio/piper/e436878127b997e3.mp3"},{"name":"Källvägen","lat":59.255372,"lon":17.982792,"story":"Hagsätra centrum invigdes 1960 efter bara ett års byggtid, samma år som tunnelbanan kom hit, och kostade 25 miljoner kronor i dåtidens penningvärde. Centrumets signum är ”Barnet med käpphästen”, en skulptur i koppar av Marie Stenqvist. Behöver man grönska ligger Hagsätraskogen nära, som 2021 blev Stockholms elfte naturreservat.","tips":[["Hagsätra centrum","6 min"],["Hagsätraskogens naturreservat","7 min"]],"dur":20.3,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Hags%C3%A4tra_centrum_2011a.jpg/1280px-Hags%C3%A4tra_centrum_2011a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Hags%C3%A4tra_centrum_2011a.jpg","title":"Hagsätra centrum 2011a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/34/Hags%C3%A4traskogens_naturreservat%2C_april_2012.jpg/1280px-Hags%C3%A4traskogens_naturreservat%2C_april_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Hags%C3%A4traskogens_naturreservat,_april_2012.jpg","title":"Hagsätraskogens naturreservat, april 2012"}],"audio":"audio/piper/44ed5b01d1b96c88.mp3"},{"name":"Heimdalsvägen","lat":59.254283,"lon":17.990599},{"name":"Stuvsta station","lat":59.252486,"lon":17.997255,"story":"Häradsvägen, som slutar en bit härifrån vid Stuvstatunneln, anlades i mitten av 1920-talet som ett nödhjälpsarbete av Svartlösa härads vägförening – det är därifrån namnet kommer. Man fick röja skog för att komma fram, och längs vägen växte villorna upp. Själva tunneln är ovanlig: dess norra mynning är inbyggd i ett bostadshus som står grensle över infarten.","tips":[["Stuvstatunneln","3 min"],["Häradsvägen","3 min"]],"dur":21.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/H%C3%A4radsv%C3%A4gen_Sn%C3%A4ttringe_2012.jpg/1280px-H%C3%A4radsv%C3%A4gen_Sn%C3%A4ttringe_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%A4radsv%C3%A4gen_Sn%C3%A4ttringe_2012.jpg","title":"Häradsvägen Snättringe 2012"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3f/Stuvstatunneln_2012b.jpg/1280px-Stuvstatunneln_2012b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stuvstatunneln_2012b.jpg","title":"Stuvstatunneln 2012b"}],"audio":"audio/piper/153dfa5a2c29d81d.mp3"},{"name":"Skeppsmyreparken","lat":59.248553,"lon":17.996766,"story":"Bilarna på Stuvstaleden försvinner in i berget Kungsklippan genom Stuvstatunneln, 193 meter lång och invigd 1994. Tidigare gick vägen rakt genom Stuvsta, med bullerproblem som följd. Det märkligaste är tunnelns norra mynning: den är integrerad i ett bostadshus som byggdes samtidigt och står grensle över infarten.","tips":[["Stuvstatunneln","5 min"]],"dur":19.4,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3f/Stuvstatunneln_2012b.jpg/1280px-Stuvstatunneln_2012b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stuvstatunneln_2012b.jpg","title":"Stuvstatunneln 2012b"}],"audio":"audio/piper/02b3eeb89cfbf6f8.mp3"},{"name":"Kvarnbergsskolan","lat":59.241925,"lon":17.997389,"story":"Alldeles intill stod Stuvsta gårds kvarn, en väderkvarn på Kvarnberget som gav området Kvarnbergsplan dess namn. En bit bort, vid Huddinge kommunalhus, står Bror Hjorths bronsskulptur Flicka med fruktkorg från 1951 – i naturlig storlek, med en välfylld äppelkorg. Den beställdes för pengar som blev över när sessionssalen hade smyckats med Sven X:et Erixsons stora fresk.","tips":[["Huddingegymnasiet","3 min"]],"dur":21.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/Stuvsta_g%C3%A5rds_kvarn_2013a.jpg/1280px-Stuvsta_g%C3%A5rds_kvarn_2013a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stuvsta_g%C3%A5rds_kvarn_2013a.jpg","title":"Stuvsta gårds kvarn 2013a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg/1280px-Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg","title":"Huddinge kommunalhus Flicka med fruktkorg"}],"audio":"audio/piper/20b9b2d63a358df4.mp3"},{"name":"Kvarnbergsplan","lat":59.241167,"lon":17.994682,"story":"Namnet kommer från Stuvsta gårds väderkvarn, som en gång stod på Kvarnberget. Kvarnen är borta, men flera kvarnstenar finns kvar. En av dem har kommunen ställt vid Gymnasievägen. Norr om Huddinge station spårade ett tåg ur i kurvan en lördagskväll 1908. Ingen dog, och händelsen förevigades på två vykort.","tips":[["Se kvarnstenen vid Gymnasievägen","4 min"]],"dur":19.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Kvarnbergsplan.jpg/1280px-Kvarnbergsplan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Kvarnbergsplan.jpg","title":"Kvarnbergsplan"}],"audio":"audio/piper/55481d613a81ac43.mp3"},{"name":"Huddinge kommunalkontor","lat":59.239333,"lon":17.988348,"story":"Vid kommunalhusets entré står Bror Hjorths brons Flicka med fruktkorg från 1951. Äppelkorgen är en hyllning till Huddinges tusentals villaträdgårdar och husmödrarna som skördade och mustade. Bakom kyrkogården ligger Biskopsstenen, ett jätteblock från istiden. Det mäter 7 gånger 4 meter, och spetsen liknar en biskopsmössa.","tips":[["Se Flicka med fruktkorg","1 min"],["Hitta Biskopsstenen","2 min"]],"dur":20.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg/1280px-Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg","title":"Huddinge kommunalhus Flicka med fruktkorg"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Biskopsstenen_%28Huddinge_139.1%29a.JPG/1280px-Biskopsstenen_%28Huddinge_139.1%29a.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jssfrk","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Biskopsstenen_(Huddinge_139.1)a.JPG","title":"Biskopsstenen (Huddinge 139.1)a"}],"audio":"audio/piper/c03be04f0d5c701e.mp3"},{"name":"Huddinge centrum","lat":59.236378,"lon":17.979406,"story":"Kommunalvägen löper genom Huddinges hjärta, med station, centrum, kyrka och kommunalhus längs sina 1,3 kilometer. Det har också hänt saker nyligen: Sjödalsgymnasiet, som startade 1994, lades ner 2026. Det sista året hade skolan 185 elever, jämfört med 608 bara tre år tidigare.","tips":[],"dur":21.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg/1280px-Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg","title":"Nyboda museum Kommunalvägen 2013"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Sjodalsgymnasiet.jpg/1280px-Sjodalsgymnasiet.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Sjodalsgymnasiet.jpg","title":"Sjodalsgymnasiet"}],"audio":"audio/piper/a333f43400c6c544.mp3"},{"name":"Sördalavägen","lat":59.232885,"lon":17.978747,"story":"Huddinge centrum ligger mitt i en villastad som aldrig blev av. 1902 började ägaren till Fullersta gård sälja tomter för Huddinge villastad. Det var mer lönsamt att sälja byggtomter nära Stockholm än att fortsätta med jordbruket. Bara några av de gamla villorna finns kvar.","tips":[],"dur":16.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Huddinge_villastad.jpg/1280px-Huddinge_villastad.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_villastad.jpg","title":"Huddinge villastad"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Huddinge_centrum_2010b.jpg/1280px-Huddinge_centrum_2010b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_centrum_2010b.jpg","title":"Huddinge centrum 2010b"}],"audio":"audio/piper/f1df9d32467c0b5f.mp3"},{"name":"Helgedalsvägen","lat":59.230982,"lon":17.983273,"story":"Storängshallen alldeles intill, invigd 2007, är en hall främst för friidrott och gymnastik. Trakten har en lustig historia. År 1902 lanserade ägaren till Fullersta gård Huddinge villastad, ett projekt för en hel ny villastad. Bara några enstaka av de gamla villorna finns kvar, och mitt där villastaden skulle ligga står i dag Huddinge centrum.","tips":[["Storängshallen","2 min"]],"dur":19.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Stor%C3%A4ngshallen%2C_mars_2021.jpg/1280px-Stor%C3%A4ngshallen%2C_mars_2021.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Stor%C3%A4ngshallen,_mars_2021.jpg","title":"Storängshallen, mars 2021"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Huddinge_villastad.jpg/1280px-Huddinge_villastad.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_villastad.jpg","title":"Huddinge villastad"}],"audio":"audio/piper/ebcfcc15a9c5683f.mp3"},{"name":"Björkholmsvägen","lat":59.228394,"lon":17.991622,"story":"Storängens industriområde, alldeles i närheten, började byggas i början av 1950-talet, en knapp kilometer sydost om Huddinge centrum. Nu står området inför en förvandling. Enligt en plan från 2009 ska det på sikt bli blandstad, med mest bostäder och verksamheter som passar ihop med boende. I området ligger också Storängshallen för friidrott och gymnastik.","tips":[],"dur":22.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/db/Fabriken_15%2C_Stor%C3%A4ngens_industriomr%C3%A5de%2C_mars_2021e.jpg/1280px-Fabriken_15%2C_Stor%C3%A4ngens_industriomr%C3%A5de%2C_mars_2021e.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Fabriken_15,_Stor%C3%A4ngens_industriomr%C3%A5de,_mars_2021e.jpg","title":"Fabriken 15, Storängens industriområde, mars 2021e"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Stor%C3%A4ngshallen%2C_mars_2021.jpg/1280px-Stor%C3%A4ngshallen%2C_mars_2021.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Stor%C3%A4ngshallen,_mars_2021.jpg","title":"Storängshallen, mars 2021"}],"audio":"audio/piper/97a90a86902da404.mp3"},{"name":"Bläcksvampsvägen","lat":59.223848,"lon":17.996128},{"name":"Sörskogen","lat":59.222304,"lon":17.990136,"story":"Snart är vi framme vid ändhållplatsen Sörskogen. Tack för att du åkte med!","tips":[],"dur":4.6,"audio":"audio/piper/d4fd26e554d773e0.mp3"}],"looks":[],"from":"Skärholmen","to":"Sörskogen","variant":"Mot Sörskogen","color":["#d71d24","#ffffff"],"trips":79,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}