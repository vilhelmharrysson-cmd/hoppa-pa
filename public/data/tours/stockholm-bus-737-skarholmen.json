r att du åkte med!","tips":[],"dur":24.8,"audio":"audio/piper/c9a2c70527570831.mp3"}],"looks":[],"from":"Tumba station","to":"Skärholmen","variant":"Mot Skärholmen","color":["#d71d24","#ffffff"],"trips":10,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}