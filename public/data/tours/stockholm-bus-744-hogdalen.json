{"id":"stockholm-bus-744-hogdalen","group":"stockholm-bus-744","city":"Stockholm","mode":"bus","line":"744","vehicle":"buss","vehicleLong":"buss","operator":"SL","api":"sl","tab":"","guide":null,"speedKmh":18,"dwellSec":15,"route":[[59.19249,17.974755],[59.192271,17.975618],[59.192202,17.976354],[59.192261,17.980062],[59.192073,17.981806],[59.191572,17.984863],[59.191581,17.986821],[59.191257,17.988543],[59.191158,17.990303],[59.191315,17.990884],[59.192904,17.994304],[59.1942,17.997979],[59.19462,18.000125],[59.195376,18.005485],[59.195764,18.006624],[59.195786,18.00707],[59.196109,18.007487],[59.196972,18.009736],[59.199146,18.007876],[59.199194,18.008049],[59.199157,18.007867],[59.20146,18.005923],[59.202134,18.005605],[59.202518,18.005612],[59.204656,18.007169],[59.205315,18.007332],[59.207034,18.008262],[59.210275,18.013444],[59.211288,18.014349],[59.212234,18.014638],[59.213202,18.014474],[59.214265,18.013739],[59.214296,18.013832],[59.214286,18.013723],[59.217064,18.011425],[59.219049,18.010126],[59.219992,18.009165],[59.22013,18.009265],[59.220179,18.009025],[59.221081,18.007775],[59.221253,18.007794],[59.221463,18.008311],[59.221692,18.007829],[59.22162,18.006987],[59.223291,18.004472],[59.22538,18.000953],[59.226248,17.999952],[59.226789,17.999671],[59.229975,17.999337],[59.231723,17.997912],[59.233326,17.997409],[59.23276,17.991648],[59.2321,17.990821],[59.232076,17.990573],[59.231943,17.990628],[59.229605,17.988],[59.231607,17.981474],[59.232386,17.979659],[59.234018,17.977779],[59.234187,17.978288],[59.234452,17.978599],[59.235499,17.97878],[59.235859,17.978989],[59.237456,17.981359],[59.238838,17.985034],[59.239437,17.989736],[59.239679,17.990566],[59.240287,17.99169],[59.240734,17.99323],[59.240858,17.993845],[59.240847,17.994185],[59.240719,17.994328],[59.240745,17.994534],[59.240901,17.994549],[59.241433,17.995133],[59.24144,17.995481],[59.241535,17.995584],[59.241647,17.99533],[59.243637,17.994],[59.244573,17.996572],[59.24543,17.999826],[59.246128,18.001596],[59.246702,18.002773],[59.250031,18.008609],[59.250504,18.009264],[59.25278,18.011226],[59.254298,18.012841],[59.254264,18.012958],[59.254298,18.01284],[59.255229,18.013801],[59.255896,18.01415],[59.256829,18.01428],[59.256737,18.015778],[59.255868,18.018636],[59.255968,18.020806],[59.254365,18.022563],[59.253628,18.024226],[59.252661,18.025644],[59.252527,18.025999],[59.252485,18.026709],[59.252974,18.031104],[59.253716,18.032949],[59.254252,18.034788],[59.254829,18.035882],[59.255378,18.036237],[59.256904,18.03613],[59.257425,18.035628],[59.257773,18.034738],[59.257735,18.032574],[59.257454,18.031681],[59.25744,18.031143],[59.257633,18.030169],[59.257728,18.029936],[59.257877,18.029899],[59.25786,18.029622],[59.258175,18.028996],[59.258989,18.031885],[59.258644,18.032248],[59.260156,18.037701],[59.260823,18.039309],[59.261664,18.040558],[59.262473,18.041398],[59.262683,18.0406],[59.263017,18.041094],[59.263218,18.041804],[59.263044,18.042586],[59.262988,18.042522]],"stops":[{"name":"Gladö kvarn","lat":59.19249,"lon":17.974755,"story":"Välkommen ombord på buss 744 mot Högdalen! Resan tar ungefär 59 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":9.5,"audio":"audio/piper/1224b562ab555405.mp3"},{"name":"Torget","lat":59.191927,"lon":17.982631},{"name":"Kvarnsjön","lat":59.191157,"lon":17.989534},{"name":"Krönet","lat":59.192788,"lon":17.994067,"story":"En bit härifrån låg torpet Parken, anlagt 1839 och rivet i mitten av 1950-talet, ungefär när Bagarmossen växte fram som förort. Stadsdelen är i dag en välbevarad 1950-talsförort, känd för sina många gångvägar och gångtunnlar som håller gående och bilar isär, och för låga flerfamiljshus, småhus och radhus som följer naturen väl.","tips":[],"dur":21.9,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/a/af/Torpet_Parken%2C_Bagarmossen_1949a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Torpet_Parken,_Bagarmossen_1949a.jpg","title":"Torpet Parken, Bagarmossen 1949a"},{"src":"https://upload.wikimedia.org/wikipedia/commons/c/cb/Bagarmossen_centrum_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bagarmossen_centrum_1.jpg","title":"Bagarmossen centrum 1"},{"src":"https://pub.raa.se/dokumentation/51882c44-07c7-4a18-8be9-e0dc21672ddb/visning/1","credit":"Westlund, Per Olof","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/51882c44-07c7-4a18-8be9-e0dc21672ddb","title":"Långhusvinden, krönet av rundhusets yttermur","old":true,"year":1935,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/32241acb-147c-4310-b303-073e16a0451b/visning/1","credit":"Roosval, Johnny","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/32241acb-147c-4310-b303-073e16a0451b","title":"Epitafium, detalj, figur nu placerad på krönet av A. Salvius epitafium","old":true,"year":null,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/24ad2059845915c9.mp3"},{"name":"Lidavägen","lat":59.19521,"lon":18.00463},{"name":"Gladövägen","lat":59.199194,"lon":18.008049,"story":"På Sundby gård en bit härifrån finns Litografiska museet, det enda museet i sitt slag i Sverige, helt ägnat åt konsten att trycka från sten. Strax söder om gården ligger Sundbyfortet, även kallat Örnnästet, vid södra viken av Orlången. Fortet var en del av Södra fronten, som byggdes kring första världskriget för att skydda Stockholm mot angrepp söderifrån.","tips":[["Litografiska museet","7 min"],["Sundbyfortet","8 min"]],"dur":19.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Litografiska_museet_2012e.jpg/1280px-Litografiska_museet_2012e.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Litografiska_museet_2012e.jpg","title":"Litografiska museet 2012e"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b4/Sundbyfortet_jan_2013a_01.jpg/1280px-Sundbyfortet_jan_2013a_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sundbyfortet_jan_2013a_01.jpg","title":"Sundbyfortet jan 2013a 01"}],"audio":"audio/piper/84cfe138abf60e34.mp3"},{"name":"Sjötorp","lat":59.209712,"lon":18.012738,"story":"Sjötorp var ett torp under Balingsta gård vid Flemingsbergsviken. Huvudbyggnaden uppfördes 1904 av Ersta diakonisällskap som hem för, med tidens ord, vanartiga flickor. Sedan 1998 är den privatbostad, mitt i Orlångens naturreservat. Ett par hundra meter bort ligger Stensättra gård, ett gammalt säteri i en trakt som troligen befolkades redan på vikingatiden.","tips":[["Sjötorp","3 min"],["Stensättra gård","7 min"]],"dur":22.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Sj%C3%B6torp_Balingsta_2013a_01.jpg/1280px-Sj%C3%B6torp_Balingsta_2013a_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sj%C3%B6torp_Balingsta_2013a_01.jpg","title":"Sjötorp Balingsta 2013a 01"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b4/Stens%C3%A4ttra_g%C3%A5rd_2011a.jpg/1280px-Stens%C3%A4ttra_g%C3%A5rd_2011a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stens%C3%A4ttra_g%C3%A5rd_2011a.jpg","title":"Stensättra gård 2011a"}],"audio":"audio/piper/309cc19c96c2beb3.mp3"},{"name":"Balingstavägen","lat":59.214296,"lon":18.013832,"story":"En bit härifrån, i Orlångens naturreservat, ligger skogssjön Mörtsjön. Vid dess strand ligger torpet Charlottendal, där prins Eugen målade tavlan Våren. Sjön är ovanligt näringsrik för att vara en skogssjö, så ruda och sarv trivs, och någon har dessutom planterat in karp. I andra riktningen ligger det gamla torpet Sjötorp vid Flemingsbergsviken.","tips":[],"dur":20.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/M%C3%B6rtsj%C3%B6n_Huddinge.jpg/1280px-M%C3%B6rtsj%C3%B6n_Huddinge.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:M%C3%B6rtsj%C3%B6n_Huddinge.jpg","title":"Mörtsjön Huddinge"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Sj%C3%B6torp_Balingsta_2013a_01.jpg/1280px-Sj%C3%B6torp_Balingsta_2013a_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Sj%C3%B6torp_Balingsta_2013a_01.jpg","title":"Sjötorp Balingsta 2013a 01"}],"audio":"audio/piper/29d359dd275866d9.mp3"},{"name":"Balingsnäs","lat":59.221686,"lon":18.007216},{"name":"Mellansjö","lat":59.225004,"lon":18.001757},{"name":"Glimmervägen","lat":59.228787,"lon":17.999606},{"name":"Centralvägen","lat":59.233215,"lon":17.99604,"story":"Namnet Trolldalen har använts sedan 1700-talet och syftade då på ravinen mitt i skogen på Henriksdalsberget, en sprickdal som gärna sätter fart på fantasin. Uppe på berget ligger Henriksdalsringen, som byggdes 1964 till 1969 efter ritningar av bröderna Erik och Tore Ahlsén, som efteråt själva valde att flytta dit. En bit bort, i Finnboda, låg Finnboda varv mellan 1884 och 1991.","tips":[["Trolldalen","2 min"]],"dur":25.7,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Finnboda.jpg/1280px-Finnboda.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Finnboda.jpg","title":"Finnboda"}],"audio":"audio/piper/11596f14902e6de0.mp3"},{"name":"Ängsnäsvägen","lat":59.232314,"lon":17.991002},{"name":"Dalhemsvägen","lat":59.230436,"lon":17.988793},{"name":"Helgedalsvägen","lat":59.231192,"lon":17.983246,"story":"Storängshallen alldeles intill, invigd 2007, är en hall främst för friidrott och gymnastik. Trakten har en lustig historia. År 1902 lanserade ägaren till Fullersta gård Huddinge villastad, ett projekt för en hel ny villastad. Bara några enstaka av de gamla villorna finns kvar, och mitt där villastaden skulle ligga står i dag Huddinge centrum.","tips":[["Storängshallen","2 min"]],"dur":19.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Stor%C3%A4ngshallen%2C_mars_2021.jpg/1280px-Stor%C3%A4ngshallen%2C_mars_2021.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Stor%C3%A4ngshallen,_mars_2021.jpg","title":"Storängshallen, mars 2021"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Huddinge_villastad.jpg/1280px-Huddinge_villastad.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_villastad.jpg","title":"Huddinge villastad"}],"audio":"audio/piper/ebcfcc15a9c5683f.mp3"},{"name":"Sördalavägen","lat":59.233219,"lon":17.978717,"story":"Huddinge centrum ligger mitt i en villastad som aldrig blev av. 1902 började ägaren till Fullersta gård sälja tomter för Huddinge villastad. Det var mer lönsamt att sälja byggtomter nära Stockholm än att fortsätta med jordbruket. Bara några av de gamla villorna finns kvar.","tips":[],"dur":16.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Huddinge_villastad.jpg/1280px-Huddinge_villastad.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_villastad.jpg","title":"Huddinge villastad"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Huddinge_centrum_2010b.jpg/1280px-Huddinge_centrum_2010b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_centrum_2010b.jpg","title":"Huddinge centrum 2010b"}],"audio":"audio/piper/f1df9d32467c0b5f.mp3"},{"name":"Huddinge centrum","lat":59.236513,"lon":17.980043,"story":"Kommunalvägen löper genom Huddinges hjärta, med station, centrum, kyrka och kommunalhus längs sina 1,3 kilometer. Det har också hänt saker nyligen: Sjödalsgymnasiet, som startade 1994, lades ner 2026. Det sista året hade skolan 185 elever, jämfört med 608 bara tre år tidigare.","tips":[],"dur":21.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg/1280px-Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nyboda_museum_Kommunalv%C3%A4gen_2013.jpg","title":"Nyboda museum Kommunalvägen 2013"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Sjodalsgymnasiet.jpg/1280px-Sjodalsgymnasiet.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Sjodalsgymnasiet.jpg","title":"Sjodalsgymnasiet"},{"src":"https://pub.raa.se/dokumentation/06e8db91-217b-48d0-9409-532f39e50d76/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/06e8db91-217b-48d0-9409-532f39e50d76","title":"Bygget av Karolinska Universitetssjukhuset i Huddinge. Huddingevägen, Flemmingsberg, Visättra","old":true,"year":1970,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/a333f43400c6c544.mp3"},{"name":"Huddinge kommunalkontor","lat":59.239155,"lon":17.987869,"story":"Vid kommunalhusets entré står Bror Hjorths brons Flicka med fruktkorg från 1951. Äppelkorgen är en hyllning till Huddinges tusentals villaträdgårdar och husmödrarna som skördade och mustade. Bakom kyrkogården ligger Biskopsstenen, ett jätteblock från istiden. Det mäter 7 gånger 4 meter, och spetsen liknar en biskopsmössa.","tips":[["Se Flicka med fruktkorg","1 min"],["Hitta Biskopsstenen","2 min"]],"dur":20.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg/1280px-Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Huddinge_kommunalhus_Flicka_med_fruktkorg.jpg","title":"Huddinge kommunalhus Flicka med fruktkorg"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Biskopsstenen_%28Huddinge_139.1%29a.JPG/1280px-Biskopsstenen_%28Huddinge_139.1%29a.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jssfrk","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Biskopsstenen_(Huddinge_139.1)a.JPG","title":"Biskopsstenen (Huddinge 139.1)a"}],"audio":"audio/piper/c03be04f0d5c701e.mp3"},{"name":"Kvarnbergsplan","lat":59.241257,"lon":17.995111,"story":"Namnet kommer från Stuvsta gårds väderkvarn, som en gång stod på Kvarnberget. Kvarnen är borta, men flera kvarnstenar finns kvar. En av dem har kommunen ställt vid Gymnasievägen. Norr om Huddinge station spårade ett tåg ur i kurvan en lördagskväll 1908. Ingen dog, och händelsen förevigades på två vykort.","tips":[["Se kvarnstenen vid Gymnasievägen","4 min"]],"dur":19.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Kvarnbergsplan.jpg/1280px-Kvarnbergsplan.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Kvarnbergsplan.jpg","title":"Kvarnbergsplan"}],"audio":"audio/piper/55481d613a81ac43.mp3"},{"name":"Huddinge gymnasium","lat":59.244874,"lon":17.997873,"story":"Uppe på Kvarnberget snurrade en gång Stuvsta gårds väderkvarn, och det är den som gett hela området Kvarnbergsplan dess namn. Flera kvarnstenar finns bevarade, och en av dem har kommunen placerat vid Gymnasievägen. Där ligger också Huddingegymnasiet, vars skolhus räknas som en av kommunens särskilt värdefulla byggnader.","tips":[["Huddingegymnasiet","2 min"]],"dur":17.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Huddingegymnasiet.jpg/1280px-Huddingegymnasiet.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"AleWi","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Huddingegymnasiet.jpg","title":"Huddingegymnasiet"}],"audio":"audio/piper/6690f3f4922bc9da.mp3"},{"name":"Dalkarlsvägen","lat":59.248404,"lon":18.005939,"story":"Stuvsta sträcker sig hela vägen från Hagsätra i norr ner till Tomtberga och Hörningsnäs gård i söder, och österut till sjön Trehörningen. En bit härifrån går Stuvstaleden genom berget Kungsklippan i Stuvstatunneln, invigd 1994, vars norra mynning är inbyggd i ett bostadshus som står grensle över infarten.","tips":[],"dur":17.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4b/Stuvsta_2012b.jpg/1280px-Stuvsta_2012b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stuvsta_2012b.jpg","title":"Stuvsta 2012b"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3f/Stuvstatunneln_2012b.jpg/1280px-Stuvstatunneln_2012b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stuvstatunneln_2012b.jpg","title":"Stuvstatunneln 2012b"}],"audio":"audio/piper/7ba7454997005156.mp3"},{"name":"Ågestavägen","lat":59.251171,"lon":18.009943},{"name":"Bäckdalsvägen","lat":59.254264,"lon":18.012958},{"name":"Rågsvedsvägen","lat":59.256137,"lon":18.017564,"story":"En bit härifrån ligger Rågsveds tunnelbanestation, som öppnade den 14 november 1959 och var ändstation fram till 1960, då spåren förlängdes till Hagsätra. Plattformen ligger utomhus, och där står bronsskulpturen Fågel Grön av konstnären Björn Selder. Stadsdelen delas mitt itu av tunnelbanan, med det ikoniska hästskoformade centrumet på ena sidan.","tips":[],"dur":21.4,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/4/46/Ragsveds_tunnelbana.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Daniel Mott","license":"CC BY-SA 2.5","page":"https://commons.wikimedia.org/wiki/File:Ragsveds_tunnelbana.jpg","title":"Ragsveds tunnelbana"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/R%C3%A5gsved.jpg/1280px-R%C3%A5gsved.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Sofie Sigrinn","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:R%C3%A5gsved.jpg","title":"Rågsved"}],"audio":"audio/piper/e6aeb8973e68e684.mp3"},{"name":"Gillerbacken","lat":59.252734,"lon":18.029337},{"name":"Bäverdammsgränd","lat":59.253856,"lon":18.03349,"story":"Rågsved är känt för sin ikoniska hästskoformade centrumanläggning, och tunnelbanestationen var ändstation när den öppnade 1959. På plattformen står bronsskulpturen Fågel Grön av konstnären Björn Selder. En bit bort i Högdalen ligger Cyklopen, ett självförvaltat kulturhus som drivs helt ideellt – det första huset brann ner 2008 i en anlagd brand av misstänkta nazister, men föreningen byggde upp ett nytt.","tips":[["Rågsveds friområde","6 min"]],"dur":23.2,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/2/23/Cyklopen.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Qvarten","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Cyklopen.jpg","title":"Cyklopen"}],"audio":"audio/piper/d87bd39baac52ab7.mp3"},{"name":"Lurstigen","lat":59.255765,"lon":18.036277,"story":"Söder om Rågsved tar Rågsveds friområde vid, även kallat Kräppladalen, drygt 100 hektar natur med stundtals dramatisk topografi, höjder, branter och dalgångar i ett gammalt sprickdalslandskap. En del av området blev naturreservat 2018. Åt andra hållet ligger Högdalens skatepark, Stockholms största, som togs initiativ till av föreningen Stockholm Sub Surfers.","tips":[["Rågsveds naturreservat","7 min"],["Högdalens skatepark","8 min"]],"dur":22.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2d/Kr%C3%A4ppla%C3%A5n_mars_2015.jpg/1280px-Kr%C3%A4ppla%C3%A5n_mars_2015.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Kr%C3%A4ppla%C3%A5n_mars_2015.jpg","title":"Kräpplaån mars 2015"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/07/Highvalley_Skatepark_%287961927896%29.jpg/1280px-Highvalley_Skatepark_%287961927896%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Per-Olof Forsberg","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Highvalley_Skatepark_(7961927896).jpg","title":"Highvalley Skatepark (7961927896)"}],"audio":"audio/piper/c412ba0546ad99c1.mp3"},{"name":"Hardemogatan","lat":59.258472,"lon":18.030128,"story":"En kort promenad bort ligger kulturhuset Cyklopen, självförvaltat och ideellt, med musik, konst och folkbildning. Det första huset brann ner 2008 i en anlagd brand men byggdes upp igen. Strax nedanför Högdalens centrum ligger dessutom Högdalens skatepark, med cirka 5 500 kvadratmeter betong den största i Stockholm och nästan lika stor som Stapelbäddsparken i Malmö.","tips":[["Cyklopen","8 min"],["Högdalens skatepark","8 min"]],"dur":22.2,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/2/23/Cyklopen.jpg?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Qvarten","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Cyklopen.jpg","title":"Cyklopen"}],"audio":"audio/piper/546365d22291b927.mp3"},{"name":"Högdalen","lat":59.262988,"lon":18.042522,"story":"Snart är vi framme vid ändhållplatsen Högdalen. Inte långt härifrån reser sig tre konstgjorda berg av rivningsmassor och grovsopor. Det första, Högdalstoppen, var klart 1964, och berget där var tidigare den högsta punkten i Högdalen och Fagersjö. I dag är topparna friluftsområde med skatepark och discgolfbana. Högdalstoppen 3 fylls fortfarande på med schaktmassor från vägbyggen. Tack för att du åkte med!","tips":[],"dur":24.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/H%C3%B6gdalens_tunnelbanestation.jpg/1280px-H%C3%B6gdalens_tunnelbanestation.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6gdalens_tunnelbanestation.jpg","title":"Högdalen metro station","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/47/H%C3%B6gdalen_Harpsundsv%C3%A4gen%2C_2016b.jpg/1280px-H%C3%B6gdalen_Harpsundsv%C3%A4gen%2C_2016b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B6gdalen_Harpsundsv%C3%A4gen,_2016b.jpg","title":"Högdalen Harpsundsvägen \"Tupphuset\"","near":true},{"src":"https://pub.raa.se/dokumentation/724f5067-f3ab-4c7f-9020-aa8065e2f0af/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/724f5067-f3ab-4c7f-9020-aa8065e2f0af","title":"Högdalen vattentorn","old":true,"year":1968,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/81c8d0cb0d41ce61.mp3"}],"looks":[],"from":"Gladö kvarn","to":"Högdalen","variant":"Mot Högdalen","color":["#d71d24","#ffffff"],"trips":75,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}