,[59.322209,18.074459],[59.320519,18.072989],[59.320339,18.072669],[59.320149,18.071879],[59.320019,18.071019],[59.320094,18.070981],[59.320019,18.07102],[59.319739,18.069049],[59.31958,18.068609],[59.317409,18.06989],[59.313999,18.07143],[59.31399,18.07202],[59.314379,18.075201],[59.315523,18.0838],[59.310217,18.086293],[59.309987,18.086323],[59.309771,18.085646],[59.308652,18.088486]],"stops":[{"name":"Ropsten","lat":59.357891,"lon":18.103781,"story":"Välkommen ombord på buss 76 mot Ljusterögatan! Resan tar ungefär 42 minuter. Från Ropsten går Lidingöbanan över Lidingöbron ut till Lidingö. Bron öppnade 1925 och var länge den enda landförbindelsen till ön.","tips":[["Utsikt mot Lidingö","2 min",59.364155,18.131047]],"dur":14.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Liding%C3%B6bron_2010-04-17.jpg/1280px-Liding%C3%B6bron_2010-04-17.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Esquilo","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Liding%C3%B6bron_2010-04-17.jpg","title":"A tram-car on Lidingöbanan passing Lidingöbron.","near":true}],"audio":"audio/piper/b4295b1f651142e9.mp3"},{"name":"Värtahamnens färjeterminal","lat":59.351388,"lon":18.109403},{"name":"Hangövägen","lat":59.348519,"lon":18.111264,"story":"Värtahamnen anlades 1879 till 1886 som hamn för kol och annat skrymmande gods, i dag går färjorna härifrån till Finland, Åland, Estland och Lettland. I det gamla Kommunalhuset låg Värtans brandstation mellan 1905 och 1934. En bit bort, utanför Värtaverkets entré, står Kungseken, cirka 600 år gammal. Den har troligen fått namnet efter Oscar II, som gjorde vårutflykter till eken.","tips":[["Värtans stationshus","4 min"]],"dur":26.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/V%C3%A4rtahamnen_helikopter.JPG/1280px-V%C3%A4rtahamnen_helikopter.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Jan Ainali","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:V%C3%A4rtahamnen_helikopter.JPG","title":"Värtahamnen helikopter"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Kommunalhuset_i_V%C3%A4rtan.jpg/1280px-Kommunalhuset_i_V%C3%A4rtan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kommunalhuset_i_V%C3%A4rtan.jpg","title":"Kommunalhuset i Värtan"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Kungseken_Hjorthagen_2012.jpg/1280px-Kungseken_Hjorthagen_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kungseken_Hjorthagen_2012.jpg","title":"Kungseken Hjorthagen 2012"}],"audio":"audio/piper/15eaceb18fb66e8a.mp3"},{"name":"Malmvägen","lat":59.347461,"lon":18.113466,"story":"På slottsområdet står en stuga som har varit på världsutställning! Ornässtugan är en något mindre kopia av Ornässtugan i Ornäs i Dalarna, visades på världsutställningen i Paris 1867 och har stått här sedan 1869. I grannskapet finns också villor med lustiga namn, som Villa Snörin, som uttalas snör-in.","tips":[["Ornässtugan","6 min"]],"dur":19.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Orn%C3%A4sstugan%2C_Ulriksdal%2C_okt_2012a.jpg/1280px-Orn%C3%A4sstugan%2C_Ulriksdal%2C_okt_2012a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Orn%C3%A4sstugan,_Ulriksdal,_okt_2012a.jpg","title":"Ornässtugan, Ulriksdal, okt 2012a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Villa_Sn%C3%B6rin%2C_Ulriksdal%2C_2015a.jpg/1280px-Villa_Sn%C3%B6rin%2C_Ulriksdal%2C_2015a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Sn%C3%B6rin,_Ulriksdal,_2015a.jpg","title":"Villa Snörin, Ulriksdal, 2015a"}],"audio":"audio/piper/b1e51efb82c125c4.mp3"},{"name":"Frihamnen","lat":59.341873,"lon":18.118316,"story":"Stockholms frihamn öppnade som ett provisorium 1919 och byggdes ut ända fram till 1970-talet. Under samma tid landade sjöflygplan vid Lindarängen, där frihamnen nu ligger, mellan 1921 och 1952. Fordhuset, ritat av Uno Åhrén, byggdes 1929 till 1931 som sammansättningsfabrik för Fordbilar, och i dag huserar börsföretaget Nasdaq där. Det enorma Magasin 6 blev däremot snabbt omodernt när containertrafiken tog över.","tips":[["Fordhuset","5 min",59.339444,18.120833]],"dur":29.0,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Stockholms_frihamn_2009a.jpg/1280px-Stockholms_frihamn_2009a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stockholms_frihamn_2009a.jpg","title":"Stockholms frihamn 2009a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Stockholms_frihamn_2011a_Fordbyggnaden.jpg/1280px-Stockholms_frihamn_2011a_Fordbyggnaden.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stockholms_frihamn_2011a_Fordbyggnaden.jpg","title":"Stockholms frihamn 2011a Fordbyggnaden"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Magasin_6_2009.JPG/1280px-Magasin_6_2009.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Stockholm_2009_PD_019.JPG: Bin im Garten derivative work: Ankara (talk)","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Magasin_6_2009.JPG","title":"Magasin 6 2009"}],"audio":"audio/piper/4fc9634917d68064.mp3"},{"name":"Frihamnsporten","lat":59.339967,"lon":18.114371,"story":"Bostadshuset 79&Park, alldeles intill, är ritat av det danska arkitektkontoret Bjarke Ingels Group och nominerades till Årets Stockholmsbyggnad 2019. En bit bort, i ett lagerhus från 1920-talet i Frihamnen, grundade finansmannen Robert Weil och museichefen David Neuman 1987 det som blev konstmuseet Magasin III. Sedan maj 2024 har museet stängt sin publika verksamhet i Stockholm.","tips":[["79&Park","2 min",59.338,18.07463]],"dur":25.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/Magasin3.JPG/1280px-Magasin3.JPG?utm_source=sv.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Ankara","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Magasin3.JPG","title":"Magasin3"}],"audio":"audio/piper/2b55eaa7e66f7710.mp3"},{"name":"Lindarängsvägen","lat":59.33954,"lon":18.112696},{"name":"Filmhuset","lat":59.339148,"lon":18.103822,"story":"Peter Celsing ritade Filmhuset åt Svenska Filminstitutet, och det togs i bruk 1971. Filminstitutet, som bland annat delar ut Guldbaggarna, leds härifrån. Ett stenkast bort, på Hakberget, reser sig skulpturen Protest från 1986, tre block av röd granit där det mittersta formar en knytnäve. Platsen var mål för arbetarrörelsens förstamajtåg från 1890 till 1965. Och precis intill ligger en militär helikopterflygplats utan särskild infrastruktur.","tips":[["Filmhuset","2 min",59.33987,18.10366],["Skulpturen Protest","2 min",59.338056,18.104167]],"dur":30.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Filmhuset_2009b.jpg/1280px-Filmhuset_2009b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Filmhuset_2009b.jpg","title":"Filmhuset 2009b"},{"src":"https://upload.wikimedia.org/wikipedia/commons/3/3b/Svenska_Filminstitutet_-_Filmhuset_-_Borgv%C3%A4gen_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Vargklo","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Svenska_Filminstitutet_-_Filmhuset_-_Borgv%C3%A4gen_1.jpg","title":"Svenska Filminstitutet - Filmhuset - Borgvägen 1"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/Protest_skulptur_2011b.jpg/1280px-Protest_skulptur_2011b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Protest_skulptur_2011b.jpg","title":"Protest skulptur 2011b"}],"audio":"audio/piper/77fdf88dda0e7017.mp3"},{"name":"Oxenstiernsgatan","lat":59.337363,"lon":18.102259},{"name":"Radiohuset","lat":59.335006,"lon":18.10034},{"name":"Berwaldhallen","lat":59.333036,"lon":18.098276,"story":"I Nobelparken, ett stenkast härifrån, skulle det ha stått ett monumentalt Nobelpalats till Alfred Nobels minne. Ferdinand Boberg ritade på det mellan 1906 och 1911, men det byggdes aldrig. Det enda som påminner om de storslagna planerna är namnen Nobelparken och Nobelgatan, som bestämdes 1912. Gatan leder i dag genom Diplomatstaden, ett exklusivt villaområde.","tips":[["Nobelparken","2 min",59.331944,18.098889]],"dur":23.8,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Nobelparken_2007.jpg/1280px-Nobelparken_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nobelparken_2007.jpg","title":"Nobelparken 2007"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3e/Nobelpalatset_1.jpg/1280px-Nobelpalatset_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nobelpalatset_1.jpg","title":"Nobelpalatset 1"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Nobelgatan_2008.jpg/1280px-Nobelgatan_2008.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Nobelgatan_2008.jpg","title":"Nobelgatan 2008"}],"audio":"audio/piper/00ab5e6d79b4bccd.mp3"},{"name":"Djurgårdsbron","lat":59.331878,"lon":18.092172,"story":"Över bron når vi Djurgården, som i flera hundra år var kungens jaktpark. I dag är ön en del av Kungliga nationalstadsparken, med museer, nöjesfält och stora grönområden.","tips":[["Promenad längs Djurgårdsbrunnsviken","3 min",59.3309,18.108]],"dur":10.6,"images":[{"src":"https://sokisamlingar.sormlandsmuseum.se/files/fullsize/4c64568fcadc5c13adb076da2b27a608.jpg","credit":"Okänd","license":"CC BY","page":"https://kulturarvsdata.se/SLM/item/html/417166","title":"Djurgårdsbron","old":true,"year":1897,"museum":"Sörmlands museum"},{"src":"https://pub.raa.se/dokumentation/baa0f187-b7c1-4eca-bfcd-51cc18dd0859/visning/1","credit":"Norrman, Jan","license":"CC BY","page":"https://kulturarvsdata.se/raa/dokumentation/html/baa0f187-b7c1-4eca-bfcd-51cc18dd0859","title":"Djurgårdsbron över Ladugårdslandsviken i Saltsjön. Nere till vänster Nordiska museet statligt byggnadsminne RA","old":true,"year":1990,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/48ea627f1f3c14bd.mp3"},{"name":"Styrmansgatan","lat":59.331684,"lon":18.083309},{"name":"Nybroplan","lat":59.332827,"lon":18.076221,"story":"Vid Nybroplan ligger Dramaten, Kungliga Dramatiska teatern, invigd 1908. Härifrån börjar Strandvägen, med sina pampiga sekelskifteshus längs vattnet, och från Nybrokajen går båtar ut i skärgården.","tips":[["Strandvägen, promenad längs vattnet","2 min",59.331667,18.088333],["Båtar från Nybrokajen","2 min",59.331489,18.076356]],"dur":12.5,"images":[{"src":"https://pub.raa.se/dokumentation/40c8b182-f89b-41d4-9376-5386108120ab/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/40c8b182-f89b-41d4-9376-5386108120ab","title":"Nybroplan/Birgerjarlsgatan, Stockholm City","old":true,"year":1966,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/ea4ba032-18b9-48b6-8228-6d2c117fa83a/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/ea4ba032-18b9-48b6-8228-6d2c117fa83a","title":"Nybroplan mot Hötorgscity - City","old":true,"year":1967,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/db93ec2f482d16a4.mp3"},{"name":"Kungsträdgården","lat":59.332241,"lon":18.07191,"story":"Kungsträdgården var från början kungens köksträdgård. I dag är den en av stadens mest omtyckta parker, och på våren blommar körsbärsträden här i rosa och vitt.","tips":[["Kungsträdgården","1 min",59.330833,18.070994],["Kungliga Operan","4 min",59.329722,18.070556]],"dur":9.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Folkvimmel_p%C3%A5_promendstr%C3%A5ken_vid_Kungstr%C3%A4dg%C3%A5rden%2C_en_mycket_varm_m%C3%A5ndagkv%C3%A4ll%2C_Sveriges_Nationaldag_-_panoramio_%289%29.jpg/1280px-Folkvimmel_p%C3%A5_promendstr%C3%A5ken_vid_Kungstr%C3%A4dg%C3%A5rden%2C_en_mycket_varm_m%C3%A5ndagkv%C3%A4ll%2C_Sveriges_Nationaldag_-_panoramio_%289%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Gagarinone","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Folkvimmel_p%C3%A5_promendstr%C3%A5ken_vid_Kungstr%C3%A4dg%C3%A5rden,_en_mycket_varm_m%C3%A5ndagkv%C3%A4ll,_Sveriges_Nationaldag_-_panoramio_(9).jpg","title":"Folkvimmel på promendstråken vid Kungsträdgården, en mycket varm måndagkväll, Sveriges Nationaldag","near":true},{"src":"https://pub.raa.se/dokumentation/2dd0d24b-a1a2-44d1-86f6-c051d3824f51/visning/1","credit":"Rosenberg, Carl Gustaf","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/2dd0d24b-a1a2-44d1-86f6-c051d3824f51","title":"Utsikt mot Slottet från Kungsträdgården","old":true,"year":1922,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/ee5643ae-c47e-4579-9543-099f026163cb/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/ee5643ae-c47e-4579-9543-099f026163cb","title":"Kungsträdgården - City","old":true,"year":1967,"museum":"Riksantikvarieämbetet"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/K%C3%B6rsb%C3%A4rsblom_i_Kungstr%C3%A4dg%C3%A5rden_03.JPG/1280px-K%C3%B6rsb%C3%A4rsblom_i_Kungstr%C3%A4dg%C3%A5rden_03.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"I99pema","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:K%C3%B6rsb%C3%A4rsblom_i_Kungstr%C3%A4dg%C3%A5rden_03.JPG","title":"Körsbärsblom i Kungsträdgården This is a photo of a building (without protection) in Sweden, number ","near":true}],"audio":"audio/piper/7c7439e25bb3acdc.mp3"},{"name":"Karl XII:s torg","lat":59.329946,"lon":18.0732,"story":"Karl XII står i brons och pekar mot Ryssland, som en påminnelse om sina krig. Statyn av Johan Peter Molin avtäcktes den 30 november 1868, på 150-årsdagen av kungens död. Den göts på Kungsholmen och väger två och ett halvt ton. Mörsarna runt sockeln är krigsbyte från Riga. Miljöpartiet har motionerat om att flytta statyn.","tips":[],"dur":21.6,"images":[{"src":"https://pub.raa.se/dokumentation/9e5cc47a-a2b8-40b6-b0d9-56d9a4a81c69/visning/1","credit":"Curman, Carl","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/9e5cc47a-a2b8-40b6-b0d9-56d9a4a81c69","title":"Karl XII:s torg i Kungsträdgården","old":true,"year":1900,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/d8897c9ca8530c2a.mp3"},{"name":"Slottsbacken","lat":59.325812,"lon":18.075401,"story":"Uppför backen ligger Kungliga slottet, som stod klart 1754 efter att det gamla slottet Tre Kronor brann 1697. Slottet har över sexhundra rum, och vaktavlösningen på yttre borggården lockar besökare varje dag.","tips":[["Kungliga slottet","2 min"],["Gamla stans gränder","3 min"]],"dur":13.6,"images":[{"src":"https://pub.raa.se/dokumentation/148b0000-4ab4-4a95-a1cf-860b4c1709de/visning/1","credit":"Nilsson, Pål-Nils","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/148b0000-4ab4-4a95-a1cf-860b4c1709de","title":"Julstämning vid Slottsbacken","old":true,"year":1953,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/710d3c5e09f0ea05.mp3"},{"name":"Slussen","lat":59.320094,"lon":18.070981,"story":"Slussen är platsen där Mälaren möter Saltsjön och där Södermalm möter Gamla stan. Här har det funnits slussar sedan 1600-talet, och just nu byggs hela området om i ett av Stockholms största byggprojekt. Från kajerna har du utsikt mot Gamla stan, Skeppsholmen och Djurgården.","tips":[["Gamla stan","5 min",59.32332,18.06698],["Fotografiska vid Stadsgårdskajen","8 min"],["Utsikt från Katarinahissen","4 min",59.32,18.072778]],"dur":16.1,"images":[{"src":"https://pub.raa.se/dokumentation/27328925-fa58-4bee-b01b-563724294a32/visning/1","credit":"Rosenberg, Carl Gustaf","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/27328925-fa58-4bee-b01b-563724294a32","title":"Slussen","old":true,"year":1922,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/ed8c019f-0660-43dd-92c3-feabc2c7ec34/visning/1","credit":"Rosenberg, Carl Gustaf","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/ed8c019f-0660-43dd-92c3-feabc2c7ec34","title":"Båt vid Slussen","old":true,"year":null,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/df5f6f471df10875.mp3"},{"name":"Medborgarplatsen","lat":59.314379,"lon":18.075201,"story":"Medborgarplatsen är Södermalms stora torg, med uteserveringar på somrarna och skridskobana om vintern. Härifrån når du Götgatan, Söders livliga huvudgata.","tips":[["Götgatan","1 min",59.33525,18.062333],["Björns trädgård","1 min",59.315278,18.073889]],"dur":9.4,"images":[{"src":"https://pub.raa.se/dokumentation/22a479e9-dd72-4389-bceb-b19e24be1611/visning/1","credit":"Bruno, Fredrik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/22a479e9-dd72-4389-bceb-b19e24be1611","title":"Medborgarplatsen, Södermalm. \"Medborgarhuset i Stockholm\". Återfotografering år 2010: se bild nr ND38940","old":true,"year":1945,"museum":"Riksantikvarieämbetet"},{"src":"https://ems.dimu.org/image/019EE8ixNbLHi?dimension=600x600","credit":"Gullers, K W","license":"CC BY-SA","page":"https://kulturarvsdata.se/nomu/photo/html/NMAx0001607","title":"Medborgarplatsen","old":true,"year":1941,"museum":"Nordiska museet"}],"audio":"audio/piper/6929f14e442995c0.mp3"},{"name":"Åsögatan","lat":59.313843,"lon":18.084557},{"name":"Gotlandsgatan","lat":59.310573,"lon":18.086054,"story":"Groens malmgård är en riktig överlevare: huvudbyggnaden i karolinsk stil är den enda kvarvarande av sin typ i Stockholm, och i trädgården har man odlat oavbrutet i mer än 300 år. Gatan utanför hette först Vermdögatan, men namnet ansågs missvisande och byttes 1939 mot Malmgårdsvägen. På 1600-talet snurrade här också en väderkvarn, Bengt Bagares kvarn.","tips":[["Groens malmgård","1 min",59.310833,18.087222],["Konstverket Sophie","2 min",59.309728,18.086264]],"dur":22.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Malmg%C3%A5rdsv%C3%A4gen_2009.jpg/1280px-Malmg%C3%A5rdsv%C3%A4gen_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Malmg%C3%A5rdsv%C3%A4gen_2009.jpg","title":"Malmgårdsvägen 2009"},{"src":"https://upload.wikimedia.org/wikipedia/commons/2/26/Bengt_Bagares_kvarn_Holm_1674a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Holms tomtbok","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Bengt_Bagares_kvarn_Holm_1674a.jpg","title":"Bengt Bagares kvarn Holm 1674a"}],"audio":"audio/piper/a1dc7cacdbe59ee7.mp3"},{"name":"Ljusterögatan","lat":59.308652,"lon":18.088486,"story":"Snart är vi framme vid ändhållplatsen Ljusterögatan. Tack för att du åkte med!","tips":[],"dur":4.4,"audio":"audio/piper/968d9e067dcd07d0.mp3"}],"looks":[{"id":"slottet","lat":59.3268,"lon":18.0717,"r":260,"text":"Till höger ligger Kungliga slottet.","dur":3.0,"audio":"audio/piper/943189fce984ea0e.mp3"}],"from":"Ropsten","to":"Ljusterögatan","variant":"Mot Ljusterögatan","color":["#d71d24","#ffffff"],"trips":198,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}