,[59.234778,18.094735],[59.235643,18.096055],[59.235568,18.097174],[59.235662,18.098824],[59.235961,18.100528],[59.236205,18.10277],[59.236287,18.109275],[59.2364,18.109275],[59.236405,18.106847],[59.236223,18.101742],[59.236286,18.101713],[59.236223,18.101743],[59.235617,18.098144],[59.235568,18.097174],[59.235643,18.096055],[59.235977,18.094548],[59.237037,18.092789],[59.237523,18.092245],[59.237698,18.092444],[59.237895,18.092342],[59.238339,18.09297],[59.239142,18.093603],[59.239667,18.093237],[59.240008,18.092373],[59.240684,18.093361],[59.240858,18.094491],[59.241479,18.096332],[59.241711,18.096587],[59.24219,18.096482],[59.242201,18.096621],[59.242191,18.096482],[59.24273,18.095935],[59.2436,18.094294],[59.24417,18.094127],[59.244197,18.093743],[59.243779,18.092521]],"stops":[{"name":"Pelikanvägen","lat":59.194435,"lon":18.061184,"story":"Välkommen ombord på buss 833 mot Farsta centrum! Resan tar ungefär 41 minuter. Luta dig tillbaka och titta ut genom fönstret.","tips":[],"dur":9.4,"audio":"audio/piper/c0a3b526ce811056.mp3"},{"name":"Ringsättravägen","lat":59.19922,"lon":18.071113,"story":"En bit härifrån ligger Vidja, vid östra stranden av sjön Orlången. Byn är lite av en återvändsgränd: bilvägen in går bara norrifrån, genom Ågesta. Sedan 2018 bildar de båda tillsammans kommundelen Vidja-Ågesta. I skogarna runt Lissma ligger också Kvarnsjön, en långsmal och grund sjö som är skyddad som Natura 2000-område.","tips":[],"dur":20.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/Vidja_brevl%C3%A5dor_2011.jpg/1280px-Vidja_brevl%C3%A5dor_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Vidja_brevl%C3%A5dor_2011.jpg","title":"Vidja brevlådor 2011"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/%C3%85gesta_g%C3%A5rd_huvudbyggnad%2C_2012.jpg/1280px-%C3%85gesta_g%C3%A5rd_huvudbyggnad%2C_2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:%C3%85gesta_g%C3%A5rd_huvudbyggnad,_2012.jpg","title":"Ågesta gård huvudbyggnad, 2012"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d7/Kvarnsj%C3%B6n%2C_Lissma_2012a.jpg/1280px-Kvarnsj%C3%B6n%2C_Lissma_2012a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Kvarnsj%C3%B6n,_Lissma_2012a.jpg","title":"Kvarnsjön, Lissma 2012a"}],"audio":"audio/piper/19276b9367f86c3e.mp3"},{"name":"Ågesta värmeverk","lat":59.207213,"lon":18.079869,"story":"Ett stenkast härifrån ligger Ågestaverket, även kallat R3 eller Adam, Sveriges första kärnkraftverk som levererade energi till konsumenter. Det gav mest fjärrvärme till Farsta, så det kallades atomkraftvärmeverket. Reaktorn använde tungt vatten och naturligt uran. Verket stängdes 1974 men står till stora delar kvar och har fått ett nytt liv som övningsfält för Stockholms brandförsvar.","tips":[["Ågestaverket","3 min"]],"dur":23.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/%C3%85gesta_k%C3%A4rnkraftverk_2005_%286%29.jpg/1280px-%C3%85gesta_k%C3%A4rnkraftverk_2005_%286%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Cronestrand, Nisse","license":"CC BY 4.0","page":"https://commons.wikimedia.org/wiki/File:%C3%85gesta_k%C3%A4rnkraftverk_2005_(6).jpg","title":"Ågesta kärnkraftverk 2005 (6)"}],"audio":"audio/piper/fbad4bba26129550.mp3"},{"name":"Hagvreten","lat":59.213436,"lon":18.082879,"story":"En bit härifrån slingrar sig Söderån, ett drygt kilometerlångt vattendrag mellan sjöarna Orlången och Ågestasjön. Ån börjar i Orlångens norra vik med det fina namnet Fräkenbotten och rinner sedan genom en våtmark som kallas Pumphusängen. Allt hör till Orlångens naturreservat. Lite längre bort ligger Ågestaverket, Sveriges första kärnkraftverk som levererade energi till konsumenter.","tips":[],"dur":21.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/S%C3%B6der%C3%A5n_2012a.jpg/1280px-S%C3%B6der%C3%A5n_2012a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:S%C3%B6der%C3%A5n_2012a.jpg","title":"Söderån 2012a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/%C3%85gesta_k%C3%A4rnkraftverk_2005_%286%29.jpg/1280px-%C3%85gesta_k%C3%A4rnkraftverk_2005_%286%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Cronestrand, Nisse","license":"CC BY 4.0","page":"https://commons.wikimedia.org/wiki/File:%C3%85gesta_k%C3%A4rnkraftverk_2005_(6).jpg","title":"Ågesta kärnkraftverk 2005 (6)"}],"audio":"audio/piper/8af468aa07ea1431.mp3"},{"name":"Ågesta gård","lat":59.221428,"lon":18.081063,"story":"Ågesta gårds stora stenbyggnad från 1600-talet ligger alldeles intill och fick sitt nuvarande utseende kring sekelskiftet 1800. Sedan 1945 ägs gården av Stockholms stad. Nedanför ligger Ågestasjön, och namnet är en liten gåta. Åg är ett gammalt ord för säv och vass, men hembygdsföreningen menar att namnet kommer från Åkes sta. Sjön ingår i Orlångens naturreservat.","tips":[["Ågesta gård","2 min"],["Ågestasjön","6 min"]],"dur":23.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a7/%C3%85gesta_g%C3%A5rd_2012a.jpg/1280px-%C3%85gesta_g%C3%A5rd_2012a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:%C3%85gesta_g%C3%A5rd_2012a.jpg","title":"Ågesta gård 2012a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/%C3%85gesta_1920-tal.jpg/1280px-%C3%85gesta_1920-tal.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:%C3%85gesta_1920-tal.jpg","title":"Ågesta 1920-tal"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/%C3%85gestasj%C3%B6n_in_spring_2008-1.jpg/1280px-%C3%85gestasj%C3%B6n_in_spring_2008-1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Leo Johannes","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:%C3%85gestasj%C3%B6n_in_spring_2008-1.jpg","title":"Ågestasjön in spring 2008-1"}],"audio":"audio/piper/04ec2d14ced6fc1d.mp3"},{"name":"Ågesta friluftsgård","lat":59.223195,"lon":18.103136,"story":"Vid sjön Magelungen alldeles intill driver Frälsningsarmén Ågesta folkhögskola och en officersskola. Den lilla torpstugan Nynäs finns också kvar och hör i dag till friluftsområdet. Lite längre bort, på en udde, ligger Ågestabadet, Stockholms stads enda officiella naturistbad, fast det ligger i Huddinge. Här är det alltså fritt fram att bada precis som naturen skapade en.","tips":[["Ågestabadet","8 min"]],"dur":21.9,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/71/Strandhuset_%C3%85gesta_folkh%C3%B6gskola.jpeg/1280px-Strandhuset_%C3%85gesta_folkh%C3%B6gskola.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Vegtog","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Strandhuset_%C3%85gesta_folkh%C3%B6gskola.jpeg","title":"Strandhuset Ågesta folkhögskola"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/65/Torpet_Nyn%C3%A4s_1920-tal.jpg/1280px-Torpet_Nyn%C3%A4s_1920-tal.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Unknown authorUnknown author","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Torpet_Nyn%C3%A4s_1920-tal.jpg","title":"Torpet Nynäs 1920-tal"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/%C3%85gestabadet_%28naturistbad%29%2C_2018b.jpg/1280px-%C3%85gestabadet_%28naturistbad%29%2C_2018b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:%C3%85gestabadet_(naturistbad),_2018b.jpg","title":"Ågestabadet (naturistbad), 2018b"}],"audio":"audio/piper/b00d80edbc6ea495.mp3"},{"name":"Rödmossevägen","lat":59.22827,"lon":18.087635,"story":"Alldeles i närheten står Villa Brännugnen, en privatvilla ritad av Gert Wingårdh, med en restaurang som är öppen för allmänheten. Den fick Huddinges byggnadspris 2019. En bit bort spänner Ågestabron över Magelungen. Bron står med ena foten i Stockholm och den andra i Huddinge, för ungefär halva bron ligger i varje kommun.","tips":[["Villa Brännugnen","3 min"],["Ågestabron","6 min"]],"dur":19.1,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Villa_Br%C3%A4nnugnen%2C_Huddinge%2C_okt_2021a.jpg/1280px-Villa_Br%C3%A4nnugnen%2C_Huddinge%2C_okt_2021a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 4.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Br%C3%A4nnugnen,_Huddinge,_okt_2021a.jpg","title":"Villa Brännugnen, Huddinge, okt 2021a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/Magelungen_2010b.jpg/1280px-Magelungen_2010b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Magelungen_2010b.jpg","title":"Magelungen 2010b"}],"audio":"audio/piper/59eebda58bbfade7.mp3"},{"name":"Ekshäradsgatan","lat":59.234597,"lon":18.094514,"story":"Villa Marieborg alldeles intill började som torpet Aspviken år 1712. På 1770-talet byggde kommerserådet Paul Prinzell om det till villa och döpte det efter sin hustru Maria. En bit bort ligger Rödkinda barnhem, vars namn syftar på att den friska luften skulle ge barnen röda kinder. Torget vid tunnelbanan är uppkallat efter Stieg Trenter, som föddes i närheten och lät romanen Träff i helfigur utspela sig i trakten.","tips":[["Villa Marieborg","3 min"],["Stieg Trenters torg","6 min"]],"dur":24.2,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Marieborg_2011a.jpg/1280px-Marieborg_2011a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Marieborg_2011a.jpg","title":"Marieborg 2011a"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b7/R%C3%B6dkinda_barnhem_2011.jpg/1280px-R%C3%B6dkinda_barnhem_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:R%C3%B6dkinda_barnhem_2011.jpg","title":"Rödkinda barnhem 2011"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Stieg_Trenters_torg_2011.jpg/1280px-Stieg_Trenters_torg_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stieg_Trenters_torg_2011.jpg","title":"Stieg Trenters torg 2011"}],"audio":"audio/piper/b5f569d3ce62e2f9.mp3"},{"name":"Farsta strand","lat":59.236085,"lon":18.102,"story":"Torget vid stationen är uppkallat efter deckarförfattaren Stieg Trenter, som föddes på Magelungsvägen 453. Hans föräldrar drev en livsmedelsaffär vid järnvägsstationen som då hette Södertörns villastad, där unge Stieg hjälpte till ibland – och kriminalromanen Träff i helfigur utspelar sig i omgivningarna. Själva villastaden blev aldrig av: tomterna sålde trögt, främst på grund av dåliga kommunikationer.","tips":[["Stieg Trenters torg","1 min"]],"dur":23.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Stieg_Trenters_torg_2011.jpg/1280px-Stieg_Trenters_torg_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Stieg_Trenters_torg_2011.jpg","title":"Stieg Trenters torg 2011"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3e/Villa_Dagaborg_2011a.jpg/1280px-Villa_Dagaborg_2011a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Dagaborg_2011a.jpg","title":"Villa Dagaborg 2011a"}],"audio":"audio/piper/2c68dfdde1a15564.mp3"},{"name":"Boforsgatan","lat":59.236473,"lon":18.093839},{"name":"Kristinehamnsgatan","lat":59.238807,"lon":18.093564,"story":"Nere vid Magelungen står en stor röd trävilla från 1916–1917, byggd som barnhem. Namnet Rödkinda kom av tanken att frisk luft skulle ge barnen röda kinder. Villan står på en kulle med södersluttning ner mot sjön. Farsta gymnasiums gamla lokaler används numera av Farsta grundskola och Adolf Fredriks musikklasser.","tips":[["Gå ner mot Magelungen och Rödkinda","6 min"]],"dur":19.6,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b7/R%C3%B6dkinda_barnhem_2011.jpg/1280px-R%C3%B6dkinda_barnhem_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Holger.Ellgaard","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:R%C3%B6dkinda_barnhem_2011.jpg","title":"Rödkinda barnhem 2011"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Farsta_gymnasium.jpg/1280px-Farsta_gymnasium.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Farsta_gymnasium.jpg","title":"Farsta gymnasium"}],"audio":"audio/piper/87e8dd3c14386e04.mp3"},{"name":"Storforsplan","lat":59.24038,"lon":18.093038,"story":"Farsta torg, ett par minuter härifrån, anlades som en italiensk piazza och invigdes den 23 oktober 1960. Det långsmala torget, 180 gånger 100 meter, har en konvex form som kan ha inspirerats av Piazza delle Erbe i Verona – och här är det torghandel med frukt och blommor de flesta dagar. Granne är det före detta Farsta gymnasium, där Adolf Fredriks musikklasser numera håller till.","tips":[["Farsta torg","4 min"],["Farsta Centrum","4 min"]],"dur":23.3,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/c/cb/Farsta_centrum_1967.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Stockholms Spårvägsmuseum.","license":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Farsta_centrum_1967.jpg","title":"Farsta centrum 1967"},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Farsta_gymnasium.jpg/1280px-Farsta_gymnasium.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Larske","license":"CC BY-SA 3.0","page":"https://commons.wikimedia.org/wiki/File:Farsta_gymnasium.jpg","title":"Farsta gymnasium"}],"audio":"audio/piper/7e8c6461631e0a7f.mp3"},{"name":"Säfflegatan","lat":59.242201,"lon":18.096621},{"name":"Farsta centrum","lat":59.243779,"lon":18.092521,"story":"Snart är vi framme vid ändhållplatsen Farsta centrum. Farsta centrum invigdes den 23 oktober 1960 och var stort för sin tid, med rulltrappor och allt. Bilgaraget var ett av Europas största med plats för 4 000 bilar. För att korta vägen till butikerna installerades rullband som förde kunderna från bilarna. Farsta kallades Söderorts svar på Vällingby. Tack för att du åkte med!","tips":[],"dur":23.4,"images":[{"src":"https://upload.wikimedia.org/wikipedia/commons/2/20/Farsta_torg_Farsta_Stockholm_02_2005-07-25.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Jordgubbe","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Farsta_torg_Farsta_Stockholm_02_2005-07-25.jpg","title":"Farsta torg, Farsta, Stockholm, Sweden.","near":true},{"src":"https://upload.wikimedia.org/wikipedia/commons/8/81/Farsta_torg_Farsta_Stockholm_2005-07-25.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","credit":"Jordgubbe","license":"CC BY-SA 2.0","page":"https://commons.wikimedia.org/wiki/File:Farsta_torg_Farsta_Stockholm_2005-07-25.jpg","title":"Farsta torg, Farsta, Stockholm, Sweden.","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Facade_in_new_shopping_center_in_farsta_suburb_of_stockholm.jpg/1280px-Facade_in_new_shopping_center_in_farsta_suburb_of_stockholm.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Andy Eick","license":"CC BY 2.0","page":"https://commons.wikimedia.org/wiki/File:Facade_in_new_shopping_center_in_farsta_suburb_of_stockholm.jpg","title":"facade in new shopping center in farsta suburb of stockholm","near":true}],"audio":"audio/piper/07fccedb0b50592c.mp3"}],"looks":[],"from":"Pelikanvägen","to":"Farsta centrum","variant":"Mot Farsta centrum","color":["#d71d24","#ffffff"],"trips":38,"source":"SL via Trafiklab (GTFS Regional)","tts":"Piper"}