2-44d1-86f6-c051d3824f51/visning/1","credit":"Rosenberg, Carl Gustaf","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/2dd0d24b-a1a2-44d1-86f6-c051d3824f51","title":"Utsikt mot Slottet från Kungsträdgården","old":true,"year":1922,"museum":"Riksantikvarieämbetet"},{"src":"https://pub.raa.se/dokumentation/ee5643ae-c47e-4579-9543-099f026163cb/visning/1","credit":"Claesson, Erik","license":"Public domain","page":"https://kulturarvsdata.se/raa/dokumentation/html/ee5643ae-c47e-4579-9543-099f026163cb","title":"Kungsträdgården - City","old":true,"year":1967,"museum":"Riksantikvarieämbetet"}],"audio":"audio/piper/7c7439e25bb3acdc.mp3"},{"name":"Nybroplan","lat":59.332616,"lon":18.076895,"story":"Vid Nybroplan ligger Dramaten, Kungliga Dramatiska teatern, invigd 1908. Härifrån börjar Strandvägen, med sina pampiga sekelskifteshus längs vattnet, och från Nybrokajen går båtar ut i skärgården.","tips":[["Strandvägen, promenad längs vattnet","2 min"],["Båtar från Nybrokajen","2 min"]],"dur":12.5,"images":[{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9b/Norrmalm%2C_Stockholm%2C_Sweden_-_panoramio_%2841%29.jpg/1280px-Norrmalm%2C_Stockholm%2C_Sweden_-_panoramio_%2841%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"Алексей Решетников","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Norrmalm,_Stockholm,_Sweden_-_panoramio_(41).jpg","title":"Norrmalm, Stockholm, Sweden","near":true},{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Sweden_-_Stockholm_-_panoramio_%2823%29.jpg/1280px-Sweden_-_Stockholm_-_panoramio_%2823%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","credit":"randreu","license":"CC BY 3.0","page":"https://commons.wikimedia.org/wiki/File:Sweden_-_Stockholm_-_panoramio_(23).jpg","title":"Sweden - Stockholm","near":true},{"src":"https://pub.raa.se/dokumentation/40c8b182-f89b-41d4-9376-5386108120ab/visni