// Cloudflare Workers: statiska filer från public/ och API:erna /api/vt och /api/sl.
// Västtrafiks nyckel läggs in som hemlighet VT_AUTH_KEY och Trafiklab Realtime APIs som TRAFIKLAB_RT_KEY (Settings → Variables and Secrets).
{
  "name": "hoppa-pa",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  // behåll variabler som lagts in i Cloudflares dashboard när koden driftsätts
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Resenärernas tips/felrapporter och anonym statistik. Databasen skapas automatiskt vid första deploy.
  // Granskningssidan /admin.html kräver hemligheten ADMIN_KEY (Settings → Variables and Secrets).
  "d1_databases": [{ "binding": "DB", "database_name": "hoppa-pa" }]
}
